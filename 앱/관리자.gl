    (* Hugging Face 의 GGUF — 받기 전에 앞부분만 받아 확인(스레드), 확인된 것만 목록에 더한다. 주소는 저장소 · 파일 이름으로 관리자가 짓는다 *)
    문자열_같은가(길, "/api/hf/check")이면 {
        문자열 주소 = 허깅주소(제글값(o, "repo", ""), 제글값(o, "file", "")).
        주소 == 없음이면 { 웹오류(c, 400, "Hugging Face 저장소 · 파일 이름이 올바르지 않습니다"). 반환. }
        잠그기().
        참거짓 바쁨2 = 지금확인 != 없음 그리고 지금확인→상태 == 1.
        아닌 바쁨2이면 {
            원격확인 참조 x2 = 초기할당(1 을, 크기(원격확인)).
            x2→주소 = 주소.
            x2→전체 = 제정수값(o, "size", 0).
            x2→상태 = 1.
            x2→까닭 = "".
            지금확인 = x2.
        }
        원격확인 참조 x3 = 지금확인.
        풀기().
        바쁨2이면 { 웹오류(c, 409, "다른 파일을 확인하는 중입니다 — 잠시 뒤 다시 시도하세요"). 반환. }
        [공허 참조 -> 중간정수] 함수7 = 원격확인일.
        공허 참조 h7 = 스레드띄우기(함수7 으로 공허 참조, x3).
        h7 == 없음이면 { 잠그기(). x3→상태 = 3. x3→까닭 = "확인 스레드를 시작하지 못했습니다". 풀기(). } 아니면 { 앱핸들닫기(h7). }
        웹좋음(c).
        반환.
    }
    문자열_같은가(길, "/api/hf/add")이면 {
        문자열 저장소 = 제글값(o, "repo", "").
        문자열 파일길 = 제글값(o, "file", "").
        문자열 주소2 = 허깅주소(저장소, 파일길).
        주소2 == 없음이면 { 웹오류(c, 400, "Hugging Face 저장소 · 파일 이름이 올바르지 않습니다"). 반환. }
        문자열 해시값 = 제글값(o, "sha256", "").
        글자수(해시값) != 64이면 { 웹오류(c, 400, "SHA-256 값이 없습니다 — Hugging Face가 알려 준 파일만 받습니다"). 반환. }
        (* 파일 이름(폴더를 뺀 끝) *)
        정수 끝 = -1.
        반복 (정수 k7 = 0: 파일길[k7] != 0: k7 += 1) { 파일길[k7] == 47이면 { 끝 = k7. } }
        문자열 바탕이름 = 문자열_복제(파일길 + 끝 + 1).
        잠그기().
        문자열 까닭7 = "".
        원격확인 참조 x4 = 지금확인.
        (x4 == 없음 또는 아닌 문자열_같은가(x4→주소, 주소2) 또는 x4→상태 != 2 또는 x4→모양 == 없음)이면 { 까닭7 = "먼저 이 파일을 확인하세요". }
        아니면 아닌 x4→모양→받음이면 { 까닭7 = x4→모양→까닭. }
        문자열 아이디7 = 짓기("hf-%s", 새아이디(바탕이름)).
        문자열 경로7 = 잇기(모델폴더, 바탕이름).
        (* 이미 더한 같은 주소면 그 아이디 *)
        문자열 있던아이디 = 없음.
        제이슨 참조 l7 = 없음.
        추가트리 != 없음이면 { l7 = 제찾기(추가트리, "models"). }
        (l7 != 없음 그리고 l7→종류 == 5)이면 {
            반복 (정수 k8는 0부터 제개수(l7) 전까지) {
                제이슨 참조 e7 = 제자식(l7, k8).
                문자열_같은가(제글값(e7, "url", ""), 주소2)이면 { 있던아이디 = 제글값(e7, "id", 없음). }
            }
        }
        (있던아이디 == 없음 그리고 글자수(까닭7) == 0)이면 {
            반복 (정수 k9는 0부터 정수목록_길이(모델들) 전까지) {
                모델 참조 m7 = 모델칸(k9).
                문자열_같은가(m7→경로, 경로7)이면 { 까닭7 = 잇기("모델 폴더에 같은 이름의 파일이 이미 있습니다: ", 바탕이름). }
            }
            목록찾기(아이디7) != 없음이면 { 까닭7 = "같은 이름의 모델이 이미 목록에 있습니다". }
        }
        바이트열 참조 새칸 = 바이트열_만들기().
        (있던아이디 == 없음 그리고 글자수(까닭7) == 0)이면 {
            모델모양 참조 s7 = x4→모양.
            문자열 양자 = 제글값(o, "quant", "").
            글자수(양자) == 0이면 { 양자 = 형식이름(s7→형식). }
            날글넣기(새칸, "\{").
            제쌍글(새칸, "id", 아이디7). 날글넣기(새칸, ",").
            제쌍글(새칸, "name", 제글값(o, "name", 바탕이름)). 날글넣기(새칸, ",").
            제쌍글(새칸, "quant", 양자). 날글넣기(새칸, ",").
            제쌍글(새칸, "params", 잇기(실수글((s7→매개변수수 으로 실수) / 1.0e9, 1), "B")). 날글넣기(새칸, ",").
            제쌍글(새칸, "file", 바탕이름). 날글넣기(새칸, ",").
            제쌍수(새칸, "size", x4→전체). 날글넣기(새칸, ",").
            제쌍글(새칸, "sha256", 해시값). 날글넣기(새칸, ",").
            제쌍글(새칸, "source", 잇기("huggingface.co/", 저장소)). 날글넣기(새칸, ",").
            제쌍글(새칸, "url", 주소2). 날글넣기(새칸, ",").
            제쌍글(새칸, "license", 제글값(o, "license", "")). 날글넣기(새칸, ",").
            제쌍글(새칸, "check", "hf"). 날글넣기(새칸, ",").
            문자열 장치들 = "all".
            K형식인가(s7→형식)이면 { 장치들 = "k". }
            제쌍글(새칸, "devices", 장치들). 날글넣기(새칸, ",").
            제쌍글(새칸, "note", "Hugging Face에서 고른 파일 — 받기 전에 GGUF 머리로 GeulPU가 받는 모양인지 확인했습니다.").
            날글넣기(새칸, "\}").
            바이트열_넣기(새칸, 0).
        }
        풀기().
        글자수(까닭7) > 0이면 { 바이트열_해제(새칸). 웹오류(c, 400, 까닭7). 반환. }
        있던아이디 != 없음이면 { 아이디7 = 있던아이디. }
        아니면 { 허깅목록쓰기(없음, 바이트열_자료(새칸)). }
        바이트열_해제(새칸).
        바이트열 참조 b7 = 바이트열_만들기().
        날글넣기(b7, "\{\"ok\":true,").
        제쌍글(b7, "id", 아이디7).
        날글넣기(b7, "\}").
        웹제이슨(c, 200, b7).
        바이트열_해제(b7).
        반환.
    }
    (* 받다 만 파일 지우기 — 받는 중이면 먼저 멈춰야 한다. Hugging Face 에서 더한 것이면 목록에서도 뺀다 *)
    문자열_같은가(길, "/api/models/discard")이면 {
        문자열 아이디8 = 제글값(o, "id", "").
        잠그기().
        문자열 까닭8 = "".
        받기 참조 d8 = 받기찾기(아이디8).
        (d8 != 없음 그리고 (d8→상태 == 1 또는 d8→상태 == 2))이면 { 까닭8 = "다운로드 중입니다 — 먼저 일시정지하세요". }
        목록모델가진것(아이디8) != 없음이면 { 까닭8 = "이미 설치된 모델입니다 — 모델 메뉴에서 제거하세요". }
        제이슨 참조 e8 = 목록찾기(아이디8).
        e8 == 없음이면 { 까닭8 = "목록에 없는 모델입니다". }
        문자열 부분8 = 없음.
        e8 != 없음이면 { 부분8 = 잇기3(모델폴더, 제글값(e8, "file", "model.gguf"), ".part"). }
        참거짓 허깅것 = 트리에서찾기(추가트리, 아이디8) != 없음.
        글자수(까닭8) == 0이면 {
            정수목록 참조 새3 = 정수목록_만들기().
            반복 (정수 k10는 0부터 정수목록_길이(받기들) 전까지) {
                받기 참조 x5 = 정수목록_값(받기들, k10) 으로 받기 참조.
                아닌 문자열_같은가(x5→아이디, 아이디8)이면 { 정수목록_추가(새3, x5 으로 정수). }
            }
            받기들 = 새3.
        }
        풀기().
        글자수(까닭8) > 0이면 { 웹오류(c, 409, 까닭8). 반환. }
        파일지우기(부분8).
        허깅것이면 { 허깅목록쓰기(아이디8, 없음). }
        웹좋음(c).
        반환.
    }
    문자열_같은가(길, "/api/models/cancel")이면 {
        문자열 아이디6 = 제글값(o, "id", "").
        잠그기().
        받기 참조 d2 = 받기찾기(아이디6).
        d2 != 없음이면 { d2→멈춤 = 1. }
        풀기().
        웹좋음(c).
        반환.
    }
    문자열_같은가(길, "/api/open")이면 {
        문자열 무엇 = 제글값(o, "what", "data").
        문자열 곳 = 자료폴더.
        문자열_같은가(무엇, "models")이면 { 곳 = 모델폴더. }
        문자열_같은가(무엇, "results")이면 { 곳 = 결과폴더. }
        문자열_같은가(무엇, "result")이면 {
            문자열 이름 = 제글값(o, "name", "").
            결과이름맞나(이름)이면 { 곳 = 잇기(결과폴더, 이름). }
        }
        셸열기(곳).
        웹좋음(c).
        반환.
    }
    웹오류(c, 404, 잇기("없는 경로입니다: ", 길)).
}

(* ===== 시작 ===== *)

[실행폴더찾기]는 -> 문자열 {
    문자열 경로 = 실행파일_경로().
    경로 == 없음이면 { 반환 문자열_복제(".\\"). }
    정수 마지막 = -1.
    반복 (정수 k = 0: 경로[k] != 0: k += 1) {
        (경로[k] == 47 또는 경로[k] == 92)이면 { 마지막 = k. }
    }
    마지막 < 0이면 { 반환 문자열_복제(".\\"). }
    반환 문자열_자르기(경로, 0, 마지막 + 1).
}

[판정보읽기]는 {
    제이슨 참조 v = 제파일읽기(앱경로("version.json")).
    v == 없음이면 { 반환. }
    앱커밋 = 제글값(v, "commit", "").
    앱빌드때 = 제글값(v, "built", "").
    잠그기(). 제놓기(v). 풀기().
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    콘솔출력코드(65001).
    잠금준비().
    해시알고준비().
    일객체준비().
    문자열 자료인자 = 없음.
    참거짓 열기 = 참.
    반복 (정수 k = 1: k < argc: k += 1) {
        (문자열_같은가(argv[k], "--포트") 그리고 k + 1 < argc)이면 { 관리포트 = 정수로_변환(argv[k + 1]). k += 1. }
        아니면 (문자열_같은가(argv[k], "--자료") 그리고 k + 1 < argc)이면 { 자료인자 = argv[k + 1]. k += 1. }
        아니면 문자열_같은가(argv[k], "--열지않음")이면 { 열기 = 거짓. }
    }
    앱폴더 = 실행폴더찾기().
    콘솔제목W(넓게(잇기("GeulPU ", 앱판))).
    웹준비().
    (* 듣기 — 이미 GeulPU 가 그 포트에 있으면 그 화면을 열고 끝낸다 *)
    정수 포트 = 관리포트.
    참거짓 들음 = 웹듣기(포트).
    아닌 들음이면 {
        위답 참조 r = 위묻기("GET", 포트, "/api/ping", 없음, 3).
        (r != 없음 그리고 r→코드 == 200 그리고 문자열_찾기(r→몸 에서, "geulpu") != 없음)이면 {
            알림(짓기("GeulPU가 이미 http://127.0.0.1:%lld 에서 실행 중입니다 — 그 화면을 엽니다.", 포트)).
            열기이면 { 셸열기(짓기("http://127.0.0.1:%lld/", 포트)). }
            반환 0.
        }
        반복 (정수 p = 포트 + 1: p < 포트 + 20 그리고 아닌 들음: p += 1) {
            웹듣기(p)이면 { 들음 = 참. }
        }
    }
    아닌 들음이면 {
        알림(짓기("포트 %lld 근처에서 연결을 받을 수 없습니다 — --포트 옵션으로 다른 포트를 지정하세요.", 포트)).
        반환 1.
    }
    (* 자료 폴더 *)
    문자열 자료 = 자료인자.
    자료 == 없음이면 { 자료 = 환경변수("GEULPU_HOME"). }
    자료 == 없음이면 {
        문자열 집 = 환경변수("USERPROFILE").
        집 == 없음이면 { 집 = 문자열_자르기(앱폴더, 0, 글자수(앱폴더) - 1). }
        자료 = 잇기(집, "\\GeulPU").
    }
    자료폴더 = 폴더꼴(자료).
    폴더만들기(문자열_자르기(자료폴더, 0, 글자수(자료폴더) - 1)).
    설정읽기().
    모델폴더 = 잇기(자료폴더, "모델\\").
    글자수(설정모델폴더) > 0이면 { 모델폴더 = 폴더꼴(설정모델폴더). }
    결과폴더 = 잇기(자료폴더, "결과\\").
    기록폴더 = 잇기(자료폴더, "기록\\").
    모듈폴더 = 잇기3(자료폴더, "모듈\\", 잇기(앱판, "\\")).
    폴더만들기(문자열_자르기(모델폴더, 0, 글자수(모델폴더) - 1)).
    폴더만들기(문자열_자르기(결과폴더, 0, 글자수(결과폴더) - 1)).
    폴더만들기(문자열_자르기(기록폴더, 0, 글자수(기록폴더) - 1)).
    판정보읽기().
    목록트리 = 제파일읽기(앱경로("data\\models.json")).
    추가트리 = 제파일읽기(잇기(자료폴더, "허깅목록.json")).
    받기들 = 정수목록_만들기().
    모델들읽기().
    알림(짓기("GeulPU %s — 글(geul) 언어로 쓴 LLM 엔진", 앱판)).
    알림(짓기("  화면: http://127.0.0.1:%lld/", 웹포트)).
    알림(짓기("  데이터: %s", 자료폴더)).
    알림("  이 창을 닫으면 GeulPU가 종료됩니다(불러온 모델과 실행 중인 작업도 함께).").
    (* 장치 확인부터 *)
    일 참조 j = 일만들기("device", "하드웨어 확인").
    j != 없음이면 {
        [공허 참조 -> 중간정수] 함수 = 장치일.
        일띄우기(j, 함수 으로 공허 참조).
    }
    열기이면 { 셸열기(짓기("http://127.0.0.1:%lld/", 웹포트)). }
    실수 살핌때 = 0.0.
    (참)동안 {
        웹한바퀴(50).
        정밀시각_밀리초() - 살핌때 > 1000.0이면 {
            서버살피기().
            살핌때 = 정밀시각_밀리초().
        }
    }
    반환 0.
}
