(* GeulPU.exe — GeulPU 앱의 관리자(36단계), 글(geul) 언어로. 두 번 누르면 http://127.0.0.1:44544 (44544 = '글' 의 코드포인트 U+AE00)에서
   화면(web\)을 열고 브라우저를 띄운다. 화면이 /api 로 장치 확인 · 모델 받기 · 서버 올리기 · 벤치(자기 진단 · 속도 · 교차검증)를 시키고,
   /v1 은 추론 서버(bin\server-cuda.exe · server-vulkan.exe — 127.0.0.1 의 다른 포트)로 넘긴다. 창을 닫으면 관리자와 그 아래 프로세스가 함께
   꺼진다(일 객체).

     GeulPU [--포트 44544] [--자료 <폴더>] [--열지않음]

   폴더: 실행 파일 옆의 bin · kernels · web · data(받을 모델 목록 · 교차검증 기준), 자료는 %USERPROFILE%\GeulPU(GEULPU_HOME 으로 바꿈) —
   설정.json · 모델목록.json · 모델\ · 모듈\<판>\ · 결과\ · 기록\.
   지킴: 127.0.0.1 에서만 듣고, Host 가 이 주소가 아니면(DNS 다시 묶기) · 다른 출처의 쓰기 요청이면 거절한다. CORS 머리는 내지 않는다. *)
포함 "윈도.gl"
포함 "웹.gl"
포함 "위.gl"
포함 "판.gl"
포함 "모델보기.gl"
포함 "상태.gl"
포함 "일.gl"
포함 "받기.gl"
포함 "묶기.gl"
포함 "벤치.gl"

정수 관리포트 = 44544.

(* ===== 지킴 ===== *)

[문자열 값을 문자열 앞을 정수 포트를 주소맞나]는 -> 참거짓 {
    값 == 없음이면 { 반환 거짓. }
    문자열 a = 짓기("%s127.0.0.1:%lld", 앞, 포트).
    문자열 b = 짓기("%slocalhost:%lld", 앞, 포트).
    참거짓 r = 문자열_같은가(값, a) 또는 문자열_같은가(값, b).
    해제(a).
    해제(b).
    반환 r.
}

(* ===== JSON 몸 ===== *)

[요청 참조 q를 몸풀기]는 -> 제이슨 참조 {
    (q→몸 == 없음 또는 q→몸길이 == 0)이면 { 반환 제풀기("\{\}", 2). }
    반환 제풀기(q→몸, q→몸길이).
}

[제이슨 참조 o를 몸놓기]는 {
    o == 없음이면 { 반환. }
    잠그기(). 제놓기(o). 풀기().
}

(* ===== 상태 ===== *)

[바이트열 참조 b에 목록제이슨]는 {
    날글넣기(b, "[").
    정수 쓴수 = 트리목록제이슨(목록트리, b, 0).
    트리목록제이슨(추가트리, b, 쓴수).
    날글넣기(b, "]").
}

(* 목록 하나(받을 수 있는 모델)의 칸들 — 앞에 쓴 수를 받아 쉼표를 맞추고, 쓴 수를 돌려준다 *)
[제이슨 참조 트리를 바이트열 참조 b에 정수 앞수로 트리목록제이슨]는 -> 정수 {
    정수 쓴수 = 앞수.
    (트리 != 없음)이면 {
        제이슨 참조 l = 제찾기(트리, "models").
        (l != 없음 그리고 l→종류 == 5)이면 {
            반복 (정수 k는 0부터 제개수(l) 전까지) {
                제이슨 참조 e = 제자식(l, k).
                문자열 아이디 = 제글값(e, "id", "").
                쓴수 > 0이면 { 날글넣기(b, ","). }
                쓴수 += 1.
                날글넣기(b, "\{").
                제쌍글(b, "id", 아이디). 날글넣기(b, ",").
                제쌍글(b, "name", 제글값(e, "name", "")). 날글넣기(b, ",").
                제쌍글(b, "quant", 제글값(e, "quant", "")). 날글넣기(b, ",").
                제쌍글(b, "params", 제글값(e, "params", "")). 날글넣기(b, ",").
                제쌍글(b, "file", 제글값(e, "file", "")). 날글넣기(b, ",").
                제쌍수(b, "size", 제정수값(e, "size", 0)). 날글넣기(b, ",").
                제쌍글(b, "sha256", 제글값(e, "sha256", "")). 날글넣기(b, ",").
                제쌍글(b, "source", 제글값(e, "source", "")). 날글넣기(b, ",").
                제쌍글(b, "url", 제글값(e, "url", "")). 날글넣기(b, ",").
                제쌍글(b, "license", 제글값(e, "license", "")). 날글넣기(b, ",").
                제쌍글(b, "check", 제글값(e, "check", "")). 날글넣기(b, ",").
                제쌍글(b, "devices", 제글값(e, "devices", "")). 날글넣기(b, ",").
                제쌍글(b, "note", 제글값(e, "note", "")). 날글넣기(b, ",").
                모델 참조 m = 목록모델가진것(아이디).
                문자열 가진것 = 없음.
                m != 없음이면 { 가진것 = m→아이디. }
                제쌍글(b, "installed", 가진것). 날글넣기(b, ",\"download\":").
                받기 참조 d = 받기찾기(아이디).
                d == 없음이면 { 날글넣기(b, "null"). } 아니면 { 받기제이슨(d, b). }
                날글넣기(b, "\}").
            }
        }
    }
    반환 쓴수.
}

(* 38단계 — 연구자 패널의 출처: 엔진 바이너리 다섯(릴리스 CI 의 해시 문과 같은 것)의 SHA-256 이 교차검증 기준(data\crosscheck\expected.json)과
   같은가, 지금 추론 서버가 쓰는 커널 모듈(이름 · SHA-256 · 층). 해시는 물을 때마다 셈한다(모듈 수십 MB — 수백 ms) *)
[바이트열 참조 b에 문자열 이름을 문자열 파일을 문자열 기대를 출처한줄]는 {
    문자열 h = 파일해시(앱경로(파일), 없음, 없음).
    날글넣기(b, "\{").
    제쌍글(b, "name", 이름). 날글넣기(b, ",").
    제쌍글(b, "file", 파일). 날글넣기(b, ",").
    h == 없음이면 { 날글넣기(b, "\"sha256\":null,"). } 아니면 { 제쌍글(b, "sha256", h). 날글넣기(b, ","). }
    기대 == 없음이면 { 날글넣기(b, "\"reference\":null,"). } 아니면 { 제쌍글(b, "reference", 기대). 날글넣기(b, ","). }
    제쌍참(b, "same", h != 없음 그리고 기대 != 없음 그리고 문자열_같은가(h, 기대)).
    날글넣기(b, "\}").
}

[출처제이슨]는 -> 바이트열 참조 {
    바이트열 참조 b = 바이트열_만들기().
    제이슨 참조 기준 = 제파일읽기(데이터경로("crosscheck\\expected.json")).
    제이슨 참조 빌 = 없음.
    제이슨 참조 빌V = 없음.
    기준 != 없음이면 {
        빌 = 제찾기(기준, "build").
        빌V = 제찾기(기준, "build_vulkan").
    }
    날글넣기(b, "\{\"app\":\{").
    제쌍글(b, "version", 앱판). 날글넣기(b, ",").
    제쌍글(b, "commit", 앱커밋). 날글넣기(b, ",").
    제쌍글(b, "built", 앱빌드때).
    날글넣기(b, "\},\"contract\":\"5.2 (38)\",\"binaries\":[").
    출처한줄(b, "generator", "bin\\kernel-gen.exe", 기준해시(빌, "generator", 없음)). 날글넣기(b, ",").
    출처한줄(b, "ptx_backend", "bin\\ptx-backend.exe", 기준해시(빌, "ptx_backend", 없음)). 날글넣기(b, ",").
    출처한줄(b, "server_r1 (server-cuda)", "bin\\server-cuda.exe", 기준해시(빌, "server_r1", 없음)). 날글넣기(b, ",").
    출처한줄(b, "spirv_backend", "bin\\spirv-backend.exe", 기준해시(빌V, "spirv_backend", 없음)). 날글넣기(b, ",").
    출처한줄(b, "server_r1_vulkan (server-vulkan)", "bin\\server-vulkan.exe", 기준해시(빌V, "server_r1_vulkan", 없음)).
    날글넣기(b, "],\"module\":").
    잠그기().
    문자열 모듈 = 없음.
    서버모듈 != 없음이면 { 모듈 = 문자열_복제(서버모듈). }
    문자열 층 = 문자열_복제(고른층).
    풀기().
    모듈 == 없음이면 { 날글넣기(b, "null"). }
    아니면 {
        정수 마지막 = -1.
        반복 (정수 k = 0: 모듈[k] != 0: k += 1) { (모듈[k] == 47 또는 모듈[k] == 92)이면 { 마지막 = k. } }
        문자열 mh = 파일해시(모듈, 없음, 없음).
        날글넣기(b, "\{").
        제쌍글(b, "file", 모듈 + 마지막 + 1). 날글넣기(b, ",").
        제쌍글(b, "layer", 층). 날글넣기(b, ",").
        mh == 없음이면 { 날글넣기(b, "\"sha256\":null"). } 아니면 { 제쌍글(b, "sha256", mh). }
        날글넣기(b, "\}").
    }
    날글넣기(b, "\}").
    기준 != 없음이면 { 잠그기(). 제놓기(기준). 풀기(). }
    반환 b.
}

[상태제이슨]는 -> 바이트열 참조 {
    바이트열 참조 b = 바이트열_만들기().
    (* 꼬리(파일 읽기)는 잠금 밖에서 *)
    잠그기().
    문자열 일기록 = 없음.
    지금일 != 없음이면 { 일기록 = 지금일→지금기록. }
    문자열 서기록 = 서버기록.
    정수 서단계 = 서버단계.
    풀기().
    문자열 일꼬리 = 문자열_복제("").
    일기록 != 없음이면 { 일꼬리 = 파일꼬리(일기록, 2500). }
    문자열 서꼬리 = 문자열_복제("").
    (서기록 != 없음 그리고 (서단계 == 1 또는 서단계 == 3))이면 { 서꼬리 = 파일꼬리(서기록, 2500). }
    잠그기().
    날글넣기(b, "\{\"app\":\{").
    제쌍글(b, "name", "GeulPU"). 날글넣기(b, ",").
    제쌍글(b, "version", 앱판). 날글넣기(b, ",").
    제쌍글(b, "commit", 앱커밋). 날글넣기(b, ",").
    제쌍글(b, "built", 앱빌드때). 날글넣기(b, ",").
    제쌍글(b, "data_dir", 자료폴더). 날글넣기(b, ",").
    제쌍글(b, "models_dir", 모델폴더). 날글넣기(b, ",").
    제쌍글(b, "results_dir", 결과폴더). 날글넣기(b, ",").
    제쌍수(b, "port", 웹포트). 날글넣기(b, ",").
    제쌍수(b, "disk_free", 디스크여유(모델폴더)).
    날글넣기(b, "\},\"settings\":").
    바이트열 참조 sj = 설정제이슨().
    바이트열_붙이기(b, 바이트열_자료(sj), 바이트열_길이(sj)).
    바이트열_해제(sj).
    날글넣기(b, ",\"device\":\{").
    제쌍참(b, "checked", 장치확인됨). 날글넣기(b, ",").
    제쌍글(b, "layer", 고른층). 날글넣기(b, ",").
    제쌍글(b, "name", 장치이름). 날글넣기(b, ",").
    제쌍수(b, "memory", 장치메모리). 날글넣기(b, ",").
    제쌍글(b, "variant", 모듈판). 날글넣기(b, ",").
    제쌍글(b, "coop", 협력모양). 날글넣기(b, ",").
    제쌍글(b, "vendor", 장치회사). 날글넣기(b, ",").
    제쌍글(b, "driver", 장치드라이버). 날글넣기(b, ",").
    제쌍참(b, "cuda_ok", 쿠다됨). 날글넣기(b, ",").
    제쌍참(b, "vulkan_ok", 벌칸됨). 날글넣기(b, ",").
    제쌍글(b, "reason", 장치까닭).
    날글넣기(b, "\},\"server\":\{").
    제쌍글(b, "state", 서버단계글(서버단계)). 날글넣기(b, ",").
    제쌍글(b, "model", 서버모델). 날글넣기(b, ",").
    제쌍글(b, "layer", 서버층). 날글넣기(b, ",").
    제쌍글(b, "template", 서버틀). 날글넣기(b, ",").
    제쌍수(b, "slots", 서버슬롯). 날글넣기(b, ",").
    제쌍수(b, "context", 서버문맥). 날글넣기(b, ",").
    실수 서초 = 0.0.
    서버단계 == 1이면 { 서초 = (정밀시각_밀리초() - 서버때) / 1000.0. }
    서버단계 == 2이면 { 서초 = (서버준비때 - 서버때) / 1000.0. }
    제쌍실수(b, "seconds", 서초, 1). 날글넣기(b, ",").
    제쌍글(b, "reason", 서버까닭). 날글넣기(b, ",").
    제쌍글(b, "log_tail", 서꼬리).
    날글넣기(b, "\},\"job\":").
    일제이슨(지금일, b).
    날글넣기(b, ",").
    제쌍글(b, "job_tail", 일꼬리).
    날글넣기(b, ",\"models\":[").
    반복 (정수 k는 0부터 정수목록_길이(모델들) 전까지) {
        k > 0이면 { 날글넣기(b, ","). }
        모델제이슨(모델칸(k), b).
    }
    날글넣기(b, "],\"catalog\":").
    목록제이슨(b).
    날글넣기(b, "\}").
    풀기().
    해제(일꼬리).
    해제(서꼬리).
    반환 b.
}

(* ===== 결과 목록 ===== *)

[문자열 이름을 결과종류]는 -> 문자열 {
    정수 k = 0.
    (이름[k] != 0 그리고 이름[k] != 45)동안 { k += 1. }
    반환 문자열_자르기(이름, 0, k).
}

(* 이름 끝의 시각 도장(YYYYMMDD-HHMMSS) *)
[문자열 이름을 결과도장]는 -> 문자열 {
    정수 n = 글자수(이름).
    n < 15이면 { 반환 문자열_복제(이름). }
    반환 문자열_복제(이름 + n - 15).
}

[결과목록제이슨]는 -> 바이트열 참조 {
    바이트열 참조 b = 바이트열_만들기().
    정수목록 참조 칸들 = 폴더보기(문자열_자르기(결과폴더, 0, 글자수(결과폴더) - 1)).
    (* 도장의 거꾸로 차례 — 고르기 정렬 *)
    정수목록 참조 폴더들 = 정수목록_만들기().
    칸들 != 없음이면 {
        반복 (정수 k는 0부터 정수목록_길이(칸들) 전까지) {
            폴더칸 참조 c = 정수목록_값(칸들, k) 으로 폴더칸 참조.
            c→폴더이면 { 정수목록_추가(폴더들, c 으로 정수). }
        }
    }
    정수 n = 정수목록_길이(폴더들).
    정수 참조 a = 초기할당(n + 1 을, 8).
    반복 (정수 i는 0부터 n 전까지) { a[i] = 정수목록_값(폴더들, i). }
    반복 (정수 i2는 0부터 n 전까지) {
        반복 (정수 i3 = i2 + 1: i3 < n: i3 += 1) {
            폴더칸 참조 x = a[i2] 으로 폴더칸 참조.
            폴더칸 참조 y = a[i3] 으로 폴더칸 참조.
            문자열_비교(결과도장(y→이름), 결과도장(x→이름)) > 0이면 {
                정수 t = a[i2].
                a[i2] = a[i3].
                a[i3] = t.
            }
        }
    }
    날글넣기(b, "\{\"results\":[").
    반복 (정수 k2는 0부터 n 전까지) {
        폴더칸 참조 c2 = a[k2] 으로 폴더칸 참조.
        k2 > 0이면 { 날글넣기(b, ","). }
        문자열 폴더 = 잇기(결과폴더, c2→이름).
        문자열 첫줄 = 파일꼬리(잇기(폴더, "\\결과.txt"), 4000).
        날글넣기(b, "\{").
        제쌍글(b, "name", c2→이름). 날글넣기(b, ",").
        제쌍글(b, "kind", 결과종류(c2→이름)). 날글넣기(b, ",").
        제쌍글(b, "stamp", 결과도장(c2→이름)). 날글넣기(b, ",").
        제쌍글(b, "headline", 첫줄). 날글넣기(b, ",").
        (* 잰 모델(environment.json 의 model — 화면의 결과 목록에 보인다) *)
        문자열 잰모델 = "".
        제이슨 참조 환경 = 제파일읽기(잇기(폴더, "\\environment.json")).
        환경 != 없음이면 {
            잰모델 = 제글값(환경, "model", "").
            잠그기(). 제놓기(환경). 풀기().
        }
        제쌍글(b, "model", 잰모델). 날글넣기(b, ",").
        제쌍참(b, "has_summary", 파일있음(잇기(폴더, "\\summary.json"))). 날글넣기(b, ",").
        제쌍참(b, "has_diag", 파일있음(잇기(폴더, "\\diag.json"))). 날글넣기(b, ",").
        제쌍참(b, "has_speed", 파일있음(잇기(폴더, "\\speed.json"))).
        날글넣기(b, "\}").
    }
    날글넣기(b, "]\}").
    해제(a).
    반환 b.
}

(* 결과 이름이 결과 폴더 안의 폴더인가(.. · \ · / 없음) *)
[문자열 이름을 결과이름맞나]는 -> 참거짓 {
    이름 == 없음이면 { 반환 거짓. }
    글자수(이름) == 0이면 { 반환 거짓. }
    반복 (정수 k = 0: 이름[k] != 0: k += 1) {
        (이름[k] == 92 또는 이름[k] == 47 또는 이름[k] == 58)이면 { 반환 거짓. }
    }
    문자열_찾기(이름 에서, "..") != 없음이면 { 반환 거짓. }
    반환 디렉터리인가(잇기(결과폴더, 이름)).
}

[문자열 이름을 결과묶기]는 -> 문자열 {
    문자열 폴더 = 잇기(결과폴더, 이름).
    문자열 zip = 잇기3(결과폴더, 이름, ".zip").
    문자열목록 참조 지울 = 문자열목록_만들기().
    문자열목록 참조 바꿀 = 문자열목록_만들기().
    문자열 자료없이 = 문자열_자르기(자료폴더, 0, 글자수(자료폴더) - 1).
    문자열 앱없이 = 문자열_자르기(앱폴더, 0, 글자수(앱폴더) - 1).
    문자열목록_추가(지울, 자료없이). 문자열목록_추가(바꿀, "<data>").
    문자열목록_추가(지울, 앱없이). 문자열목록_추가(바꿀, "<app>").
    문자열 집 = 환경변수("USERPROFILE").
    집 != 없음이면 { 문자열목록_추가(지울, 집). 문자열목록_추가(바꿀, "<home>"). }
    아닌 폴더묶기(폴더, zip, 지울, 바꿀)이면 { 반환 없음. }
    반환 zip.
}

(* ===== 파일 고르기(화면) ===== *)

[문자열 경로를 폴더제이슨]는 -> 바이트열 참조 {
    바이트열 참조 b = 바이트열_만들기().
    (경로 == 없음 또는 글자수(경로) == 0)이면 {
        날글넣기(b, "\{\"path\":\"\",\"parent\":null,\"entries\":[").
        문자열목록 참조 드 = 드라이브들().
        반복 (정수 k는 0부터 문자열목록_길이(드) 전까지) {
            k > 0이면 { 날글넣기(b, ","). }
            날글넣기(b, "\{").
            제쌍글(b, "name", 잇기(문자열목록_값(드, k), ":\\")). 날글넣기(b, ",").
            제쌍글(b, "path", 잇기(문자열목록_값(드, k), ":\\")). 날글넣기(b, ",").
            제쌍참(b, "dir", 참).
            날글넣기(b, "\}").
        }
        문자열 집 = 환경변수("USERPROFILE").
        집 != 없음이면 {
            문자열목록 참조 곳들 = 문자열목록_만들기().
            문자열목록 참조 이름들 = 문자열목록_만들기().
            문자열목록_추가(곳들, 집). 문자열목록_추가(이름들, "내 폴더").
            문자열목록_추가(곳들, 잇기(집, "\\Downloads")). 문자열목록_추가(이름들, "다운로드").
            문자열목록_추가(곳들, 잇기(집, "\\Desktop")). 문자열목록_추가(이름들, "바탕 화면").
            문자열목록_추가(곳들, 잇기(집, "\\.lmstudio\\models")). 문자열목록_추가(이름들, "LM Studio 모델").
            문자열목록_추가(곳들, 문자열_자르기(모델폴더, 0, 글자수(모델폴더) - 1)). 문자열목록_추가(이름들, "GeulPU 모델 폴더").
            반복 (정수 k2는 0부터 문자열목록_길이(곳들) 전까지) {
                문자열 p = 문자열목록_값(곳들, k2).
                디렉터리인가(p)이면 {
                    날글넣기(b, ",\{").
                    제쌍글(b, "name", 문자열목록_값(이름들, k2)). 날글넣기(b, ",").
                    제쌍글(b, "path", p). 날글넣기(b, ",").
                    제쌍참(b, "dir", 참).
                    날글넣기(b, "\}").
                }
            }
        }
        날글넣기(b, "]\}").
        반환 b.
    }
    문자열 p2 = 경로.
    정수 n = 글자수(p2).
    (n > 3 그리고 (p2[n - 1] == 92 또는 p2[n - 1] == 47))이면 { p2 = 문자열_자르기(p2, 0, n - 1). }
    (* 위 폴더 *)
    문자열 위 = "".
    정수 마지막 = -1.
    반복 (정수 k3 = 0: p2[k3] != 0: k3 += 1) {
        (p2[k3] == 92 또는 p2[k3] == 47)이면 { 마지막 = k3. }
    }
    마지막 > 2이면 { 위 = 문자열_자르기(p2, 0, 마지막). }
    아니면 (마지막 == 2 그리고 글자수(p2) > 3)이면 { 위 = 문자열_자르기(p2, 0, 3). }
    문자열 목록경로 = p2.
    글자수(p2) == 2이면 { 목록경로 = 잇기(p2, "\\"). }
    문자열 목록몸 = 목록경로.
    문자열_끝나는가(목록경로, "\\" 로)이면 { 목록몸 = 문자열_자르기(목록경로, 0, 글자수(목록경로) - 1). }
    정수목록 참조 칸들 = 폴더보기(목록몸).
    날글넣기(b, "\{").
    제쌍글(b, "path", 목록경로). 날글넣기(b, ",").
    제쌍글(b, "parent", 위). 날글넣기(b, ",\"entries\":[").
    정수 개수 = 0.
    칸들 != 없음이면 {
        반복 (정수 k4는 0부터 정수목록_길이(칸들) 전까지) {
            폴더칸 참조 c = 정수목록_값(칸들, k4) 으로 폴더칸 참조.
            (c→폴더 또는 문자열_끝나는가(c→이름, ".gguf" 로) 또는 문자열_끝나는가(c→이름, ".GGUF" 로))이면 {
                개수 > 0이면 { 날글넣기(b, ","). }
                날글넣기(b, "\{").
                제쌍글(b, "name", c→이름). 날글넣기(b, ",").
                문자열 전경로 = 잇기3(목록몸, "\\", c→이름).
                제쌍글(b, "path", 전경로). 날글넣기(b, ",").
                제쌍참(b, "dir", c→폴더). 날글넣기(b, ",").
                제쌍수(b, "size", c→바이트).
                날글넣기(b, "\}").
                개수 += 1.
            }
        }
    }
    날글넣기(b, "]\}").
    반환 b.
}

(* ===== 나눠주기 ===== *)

[이음 참조 c에 문자열 글을 바이트열 참조 b에 일시작답]는 {
    b != 없음이면 { 바이트열_해제(b). }
    웹오류(c, 409, 글).
}

(* 일을 띄운다 — 다른 일이 돌면 409 *)
[이음 참조 c에 일 참조 j를 공허 참조 함수를 일답]는 {
    일띄우기(j, 함수).
    바이트열 참조 b = 바이트열_만들기().
    날글넣기(b, "\{\"ok\":true,\"job\":").
    제수쓰기(b, j→번호).
    날글넣기(b, "\}").
    웹제이슨(c, 200, b).
    바이트열_해제(b).
}

[정수 번호를 요청 참조 q를 관리나눠주기]는 {
    이음 참조 c = 이음칸(번호).
    (* 지킴: Host 는 이 주소, 쓰기 요청의 Origin 은 이 화면 *)
    아닌 주소맞나(q→호스트, "", 웹포트)이면 {
        c→이어씀 = 거짓.
        웹오류(c, 403, "Host 헤더가 127.0.0.1이 아닙니다").
        반환.
    }
    참거짓 가져옴 = 문자열_같은가(q→방법, "GET") 또는 문자열_같은가(q→방법, "HEAD").
    참거짓 보냄 = 문자열_같은가(q→방법, "POST").
    (q→출처 != 없음 그리고 아닌 주소맞나(q→출처, "http://", 웹포트))이면 {
        웹오류(c, 403, "다른 출처에서 온 요청은 받지 않습니다").
        반환.
    }
    (아닌 가져옴 그리고 아닌 보냄)이면 {
        웹오류(c, 405, "GET · POST 요청만 받습니다").
        반환.
    }
    문자열 길 = q→길.
    (* /v1 — 추론 서버로. 38단계 — 토큰화 셋(/tokenize · /detokenize · /tokenizer_info — lm-evaluation-harness 의 원격 토크나이저)도 *)
    (문자열_시작하는가(길, "/v1/" 로) 또는 문자열_같은가(길, "/tokenize") 또는 문자열_같은가(길, "/detokenize") 또는 문자열_같은가(길, "/tokenizer_info"))이면 {
        잠그기().
        정수 단계 = 서버단계.
        정수 포트 = 서버포트.
        풀기().
        단계 != 2이면 {
            웹오류(c, 503, "불러온 모델이 없습니다 — 앱 화면에서 모델을 먼저 불러오세요").
            반환.
        }
        웹넘기기(번호, 포트, q).
        반환.
    }
    (* 화면 파일 *)
    가져옴이면 {
        문자열 화면 = 없음.
        (문자열_같은가(길, "/") 또는 문자열_같은가(길, "/index.html"))이면 { 화면 = "index.html". }
        아니면 문자열_같은가(길, "/app.js")이면 { 화면 = "app.js". }
        아니면 문자열_같은가(길, "/app.css")이면 { 화면 = "app.css". }
        아니면 문자열_같은가(길, "/favicon.svg")이면 { 화면 = "favicon.svg". }
        화면 != 없음이면 {
            웹파일(c, 잇기3(앱폴더, "web\\", 화면), 없음).
            반환.
        }
        문자열_같은가(길, "/favicon.ico")이면 {
            웹응답(c, 204, 없음, 없음, 0, 없음).
            반환.
        }
        문자열_같은가(길, "/api/ping")이면 {
            바이트열 참조 bp = 바이트열_만들기().
            날글넣기(bp, "\{\"app\":\"geulpu\",").
            제쌍글(bp, "version", 앱판).
            날글넣기(bp, "\}").
            웹제이슨(c, 200, bp).
            바이트열_해제(bp).
            반환.
        }
        문자열_같은가(길, "/api/state")이면 {
            바이트열 참조 b = 상태제이슨().
            웹제이슨(c, 200, b).
            바이트열_해제(b).
            반환.
        }
        문자열_같은가(길, "/api/provenance")이면 {                 (* 38단계 — 연구자 패널의 출처 *)
            바이트열 참조 bp2 = 출처제이슨().
            웹제이슨(c, 200, bp2).
            바이트열_해제(bp2).
            반환.
        }
        문자열_같은가(길, "/api/job/log")이면 {
            정수 부터 = 0.
            문자열 f = 물음값(q→물음, "from").
            f != 없음이면 { 부터 = 정수로_변환(f). }
            바이트열 참조 b2 = 바이트열_만들기().
            잠그기().
            지금일 == 없음이면 { 날글넣기(b2, "\{\"id\":0,\"text\":\"\",\"size\":0\}"). }
            아니면 {
                정수 길이 = 바이트열_길이(지금일→기록).
                (부터 < 0 또는 부터 > 길이)이면 { 부터 = 0. }
                날글넣기(b2, "\{").
                제쌍수(b2, "id", 지금일→번호). 날글넣기(b2, ",\"text\":").
                제글쓰기(b2, 바이트열_자료(지금일→기록) + 부터, 길이 - 부터).
                날글넣기(b2, ",").
                제쌍수(b2, "size", 길이).
                날글넣기(b2, "\}").
            }
            풀기().
            웹제이슨(c, 200, b2).
            바이트열_해제(b2).
            반환.
        }
        문자열_같은가(길, "/api/device")이면 {
            바이트열 참조 b3 = 바이트열_만들기().
            잠그기().
            날글넣기(b3, "\{\"vulkan\":").
            장치벌칸글 != 없음이면 { 날글넣기(b3, 장치벌칸글). } 아니면 { 날글넣기(b3, "null"). }
            날글넣기(b3, ",\"cuda\":").
            장치쿠다글 != 없음이면 { 날글넣기(b3, 장치쿠다글). } 아니면 { 날글넣기(b3, "null"). }
            날글넣기(b3, "\}").
            풀기().
            웹제이슨(c, 200, b3).
            바이트열_해제(b3).
            반환.
        }
        문자열_같은가(길, "/api/fs")이면 {
            문자열 p = 물음값(q→물음, "path").
            바이트열 참조 b4 = 폴더제이슨(p).
            웹제이슨(c, 200, b4).
            바이트열_해제(b4).
            반환.
        }
        문자열_같은가(길, "/api/results")이면 {
            바이트열 참조 b5 = 결과목록제이슨().
            웹제이슨(c, 200, b5).
            바이트열_해제(b5).
            반환.
        }
        문자열_같은가(길, "/api/results/file")이면 {
            문자열 이름 = 물음값(q→물음, "name").
            문자열 파일 = 물음값(q→물음, "file").
            참거짓 됨 = 결과이름맞나(이름) 그리고 파일 != 없음.
            됨이면 {
                (* 결과 폴더 맨 위의 알려진 파일만 *)
                됨 = 문자열_같은가(파일, "결과.txt") 또는 문자열_같은가(파일, "summary.json") 또는 문자열_같은가(파일, "diag.json") 또는
                     문자열_같은가(파일, "speed.json") 또는 문자열_같은가(파일, "environment.json").
            }
            아닌 됨이면 {
                웹오류(c, 404, "결과 파일이 없습니다").
                반환.
            }
            웹파일(c, 잇기3(잇기(결과폴더, 이름), "\\", 파일), 없음).
            반환.
        }
        문자열_같은가(길, "/api/results/zip")이면 {
            문자열 이름2 = 물음값(q→물음, "name").
            아닌 결과이름맞나(이름2)이면 {
                웹오류(c, 404, "결과가 없습니다").
                반환.
            }
            문자열 zip = 결과묶기(이름2).
            zip == 없음이면 {
                웹오류(c, 500, "zip 파일을 만들지 못했습니다").
                반환.
            }
            웹파일(c, zip, 잇기(이름2, ".zip")).
            반환.
