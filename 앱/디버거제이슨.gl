(* 디버거 1판 — 기록기의 JSON 문법 훑기(앱/디버거.gl 이 포함한다 · 엔진/시험_디버거제이슨.gl 이 GPU 없이 시험한다 — 시험/디버거제이슨.py).
   기록 줄에 그대로 넣어도 되는가만 본다 — 나무를 짓지 않고 한 번만 훑는다. 엔진의 제이슨풀기는 나무를 짓고(수 1.5 만 개면 수 ms) 풀기
   상태가 전역이라 잠금이 든다. 여기는 상태가 없다. 문법(RFC 8259) · UTF-8(파이썬의 엄격한 풀기와 같은 범위) · 깊이 128 까지.
   s[k] 는 늘 k < n 일 때만 읽는다(사례를 이어 붙인 시험 파일에서 다음 사례를 읽지 않는다) *)

[정수 c를 디버거빈칸인가]는 -> 참거짓 { 반환 c == 32 또는 c == 9 또는 c == 10 또는 c == 13. }

[문자열 s를 정수 k를 정수 n을 디버거빈칸넘기]는 -> 정수 {
    (k < n 그리고 디버거빈칸인가(s[k] & 255))동안 { k += 1. }
    반환 k.
}

[정수 c를 디버거잇는바이트인가]는 -> 참거짓 { 반환 c >= 128 그리고 c <= 191. }

(* 글(따옴표부터) — 끝 따옴표 다음 자리, 틀리면 −1 *)
[문자열 s를 정수 k를 정수 n을 디버거글넘기]는 -> 정수 {
    k += 1.
    (k < n)동안 {
        정수 c = s[k] & 255.
        c == 34이면 { 반환 k + 1. }
        c < 32이면 { 반환 -1. }
        c == 92이면 {
            k + 1 >= n이면 { 반환 -1. }
            정수 e = s[k + 1] & 255.
            e == 117이면 {
                k + 6 > n이면 { 반환 -1. }
                반복 (정수 j는 2부터 6 전까지) {
                    정수 h = s[k + j] & 255.
                    아닌 ((h >= 48 그리고 h <= 57) 또는 (h >= 65 그리고 h <= 70) 또는 (h >= 97 그리고 h <= 102))이면 { 반환 -1. }
                }
                k += 6.
            }
            아니면 (e == 34 또는 e == 92 또는 e == 47 또는 e == 98 또는 e == 102 또는 e == 110 또는 e == 114 또는 e == 116)이면 { k += 2. }
            아니면 { 반환 -1. }
        }
        아니면 c < 128이면 { k += 1. }
        아니면 {                                    (* UTF-8 — 넘는 꼴 · 대리 · U+10FFFF 너머는 틀림 *)
            정수 m = 0.
            정수 lo = 128.
            정수 hi = 191.
            (c >= 194 그리고 c <= 223)이면 { m = 1. }
            아니면 c == 224이면 { m = 2. lo = 160. }
            아니면 c == 237이면 { m = 2. hi = 159. }
            아니면 (c >= 225 그리고 c <= 239)이면 { m = 2. }
            아니면 c == 240이면 { m = 3. lo = 144. }
            아니면 c == 244이면 { m = 3. hi = 143. }
            아니면 (c >= 241 그리고 c <= 243)이면 { m = 3. }
            아니면 { 반환 -1. }
            k + m >= n이면 { 반환 -1. }
            정수 c1 = s[k + 1] & 255.
            (c1 < lo 또는 c1 > hi)이면 { 반환 -1. }
            반복 (정수 j2는 2부터 m + 1 전까지) {
                아닌 디버거잇는바이트인가(s[k + j2] & 255)이면 { 반환 -1. }
            }
            k += m + 1.
        }
    }
    반환 -1.
}

[문자열 s를 정수 k를 정수 n을 디버거숫자넘기]는 -> 정수 {
    (k < n 그리고 (s[k] & 255) >= 48 그리고 (s[k] & 255) <= 57)동안 { k += 1. }
    반환 k.
}

(* 수 — 다음 자리, 틀리면 −1 *)
[문자열 s를 정수 k를 정수 n을 디버거수넘기]는 -> 정수 {
    (k < n 그리고 (s[k] & 255) == 45)이면 { k += 1. }
    k >= n이면 { 반환 -1. }
    정수 c = s[k] & 255.
    c == 48이면 { k += 1. }
    아니면 (c >= 49 그리고 c <= 57)이면 { k = 디버거숫자넘기(s, k + 1, n). }
    아니면 { 반환 -1. }
    (k < n 그리고 (s[k] & 255) == 46)이면 {
        정수 f = 디버거숫자넘기(s, k + 1, n).
        f == k + 1이면 { 반환 -1. }
        k = f.
    }
    (k < n 그리고 ((s[k] & 255) == 101 또는 (s[k] & 255) == 69))이면 {
        k += 1.
        (k < n 그리고 ((s[k] & 255) == 43 또는 (s[k] & 255) == 45))이면 { k += 1. }
        정수 e2 = 디버거숫자넘기(s, k, n).
        e2 == k이면 { 반환 -1. }
        k = e2.
    }
    반환 k.
}

[문자열 s를 정수 k를 정수 n을 문자열 말을 디버거말맞나]는 -> 참거짓 {
    정수 m = 글자수(말).
    k + m > n이면 { 반환 거짓. }
    반환 메모리_비교(s + k, 말, m) == 0.
}

(* 값 하나(앞 빈칸 포함) — 다음 자리, 틀리면 −1 *)
[문자열 s를 정수 k를 정수 n을 정수 깊이를 디버거값넘기]는 -> 정수 {
    k = 디버거빈칸넘기(s, k, n).
    k >= n이면 { 반환 -1. }
    정수 c = s[k] & 255.
    c == 34이면 { 반환 디버거글넘기(s, k, n). }
    (c == 123 또는 c == 91)이면 {
        깊이 >= 128이면 { 반환 -1. }
        정수 닫음 = 93.
        c == 123이면 { 닫음 = 125. }
        k = 디버거빈칸넘기(s, k + 1, n).
        (k < n 그리고 (s[k] & 255) == 닫음)이면 { 반환 k + 1. }
        (참)동안 {
            c == 123이면 {
                (k >= n 또는 (s[k] & 255) != 34)이면 { 반환 -1. }
                k = 디버거글넘기(s, k, n).
                k < 0이면 { 반환 -1. }
                k = 디버거빈칸넘기(s, k, n).
                (k >= n 또는 (s[k] & 255) != 58)이면 { 반환 -1. }
                k += 1.
            }
            k = 디버거값넘기(s, k, n, 깊이 + 1).
            k < 0이면 { 반환 -1. }
            k = 디버거빈칸넘기(s, k, n).
            k >= n이면 { 반환 -1. }
            정수 d = s[k] & 255.
            k += 1.
            d == 닫음이면 { 반환 k. }
            d != 44이면 { 반환 -1. }
            k = 디버거빈칸넘기(s, k, n).
        }
    }
    (c == 45 또는 (c >= 48 그리고 c <= 57))이면 { 반환 디버거수넘기(s, k, n). }
    디버거말맞나(s, k, n, "true")이면 { 반환 k + 4. }
    디버거말맞나(s, k, n, "false")이면 { 반환 k + 5. }
    디버거말맞나(s, k, n, "null")이면 { 반환 k + 4. }
    반환 -1.
}

(* s[a … b) 가 JSON 값 하나(앞뒤 빈칸 허용)인가 *)
[문자열 s를 정수 a를 정수 b를 디버거제이슨인가]는 -> 참거짓 {
    b <= a이면 { 반환 거짓. }
    정수 k = 디버거값넘기(s, a, b, 0).
    k < 0이면 { 반환 거짓. }
    반환 디버거빈칸넘기(s, k, b) == b.
}
