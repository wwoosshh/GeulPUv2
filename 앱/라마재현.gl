        }
        칸수 = 제개수(확) - 못맞춘.
    }
    정수 값수 = 0.
    정수 다름 = 0.
    정수 토큰다름 = 0.
    정수 첫갈림 = -1.
    바이트열 참조 다른것 = 바이트열_만들기().
    정수 다른것수 = 0.
    라마걸음값 참조 w = 초기할당(1 을, 크기(라마걸음값)).          (* 디버거의 실행 로그(4-4)에 적을 걸음마다의 값 *)
    w→걸음수 = ng.
    w→위수 = 위수.
    w→고른 = 할당(ng * 8 + 8).
    w→위번호 = 할당(ng * 위수 * 8 + 8).
    w→위비트 = 할당(ng * 위수 * 8 + 8).
    w→엔트로피 = 할당(ng * 8 + 8).
    w→다른걸음 = 정수목록_만들기().
    w→답바이트 = 답바이트.
    w→조각끝 = 조각끝.
    w→칸 = 칸.
    w→어휘 = 어.
    반복 (정수 k5는 0부터 ng 전까지) {
        정수 o = k5 * 폭.
        정수 서버토큰 = 정수목록_값(생토, k5).
        정수 사슬토큰 = 확값[o + 3 + 2 * 위수].                (* 서버의 고르기 사슬이 고른 토큰(온도 0 이면 정렬 차례에서 처음 만난 가장 큰 logit) *)
        (끝만빠짐 그리고 k5 == ng - 1)이면 {
            (* 22단계 — 서버가 보내지 않은 끝 토큰: 사슬이 고른 토큰. 서버는 여기서 멈췄으므로(stop_type eos) 제어 토큰이어야 한다 *)
            서버토큰 = 사슬토큰.
            정수 끝형 = GGUF배열수(어→머리, "tokenizer.ggml.token_type", 사슬토큰, 1).
            끝형 != 3이면 {
                토큰다름 += 1.
                다른것수 < 40이면 {
                    다른것수 > 0이면 { 날글넣기(다른것, ","). }
                    날글넣기(다른것, 짓기("\{\"step\":%lld,\"what\":\"eos\",\"replay\":%lld,\"token_type\":%lld\}", k5, 사슬토큰, 끝형)).
                    다른것수 += 1.
                }
            }
            일적기(j, 짓기("채팅 스트리밍의 끝 토큰은 서버가 보내지 않습니다 — 마지막 걸음은 재현의 고르기 사슬(같은 시드)이 고른 토큰 %lld(토큰 형 %lld)로 셈했습니다", 사슬토큰, 끝형)).
        }
        정수 고른비트 = 확값[o + 1].                           (* 서버의 셈 그대로(partial_sort 의 앞 개수 = 요청의 n_probs) *)
        w→엔트로피[k5] = ((확값 + (o + 2 + 2 * 위수)) 으로 실수 참조)[0].   (* 서버는 내지 않는 값 — 다시 계산한 로짓의 분포(온도 1) *)
        w→고른[k5] = 고른비트.
        반복 (정수 t1는 0부터 위수 전까지) {
            w→위번호[k5 * 위수 + t1] = 확값[o + 2 + 2 * t1].
            w→위비트[k5 * 위수 + t1] = 확값[o + 3 + 2 * t1].
        }
        정수 이번 = 0.
        사슬토큰 != 서버토큰이면 {
            토큰다름 += 1.
            이번 += 1.
            다른것수 < 40이면 {
                다른것수 > 0이면 { 날글넣기(다른것, ","). }
                날글넣기(다른것, 짓기("\{\"step\":%lld,\"what\":\"token\",\"server\":%lld,\"replay\":%lld\}", k5, 서버토큰, 사슬토큰)).
                다른것수 += 1.
            }
        }
        값수 += 1.
        (n_probs > 0 그리고 칸[k5] >= 0)이면 {
            제이슨 참조 걸 = 제자식(확, 칸[k5]).
            정수 서버비트 = 라마실수비트(제찾기(걸, "logprob")).
            값수 += 1.
            (라마정수(제찾기(걸, "id")) != 서버토큰 또는 고른비트 != 서버비트)이면 {
                다름 += 1.
                이번 += 1.
                다른것수 < 40이면 {
                    다른것수 > 0이면 { 날글넣기(다른것, ","). }
                    날글넣기(다른것, 짓기("\{\"step\":%lld,\"what\":\"logprob\",\"server\":%lld,\"replay\":%lld\}", k5, 서버비트, 고른비트)).
                    다른것수 += 1.
                }
            }
            제이슨 참조 위들 = 제찾기(걸, "top_logprobs").
            정수 위개수 = 제개수(위들).
            위개수 > n_probs이면 { 위개수 = n_probs. }
            위개수 < n_probs이면 {                                   (* 서버의 상위 목록이 짧다 — 모자란 만큼 다름 *)
                다름 += n_probs - 위개수.
                값수 += 2 * (n_probs - 위개수).
                이번 += 1.
            }
            반복 (정수 t는 0부터 위개수 전까지) {
                제이슨 참조 위 = 제자식(위들, t).
                정수 sid = 라마정수(제찾기(위, "id")).
                정수 sb = 라마실수비트(제찾기(위, "logprob")).
                정수 rid = 확값[o + 2 + 2 * t].
                정수 rb = 확값[o + 3 + 2 * t].
                값수 += 2.
                (sid != rid 또는 sb != rb)이면 {
                    다름 += 1.
                    이번 += 1.
                    다른것수 < 40이면 {
                        다른것수 > 0이면 { 날글넣기(다른것, ","). }
                        날글넣기(다른것, 짓기("\{\"step\":%lld,\"what\":\"top\",\"rank\":%lld,\"server_id\":%lld,\"replay_id\":%lld,\"server\":%lld,\"replay\":%lld\}",
                            k5, t, sid, rid, sb, rb)).
                        다른것수 += 1.
                    }
                }
            }
        }
        (이번 > 0 그리고 첫갈림 < 0)이면 { 첫갈림 = k5. }
        이번 > 0이면 { 정수목록_추가(w→다른걸음, k5). }
    }
    해제(확글).
    파일지우기(확률경로).
    못맞춘 > 0이면 {
        다름 += 못맞춘.
        값수 += 2 * 못맞춘.
        다른것수 < 40이면 {
            다른것수 > 0이면 { 날글넣기(다른것, ","). }
            날글넣기(다른것, 짓기("\{\"step\":-1,\"what\":\"entry\",\"unmatched\":%lld\}", 못맞춘)).
            다른것수 += 1.
        }
        첫갈림 < 0이면 { 첫갈림 = ng. }
    }
    해제(온전).
    정수 칸없음 = ng - 칸수.
    n_probs <= 0이면 { 칸없음 = 0. }
    칸없음 > 0이면 { 일적기(j, 짓기("서버가 로그 확률 칸을 적지 않은 걸음 %lld 개(글이 UTF-8 글자 가운데서 끝난 걸음 — 그 바이트는 다음 칸에) — 토큰만 견줍니다", 칸없음)). }
    (* 30단계 — 토큰 없는 영수증: 다시 만든 토큰의 조각을 이은 글이 응답의 글과 바이트까지 같아야 한다 *)
    정수 모름 = 제정수값(응, "tokens_unknown", 0).
    정수 글다름 = 0.
    정수 글갈림 = -1.
    모름 > 0이면 {
        문자열 답글 = 제글보기(응, "content", "").
        정수 m1 = 글자수(답글).
        정수 m2 = 바이트열_길이(답바이트).
        문자열 d2 = 바이트열_자료(답바이트).
        정수 i9 = 0.
        (i9 < m1 그리고 i9 < m2 그리고 (답글[i9] & 255) == (d2[i9] & 255)) 동안 { i9 += 1. }
        (i9 < m1 또는 i9 < m2)이면 {
            글다름 = 1.
            글갈림 = i9.
            정수 걸9 = 0.
            (걸9 < ng - 1 그리고 조각끝[걸9] <= i9) 동안 { 걸9 += 1. }
            (첫갈림 < 0 또는 걸9 < 첫갈림)이면 { 첫갈림 = 걸9. }
            다른것수 < 40이면 {
                다른것수 > 0이면 { 날글넣기(다른것, ","). }
                날글넣기(다른것, 짓기("\{\"step\":%lld,\"what\":\"text\",\"byte\":%lld\}", 걸9, i9)).
                다른것수 += 1.
            }
        }
    }
    (* 결과 *)
    참거짓 같음 = 다름 == 0 그리고 토큰다름 == 0 그리고 글다름 == 0.
    문자열 결과말 = 짓기("결과: 영수증과 비트까지 같습니다 — 걸음 %lld · 값 %lld(토큰과 상위 %lld 로그 확률) · %s · %s초",
        ng, 값수, n_probs, 층, 실수글(걸린초, 1)).
    아닌 같음이면 {
        결과말 = 짓기("결과: 영수증과 다릅니다 — 걸음 %lld 에서 처음 갈림 · 다른 값 %lld(토큰 %lld) / %lld · %s", 첫갈림, 다름 + 토큰다름, 토큰다름, 값수, 층).
    }
    모름 > 0이면 {
        (* 30단계 — 토큰 없는 영수증: 다시 만든 토큰의 글과 응답의 글 *)
        문자열 확말 = "로그 확률은 요청에 없어 견주지 않음".
        n_probs > 0이면 { 확말 = 짓기("상위 %lld 로그 확률까지", n_probs). }
        결과말 = 짓기("결과: 다시 만든 토큰의 글이 응답과 바이트까지 같습니다 — 걸음 %lld · 값 %lld(토큰 없는 영수증 — %s) · %s · %s초",
            ng, 값수, 확말, 층, 실수글(걸린초, 1)).
        글다름 > 0이면 { 결과말 = 짓기("결과: 다시 만든 토큰의 글이 응답과 다릅니다 — 걸음 %lld 에서 처음 갈림(글의 바이트 %lld) · %s", 첫갈림, 글갈림, 층). }
        아니면 아닌 같음이면 { 결과말 = 짓기("결과: 영수증과 다릅니다 — 걸음 %lld 에서 처음 갈림 · 다른 값 %lld / %lld · %s", 첫갈림, 다름 + 토큰다름, 값수, 층). }
    }
    (같음 그리고 모름 > 0)이면 {
        (* 30단계 — 다시 만든 생성 토큰을 적는다: 같은 서버의 뒤 영수증의 사슬이 쓴다 *)
        바이트열 참조 gb = 바이트열_만들기().
        날글넣기(gb, "[").
        반복 (정수 k9는 0부터 ng 전까지) { k9 > 0이면 { 날글넣기(gb, ","). } 제수쓰기(gb, 정수목록_값(생토, k9)). }
        날글넣기(gb, "]").
        바이트열_넣기(gb, 0).
        라마다시만듦쓰기(이름, 없음, 없음, 바이트열_자료(gb), 제글보기(제찾기(영, "engine"), "build_info", "")).
        바이트열_해제(gb).
        일적기(j, "다시 만든 생성 토큰을 적었습니다(다시만듦 파일) — 같은 서버의 뒤 영수증이 이 토큰으로 사슬을 짓습니다.").
    }
    (* 디버거의 실행 로그(4-4) — 머리의 replay 칸 *)
    바이트열 참조 재현 = 바이트열_만들기().
    날글넣기(재현, "\"replay\":\{").
    제쌍글(재현, "receipt", 이름). 날글넣기(재현, ",").
    제쌍글(재현, "layer", 층). 날글넣기(재현, ",").
    제쌍글(재현, "vulkan_device", 장치). 날글넣기(재현, ",").
    제쌍글(재현, "result", 폴더이름). 날글넣기(재현, ",").
    제쌍참(재현, "same", 같음). 날글넣기(재현, ",").
    제쌍수(재현, "steps", ng). 날글넣기(재현, ",").
    제쌍수(재현, "values", 값수). 날글넣기(재현, ",").
    제쌍수(재현, "mismatches", 다름 + 토큰다름). 날글넣기(재현, ",").
    제쌍수(재현, "first_divergence", 첫갈림). 날글넣기(재현, ",").
    제쌍수(재현, "steps_without_probs", 칸없음). 날글넣기(재현, ",").
    제쌍실수(재현, "seconds", 걸린초, 1).
    날글넣기(재현, "\}").
    문자열 실행 = 라마실행기록쓰기(영, 이름, 층, 재현, w).
    바이트열_해제(재현).
    해제(w→고른). 해제(w→위번호). 해제(w→위비트). 해제(w→엔트로피). 정수목록_해제(w→다른걸음).
    바이트열_해제(답바이트). 해제(조각끝). 해제(칸). 라마어휘닫기(어). 해제(w).
    실행 == 없음이면 { 일적기(j, "디버거의 실행 로그를 쓰지 못했습니다(영수증 이름이 길거나 자료 폴더에 쓸 수 없음)"). }
    아니면 { 일적기(j, 잇기("디버거의 실행 로그: ", 실행)). }
    바이트열 참조 s = 바이트열_만들기().
    날글넣기(s, "\{").
    제쌍글(s, "format", "geulpu-llama-verify/1"). 날글넣기(s, ",").
    제쌍글(s, "receipt", 이름). 날글넣기(s, ",").
    제쌍글(s, "checked_at", 시각글()). 날글넣기(s, ",").
    제쌍글(s, "app_version", 앱판). 날글넣기(s, ",").
    제쌍글(s, "layer", 층). 날글넣기(s, ",").
    제쌍글(s, "vulkan_device", 장치). 날글넣기(s, ",").
    제쌍글(s, "module_sha256", 모듈정보(모듈, "module_sha256")). 날글넣기(s, ",").
    제쌍글(s, "host_sha256", 파일해시(호스트, 없음, 없음)). 날글넣기(s, ",").
    제쌍수(s, "prompt_tokens", np). 날글넣기(s, ",").
    제쌍수(s, "steps", ng). 날글넣기(s, ",").
    제쌍수(s, "n_probs", n_probs). 날글넣기(s, ",\"sampling\":\{\"temperature\":").
    파이썬쓰기(s, 제찾기(고, "temperature"), 0, 0). 날글넣기(s, ",\"seed\":").
    파이썬쓰기(s, 제찾기(고, "seed"), 0, 0). 날글넣기(s, ",\"top_k\":").
    파이썬쓰기(s, 제찾기(고, "top_k"), 0, 0). 날글넣기(s, ",\"top_p\":").
    파이썬쓰기(s, 제찾기(고, "top_p"), 0, 0). 날글넣기(s, ",\"min_p\":").
    파이썬쓰기(s, 제찾기(고, "min_p"), 0, 0). 날글넣기(s, ",\"min_keep\":").
    파이썬쓰기(s, 제찾기(고, "min_keep"), 0, 0). 날글넣기(s, "\},").
    제쌍수(s, "values", 값수). 날글넣기(s, ",").
    제쌍수(s, "mismatches", 다름 + 토큰다름). 날글넣기(s, ",").
    제쌍수(s, "token_mismatches", 토큰다름). 날글넣기(s, ",").
    제쌍수(s, "first_divergence", 첫갈림). 날글넣기(s, ",").
    제쌍수(s, "steps_without_probs", 칸없음). 날글넣기(s, ",").
    제쌍수(s, "regenerated_tokens", 모름). 날글넣기(s, ",\"cache\":\{").          (* 30단계 — 토큰 없는 영수증에서 재현이 다시 만든 생성 토큰 수 *)
    제쌍수(s, "cache_n", 사→cache_n). 날글넣기(s, ",").
    제쌍수(s, "restored_checkpoint", 사→되살림). 날글넣기(s, ",").
    제쌍수(s, "earlier_receipts", 사→앞수). 날글넣기(s, ",").
    제쌍글(s, "earlier", 사→앞이름들). 날글넣기(s, ",").
    제쌍수(s, "ubatches", 정수목록_길이(ub)). 날글넣기(s, "\},").
    사→섞임 != 0이면 {                                        (* 29단계 — 서버 기록의 ubatch 묶음대로 셈함(연속 배치) *)
        날글넣기(s, "\"batch_log\":\{"). 제쌍글(s, "path", 사→섞임기록). 날글넣기(s, ",").
        제쌍수(s, "items", 사→섞임항목). 날글넣기(s, ",").
        제쌍수(s, "mixed_ubatches", 사→섞인수). 날글넣기(s, ",").
        제쌍수(s, "find_slot_compared", 사→섞임견준). 날글넣기(s, "\},").
    }
    제쌍참(s, "same", 같음). 날글넣기(s, ",").
    제쌍글(s, "run_log", 실행). 날글넣기(s, ",").
    제쌍실수(s, "seconds", 걸린초, 1). 날글넣기(s, ",\"differences\":[").
    바이트열_붙이기(s, 바이트열_자료(다른것), 바이트열_길이(다른것)).
    날글넣기(s, "]\}\n").
    바이트열파일쓰기(잇기(폴더, "summary.json"), s).
    바이트열_해제(s).
    바이트열_해제(다른것).
    글파일쓰기(잇기(폴더, "결과.txt"), 잇기(결과말, "\n")).
    파일지우기(고른경로).
    정수목록_해제(사→ub). 정수목록_해제(사→up). 정수목록_해제(사→ut). 해제(사→앞이름들).
    정수목록_해제(사→uc). 정수목록_해제(사→un). 정수목록_해제(사→sc). 정수목록_해제(사→sn). 해제(사). 정수목록_해제(생토).
    잠그기(). j→요약 = 결과말. 제놓기(영). 풀기().
    일적기(j, 결과말).
    일끝(j, 2, 없음).
    반환 0.
}

(* ===== 기록기 — 앱의 /llama/… 를 사용자의 llama-server(127.0.0.1 의 포트)로 넘기고, /llama/completion 의 요청 · 응답을 영수증으로 =====
   설정(자료\영수증\기록기.json): port · args(그 llama-server 를 띄운 명령줄 — n_batch · n_ubatch · flash attention · 슬롯 · 통합 KV ·
   체크포인트 · RAM 캐시를 읽는다). 요청에 n_probs · return_tokens 가 없으면 20 · true 를 더한다 — 실행 조건이 바뀐다(30단계에 바로잡음:
   n_probs 가 있으면 온도 0 에서도 고르기 사슬 끝이 dist 라 맨 위 logit 이 같은 걸음에서 토큰이 달라질 수 있다. 개입하지 않는 기록은
   토큰 없는 영수증 — 라마다시.gl). 프롬프트 캐시는 요청 · 서버 그대로 둔다(7단계 — 캐시를 쓴 요청은 같은 슬롯의 앞 영수증으로 검증). 응답이 끝나면
   (웹 고리 — 웹.gl) 스레드가 /props · /tokenize · /slots 로 빌드 · 모델 · 프롬프트 토큰 · 슬롯 상태를 묻고, 모델 파일의 SHA-256 과
   이 PC 의 CUDA 장치(이름 · compute capability · SM 수)를 적는다 *)
정수 라마포트 = 0.
문자열 라마명령줄 = "".
참거짓 라마설정읽음 = 거짓.
(* 31단계 — 투명한 기록기(기본): 요청 바이트 그대로 · 실행 중 질의 없음 · 토큰 없는 영수증(/2). 라마개입 참이면 지금까지의 기록기
   (확률 · 토큰 칸을 더하고 /slots · /props · /tokenize 를 묻는다 — /1). 설정을 저장할 때 실행 파일의 --version(따로 도는 프로세스)으로
   빌드를, 명령줄의 -m 으로 모델 경로를, 파일 메타로 크기를 적어 둔다 — 도는 서버와 닿지 않는다 *)
참거짓 라마개입 = 거짓.
문자열 라마실행 = 없음.
문자열 라마빌드 = 없음.
문자열 라마모델경로 = 없음.
정수 라마모델크기 = -1.
정수 라마기록번호 = 0.
문자열 라마해시경로 = 없음.          (* 모델 해시 캐시 — 경로 · 크기가 같으면 다시 셈하지 않는다 *)
정수 라마해시크기 = -1.
문자열 라마해시값 = 없음.

[라마설정경로]는 -> 문자열 { 반환 잇기(라마영수증폴더(), "기록기.json"). }

[라마설정읽기]는 {
    라마설정읽음이면 { 반환. }
    라마설정읽음 = 참.
    제이슨 참조 o = 제파일읽기(라마설정경로()).
    o == 없음이면 { 반환. }
    라마포트 = 제정수값(o, "port", 0).
    라마명령줄 = 제글값(o, "args", "").
    라마개입 = 문자열_같은가(제글보기(o, "mode", "transparent"), "probes").
    라마실행 = 제글값(o, "exe", "").
    라마빌드 = 제글값(o, "build", "").
    라마모델경로 = 제글값(o, "model", "").
    라마모델크기 = 제정수값(o, "model_size", -1).
    잠그기(). 제놓기(o). 풀기().
}

(* 31단계 — 실행 파일의 --version 에서 빌드(b<번호>-<커밋>) — 따로 도는 프로세스(10 초 안). 못 읽으면 "" *)
[문자열 실행을 라마판읽기]는 -> 문자열 {
    (실행 == 없음 또는 실행[0] == 0 또는 아닌 파일있음(실행))이면 { 반환 문자열_복제(""). }
    문자열목록 참조 인자 = 문자열목록_만들기().
    문자열목록_추가(인자, "--version").
    문자열 기록 = 잇기(기록폴더, "llama-version.log").
    자식 참조 c = 자식띄우기(실행, 인자, 자료폴더, 기록).
    c == 없음이면 { 해제(기록). 반환 문자열_복제(""). }
    아닌 자식기다리기(c, 10000)이면 { 자식끊기(c). }
    자식놓기(c).
    정수 n = 0.
    문자열 글 = 파일읽기(기록, &n).
    해제(기록).
    글 == 없음이면 { 반환 문자열_복제(""). }
    문자열 r = 문자열_복제("").
    정수 bi = 문자열_찾기_위치(글 에서, "build " 를).
    bi >= 0이면 {
        정수 k = bi + 6.
        정수 번호 = 0.
        정수 자릿수 = 0.
        (k < n 그리고 (글[k] & 255) >= 48 그리고 (글[k] & 255) <= 57) 동안 { 번호 = 번호 * 10 + ((글[k] & 255) - 48). k += 1. 자릿수 += 1. }
        정수 ci = 문자열_찾기_위치(글 에서, "commit " 를).
        (자릿수 > 0 그리고 ci >= 0)이면 {
            정수 k2 = ci + 7.
            정수 k3 = k2.
            (k3 < n 그리고 (((글[k3] & 255) >= 48 그리고 (글[k3] & 255) <= 57) 또는 ((글[k3] & 255) >= 97 그리고 (글[k3] & 255) <= 102))) 동안 { k3 += 1. }
            k3 > k2이면 {
                문자열 커밋 = 문자열_자르기(글, k2, k3 - k2).
                해제(r).
                r = 짓기("b%lld-%s", 번호, 커밋).
                해제(커밋).
            }
        }
    }
    해제(글).
    반환 r.
}

(* 31단계 — 설정에서 실행 파일 · 빌드 · 모델 경로 · 크기를 맞춘다(저장할 때). 찾지 못한 것은 경고로(JSON 배열 글) *)
[라마설정맞추기]는 -> 문자열 {
    문자열목록 참조 낱 = 문자열_나누기(라마명령줄, " " 로).
    (라마실행 == 없음 또는 라마실행[0] == 0)이면 {
        라마실행 != 없음이면 { 해제(라마실행). }
        라마실행 = 문자열_복제("").
        (문자열목록_길이(낱) > 0 그리고 파일있음(문자열목록_값(낱, 0)))이면 { 해제(라마실행). 라마실행 = 문자열_복제(문자열목록_값(낱, 0)). }
    }
    라마빌드 != 없음이면 { 해제(라마빌드). }
    라마빌드 = 라마판읽기(라마실행).
    라마모델경로 != 없음이면 { 해제(라마모델경로). }
    라마모델경로 = 문자열_복제(라마명령값("-m", "--model", "")).
    라마모델크기 = -1.
    라마모델경로[0] != 0이면 { 라마모델크기 = 파일바이트(라마모델경로). }
    바이트열 참조 w = 바이트열_만들기().
    날글넣기(w, "[").
    정수 몇 = 0.
    (라마실행[0] == 0 또는 아닌 파일있음(라마실행))이면 {
        제글넣기(w, "llama-server 의 실행 파일을 찾지 못했습니다 — 설정의 실행 파일(exe)에 적으세요. 검증할 때 같은 빌드의 llama-server 로 프롬프트 토큰을 다시 만듭니다"). 몇 += 1.
    } 아니면 라마빌드[0] == 0이면 {
        몇 > 0이면 { 날글넣기(w, ","). }
        제글넣기(w, "실행 파일의 --version 에서 빌드를 읽지 못했습니다 — 채팅 영수증은 응답의 system_fingerprint 로, 다른 영수증은 검증할 때 임시 서버에서 받습니다"). 몇 += 1.
    }
    (라마모델경로[0] == 0 또는 라마모델크기 < 0)이면 {
        몇 > 0이면 { 날글넣기(w, ","). }
        제글넣기(w, "명령줄의 -m 에서 모델 파일을 찾지 못했습니다 — 영수증에 모델 경로 · 크기가 없으면 검증하지 못합니다"). 몇 += 1.
    }
    라마개입이면 {
        몇 > 0이면 { 날글넣기(w, ","). }
        제글넣기(w, "개입하는 기록(probes): 요청에 확률 · 토큰 칸(n_probs · return_tokens — 채팅은 logprobs · verbose)을 더하고 실행 중에 /slots · /props · /tokenize 를 묻습니다. n_probs 가 있으면 온도 0 에서도 서버의 고르기 사슬 끝이 바뀝니다(맨 위 logit 이 같은 걸음)"). 몇 += 1.
    }
    날글넣기(w, "]").
    바이트열_넣기(w, 0).
    문자열 r = 문자열_복제(바이트열_자료(w)).
    바이트열_해제(w).
    반환 r.
}

[라마설정제이슨]는 -> 바이트열 참조 {
    바이트열 참조 b = 바이트열_만들기().
    날글넣기(b, "\{").
    제쌍수(b, "port", 라마포트). 날글넣기(b, ",").
    제쌍글(b, "args", 라마명령줄). 날글넣기(b, ",").
    제쌍글(b, "folder", 라마영수증폴더()). 날글넣기(b, ",").
    문자열 방식 = "transparent".
    라마개입이면 { 방식 = "probes". }
    제쌍글(b, "mode", 방식). 날글넣기(b, ",").
    제쌍글(b, "exe", 라마실행). 날글넣기(b, ",").
    제쌍글(b, "build", 라마빌드). 날글넣기(b, ",").
    제쌍글(b, "model", 라마모델경로). 날글넣기(b, ",").
    제쌍수(b, "model_size", 라마모델크기).
    날글넣기(b, "\}").
    반환 b.
}

(* 명령줄의 값 하나(이름 둘 가운데 하나 뒤의 낱말) — 없으면 기본값 *)
[문자열 짧은이름을 문자열 긴이름을 문자열 기본값을 라마명령값]는 -> 문자열 {
    문자열목록 참조 낱 = 문자열_나누기(라마명령줄, " " 로).
    문자열 값 = 기본값.
    반복 (정수 k는 0부터 문자열목록_길이(낱) 전까지) {
        문자열 a = 문자열목록_값(낱, k).
        ((문자열_같은가(a, 짧은이름) 또는 문자열_같은가(a, 긴이름)) 그리고 k + 1 < 문자열목록_길이(낱))이면 { 값 = 문자열목록_값(낱, k + 1). }
    }
    반환 값.
}

(* 십진 정수(음 아닌) — 아니면 −1 *)
[문자열 s를 라마십진]는 -> 정수 {
    (s == 없음 또는 s[0] == 0)이면 { 반환 -1. }
    정수 v = 0.
    반복 (정수 k = 0: s[k] != 0: k += 1) {
        정수 c = s[k] & 255.
        (c < 48 또는 c > 57)이면 { 반환 -1. }
        v = v * 10 + (c - 48).
    }
    반환 v.
}

[문자열 이름을 라마명령있나]는 -> 참거짓 {
    문자열목록 참조 낱 = 문자열_나누기(라마명령줄, " " 로).
    반복 (정수 k는 0부터 문자열목록_길이(낱) 전까지) { 문자열_같은가(문자열목록_값(낱, k), 이름)이면 { 반환 참. } }
    반환 거짓.
}

(* 7단계 — 통합 KV 인가(b12008 tools/server/server.cpp): -kvu · --kv-unified 면 켬, -no-kvu · --no-kv-unified 면 끔, 아니면 슬롯 수를
   주지 않았을 때(-np 자동 = −1 → 슬롯 4 · 통합 KV)만 켬 *)
[라마통합KV]는 -> 참거짓 {
    (라마명령있나("-kvu") 또는 라마명령있나("--kv-unified"))이면 { 반환 참. }
    (라마명령있나("-no-kvu") 또는 라마명령있나("--no-kv-unified"))이면 { 반환 거짓. }
    반환 문자열_같은가(라마명령값("-np", "--parallel", "-1"), "-1").
}

(* 명령줄의 작은 수(0.1 따위)를 JSON 수로 — 숫자와 점 하나만이면 그대로, 아니면 기본 0.1 *)
[문자열 s를 라마작은수]는 -> 문자열 {
    (s == 없음 또는 s[0] == 0)이면 { 반환 "0.1". }
    정수 점 = 0.
    반복 (정수 k = 0: s[k] != 0: k += 1) {
        정수 c = s[k] & 255.
        c == 46이면 { 점 += 1. } 아니면 (c < 48 또는 c > 57)이면 { 반환 "0.1". }
    }
    (점 > 1 또는 s[0] == 46)이면 { 반환 "0.1". }
    반환 s.
}

(* 보낼 몸 — /completion 은 n_probs · return_tokens, 채팅 API(9단계)는 logprobs · top_logprobs · return_tokens · verbose(응답의
   __verbose 에 /completion 꼴)가 없으면 앞에 더한다. JSON 객체가 아니면 없음 *)
[요청 참조 q를 참거짓 채팅으로 라마넘김몸]는 -> 바이트열 참조 {
    (q→몸 == 없음 또는 q→몸길이 < 2)이면 { 반환 없음. }
    제이슨 참조 o = 제풀기(q→몸, q→몸길이).
    (o == 없음 또는 o→종류 != 6)이면 {
        o != 없음이면 { 잠그기(). 제놓기(o). 풀기(). }
        반환 없음.
    }
    참거짓 확률있음 = 제찾기(o, "n_probs") != 없음.
    채팅이면 { 확률있음 = 제찾기(o, "logprobs") != 없음. }
    참거짓 토큰있음 = 제찾기(o, "return_tokens") != 없음.
    참거짓 자세히있음 = 제찾기(o, "verbose") != 없음.
    잠그기(). 제놓기(o). 풀기().
    문자열 s = q→몸.
    정수 n = q→몸길이.
    정수 k = 0.
    (k < n 그리고 (s[k] & 255) != 123)동안 { k += 1. }
    정수 j = k + 1.
    (j < n 그리고 디버거빈칸인가(s[j] & 255))동안 { j += 1. }
    바이트열 참조 b = 바이트열_만들기().
    바이트열_붙이기(b, s, k + 1).
    정수 더한것 = 0.
    아닌 확률있음이면 {
        채팅이면 { 날글넣기(b, "\"logprobs\":true,\"top_logprobs\":20"). } 아니면 { 날글넣기(b, "\"n_probs\":20"). }
        더한것 += 1.
    }
    아닌 토큰있음이면 {
        더한것 > 0이면 { 날글넣기(b, ","). }
        날글넣기(b, "\"return_tokens\":true"). 더한것 += 1.
    }
    (채팅 그리고 아닌 자세히있음)이면 {
        더한것 > 0이면 { 날글넣기(b, ","). }
        날글넣기(b, "\"verbose\":true"). 더한것 += 1.
    }
    (더한것 > 0 그리고 j < n 그리고 (s[j] & 255) != 125)이면 { 날글넣기(b, ","). }
    바이트열_붙이기(b, s + k + 1, n - k - 1).
    반환 b.
}

(* 28단계 — 서버의 슬롯 상태(/slots — 우선 작업이라 디코드 가운데에도 곧 답한다): 슬롯마다 id · id_task(쓰인 적이 있으면) ·
   is_processing · n_prompt_tokens 의 JSON 배열 글. 묻지 못하면 없음 *)
[라마슬롯글]는 -> 바이트열 참조 {
    바이트열 참조 슬롯글 = 없음.
    위답 참조 sl = 위묻기("GET", 라마포트, "/slots", 없음, 5).
    (sl != 없음 그리고 sl→코드 == 200)이면 {
        제이슨 참조 sa = 제풀기(sl→몸, sl→몸길이).
        (sa != 없음 그리고 sa→종류 == 5)이면 {
            슬롯글 = 바이트열_만들기().
            날글넣기(슬롯글, "[").
            반복 (정수 ks는 0부터 제개수(sa) 전까지) {
                제이슨 참조 하나 = 제자식(sa, ks).
                ks > 0이면 { 날글넣기(슬롯글, ","). }
                날글넣기(슬롯글, "\{").
                제쌍수(슬롯글, "id", 제정수값(하나, "id", -1)).
                제찾기(하나, "id_task") != 없음이면 { 날글넣기(슬롯글, ","). 제쌍수(슬롯글, "id_task", 제정수값(하나, "id_task", -1)). }
                날글넣기(슬롯글, ","). 제쌍참(슬롯글, "is_processing", 제참값(하나, "is_processing", 거짓)).
                제찾기(하나, "n_prompt_tokens") != 없음이면 { 날글넣기(슬롯글, ","). 제쌍수(슬롯글, "n_prompt_tokens", 제정수값(하나, "n_prompt_tokens", 0)). }
                날글넣기(슬롯글, "\}").
            }
            날글넣기(슬롯글, "]").
        }
        sa != 없음이면 { 잠그기(). 제놓기(sa). 풀기(). }
    }
    sl != 없음이면 { 위답놓기(sl). }
    반환 슬롯글.
}

(* /llama/… 를 넘긴다(관리나눠주기에서). 웹넘기기와 같고, 길에서 /llama 를 떼고, /completion 이면 더한 몸을 보내며 기록한다 *)
[정수 번호를 요청 참조 q를 라마넘기기]는 {
    이음 참조 c = 이음칸(번호).
    라마설정읽기().
    라마포트 <= 0이면 {
        웹오류(c, 503, "llama-server 기록기가 꺼져 있습니다 — 기록기 설정에 llama-server 의 포트를 적으세요(POST /api/llama/recorder)").
        반환.
    }
    정수 빈 = -1.
    반복 (정수 k는 0부터 이음최대 전까지) { (빈 < 0 그리고 위들[k] == 0)이면 { 빈 = k. } }
    빈 < 0이면 { 웹오류(c, 503, "동시 연결이 너무 많습니다 — 잠시 뒤 다시 시도하세요"). 반환. }
    문자열 새길 = q→길 + 6.
    바이트열 참조 몸 = 없음.
    참거짓 채팅 = 문자열_같은가(새길, "/v1/chat/completions").
    ((문자열_같은가(새길, "/completion") 또는 채팅) 그리고 문자열_같은가(q→방법, "POST"))이면 {
        라마개입이면 { 몸 = 라마넘김몸(q, 채팅). }
        아니면 (q→몸 != 없음 그리고 q→몸길이 > 0)이면{
            몸 = 바이트열_만들기().                                 (* 31단계 — 투명: 바이트 그대로 *)
            바이트열_붙이기(몸, q→몸, q→몸길이).
        }
    }
    정수 s = 위잇기시작(라마포트).
    s == 소켓없음이면 {
        몸 != 없음이면 { 바이트열_해제(몸). }
        c→이어씀 = 거짓.
        웹오류(c, 502, "llama-server 에 연결하지 못했습니다 — 기록기 설정의 포트를 확인하세요").
        반환.
    }
    위이음 참조 u = 초기할당(1 을, 크기(위이음)).
    u→소켓 = s.
    u→아래 = 번호.
    u→나감 = 바이트열_만들기().
    (몸 != 없음 그리고 라마개입)이면 { u→기록앞 = 라마슬롯글(). }  (* 28단계 — 넘기기 전의 슬롯 상태(영수증의 slots_before) — 개입할 때만 *)
    u→때 = 정밀시각_밀리초().
    날글넣기(u→나감, q→방법).
    날글넣기(u→나감, " ").
    날글넣기(u→나감, 새길).
    q→물음 != 없음이면 { 날글넣기(u→나감, "?"). 날글넣기(u→나감, q→물음). }
    날글넣기(u→나감, " HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n").
    q→형식 != 없음이면 { 날글넣기(u→나감, "Content-Type: "). 날글넣기(u→나감, q→형식). 날글넣기(u→나감, "\r\n"). }
    날글넣기(u→나감, "Content-Length: ").
    몸 != 없음이면 { 제수쓰기(u→나감, 바이트열_길이(몸)). } 아니면 { 제수쓰기(u→나감, q→몸길이). }
    날글넣기(u→나감, "\r\n\r\n").
    몸 != 없음이면 {
        바이트열_붙이기(u→나감, 바이트열_자료(몸), 바이트열_길이(몸)).
        u→기록몸 = 몸.
        u→받음 = 바이트열_만들기().
        u→기록길 = 문자열_복제("/llama/completion").
        채팅이면 { 해제(u→기록길). u→기록길 = 문자열_복제("/llama/v1/chat/completions"). }
    }
    아니면 q→몸길이 > 0이면 { 바이트열_붙이기(u→나감, q→몸, q→몸길이). }
    위들[빈] = u 으로 정수.
    c→위 = 빈.
    c→이어씀 = 거짓.
}

묶음 라마기록은 문자열 보낸, 정수 보낸길이, 문자열 받은, 정수 받은길이, 실수 걸림, 문자열 때, 정수 순번, 문자열 길,
    바이트열 참조 앞슬롯, 바이트열 참조 뒤슬롯,          (* 28단계 — 넘기기 전 · 응답 바로 뒤의 /slots *)
    정수 개입.                                          (* 31단계 — 0 투명(토큰 없는 영수증) · 1 개입 *)

정수 라마적기순번 = 0.             (* 7단계 — 응답이 끝난 차례(웹 고리 — 한 스레드). 영수증의 recorder.seq: 같은 초의 두 영수증의 차례 *)

(* ===== 18단계 — 스트리밍 응답(SSE): 기록기가 받은 몸(data: {…} 줄들)의 조각을 모아 비스트리밍 응답과 같은 꼴로 적는다.
   /completion: 조각마다 tokens(토큰 하나 — 글자가 덜 끝난 토큰은 조각이 없다) · completion_probabilities(칸 하나) · content, 끝 조각
   (stop 참)에 tokens_predicted · timings · tokens_cached · generation_settings(tokens · 로그 확률은 비었다). 채팅 API: 조각마다
   choices[].logprobs.content(칸 — 글 조각이 없는 토큰은 칸도 없다) · delta, 끝 조각의 __verbose(/completion 꼴). 알려진 토큰은
   /completion 이 조각의 tokens, 채팅이 칸의 id. 빠진 토큰 수 = tokens_predicted − 알려진 수 ===== *)
묶음 라마흐름은 정수목록 참조 토큰, 정수목록 참조 칸들, 정수목록 참조 조각들, 바이트열 참조 글, 제이슨 참조 끝, 정수 조각수.

[문자열 s를 정수 n을 참거짓 채팅을 라마흐름풀기]는 -> 라마흐름 참조 {
    라마흐름 참조 h = 초기할당(1 을, 크기(라마흐름)).
    h→토큰 = 정수목록_만들기(). h→칸들 = 정수목록_만들기(). h→조각들 = 정수목록_만들기(). h→글 = 바이트열_만들기().
    정수 i = 0.
    (s != 없음 그리고 i < n) 동안 {
        정수 j = i.
        (j < n 그리고 (s[j] & 255) != 10) 동안 { j += 1. }
        정수 e = j.
        (e > i 그리고 (s[e - 1] & 255) == 13)이면 { e -= 1. }
        참거짓 자료줄 = e - i > 6.
        자료줄이면 {
            자료줄 = (s[i] & 255) == 100 그리고 (s[i + 1] & 255) == 97 그리고 (s[i + 2] & 255) == 116 그리고 (s[i + 3] & 255) == 97.
            자료줄 = 자료줄 그리고 (s[i + 4] & 255) == 58 그리고 (s[i + 5] & 255) == 32 그리고 (s[i + 6] & 255) == 123.
        }
        자료줄이면 {
            제이슨 참조 c = 제풀기(s + i + 6, e - i - 6).
            (c != 없음 그리고 c→종류 == 6)이면 {
                정수목록_추가(h→조각들, c 으로 정수).
                h→조각수 += 1.
                채팅이면 {
                    제이슨 참조 v = 제찾기(c, "__verbose").
                    v != 없음이면 { h→끝 = v. }
                    제이슨 참조 chs = 제찾기(c, "choices").
                    반복 (정수 a는 0부터 제개수(chs) 전까지) {
                        제이슨 참조 ch = 제자식(chs, a).
                        제이슨 참조 lp = 제찾기(제찾기(ch, "logprobs"), "content").
                        반복 (정수 b2는 0부터 제개수(lp) 전까지) {
                            제이슨 참조 en = 제자식(lp, b2).
                            정수목록_추가(h→칸들, en 으로 정수).
                            정수목록_추가(h→토큰, 라마정수(제찾기(en, "id"))).
                        }
                        제이슨 참조 dc = 제찾기(제찾기(ch, "delta"), "content").
                        (dc != 없음 그리고 dc→종류 == 4)이면 { 바이트열_붙이기(h→글, dc→글, dc→글길이). }
                    }
                } 아니면 제참값(c, "stop", 거짓)이면 {
                    h→끝 = c.
                } 아니면 {
                    제이슨 참조 tk = 제찾기(c, "tokens").
                    반복 (정수 a2는 0부터 제개수(tk) 전까지) { 정수목록_추가(h→토큰, 라마정수(제자식(tk, a2))). }
                    제이슨 참조 cp = 제찾기(c, "completion_probabilities").
                    반복 (정수 a3는 0부터 제개수(cp) 전까지) { 정수목록_추가(h→칸들, 제자식(cp, a3) 으로 정수). }
                    제이슨 참조 ct = 제찾기(c, "content").
                    (ct != 없음 그리고 ct→종류 == 4)이면 { 바이트열_붙이기(h→글, ct→글, ct→글길이). }
                }
            } 아니면 c != 없음이면 { 잠그기(). 제놓기(c). 풀기(). }
        }
        i = j + 1.
    }
    반환 h.
}

(* 모은 응답을 b 에 — stream{조각 수 · 알려진 · 빠진 토큰 수}, 모은 tokens · 로그 확률 칸 · 글, 끝 조각의 나머지 값 *)
[바이트열 참조 b에 라마흐름 참조 h를 라마흐름쓰기]는 {
    정수 예측 = 제정수값(h→끝, "tokens_predicted", -1).
    정수 알려진 = 정수목록_길이(h→토큰).
    정수 빠짐 = -1.
    예측 >= 0이면 { 빠짐 = 예측 - 알려진. }
    날글넣기(b, "\{\"stream\":\{").
    제쌍수(b, "events", h→조각수). 날글넣기(b, ",").
    제쌍수(b, "tokens_known", 알려진). 날글넣기(b, ",").
    제쌍수(b, "tokens_missing", 빠짐).
    날글넣기(b, "\},\"tokens\":[").
    반복 (정수 k는 0부터 알려진 전까지) {
        k > 0이면 { 날글넣기(b, ","). }
        제수쓰기(b, 정수목록_값(h→토큰, k)).
    }
    날글넣기(b, "],\"completion_probabilities\":[").
    반복 (정수 k2는 0부터 정수목록_길이(h→칸들) 전까지) {
        k2 > 0이면 { 날글넣기(b, ","). }
        파이썬쓰기(b, 정수목록_값(h→칸들, k2) 으로 제이슨 참조, 0, 0).
    }
    날글넣기(b, "],\"content\":").
    파이썬글쓰기(b, 바이트열_자료(h→글), 바이트열_길이(h→글)).
    제이슨 참조 끝 = h→끝.
    (끝 != 없음 그리고 끝→종류 == 6)이면 {
        반복 (정수 k3는 0부터 제개수(끝) 전까지) {
            문자열 열 = 정수목록_값(끝→열쇠들, k3) 으로 문자열.
            (아닌 문자열_같은가(열, "tokens") 그리고 아닌 문자열_같은가(열, "content") 그리고 아닌 문자열_같은가(열, "completion_probabilities")
                그리고 아닌 문자열_같은가(열, "stream"))이면 {
                날글넣기(b, ",").
                파이썬글쓰기(b, 열, 글자수(열)).
                날글넣기(b, ":").
                파이썬쓰기(b, 제자식(끝, k3), 0, 0).
            }
        }
    }
    날글넣기(b, "\}").
}

[라마흐름 참조 h를 라마흐름놓기]는 {
    h == 없음이면 { 반환. }
    잠그기().
    반복 (정수 k는 0부터 정수목록_길이(h→조각들) 전까지) { 제놓기(정수목록_값(h→조각들, k) 으로 제이슨 참조). }
    풀기().
    정수목록_해제(h→토큰). 정수목록_해제(h→칸들). 정수목록_해제(h→조각들). 바이트열_해제(h→글).
    해제(h).
}

(* 웹 고리(웹.gl — 위가 닫혔을 때): 받은 바이트(머리 + 몸)가 200 이면 스레드가 영수증을 마무리한다 *)
[문자열 길을 바이트열 참조 보낸몸을 바이트열 참조 받음을 실수 걸림을 바이트열 참조 앞슬롯을 라마적기]는 {
    위답 참조 r = 위답풀기(바이트열_자료(받음), 바이트열_길이(받음)).
    r == 없음이면 { 앞슬롯 != 없음이면 { 바이트열_해제(앞슬롯). } 반환. }
    r→코드 != 200이면 { 위답놓기(r). 앞슬롯 != 없음이면 { 바이트열_해제(앞슬롯). } 반환. }
    라마기록 참조 x = 초기할당(1 을, 크기(라마기록)).
    x→보낸길이 = 바이트열_길이(보낸몸).
    x→보낸 = 할당(x→보낸길이 + 1).
    메모리_복사(x→보낸 에, 바이트열_자료(보낸몸) 에서, x→보낸길이 를).
    x→보낸[x→보낸길이] = 0.
    x→받은 = r→몸.
    x→받은길이 = r→몸길이.
    r→몸 = 없음.
    위답놓기(r).
    x→걸림 = 걸림.
    x→앞슬롯 = 앞슬롯.
    x→개입 = 0.
    라마개입이면 { x→개입 = 1. x→뒤슬롯 = 라마슬롯글(). }      (* 28단계 — 응답 바로 뒤(다음 요청과 엇갈리는 틈을 줄인다) — 개입할 때만 *)
    x→때 = 시각글().
    x→길 = 문자열_복제(길).
    라마적기순번 += 1.
    x→순번 = 라마적기순번.
    [공허 참조 -> 중간정수] 함수 = 라마영수증마무리.
    스레드띄우기(함수 으로 공허 참조, x).
}

(* 이 PC 의 CUDA 장치(장치 확인의 첫 장치) — 이름 · "주.부" · SM 수 *)
[바이트열 참조 b에 라마장치쓰기]는 {
    잠그기().
    문자열 글 = 없음.
    장치쿠다글 != 없음이면 { 글 = 문자열_복제(장치쿠다글). }
    풀기().
    제이슨 참조 o = 없음.
    글 != 없음이면 { o = 제풀기(글, 글자수(글)). }
    제이슨 참조 첫 = 없음.
    (o != 없음 그리고 제찾기(o, "devices") != 없음 그리고 제개수(제찾기(o, "devices")) > 0)이면 { 첫 = 제자식(제찾기(o, "devices"), 0). }
    날글넣기(b, "\"device\":\{").
    첫 != 없음이면 {
        제쌍글(b, "name", 제글보기(첫, "name", "")). 날글넣기(b, ",").
        제쌍글(b, "cc", 짓기("%lld.%lld", 제정수값(첫, "cc_major", 0), 제정수값(첫, "cc_minor", 0))). 날글넣기(b, ",").
        제쌍수(b, "sm_count", 제정수값(첫, "sm", 0)).
    }
    날글넣기(b, "\}").
    o != 없음이면 { 잠그기(). 제놓기(o). 풀기(). }
}

(* 9단계 — 채팅 템플릿의 사용자 메시지 구분 글(llama.cpp chat-diff-analyzer.cpp detect_user_start_marker 의 다른 판과 같은 셈):
   /apply-template 로 (사용자 · 도우미 · 사용자) 대화를 그려 도우미 글과 마지막 사용자 글 사이의 글에서, 앞의 끝 표지(<…> 가운데 end ·
   close 가 든 것)와 빈칸을 건너뛰고 앞뒤 빈칸을 뗀다. 그 글을 /tokenize(add_special false · parse_special true — common_tokenize)로.
   기록기가 켜진 동안 한 번 묻는다. 못 찾으면 빈 글 *)
문자열 라마구분글 = 없음.
문자열 라마구분토큰 = 없음.              (* JSON 배열 글 *)

[문자열 s에서 정수 i를 라마빈칸인가]는 -> 참거짓 {
    정수 c = s[i] & 255.
    반환 c == 32 또는 c == 9 또는 c == 10 또는 c == 13.
}

(* 30단계 — 포트의 llama-server 에 묻는다(기록기의 서버 · 토큰 없는 영수증의 임시 서버): [구분 글, 구분 토큰의 JSON 배열 글] *)
[정수 포트를 라마구분묻기]는 -> 문자열목록 참조 {
    문자열 찾은 = 문자열_복제("").
    문자열 토큰글 = 문자열_복제("[]").
    문자열 몸 = "\{\"messages\":[\{\"role\":\"user\",\"content\":\"GEULPUQQ1\"\},\{\"role\":\"assistant\",\"content\":\"GEULPUQQ2\"\},\{\"role\":\"user\",\"content\":\"GEULPUQQ3\"\}]\}".
    위답 참조 a = 위묻기("POST", 포트, "/apply-template", 몸, 30).
    (a != 없음 그리고 a→코드 == 200)이면 {
        제이슨 참조 aj = 제풀기(a→몸, a→몸길이).
        문자열 글 = 제글보기(aj, "prompt", "").
        정수 ia = 문자열_찾기_위치(글 에서, "GEULPUQQ2" 를).
        정수 ib = 문자열_찾기_위치(글 에서, "GEULPUQQ3" 를).
        (ia >= 0 그리고 ib > ia)이면 {
            정수 i = ia + 9.
            정수 끝 = ib.
            참거짓 건넘 = 참.
            (건넘 그리고 i < 끝) 동안 {
                건넘 = 거짓.
                (i < 끝 그리고 라마빈칸인가(글, i)) 동안 { i += 1. 건넘 = 참. }
                (i < 끝 그리고 (글[i] & 255) == 60)이면 {
                    정수 j = i.
                    (j < 끝 그리고 (글[j] & 255) != 62) 동안 { j += 1. }
                    j < 끝이면 {
                        문자열 표 = 문자열_자르기(글, i, j + 1 - i).
                        (문자열_찾기_위치(표 에서, "end" 를) >= 0 또는 문자열_찾기_위치(표 에서, "END" 를) >= 0 또는 문자열_찾기_위치(표 에서, "close" 를) >= 0)이면 {
                            i = j + 1. 건넘 = 참.
                        }
                        해제(표).
                    }
                }
            }
            (끝 > i 그리고 라마빈칸인가(글, 끝 - 1)) 동안 { 끝 -= 1. }
            끝 > i이면 { 해제(찾은). 찾은 = 문자열_자르기(글, i, 끝 - i). }
        }
        aj != 없음이면 { 잠그기(). 제놓기(aj). 풀기(). }
    }
    a != 없음이면 { 위답놓기(a). }
    찾은[0] != 0이면 {
        바이트열 참조 tq = 바이트열_만들기().
        날글넣기(tq, "\{\"content\":").
        제글넣기(tq, 찾은).
        날글넣기(tq, ",\"add_special\":false,\"parse_special\":true\}").
        바이트열_넣기(tq, 0).
        위답 참조 t = 위묻기("POST", 포트, "/tokenize", 바이트열_자료(tq), 30).
        바이트열_해제(tq).
        (t != 없음 그리고 t→코드 == 200)이면 {
            제이슨 참조 tt = 제풀기(t→몸, t→몸길이).
            제이슨 참조 tk = 제찾기(tt, "tokens").
            tk != 없음이면 {
                바이트열 참조 tb = 바이트열_만들기().
                날글넣기(tb, "[").
                반복 (정수 k는 0부터 제개수(tk) 전까지) {
                    k > 0이면 { 날글넣기(tb, ","). }
                    제수쓰기(tb, 라마정수(제자식(tk, k))).
                }
                날글넣기(tb, "]").
                바이트열_넣기(tb, 0).
                해제(토큰글).
                토큰글 = 문자열_복제(바이트열_자료(tb)).
                바이트열_해제(tb).
            }
            tt != 없음이면 { 잠그기(). 제놓기(tt). 풀기(). }
        }
        t != 없음이면 { 위답놓기(t). }
    }
    문자열목록 참조 r = 문자열목록_만들기().
    문자열목록_추가(r, 찾은).
    문자열목록_추가(r, 토큰글).
    반환 r.
}

[라마채팅구분찾기]는 {
    잠그기(). 참거짓 있음 = 라마구분글 != 없음. 풀기().
    있음이면 { 반환. }
    문자열목록 참조 r = 라마구분묻기(라마포트).
    문자열 찾은 = 문자열목록_값(r, 0).
    문자열 토큰글 = 문자열목록_값(r, 1).
    잠그기().
    라마구분글 == 없음이면 { 라마구분글 = 찾은. 라마구분토큰 = 토큰글. } 아니면 { 해제(찾은). 해제(토큰글). }
    풀기().
}

(* 스레드 — 영수증을 마무리해 자료\영수증\ 에 쓴다 *)
(* 31단계 — 명령줄에서 서버 설정을 읽어 영수증의 server 칸에(없으면 b12008 의 기본 — derived: true) *)
[바이트열 참조 b에 라마서버칸쓰기]는 {
    정수 슬롯수 = 라마십진(라마명령값("-np", "--parallel", "-1")).
    슬롯수 <= 0이면 { 슬롯수 = 4. }                                 (* -np 자동(−1) — b12008 은 슬롯 4 *)
    정수 문맥모두 = 라마십진(라마명령값("-c", "--ctx-size", "4096")).
    정수 문맥 = 문맥모두.
    (문맥모두 > 0 그리고 아닌 라마통합KV())이면 { 문맥 = (문맥모두 / 슬롯수 + 255) / 256 * 256. }
    문맥모두 <= 0이면 { 문맥 = -1. }                                (* -c 0 — 모델의 문맥(모른다) *)
    날글넣기(b, "\"server\":\{").
    제쌍수(b, "port", 라마포트). 날글넣기(b, ",").
    제쌍글(b, "args", 라마명령줄). 날글넣기(b, ",").
    제쌍글(b, "exe", 라마실행). 날글넣기(b, ",").
    제쌍참(b, "derived", 참). 날글넣기(b, ",").
    제쌍수(b, "n_ctx", 문맥). 날글넣기(b, ",").
    제쌍수(b, "n_parallel", 슬롯수). 날글넣기(b, ",").
    제쌍수(b, "n_batch", 라마십진(라마명령값("-b", "--batch-size", "2048"))). 날글넣기(b, ",").
    제쌍수(b, "n_ubatch", 라마십진(라마명령값("-ub", "--ubatch-size", "512"))). 날글넣기(b, ",").
    제쌍참(b, "flash_attn", 문자열_같은가(라마명령값("-fa", "--flash-attn", "auto"), "on")). 날글넣기(b, ",").
    제쌍글(b, "flash_attn_mode", 라마명령값("-fa", "--flash-attn", "auto")). 날글넣기(b, ",").
    제쌍참(b, "cache_prompt", 아닌 라마명령있나("--no-cache-prompt")). 날글넣기(b, ",").
    제쌍참(b, "kv_unified", 라마통합KV()). 날글넣기(b, ",").
    제쌍수(b, "ctx_checkpoints", 라마십진(라마명령값("-ctxcp", "--ctx-checkpoints", 라마명령값("--swa-checkpoints", "--swa-checkpoints", "32")))).
    날글넣기(b, ",").
    제쌍수(b, "checkpoint_min_step", 라마십진(라마명령값("-cms", "--checkpoint-min-step", "8192"))). 날글넣기(b, ",").
    제쌍수(b, "cache_ram_mib", 라마십진(라마명령값("-cram", "--cache-ram", "8192"))). 날글넣기(b, ",").
    제쌍수(b, "cache_reuse", 라마십진(라마명령값("--cache-reuse", "--cache-reuse", "0"))). 날글넣기(b, ",\"slot_prompt_similarity\":").
    날글넣기(b, 라마작은수(라마명령값("-sps", "--slot-prompt-similarity", "0.1"))).
    날글넣기(b, "\}").
}

(* 31단계 — 토큰 없는 영수증(geulpu-llama-receipt/2): 요청 몸 · 응답 그대로. 서버에 묻지 않고 모델 파일을 읽지 않는다 *)
[라마기록 참조 x를 라마영수증2쓰기]는 {
    제이슨 참조 몸 = 제풀기(x→보낸, x→보낸길이).
    (몸 == 없음 또는 몸→종류 != 6)이면 {
        몸 != 없음이면 { 잠그기(). 제놓기(몸). 풀기(). }
        반환.
    }
    참거짓 채팅 = 문자열_같은가(x→길, "/llama/v1/chat/completions").
    참거짓 흐름 = 제참값(몸, "stream", 거짓).
    제이슨 참조 받음j = 없음.
    아닌 흐름이면 { 받음j = 제풀기(x→받은, x→받은길이). }
    (받음j != 없음 그리고 받음j→종류 != 6)이면 { 잠그기(). 제놓기(받음j). 풀기(). 받음j = 없음. }
    라마흐름 참조 흐 = 없음.
    흐름이면 { 흐 = 라마흐름풀기(x→받은, x→받은길이, 채팅). }
    (* 빌드 — 설정(--version), 없으면 채팅 응답의 system_fingerprint *)
    문자열 빌드 = 문자열_복제(라마빌드).
    (빌드[0] == 0 그리고 채팅)이면 {
        해제(빌드).
        빌드 = 문자열_복제("").
        받음j != 없음이면 { 해제(빌드). 빌드 = 문자열_복제(제글보기(받음j, "system_fingerprint", "")). }
        아니면 (흐 != 없음 그리고 흐→조각수 > 0)이면 {
            해제(빌드).
            빌드 = 문자열_복제(제글보기(정수목록_값(흐→조각들, 흐→조각수 - 1) 으로 제이슨 참조, "system_fingerprint", "")).
        }
    }
    문자열 OS = "linux".
    문자열_같은가(실행이름("a.exe"), "a.exe")이면 { OS = "windows". }
    바이트열 참조 b = 바이트열_만들기().
    날글넣기(b, "\{").
    제쌍글(b, "format", "geulpu-llama-receipt/2"). 날글넣기(b, ",").
    제쌍글(b, "recorded_at", x→때). 날글넣기(b, ",").
    날글넣기(b, "\"recorder\":\{"). 제쌍글(b, "app", 앱판). 날글넣기(b, ","). 제쌍글(b, "commit", 앱커밋). 날글넣기(b, ",").
    제쌍수(b, "seq", x→순번). 날글넣기(b, ","). 제쌍글(b, "mode", "transparent"). 날글넣기(b, "\},").
    날글넣기(b, "\"engine\":\{").
    제쌍글(b, "name", "llama.cpp"). 날글넣기(b, ",").
    제쌍글(b, "program", "llama-server"). 날글넣기(b, ",").
    제쌍글(b, "build_info", 빌드). 날글넣기(b, ",").
    제쌍글(b, "backend", "CUDA"). 날글넣기(b, ",").
    제쌍글(b, "os", OS).
    날글넣기(b, "\},").
    라마장치쓰기(b).
    날글넣기(b, ",\"model\":\{").
    제쌍글(b, "path", 라마모델경로). 날글넣기(b, ",").
    제쌍수(b, "size", 라마모델크기).
    날글넣기(b, "\},").
    라마서버칸쓰기(b).
    날글넣기(b, ",\"request\":\{").
    채팅이면 { 제쌍글(b, "endpoint", "/v1/chat/completions"). } 아니면 { 제쌍글(b, "endpoint", "/completion"). }
    날글넣기(b, ",\"body\":").
    바이트열_붙이기(b, x→보낸, x→보낸길이).
    날글넣기(b, "\},\"response\":").
    받음j != 없음이면 { 바이트열_붙이기(b, x→받은, x→받은길이). }
    아니면 흐 != 없음이면 {
        (* 스트리밍 — 조각을 모은 글과 끝 조각(30단계의 검증은 아직 받지 않는다 — 다음 단계) *)
        날글넣기(b, "\{\"stream\":true,").
        제쌍수(b, "events", 흐→조각수). 날글넣기(b, ",\"content\":").
        파이썬글쓰기(b, 바이트열_자료(흐→글), 바이트열_길이(흐→글)).
        흐→조각수 > 0이면 { 날글넣기(b, ",\"final\":"). 파이썬쓰기(b, 정수목록_값(흐→조각들, 흐→조각수 - 1) 으로 제이슨 참조, 0, 0). }
        날글넣기(b, "\}").
    }
    아니면 { 날글넣기(b, "null"). }
    날글넣기(b, ",").
    제쌍실수(b, "elapsed_ms", x→걸림, 1).
    날글넣기(b, "\}\n").
    폴더만들기(라마영수증폴더()).
    잠그기().
    라마기록번호 += 1.
    정수 번호 = 라마기록번호.
    풀기().
    문자열 이름 = 짓기("%s-%lld", 시각도장(), 번호).
    바이트열파일쓰기(잇기3(라마영수증폴더(), 이름, ".json"), b).
    바이트열_해제(b).
    해제(빌드).
    받음j != 없음이면 { 잠그기(). 제놓기(받음j). 풀기(). }
    라마흐름놓기(흐).
    잠그기(). 제놓기(몸). 풀기().
}

[공허 참조 인자를 라마영수증마무리]는 -> 중간정수 {
    라마기록 참조 x = 인자 으로 라마기록 참조.
    x→개입 == 0이면 {                                             (* 31단계 — 투명한 기록기: 토큰 없는 영수증 *)
        라마영수증2쓰기(x).
        x→앞슬롯 != 없음이면 { 바이트열_해제(x→앞슬롯). }
        x→뒤슬롯 != 없음이면 { 바이트열_해제(x→뒤슬롯). }
        해제(x→보낸). 해제(x→받은). 해제(x→길). 해제(x).
        반환 0.
    }
    (* 서버의 빌드 · 모델 · 슬롯 · 문맥 *)
    위답 참조 p = 위묻기("GET", 라마포트, "/props", 없음, 30).
    제이슨 참조 pr = 없음.
    (p != 없음 그리고 p→코드 == 200)이면 { pr = 제풀기(p→몸, p→몸길이). }
    p != 없음이면 { 위답놓기(p). }
    문자열 빌드 = 제글값(pr, "build_info", "").
    문자열 모델경로 = 제글값(pr, "model_path", "").
    정수 슬롯 = 제정수값(pr, "total_slots", 0).
    정수 문맥 = 제정수값(제찾기(pr, "default_generation_settings"), "n_ctx", 0).
    pr != 없음이면 { 잠그기(). 제놓기(pr). 풀기(). }
    (* 프롬프트 토큰 — 글이면 /tokenize(서버가 /completion 에서 쓰는 add_special · parse_special 그대로), 번호 배열이면 그대로 *)
    제이슨 참조 몸 = 제풀기(x→보낸, x→보낸길이).
    (* 9단계 — 응답이 JSON 객체인가(스트리밍이면 아니다), 채팅 API 면 그 __verbose(/completion 꼴)와 그 prompt(템플릿을 적용한 글) *)
    참거짓 채팅 = 문자열_같은가(x→길, "/llama/v1/chat/completions").
    참거짓 흐름 = 제참값(몸, "stream", 거짓).
    제이슨 참조 받음j = 없음.
    아닌 흐름이면 { 받음j = 제풀기(x→받은, x→받은길이). }
    (받음j != 없음 그리고 받음j→종류 != 6)이면 { 잠그기(). 제놓기(받음j). 풀기(). 받음j = 없음. }
    (* 18단계 — 스트리밍 응답이면 조각을 모은다(채팅은 끝 조각의 __verbose 가 상세) *)
    라마흐름 참조 흐 = 없음.
    흐름이면 { 흐 = 라마흐름풀기(x→받은, x→받은길이, 채팅). }
    제이슨 참조 상세 = 없음.
    채팅이면 {
        흐 != 없음이면 { 상세 = 흐→끝. } 아니면 { 상세 = 제찾기(받음j, "__verbose"). }
        라마채팅구분찾기().
    }
    제이슨 참조 프 = 제찾기(몸, "prompt").
    채팅이면 { 프 = 제찾기(상세, "prompt"). }
    바이트열 참조 토큰들 = 바이트열_만들기().
    참거짓 토큰됨 = 거짓.
    (프 != 없음 그리고 프→종류 == 4)이면 {
        바이트열 참조 tq = 바이트열_만들기().
        날글넣기(tq, "\{\"content\":").
        제글넣기(tq, 프→글).
        (* 18단계 — 채팅의 __verbose.prompt 는 서버가 셈한 토큰을 되돌린 글(detokenize — BOS 같은 특수 토큰의 글까지)이라 add_special 을
           주면 BOS 가 둘이 된다(Llama). /completion 은 요청의 글 그대로라 서버와 같이 add_special *)
        채팅이면 { 날글넣기(tq, ",\"add_special\":false,\"parse_special\":true\}"). }
        아니면 { 날글넣기(tq, ",\"add_special\":true,\"parse_special\":true\}"). }
        바이트열_넣기(tq, 0).
        위답 참조 t = 위묻기("POST", 라마포트, "/tokenize", 바이트열_자료(tq), 60).
        바이트열_해제(tq).
        (t != 없음 그리고 t→코드 == 200)이면 {
            제이슨 참조 tt = 제풀기(t→몸, t→몸길이).
            제이슨 참조 tk = 제찾기(tt, "tokens").
            tk != 없음이면 {
                날글넣기(토큰들, "[").
                반복 (정수 k는 0부터 제개수(tk) 전까지) {
                    k > 0이면 { 날글넣기(토큰들, ","). }
                    제수쓰기(토큰들, 라마정수(제자식(tk, k))).
                }
                날글넣기(토큰들, "]").
                토큰됨 = 참.
            }
            tt != 없음이면 { 잠그기(). 제놓기(tt). 풀기(). }
        }
        t != 없음이면 { 위답놓기(t). }
    }
    아니면 (프 != 없음 그리고 프→종류 == 5)이면 {
        날글넣기(토큰들, "[").
        반복 (정수 k2는 0부터 제개수(프) 전까지) {
            k2 > 0이면 { 날글넣기(토큰들, ","). }
            제수쓰기(토큰들, 라마정수(제자식(프, k2))).
        }
        날글넣기(토큰들, "]").
        토큰됨 = 참.
    }
    참거짓 캐시 = 아닌 라마명령있나("--no-cache-prompt").              (* 요청의 cache_prompt 가 있으면 그것(서버의 기본을 덮는다) *)
    제찾기(몸, "cache_prompt") != 없음이면 { 캐시 = 제참값(몸, "cache_prompt", 참). }
    몸 != 없음이면 { 잠그기(). 제놓기(몸). 풀기(). }
    (* 7단계 — 슬롯 상태(/slots — 기본 켬): 슬롯마다 id · id_task(쓰인 적이 있으면) · is_processing · n_prompt_tokens. 28단계 — 응답
       바로 뒤에 물은 것(라마적기) *)
    바이트열 참조 슬롯글 = x→뒤슬롯.
    x→뒤슬롯 = 없음.
    (* 모델 파일의 SHA-256(같은 경로 · 크기면 다시 셈하지 않는다) *)
    정수 크기값 = 파일바이트(모델경로).
    문자열 해시 = 없음.
    잠그기().
    (라마해시경로 != 없음 그리고 문자열_같은가(라마해시경로, 모델경로) 그리고 라마해시크기 == 크기값)이면 { 해시 = 문자열_복제(라마해시값). }
    풀기().
    (해시 == 없음 그리고 크기값 > 0)이면 {
        해시 = 파일해시(모델경로, 없음, 없음).
        해시 != 없음이면 {
            잠그기().
            라마해시경로 = 문자열_복제(모델경로).
            라마해시크기 = 크기값.
            라마해시값 = 문자열_복제(해시).
            풀기().
        }
    }
    (* 영수증 *)
    문자열 OS = "linux".
    문자열_같은가(실행이름("a.exe"), "a.exe")이면 { OS = "windows". }     (* 리눅스 판의 실행이름은 .exe 를 뗀다 *)
    바이트열 참조 b = 바이트열_만들기().
    날글넣기(b, "\{").
    제쌍글(b, "format", "geulpu-llama-receipt/1"). 날글넣기(b, ",").
    제쌍글(b, "recorded_at", x→때). 날글넣기(b, ",").
    날글넣기(b, "\"recorder\":\{"). 제쌍글(b, "app", 앱판). 날글넣기(b, ","). 제쌍글(b, "commit", 앱커밋). 날글넣기(b, ",").
    제쌍수(b, "seq", x→순번). 날글넣기(b, "\},").
    날글넣기(b, "\"engine\":\{").
    제쌍글(b, "name", "llama.cpp"). 날글넣기(b, ",").
    제쌍글(b, "program", "llama-server"). 날글넣기(b, ",").
    제쌍글(b, "build_info", 빌드). 날글넣기(b, ",").
    제쌍글(b, "backend", "CUDA"). 날글넣기(b, ",").
    제쌍글(b, "os", OS).
    날글넣기(b, "\},").
    라마장치쓰기(b).
    날글넣기(b, ",\"model\":\{").
    제쌍글(b, "path", 모델경로). 날글넣기(b, ",").
    제쌍수(b, "size", 크기값). 날글넣기(b, ",").
    제쌍글(b, "sha256", 해시).
    날글넣기(b, "\},\"server\":\{").
    제쌍수(b, "port", 라마포트). 날글넣기(b, ",").
    제쌍글(b, "args", 라마명령줄). 날글넣기(b, ",").
    제쌍수(b, "n_ctx", 문맥). 날글넣기(b, ",").
    제쌍수(b, "n_parallel", 슬롯). 날글넣기(b, ",").
    제쌍수(b, "n_batch", 라마십진(라마명령값("-b", "--batch-size", "2048"))). 날글넣기(b, ",").
    제쌍수(b, "n_ubatch", 라마십진(라마명령값("-ub", "--ubatch-size", "512"))). 날글넣기(b, ",").
    제쌍참(b, "flash_attn", 문자열_같은가(라마명령값("-fa", "--flash-attn", "auto"), "on")). 날글넣기(b, ",").
    제쌍글(b, "flash_attn_mode", 라마명령값("-fa", "--flash-attn", "auto")). 날글넣기(b, ",").
    제쌍참(b, "cache_prompt", 캐시). 날글넣기(b, ",").
    (* 7단계 — 슬롯 · 캐시의 설정(명령줄, 없으면 b12008 의 기본) *)
    제쌍참(b, "kv_unified", 라마통합KV()). 날글넣기(b, ",").
    제쌍수(b, "ctx_checkpoints", 라마십진(라마명령값("-ctxcp", "--ctx-checkpoints", 라마명령값("--swa-checkpoints", "--swa-checkpoints", "32")))).
    날글넣기(b, ",").
    제쌍수(b, "checkpoint_min_step", 라마십진(라마명령값("-cms", "--checkpoint-min-step", "8192"))). 날글넣기(b, ",").
    제쌍수(b, "cache_ram_mib", 라마십진(라마명령값("-cram", "--cache-ram", "8192"))). 날글넣기(b, ",").
    제쌍수(b, "cache_reuse", 라마십진(라마명령값("--cache-reuse", "--cache-reuse", "0"))). 날글넣기(b, ",\"slot_prompt_similarity\":").
    날글넣기(b, 라마작은수(라마명령값("-sps", "--slot-prompt-similarity", "0.1"))).
    날글넣기(b, "\},").
    슬롯글 != 없음이면 {
        날글넣기(b, "\"slots_after\":"). 바이트열_붙이기(b, 바이트열_자료(슬롯글), 바이트열_길이(슬롯글)). 날글넣기(b, ",").
        바이트열_해제(슬롯글).
    }
    x→앞슬롯 != 없음이면 {                                       (* 28단계 — 넘기기 전의 슬롯 상태 *)
        날글넣기(b, "\"slots_before\":"). 바이트열_붙이기(b, 바이트열_자료(x→앞슬롯), 바이트열_길이(x→앞슬롯)). 날글넣기(b, ",").
        바이트열_해제(x→앞슬롯).
        x→앞슬롯 = 없음.
    }
    날글넣기(b, "\"request\":\{").
    채팅이면 { 제쌍글(b, "endpoint", "/v1/chat/completions"). } 아니면 { 제쌍글(b, "endpoint", "/completion"). }
    날글넣기(b, ",\"body\":").
    바이트열_붙이기(b, x→보낸, x→보낸길이).
    날글넣기(b, "\},").
    채팅이면 {
        잠그기().
        날글넣기(b, "\"chat\":\{"). 제쌍글(b, "user_start", 라마구분글). 날글넣기(b, ",\"user_start_tokens\":"). 날글넣기(b, 라마구분토큰).
        풀기().
        날글넣기(b, "\},").
    }
    토큰됨이면 { 날글넣기(b, "\"prompt_tokens\":"). 바이트열_붙이기(b, 바이트열_자료(토큰들), 바이트열_길이(토큰들)). 날글넣기(b, ","). }
    날글넣기(b, "\"response\":").
    흐 != 없음이면 { 라마흐름쓰기(b, 흐). }                       (* 18단계 — 모은 스트리밍 응답 *)
    아니면 상세 != 없음이면 { 파이썬쓰기(b, 상세, 0, 0). }
    아니면 받음j != 없음이면 { 바이트열_붙이기(b, x→받은, x→받은길이). }
    아니면 { 날글넣기(b, "\{\"stream\":true\}"). }
    날글넣기(b, ",").
    제쌍실수(b, "elapsed_ms", x→걸림, 1).
    날글넣기(b, "\}\n").
    폴더만들기(라마영수증폴더()).
    잠그기().
    라마기록번호 += 1.
    정수 번호 = 라마기록번호.
    풀기().
    문자열 이름 = 짓기("%s-%lld", 시각도장(), 번호).
    바이트열파일쓰기(잇기3(라마영수증폴더(), 이름, ".json"), b).
    바이트열_해제(b).
    바이트열_해제(토큰들).
    받음j != 없음이면 { 잠그기(). 제놓기(받음j). 풀기(). }
    라마흐름놓기(흐).
    해제(x→보낸).
    해제(x→받은).
    해제(x→길).
    해제(x).
    반환 0.
}

(* GET /api/llama/receipts — 영수증 목록(이름 · 기록 때 · 모델 파일 · 빌드 · 프롬프트 · 생성 토큰 수) *)
[라마영수증목록]는 -> 바이트열 참조 {
    바이트열 참조 b = 바이트열_만들기().
    날글넣기(b, "\{\"receipts\":[").
    문자열목록 참조 l = 앱폴더목록(라마영수증폴더()).
    정수 몇 = 0.
    l != 없음이면 {
        반복 (정수 k는 0부터 문자열목록_길이(l) 전까지) {
            문자열 f = 문자열목록_값(l, k).
            정수 n = 글자수(f).
            (n > 5 그리고 문자열_같은가(f + n - 5, ".json"))이면 {
                제이슨 참조 영 = 제파일읽기(잇기(라마영수증폴더(), f)).
                영 != 없음이면 {
                    몇 > 0이면 { 날글넣기(b, ","). }
                    날글넣기(b, "\{").
                    문자열 이름 = 문자열_자르기(f, 0, n - 5).
                    제쌍글(b, "name", 이름). 날글넣기(b, ",").
                    제쌍글(b, "recorded", 제글보기(영, "recorded_at", "")). 날글넣기(b, ",").
                    제쌍글(b, "model", 파일이름(제글보기(제찾기(영, "model"), "path", ""))). 날글넣기(b, ",").
                    제쌍글(b, "build", 제글보기(제찾기(영, "engine"), "build_info", "")). 날글넣기(b, ",").
                    정수 프수 = 제개수(제찾기(영, "prompt_tokens")).
                    정수 생수 = 제개수(제찾기(제찾기(영, "response"), "tokens")).
                    라마영수증2인가(영)이면 {                      (* 31단계 — 토큰 없는 영수증: 응답의 수(채팅은 usage) *)
                        제이슨 참조 응2 = 제찾기(영, "response").
                        프수 = 제정수값(응2, "tokens_evaluated", 제정수값(제찾기(응2, "usage"), "prompt_tokens", 0)).
                        생수 = 제정수값(응2, "tokens_predicted", 제정수값(제찾기(응2, "usage"), "completion_tokens", 0)).
                        제쌍참(b, "tokenless", 참). 날글넣기(b, ",").
                    }
                    제쌍수(b, "prompt_tokens", 프수). 날글넣기(b, ",").
                    제쌍수(b, "tokens", 생수).
                    날글넣기(b, "\}").
                    몇 += 1.
                    잠그기(). 제놓기(영). 풀기().
                }
            }
        }
    }
    날글넣기(b, "]\}").
    반환 b.
}

(* 관리자의 GET — 다룬 길이면 참 *)
[이음 참조 c에 문자열 길을 문자열 물음을 라마가져오기]는 -> 참거짓 {
    문자열_같은가(길, "/api/llama/receipts")이면 {
        바이트열 참조 b = 라마영수증목록().
        웹제이슨(c, 200, b).
        바이트열_해제(b).
        반환 참.
    }
    문자열_같은가(길, "/api/llama/recorder")이면 {
        라마설정읽기().
        바이트열 참조 b2 = 라마설정제이슨().
        웹제이슨(c, 200, b2).
        바이트열_해제(b2).
        반환 참.
    }
    반환 거짓.
}

(* 관리자의 POST — 다룬 길이면 참 *)
[이음 참조 c에 문자열 길을 제이슨 참조 o를 라마보냄]는 -> 참거짓 {
    문자열_같은가(길, "/api/llama/verify")이면 {
        아닌 파일있음(잇기3(라마영수증폴더(), 제글보기(o, "receipt", ""), ".json"))이면 { 웹오류(c, 404, "영수증이 없습니다"). 반환 참. }
        일 참조 j = 일만들기("llama-verify", "llama.cpp 재현 검증").
        j == 없음이면 { 웹오류(c, 409, "다른 작업이 실행 중입니다 — 끝나거나 중지한 뒤 다시 시도하세요"). 반환 참. }
        바이트열 참조 b = 바이트열_만들기().
        파이썬쓰기(b, o, 0, 0).
        바이트열_넣기(b, 0).
        j→인자글 = 문자열_복제(바이트열_자료(b)).
        바이트열_해제(b).
        [공허 참조 -> 중간정수] 함수 = 라마검증일.
        일답(c, j, 함수 으로 공허 참조).
        반환 참.
    }
    문자열_같은가(길, "/api/llama/recorder")이면 {
        라마설정읽기().
        정수 포트 = 제정수값(o, "port", 라마포트).
        (포트 < 0 또는 포트 > 65535 또는 포트 == 웹포트)이면 { 웹오류(c, 400, "포트는 0(끔) … 65535, 앱의 포트가 아닌 것"). 반환 참. }
        라마포트 = 포트.
        라마명령줄 = 제글값(o, "args", 라마명령줄).
        (* 31단계 — 방식(transparent 기본 · probes) · 실행 파일, 저장할 때 빌드 · 모델을 맞춘다 *)
        문자열 방식 = 제글보기(o, "mode", "").
        방식[0] != 0이면 { 라마개입 = 문자열_같은가(방식, "probes"). }
        제찾기(o, "exe") != 없음이면 { 라마실행 != 없음이면 { 해제(라마실행). } 라마실행 = 제글값(o, "exe", ""). }
        문자열 경고 = 라마설정맞추기().
        폴더만들기(라마영수증폴더()).
        바이트열 참조 b2 = 라마설정제이슨().
        날글넣기(b2, "\n").
        바이트열파일쓰기(라마설정경로(), b2).
        바이트열_해제(b2).
        바이트열 참조 b3 = 라마설정제이슨().
        바이트열_길이(b3) > 0이면 { b3→길이 -= 1. }                   (* 닫는 } 를 떼고 경고를 더한다 *)
        날글넣기(b3, ",\"warnings\":").
        날글넣기(b3, 경고).
        날글넣기(b3, "\}").
        해제(경고).
        웹제이슨(c, 200, b3).
        바이트열_해제(b3).
        반환 참.
    }
    반환 거짓.
}
