(* 앱리디자인 C1(문서/명령줄.md) — GeulPU 의 하위 명령: 기능 목록(data/operations.json)에서 만든 CLI. 첫 인자가 '-' 로 시작하지 않으면
   시작하기가 여기로 온다. 떠 있는 앱(127.0.0.1)을 부르고 답을 표준 출력에 JSON 으로 낸다 — 앱을 새로 띄우지 않는다.
   종료 코드: 0 성공 · 1 기능 실패(HTTP 4xx · 5xx, 기다린 작업의 실패 · 취소) · 2 사용법 오류 · 3 앱에 닿지 못함.
   모든 요청에 X-GeulPU-Source: cli, 세션 이름이 있으면 X-GeulPU-Session — 앱의 이벤트(이벤트.gl)에 적힌다. *)

상수 정수 명령성공 = 0.
상수 정수 명령실패 = 1.
상수 정수 명령사용법 = 2.
상수 정수 명령앱없음 = 3.

정수 명령인자수 = 0.
정수 참조 명령인자이름들 = 없음.     (* 기능의 인자 — 이름 글 주소 *)
정수 참조 명령인자값들 = 없음.       (* 값 글 주소(0 = 값 없이 씀) *)
정수 참조 명령인자제글들 = 없음.     (* 기능 목록의 형으로 바꾼 JSON 글 주소 *)
문자열 명령까닭 = 없음.
문자열 명령고를것 = 없음.          (* F3-3 — --select 의 경로들(쉼표로 나눔) *)

(* ---- 출력 ---- *)

[바이트열 참조 b를 명령바이트출력]는 {
    바이트열_넣기(b, 0).
    알림(바이트열_자료(b)).
}

(* 내장 명령의 출력 — 파일이 있으면(--out) 그 파일에 쓰고 {"ok","file","bytes"}. --select 가 있으면 고른 값만(F3-3) *)
[바이트열 참조 b를 문자열 파일을 명령내기]는 -> 정수 {
    명령고를것 != 없음이면 {
        바이트열 참조 고른 = 명령고르기(바이트열_자료(b), 바이트열_길이(b)).
        고른 == 없음이면 { 반환 명령틀림("the answer is not JSON — --select needs a JSON answer", 0, 없음, "leave --select out", 명령실패). }
        정수 낸것 = 명령그대로내기(고른, 파일).
        바이트열_해제(고른).
        반환 낸것.
    }
    반환 명령그대로내기(b, 파일).
}

[바이트열 참조 b를 문자열 파일을 명령그대로내기]는 -> 정수 {
    파일 == 없음이면 {
        명령바이트출력(b).
        반환 명령성공.
    }
    아닌 파일쓰기(파일, 바이트열_자료(b), 바이트열_길이(b))이면 { 반환 명령틀림(잇기("cannot write ", 파일), 0, 없음, 없음, 명령실패). }
    바이트열 참조 o = 바이트열_만들기().
    날글넣기(o, "\{\"ok\":true,").
    제쌍글(o, "file", 파일).
    날글넣기(o, ",").
    제쌍수(o, "bytes", 바이트열_길이(b)).
    날글넣기(o, "\}").
    명령바이트출력(o).
    반환 명령성공.
}

(* {"error":{"message","status","op","next","exit"}} 를 내고 끝 코드를 돌려준다 *)
[문자열 말을 정수 상태를 문자열 기능id를 문자열 다음을 정수 끝코드를 명령틀림]는 -> 정수 {
    바이트열 참조 b = 바이트열_만들기().
    날글넣기(b, "\{\"error\":\{").
    제쌍글(b, "message", 말).
    상태 > 0이면 {
        날글넣기(b, ",").
        제쌍수(b, "status", 상태).
    }
    기능id != 없음이면 {
        날글넣기(b, ",").
        제쌍글(b, "op", 기능id).
    }
    다음 != 없음이면 {
        날글넣기(b, ",").
        제쌍글(b, "next", 다음).
    }
    날글넣기(b, ",").
    제쌍수(b, "exit", 끝코드).
    날글넣기(b, "\}\}").
    명령바이트출력(b).
    바이트열_해제(b).
    반환 끝코드.
}

(* 제이슨 나무를 JSON 글로 *)
[바이트열 참조 b에 제이슨 참조 m을 제나무쓰기]는 {
    m == 없음이면 {
        날글넣기(b, "null").
        반환.
    }
    m→종류 == 0이면 { 날글넣기(b, "null"). }
    아니면 m→종류 == 1이면 { 날글넣기(b, "false"). }
    아니면 m→종류 == 2이면 { 날글넣기(b, "true"). }
    아니면 m→종류 == 3이면 {
        m→정수인가이면 { 제수쓰기(b, m→정수값). } 아니면 { 파이썬실수쓰기(b, m→수). }
    }
    아니면 m→종류 == 4이면 { 제글쓰기(b, m→글, m→글길이). }
    아니면 m→종류 == 5이면 {
        날글넣기(b, "[").
        반복 (정수 k는 0부터 제개수(m) 전까지) {
            k > 0이면 { 날글넣기(b, ","). }
            제나무쓰기(b, 제자식(m, k)).
        }
        날글넣기(b, "]").
    }
    아니면 {
        날글넣기(b, "\{").
        반복 (정수 k2는 0부터 제개수(m) 전까지) {
            k2 > 0이면 { 날글넣기(b, ","). }
            제글넣기(b, 정수목록_값(m→열쇠들, k2) 으로 문자열).
            날글넣기(b, ":").
            제나무쓰기(b, 제자식(m, k2)).
        }
        날글넣기(b, "\}").
    }
}

(* ---- F3-3 — --select: 점으로 이은 경로 하나면 그 값, 쉼표로 나눈 여럿이면 경로 → 값의 객체. 없는 경로는 null, 배열은 0 부터의
   번호(명령 창의 command.js 의 selectPaths · selectValue 와 같음) ---- *)

(* 쉼표로 나눈 경로들 — 앞뒤 빈칸을 빼고, 빈 것과 겹친 것은 뺀다(새 문자열들) *)
[문자열 s를 명령고를경로들]는 -> 정수목록 참조 {
    정수목록 참조 l = 정수목록_만들기().
    정수 n = 글자수(s).
    정수 i = 0.
    (i <= n)동안 {
        정수 j = i.
        (j < n 그리고 (s[j] & 255) != 44)동안 { j += 1. }
        정수 a = i.
        정수 e = j.
        (a < e 그리고 ((s[a] & 255) == 32 또는 (s[a] & 255) == 9))동안 { a += 1. }
        (e > a 그리고 ((s[e - 1] & 255) == 32 또는 (s[e - 1] & 255) == 9))동안 { e -= 1. }
        e > a이면 {
            문자열 p = 문자열_자르기(s, a, e - a).
            참거짓 겹침 = 거짓.
            반복 (정수 k는 0부터 정수목록_길이(l) 전까지) {
                문자열_같은가(정수목록_값(l, k) 으로 문자열, p)이면 { 겹침 = 참. }
            }
            겹침이면 { 해제(p). } 아니면 { 정수목록_추가(l, p 으로 정수). }
        }
        i = j + 1.
    }
    반환 l.
}

[정수목록 참조 l을 명령경로들놓기]는 {
    반복 (정수 k는 0부터 정수목록_길이(l) 전까지) { 해제(정수목록_값(l, k) 으로 문자열). }
    정수목록_해제(l).
}

(* 마디 m 에서 점으로 이은 경로의 값 — 객체는 키, 배열은 0 부터의 번호(숫자 18 개까지). 없으면 없음 *)
[제이슨 참조 m에서 문자열 경로를 명령경로값]는 -> 제이슨 참조 {
    제이슨 참조 x = m.
    정수 n = 글자수(경로).
    정수 i = 0.
    (x != 없음 그리고 i <= n)동안 {
        정수 j = i.
        (j < n 그리고 (경로[j] & 255) != 46)동안 { j += 1. }
        문자열 키 = 문자열_자르기(경로, i, j - i).
        x→종류 == 6이면 { x = 제찾기(x, 키). }
        아니면 x→종류 == 5이면 {
            참거짓 숫자 = j > i 그리고 j - i <= 18.
            반복 (정수 q = 0: 키[q] != 0: q += 1) {
                ((키[q] & 255) < 48 또는 (키[q] & 255) > 57)이면 { 숫자 = 거짓. }
            }
            정수 번호 = -1.
            숫자이면 { 번호 = 정수로_변환(키). }
            (번호 >= 0 그리고 번호 < 제개수(x))이면 { x = 제자식(x, 번호). } 아니면 { x = 없음. }
        }
        아니면 { x = 없음. }
        해제(키).
        i = j + 1.
    }
    반환 x.
}

(* 답(JSON 글)에서 --select 로 고른 값의 JSON — 답이 JSON 이 아니면 없음 *)
[문자열 몸을 정수 길이를 명령고르기]는 -> 바이트열 참조 {
    제이슨 참조 m = 제풀기(몸, 길이).
    m == 없음이면 { 반환 없음. }
    정수목록 참조 ps = 명령고를경로들(명령고를것).
    바이트열 참조 b = 바이트열_만들기().
    정수목록_길이(ps) == 1이면 { 제나무쓰기(b, 명령경로값(m, 정수목록_값(ps, 0) 으로 문자열)). }
    아니면 {
        날글넣기(b, "\{").
        반복 (정수 k는 0부터 정수목록_길이(ps) 전까지) {
            k > 0이면 { 날글넣기(b, ","). }
            제글넣기(b, 정수목록_값(ps, k) 으로 문자열).
            날글넣기(b, ":").
            제나무쓰기(b, 명령경로값(m, 정수목록_값(ps, k) 으로 문자열)).
        }
        날글넣기(b, "\}").
    }
    명령경로들놓기(ps).
    잠그기().
    제놓기(m).
    풀기().
    반환 b.
}

(* 경로 · id 의 마지막 폴더 이름을 ASCII 소문자로(끝의 / · \ · 빈칸은 뺀다) — 새 문자열 *)
[문자열 s를 명령끝이름]는 -> 문자열 {
    정수 n = 글자수(s).
    (n > 0 그리고 ((s[n - 1] & 255) == 47 또는 (s[n - 1] & 255) == 92 또는 (s[n - 1] & 255) == 32))동안 { n -= 1. }
    정수 a = n.
    (a > 0 그리고 (s[a - 1] & 255) != 47 그리고 (s[a - 1] & 255) != 92)동안 { a -= 1. }
    문자열 r = 문자열_자르기(s, a, n - a).
    반복 (정수 i = 0: r[i] != 0: i += 1) {
        ((r[i] & 255) >= 65 그리고 (r[i] & 255) <= 90)이면 { r[i] = (r[i] & 255) + 32. }
    }
    반환 r.
}

[정수 v를 십육글자]는 -> 정수 {
    v < 10이면 { 반환 48 + v. }
    반환 55 + v.
}

(* 쿼리 문자열의 값 — [A-Za-z0-9-._~] 밖은 %XX *)
[바이트열 참조 b에 문자열 s를 퍼센트쓰기]는 {
    반복 (정수 k = 0: s[k] != 0: k += 1) {
        정수 c = s[k] & 255.
        참거짓 그대로 = (c >= 48 그리고 c <= 57) 또는 (c >= 65 그리고 c <= 90) 또는 (c >= 97 그리고 c <= 122) 또는 c == 45 또는 c == 46 또는 c == 95 또는 c == 126.
        그대로이면 { 바이트열_넣기(b, c). }
        아니면 {
            바이트열_넣기(b, 37).
            바이트열_넣기(b, 십육글자(c >> 4)).
            바이트열_넣기(b, 십육글자(c & 15)).
        }
    }
}

(* ---- 기능 목록 ---- *)

(* 기능 하나의 명령 이름(cli.en · cli.ko) 또는 id 가 글과 같은가 *)
[제이슨 참조 o를 문자열 명령글을 명령이름같은가]는 -> 참거짓 {
    제이슨 참조 c = 제찾기(o, "cli").
    문자열_같은가(제글보기(o, "id", ""), 명령글)이면 { 반환 참. }
    문자열_같은가(제글보기(c, "en", ""), 명령글)이면 { 반환 참. }
    반환 문자열_같은가(제글보기(c, "ko", ""), 명령글).
}

[제이슨 참조 o를 명령으로부름]는 -> 참거짓 {
    반환 문자열_같은가(제글보기(o, "status", ""), "exists") 그리고 아닌 제참값(o, "internal", 거짓).
}

(* 기능의 인자 하나(없으면 없음) *)
[제이슨 참조 o에서 문자열 이름을 명령인자찾기]는 -> 제이슨 참조 {
    제이슨 참조 ps = 제찾기(o, "params").
    반복 (정수 k는 0부터 제개수(ps) 전까지) {
        제이슨 참조 p = 제자식(ps, k).
        문자열_같은가(제글보기(p, "name", ""), 이름)이면 { 반환 p. }
    }
    반환 없음.
}

(* 기능 하나를 CLI 의 모양으로: id · cli · title · description · method · path · job · result · params *)
[바이트열 참조 b에 제이슨 참조 o를 참거짓 자세히를 명령기능쓰기]는 {
    제이슨 참조 h = 제찾기(o, "http").
    날글넣기(b, "\{").
    제쌍글(b, "id", 제글보기(o, "id", "")).
    날글넣기(b, ",\"cli\":").
    제나무쓰기(b, 제찾기(o, "cli")).
    날글넣기(b, ",\"title\":").
    제나무쓰기(b, 제찾기(o, "title")).
    자세히이면 {
        날글넣기(b, ",\"description\":").
        제나무쓰기(b, 제찾기(o, "description")).
    }
    날글넣기(b, ",").
    제쌍글(b, "method", 제글보기(h, "method", "")).
    날글넣기(b, ",").
    제쌍글(b, "path", 제글보기(h, "path", "")).
    날글넣기(b, ",").
    제쌍참(b, "job", 제참값(o, "job", 거짓)).
    날글넣기(b, ",").
    제쌍글(b, "result", 제글보기(o, "result", "")).
    날글넣기(b, ",\"params\":").
    제나무쓰기(b, 제찾기(o, "params")).
    자세히이면 {
        (* 쓰는 법 한 줄 — 필수 인자는 그대로, 나머지는 [ ] *)
        바이트열 참조 u = 바이트열_만들기().
        날글넣기(u, "GeulPU ").
        날글넣기(u, 제글보기(제찾기(o, "cli"), "en", "")).
        제이슨 참조 ps = 제찾기(o, "params").
        반복 (정수 k는 0부터 제개수(ps) 전까지) {
            제이슨 참조 p = 제자식(ps, k).
            참거짓 필수 = 제참값(p, "required", 거짓).
            날글넣기(u, " ").
            아닌 필수이면 { 날글넣기(u, "["). }
            날글넣기(u, "--").
            날글넣기(u, 제글보기(p, "name", "")).
            아닌 문자열_같은가(제글보기(p, "type", ""), "boolean")이면 {
                날글넣기(u, " <").
                날글넣기(u, 제글보기(p, "type", "")).
                날글넣기(u, ">").
            }
            아닌 필수이면 { 날글넣기(u, "]"). }
        }
        제이슨 참조 h2 = 제찾기(o, "http").
        문자열_같은가(제글보기(h2, "method", ""), "POST")이면 { 날글넣기(u, " [--json <body>|@<file>]"). }
        제참값(o, "job", 거짓)이면 { 날글넣기(u, " [--wait]"). }
        문자열_같은가(제글보기(h2, "method", ""), "POST")이면 { 날글넣기(u, " [--experiment <folder|id>]"). }       (* C3 — 사용성 시험: 안내에만 있었다 *)
        바이트열_넣기(u, 0).
        날글넣기(b, ",").
        제쌍글(b, "usage", 바이트열_자료(u)).
        바이트열_해제(u).
    }
    날글넣기(b, "\}").
}

(* ---- 인자 ---- *)

(* 값 하나를 기능 목록의 형으로 JSON 글에 — 틀리면 없음(까닭은 명령까닭) *)
[문자열 인자형을 문자열 값을 인자값글]는 -> 문자열 {
    문자열_같은가(인자형, "boolean")이면 {
        값 == 없음이면 { 반환 "true". }
        (문자열_같은가(값, "true") 또는 문자열_같은가(값, "1") 또는 문자열_같은가(값, "yes"))이면 { 반환 "true". }
        (문자열_같은가(값, "false") 또는 문자열_같은가(값, "0") 또는 문자열_같은가(값, "no"))이면 { 반환 "false". }
        명령까닭 = "needs true or false".
        반환 없음.
    }
    값 == 없음이면 {
        명령까닭 = 잇기3("needs a value (", 인자형, ")").
        반환 없음.
    }
    문자열_같은가(인자형, "string")이면 {
        바이트열 참조 b = 바이트열_만들기().
        제글넣기(b, 값).
        바이트열_넣기(b, 0).
        문자열 r = 문자열_복제(바이트열_자료(b)).
        바이트열_해제(b).
        반환 r.
    }
    (* integer · number · array · object — JSON 으로 읽어 형을 본다 *)
    제이슨 참조 m = 제풀기(값, 글자수(값)).
    참거짓 맞음 = 거짓.
    m != 없음이면 {
        문자열_같은가(인자형, "integer")이면 { 맞음 = m→종류 == 3 그리고 m→정수인가. }
        아니면 문자열_같은가(인자형, "number")이면 { 맞음 = m→종류 == 3. }
        아니면 문자열_같은가(인자형, "array")이면 { 맞음 = m→종류 == 5. }
        아니면 문자열_같은가(인자형, "object")이면 { 맞음 = m→종류 == 6. }
        아니면 { 맞음 = 참. }
        잠그기().
        제놓기(m).
        풀기().
    }
    아닌 맞음이면 {
        명령까닭 = 잇기3("needs ", 인자형, " (JSON)").
        반환 없음.
    }
    반환 값.
}

[문자열 s를 점자리]는 -> 정수 {
    반복 (정수 k = 0: s[k] != 0: k += 1) {
        (s[k] & 255) == 46이면 { 반환 k. }
    }
    반환 -1.
}

(* 인자들을 JSON 객체로 — 점이 든 이름은 안쪽 객체(geulpu.step_offset → {"geulpu":{"step_offset":…}}). 앞 = 이 객체의 앞이름 *)
[바이트열 참조 b에 문자열 앞을 몸객체쓰기]는 {
    날글넣기(b, "\{").
    정수 앞길이 = 글자수(앞).
    참거짓 첫 = 참.
    반복 (정수 i는 0부터 명령인자수 전까지) {
        문자열 이름 = 명령인자이름들[i] 으로 문자열.
        문자열_시작하는가(이름, 앞 로)이면 {
            문자열 나머지 = 이름 + 앞길이.
            정수 점 = 점자리(나머지).
            점 < 0이면 {
                아닌 첫이면 { 날글넣기(b, ","). }
                첫 = 거짓.
                제글넣기(b, 나머지).
                날글넣기(b, ":").
                날글넣기(b, 명령인자제글들[i] 으로 문자열).
            }
            아니면 {
                문자열 마디 = 문자열_자르기(나머지, 0, 점).
                문자열 새앞 = 잇기3(앞, 마디, ".").
                참거짓 쓴것 = 거짓.
                반복 (정수 j는 0부터 i 전까지) {
                    문자열_시작하는가(명령인자이름들[j] 으로 문자열, 새앞 로)이면 { 쓴것 = 참. }
                }
                아닌 쓴것이면 {
                    아닌 첫이면 { 날글넣기(b, ","). }
                    첫 = 거짓.
                    제글넣기(b, 마디).
                    날글넣기(b, ":").
                    몸객체쓰기(b, 새앞).
                }
            }
        }
    }
    날글넣기(b, "\}").
}

(* ---- 보내기 ---- *)

[문자열 세션을 명령머리]는 -> 문자열 {
    세션 == 없음이면 { 반환 "X-GeulPU-Source: cli\r\n". }
    반환 잇기3("X-GeulPU-Source: cli\r\nX-GeulPU-Session: ", 세션, "\r\n").
}

(* 앱의 오류 답에서 message(없으면 몸 그대로) *)
[위답 참조 r를 명령답까닭]는 -> 문자열 {
    제이슨 참조 o = 제풀기(r→몸, r→몸길이).
    문자열 말 = 없음.
    o != 없음이면 {
        제이슨 참조 e = 제찾기(o, "error").
        e != 없음 그리고 e→종류 == 6이면 { 말 = 제글값(e, "message", 없음). }
        아니면 e != 없음 그리고 e→종류 == 4이면 { 말 = 문자열_복제(e→글). }
        잠그기().
        제놓기(o).
        풀기().
    }
    말 == 없음이면 { 말 = 문자열_복제(r→몸). }
    반환 말.
}

(* 오류 답의 다음에 할 일 *)
[정수 상태를 문자열 말을 문자열 명령이름을 명령다음]는 -> 문자열 {
    (상태 == 503 그리고 문자열_찾기(말 에서, "불러온 모델") != 없음)이면 {
        반환 "load a model first: GeulPU model load --model <id> --wait (models: GeulPU system state)".
    }
    (상태 == 409 그리고 문자열_찾기(말 에서, "다른 작업") != 없음)이면 {
        반환 "another job is running: wait for it (GeulPU system state) or cancel it (GeulPU job cancel)".
    }
    (* 앱리디자인 E3 — 다른 409(이미 있는 실험 · 첫 실행 뒤의 계획 고치기)는 작업과 상관없다 — 까닭(message)을 읽고 명령의 도움말로 *)
    (상태 == 400 또는 상태 == 404 또는 상태 == 409)이면 { 반환 잇기("check the parameters: GeulPU help ", 명령이름). }
    반환 잇기("GeulPU help ", 명령이름).
}

(* 작업이 끝나기를 기다린다 — /api/state 의 job 이 그 번호이고 running 이 아니면 그 JSON 을 낸다 *)
(* 작업이 끝날 때까지 /api/state 를 본다. 내보낼곳(--out)이 있으면 끝난 작업의 JSON 을 그 파일에 쓴다(F2 — 전에는 --out 이 먼저 돌아 기다리지 않았다) *)
[정수 포트를 문자열 요청머리를 정수 번호를 문자열 내보낼곳을 명령기다리기]는 -> 정수 {
    (참)동안 {
        위답 참조 r = 위묻기덧("GET", 포트, "/api/state", 없음, 요청머리, 60).
        r == 없음이면 { 반환 명령틀림("the GeulPU app stopped answering while waiting for the job", 0, 없음, "start it again: GeulPU --no-open", 명령앱없음). }
        제이슨 참조 o = 제풀기(r→몸, r→몸길이).
        제이슨 참조 j = 제찾기(o, "job").
        정수 id = 제정수값(j, "id", -1).
        문자열 상태글 = 제글보기(j, "state", "").
        (id == 번호 그리고 아닌 문자열_같은가(상태글, "running"))이면 {
            바이트열 참조 b = 바이트열_만들기().
            날글넣기(b, "\{\"job\":").
            제나무쓰기(b, j).
            날글넣기(b, "\}").
            참거짓 됨 = 문자열_같은가(상태글, "done").
            잠그기().
            제놓기(o).
            풀기().
            위답놓기(r).
            정수 낸것 = 명령내기(b, 내보낼곳).
            바이트열_해제(b).
            낸것 != 명령성공이면 { 반환 낸것. }
            됨이면 { 반환 명령성공. }
            반환 명령실패.
        }
        id > 번호이면 {
            잠그기().
            제놓기(o).
            풀기().
            위답놓기(r).
            반환 명령틀림(짓기("job %lld was replaced by job %lld before it could be read", 번호, id), 0, 없음, "GeulPU job log", 명령실패).
        }
        잠그기().
        제놓기(o).
        풀기().
        위답놓기(r).
        잠자기(500).
    }
    반환 명령실패.
}

(* ---- 하위 명령 ---- *)

[정수 argc를 문자열 참조 argv를 명령줄돌리기]는 -> 정수 {
    앱폴더 = 실행폴더찾기().
    소켓준비().                     (* 윈도의 WSAStartup — 앱 모드는 웹준비가 부른다 *)
    (* 1. 명령 낱말 — 첫 '--' 앞 *)
    바이트열 참조 낱말 = 바이트열_만들기().
    정수 k = 1.
    (k < argc 그리고 아닌 문자열_시작하는가(argv[k], "--" 로))동안 {
        k > 1이면 { 바이트열_넣기(낱말, 32). }
        날글넣기(낱말, argv[k]).
        k += 1.
    }
    바이트열_넣기(낱말, 0).
    문자열 명령글 = 문자열_복제(바이트열_자료(낱말)).
    바이트열_해제(낱말).

    (* 2. 기능 목록 *)
    제이슨 참조 표나무 = 제파일읽기(데이터경로("operations.json")).
    제이슨 참조 기능들 = 제찾기(표나무, "operations").
    기능들 == 없음이면 { 반환 명령틀림(잇기("cannot read the operation registry: ", 데이터경로("operations.json")), 0, 없음, "reinstall GeulPU — the file comes with the app", 명령사용법). }

    (* 3. 내장 명령 — ops · help · guide. C3 — 이것들도 --out 을 따른다(사용성 시험에서 ops --out 이 파일을 쓰지 않았다) *)
    문자열 내장파일 = 없음.
    반복 (정수 a1 = 1: a1 < argc: a1 += 1) {
        (문자열_같은가(argv[a1], "--out") 그리고 a1 + 1 < argc)이면 { 내장파일 = argv[a1 + 1]. }
        아니면 문자열_시작하는가(argv[a1], "--out=" 로)이면 { 내장파일 = argv[a1] + 6. }
        아니면 (문자열_같은가(argv[a1], "--select") 그리고 a1 + 1 < argc)이면 { 명령고를것 = argv[a1 + 1]. }       (* F3-3 — ops · help 의 JSON 도 *)
        아니면 문자열_시작하는가(argv[a1], "--select=" 로)이면 { 명령고를것 = argv[a1] + 9. }
    }
    (문자열_같은가(명령글, "ops") 또는 문자열_같은가(명령글, "기능 목록"))이면 {
        바이트열 참조 b = 바이트열_만들기().
        날글넣기(b, "\{\"format\":\"geulpu-cli/1\",").
        제쌍글(b, "version", 앱판).
        날글넣기(b, ",\"usage\":\"GeulPU <command> [--<param> <value> ...] [--json <body>|@<file>] [--wait] [--experiment <folder|id>] [--out <file>] [--select <path>[,<path>...]] [--app-port <port>] [--session <name>] [--timeout <s>] [--dry-run]\",\"commands\":[").
        참거짓 첫 = 참.
        반복 (정수 i는 0부터 제개수(기능들) 전까지) {
            제이슨 참조 o = 제자식(기능들, i).
            명령으로부름(o)이면 {
                아닌 첫이면 { 날글넣기(b, ","). }
                첫 = 거짓.
                명령기능쓰기(b, o, 거짓).
            }
        }
        날글넣기(b, "]\}").
        반환 명령내기(b, 내장파일).
    }
    (* C3 — 안내 한 쪽(docs/cli.md 의 사본 data/cli-guide.md)을 그대로 — 터미널만 가진 AI 도 읽게 *)
    (문자열_같은가(명령글, "guide") 또는 문자열_같은가(명령글, "안내"))이면 {
        문자열 안내글 = 글파일읽기(데이터경로("cli-guide.md")).
        안내글 == 없음이면 { 반환 명령틀림(잇기("cannot read the guide: ", 데이터경로("cli-guide.md")), 0, 없음, "reinstall GeulPU — the file comes with the app; it is docs/cli.md in the repository", 명령사용법). }
        바이트열 참조 gb = 바이트열_만들기().
        날글넣기(gb, 안내글).
        명령고를것 = 없음.
        반환 명령내기(gb, 내장파일).
    }
    참거짓 도움 = 문자열_같은가(명령글, "help") 또는 문자열_같은가(명령글, "도움말").
    (문자열_시작하는가(명령글, "help " 로) 또는 문자열_시작하는가(명령글, "도움말 " 로))이면 {
        도움 = 참.
        정수 띄움 = 0.
        (명령글[띄움] != 0 그리고 (명령글[띄움] & 255) != 32)동안 { 띄움 += 1. }
        명령글 = 명령글 + 띄움 + 1.
        문자열_같은가(명령글, "")이면 { 명령글 = "help". }
    }
    (도움 그리고 (문자열_같은가(명령글, "help") 또는 문자열_같은가(명령글, "도움말")))이면 {
        바이트열 참조 hb = 바이트열_만들기().
        날글넣기(hb, "\{\"usage\":\"GeulPU <command> [--<param> <value> ...] [--json <body>|@<file>] [--wait] [--experiment <folder|id>] [--out <file>] [--select <path>[,<path>...]] [--app-port <port>] [--session <name>] [--timeout <s>] [--dry-run]\",\"commands\":\"GeulPU ops lists every command with its parameters (JSON)\",\"help\":\"GeulPU help <command>\",\"names\":\"a command is its English name (run branch), its Korean name (실행 분기) or its id (run.branch)\",\"exit\":\{\"0\":\"ok\",\"1\":\"the operation failed\",\"2\":\"usage error\",\"3\":\"the GeulPU app is not reachable\"\},\"guide\":\"GeulPU guide prints a one-page guide for agents\"\}").
        반환 명령내기(hb, 내장파일).
    }

    (* 4. 기능 찾기 *)
    제이슨 참조 기능 = 없음.
    반복 (정수 i2는 0부터 제개수(기능들) 전까지) {
        제이슨 참조 o2 = 제자식(기능들, i2).
        (기능 == 없음 그리고 명령이름같은가(o2, 명령글))이면 { 기능 = o2. }
    }
    기능 == 없음이면 {
        (* 비슷한 명령 — 첫 낱말이 같은 것 *)
        정수 사이 = 0.
        (명령글[사이] != 0 그리고 (명령글[사이] & 255) != 32)동안 { 사이 += 1. }
        문자열 첫낱말 = 문자열_자르기(명령글, 0, 사이).
        바이트열 참조 비슷 = 바이트열_만들기().
        정수 수 = 0.
        반복 (정수 i3는 0부터 제개수(기능들) 전까지) {
            제이슨 참조 o3 = 제자식(기능들, i3).
            제이슨 참조 c3 = 제찾기(o3, "cli").
            (명령으로부름(o3) 그리고 수 < 12 그리고 (문자열_시작하는가(제글보기(c3, "en", ""), 첫낱말 로) 또는 문자열_시작하는가(제글보기(c3, "ko", ""), 첫낱말 로)))이면 {
                수 > 0이면 { 날글넣기(비슷, " · "). }
                날글넣기(비슷, 제글보기(c3, "en", "")).
                수 += 1.
            }
        }
        바이트열_넣기(비슷, 0).
        문자열 다음 = "GeulPU ops lists every command".
        수 > 0이면 { 다음 = 잇기3(다음, " — similar: ", 바이트열_자료(비슷)). }
        반환 명령틀림(잇기("unknown command: ", 명령글), 0, 없음, 다음, 명령사용법).
    }
    문자열 기능id = 제글보기(기능, "id", "").
    문자열 명령이름 = 제글보기(제찾기(기능, "cli"), "en", 기능id).
    아닌 명령으로부름(기능)이면 {
        제참값(기능, "internal", 거짓)이면 { 반환 명령틀림(잇기(기능id, " is internal to the app, not a command"), 0, 기능id, "GeulPU ops lists every command", 명령사용법). }
        반환 명령틀림(잇기(기능id, " is planned, not available yet"), 0, 기능id, "GeulPU ops lists every command", 명령사용법).
    }
    도움이면 {
        바이트열 참조 b2 = 바이트열_만들기().
        명령기능쓰기(b2, 기능, 참).
        반환 명령내기(b2, 내장파일).
    }

    (* 5. 옵션 — 기능의 인자와 CLI 의 옵션. 기능에 같은 이름의 인자가 있으면(replay recorder set 의 port · system events 의 wait) 기능의 인자다 *)
    정수 포트 = 44544.
    문자열 포트글 = 환경변수("GEULPU_PORT").
    (포트글 != 없음 그리고 글자수(포트글) > 0)이면 { 포트 = 정수로_변환(포트글). }
    문자열 세션 = 환경변수("GEULPU_SESSION").
    (세션 != 없음 그리고 글자수(세션) == 0)이면 { 세션 = 없음. }
    정수 초 = 3600.
    참거짓 기다림 = 거짓.
    참거짓 해보기 = 거짓.
    문자열 본문 = 없음.
    문자열 내보낼파일 = 없음.
    문자열 실험값 = 환경변수("GEULPU_EXPERIMENT").            (* C2 — 명령 기록의 실험(경로 또는 id) *)
    (실험값 != 없음 그리고 글자수(실험값) == 0)이면 { 실험값 = 없음. }
    참거짓 실험환경 = 실험값 != 없음.                          (* F3-3 — 환경 변수에서 온 실험(--experiment 를 주면 거짓) *)
    문자열 명령경로 = 없음.                                    (* F3-3 — 명령의 path(실험 명령이 가리키는 실험) *)
    명령인자수 = 0.
    명령인자이름들 = 초기할당(argc + 1 을, 8).
    명령인자값들 = 초기할당(argc + 1 을, 8).
    명령인자제글들 = 초기할당(argc + 1 을, 8).
    (k < argc)동안 {
        문자열 a = argv[k].
        아닌 문자열_시작하는가(a, "--" 로)이면 { 반환 명령틀림(잇기3("the value '", a, "' does not follow a --parameter"), 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
        문자열 이름 = a + 2.
        문자열 값 = 없음.
        정수 같음자리 = -1.
        반복 (정수 q = 0: 이름[q] != 0: q += 1) {
            (같음자리 < 0 그리고 (이름[q] & 255) == 61)이면 { 같음자리 = q. }
        }
        같음자리 >= 0이면 {
            값 = 이름 + 같음자리 + 1.
            이름 = 문자열_자르기(이름, 0, 같음자리).
        }
        제이슨 참조 p = 명령인자찾기(기능, 이름).
        참거짓 값받음 = 거짓.
        (같음자리 < 0 그리고 k + 1 < argc)이면 { 값받음 = 아닌 문자열_시작하는가(argv[k + 1], "--" 로). }
        (p != 없음 그리고 문자열_같은가(제글보기(p, "type", ""), "boolean") 그리고 값받음)이면 {
            (* 값 없이 쓴 boolean 다음의 낱말은 그 값이 true · false 일 때만 가져간다 *)
            문자열 다음낱말 = argv[k + 1].
            값받음 = 문자열_같은가(다음낱말, "true") 또는 문자열_같은가(다음낱말, "false") 또는 문자열_같은가(다음낱말, "1") 또는 문자열_같은가(다음낱말, "0") 또는 문자열_같은가(다음낱말, "yes") 또는 문자열_같은가(다음낱말, "no").
        }
        참거짓 다룸 = 거짓.
        p == 없음이면 {
            다룸 = 참.
            (문자열_같은가(이름, "wait") 또는 문자열_같은가(이름, "기다림"))이면 { 기다림 = 참. }
            아니면 (문자열_같은가(이름, "dry-run"))이면 { 해보기 = 참. }
            아니면 (문자열_같은가(이름, "port") 또는 문자열_같은가(이름, "app-port") 또는 문자열_같은가(이름, "포트") 또는 문자열_같은가(이름, "session") 또는 문자열_같은가(이름, "세션") 또는 문자열_같은가(이름, "timeout") 또는 문자열_같은가(이름, "json") 또는 문자열_같은가(이름, "out") 또는 문자열_같은가(이름, "experiment") 또는 문자열_같은가(이름, "실험") 또는 문자열_같은가(이름, "select"))이면 {
                값 == 없음 그리고 값받음이면 {
                    값 = argv[k + 1].
                    k += 1.
                }
                값 == 없음이면 { 반환 명령틀림(잇기3("--", 이름, " needs a value"), 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
                (문자열_같은가(이름, "port") 또는 문자열_같은가(이름, "app-port") 또는 문자열_같은가(이름, "포트"))이면 { 포트 = 정수로_변환(값). }
                아니면 (문자열_같은가(이름, "session") 또는 문자열_같은가(이름, "세션"))이면 { 세션 = 값. }
                아니면 문자열_같은가(이름, "timeout")이면 { 초 = 정수로_변환(값). }
                아니면 문자열_같은가(이름, "json")이면 { 본문 = 값. }
                아니면 (문자열_같은가(이름, "experiment") 또는 문자열_같은가(이름, "실험"))이면 {
                    실험값 = 값.
                    실험환경 = 거짓.
                }
                아니면 문자열_같은가(이름, "select")이면 {
                    정수목록 참조 ps0 = 명령고를경로들(값).
                    정수 경로수 = 정수목록_길이(ps0).
                    명령경로들놓기(ps0).
                    경로수 == 0이면 { 반환 명령틀림(잇기3("--", 이름, " needs a value"), 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
                    명령고를것 = 값.
                }
                아니면 { 내보낼파일 = 값. }
            }
            아니면 { 다룸 = 거짓. }
        }
        아닌 다룸이면 {
            p == 없음이면 {
                바이트열 참조 이름들 = 바이트열_만들기().
                제이슨 참조 ps = 제찾기(기능, "params").
                반복 (정수 i4는 0부터 제개수(ps) 전까지) {
                    i4 > 0이면 { 날글넣기(이름들, ", "). }
                    날글넣기(이름들, 제글보기(제자식(ps, i4), "name", "")).
                }
                바이트열_넣기(이름들, 0).
                문자열 다음2 = 잇기("pass fields the registry does not list with --json; parameters of this command: ", 바이트열_자료(이름들)).
                제개수(ps) == 0이면 { 다음2 = "this command takes no parameters". }
                반환 명령틀림(짓기("unknown parameter --%s for %s", 이름, 명령이름), 0, 기능id, 다음2, 명령사용법).
            }
            값 == 없음 그리고 값받음이면 {
                값 = argv[k + 1].
                k += 1.
            }
            반복 (정수 i5는 0부터 명령인자수 전까지) {
                문자열_같은가(명령인자이름들[i5] 으로 문자열, 이름)이면 { 반환 명령틀림(짓기("--%s is given twice", 이름), 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
            }
            문자열 값제글 = 인자값글(제글보기(p, "type", "string"), 값).
            값제글 == 없음이면 { 반환 명령틀림(짓기("--%s %s", 이름, 명령까닭), 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
            명령인자이름들[명령인자수] = 이름 으로 정수.
            명령인자값들[명령인자수] = 값 으로 정수.
            명령인자제글들[명령인자수] = 값제글 으로 정수.
            명령인자수 += 1.
        }
        k += 1.
    }
    (세션 != 없음 그리고 글자수(세션) == 0)이면 { 세션 = 없음. }

    (* 6. 요청 *)
    제이슨 참조 h = 제찾기(기능, "http").
    문자열 방법 = 제글보기(h, "method", "GET").
    문자열 길 = 제글보기(h, "path", "/").
    참거짓 보냄 = 문자열_같은가(방법, "POST").
    바이트열 참조 몸글 = 없음.
    본문 != 없음이면 {
        아닌 보냄이면 { 반환 명령틀림(잇기(명령이름, " is a GET command — it takes no --json body"), 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
        명령인자수 > 0이면 { 반환 명령틀림("--json gives the whole body — do not add other parameters to it", 0, 기능id, "put every field into the --json body", 명령사용법). }
        (본문[0] & 255) == 64이면 {                                 (* @파일 *)
            정수 파일길이 = 0.
            문자열 파일글 = 파일읽기(본문 + 1, &파일길이).
            파일글 == 없음이면 { 반환 명령틀림(잇기("cannot read the --json file ", 본문 + 1), 0, 기능id, 없음, 명령사용법). }
            본문 = 파일글.
            (파일길이 >= 3 그리고 (본문[0] & 255) == 239 그리고 (본문[1] & 255) == 187 그리고 (본문[2] & 255) == 191)이면 { 본문 = 본문 + 3. }
        }
        제이슨 참조 bo = 제풀기(본문, 글자수(본문)).
        (* F2 — 문법이 틀린 JSON 을 '객체가 아님'으로 알리지 않는다(명령 창의 command.js 와 같은 말) *)
        bo == 없음이면 { 반환 명령틀림("--json is not valid JSON", 0, 기능id, "check the JSON: quotes, commas and brackets", 명령사용법). }
        bo→종류 != 6이면 { 반환 명령틀림("--json must be a JSON object", 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
        명령경로 = 문자열_복제(제글보기(bo, "path", "")).
        참거짓 흐름 = 제참값(bo, "stream", 거짓).
        잠그기().
        제놓기(bo).
        풀기().
        흐름이면 { 반환 명령틀림("the CLI prints whole answers — leave stream off", 0, 기능id, 없음, 명령사용법). }
        몸글 = 바이트열_만들기().
        날글넣기(몸글, 본문).
    }
    아니면 {
        반복 (정수 i0는 0부터 명령인자수 전까지) {
            (문자열_같은가(명령인자이름들[i0] 으로 문자열, "path") 그리고 명령인자값들[i0] != 0)이면 { 명령경로 = 명령인자값들[i0] 으로 문자열. }
        }
        (* 필수 인자 *)
        제이슨 참조 ps2 = 제찾기(기능, "params").
        반복 (정수 i6는 0부터 제개수(ps2) 전까지) {
            제이슨 참조 p2 = 제자식(ps2, i6).
            제참값(p2, "required", 거짓)이면 {
                참거짓 있음 = 거짓.
                반복 (정수 i7는 0부터 명령인자수 전까지) {
                    문자열_같은가(명령인자이름들[i7] 으로 문자열, 제글보기(p2, "name", ""))이면 { 있음 = 참. }
                }
                아닌 있음이면 { 반환 명령틀림(짓기("--%s is required", 제글보기(p2, "name", "")), 0, 기능id, 잇기("GeulPU help ", 명령이름), 명령사용법). }
            }
        }
        (* 같은 이름이 값과 안쪽 객체로 함께 오면(--geulpu.layer_lens 와 --geulpu.layer_lens.top_k) 못 만든다 *)
        반복 (정수 i8는 0부터 명령인자수 전까지) {
            문자열 앞이름 = 잇기(명령인자이름들[i8] 으로 문자열, ".").
            반복 (정수 i9는 0부터 명령인자수 전까지) {
                문자열_시작하는가(명령인자이름들[i9] 으로 문자열, 앞이름 로)이면 {
                    반환 명령틀림(짓기("--%s and --%s cannot both be given", 명령인자이름들[i8] 으로 문자열, 명령인자이름들[i9] 으로 문자열), 0, 기능id, "give the inner fields only, or the whole value with --json", 명령사용법).
                }
            }
        }
        반복 (정수 i10는 0부터 명령인자수 전까지) {
            (문자열_같은가(명령인자이름들[i10] 으로 문자열, "stream") 그리고 문자열_같은가(명령인자제글들[i10] 으로 문자열, "true"))이면 { 반환 명령틀림("the CLI prints whole answers — leave stream off", 0, 기능id, 없음, 명령사용법). }
        }
        보냄이면 {
            몸글 = 바이트열_만들기().
            몸객체쓰기(몸글, "").
        }
        아니면 명령인자수 > 0이면 {
            바이트열 참조 qb = 바이트열_만들기().
            날글넣기(qb, 길).
            반복 (정수 i11는 0부터 명령인자수 전까지) {
                i11 == 0이면 { 날글넣기(qb, "?"). } 아니면 { 날글넣기(qb, "&"). }
                퍼센트쓰기(qb, 명령인자이름들[i11] 으로 문자열).
                날글넣기(qb, "=").
                문자열 원값 = 명령인자값들[i11] 으로 문자열.
                (원값 == 없음 또는 아닌 문자열_같은가(제글보기(명령인자찾기(기능, 명령인자이름들[i11] 으로 문자열), "type", ""), "string"))이면 { 원값 = 명령인자제글들[i11] 으로 문자열. }
                퍼센트쓰기(qb, 원값).
            }
            바이트열_넣기(qb, 0).
            길 = 문자열_복제(바이트열_자료(qb)).
            바이트열_해제(qb).
        }
    }
    (* F3-3 — GEULPU_EXPERIMENT 는 --experiment 의 기본값이다. 새 실험을 만드는 명령과 path 로 다른 실험을 가리키는 실험 명령에는 붙이지
       않는다(명령 창의 F1 규칙 — 마지막 폴더 이름으로 견준다). --experiment 를 직접 주면 그대로 *)
    (실험환경 그리고 실험값 != 없음)이면 {
        문자열_같은가(기능id, "experiment.create")이면 { 실험값 = 없음. }
        아니면 (문자열_시작하는가(기능id, "experiment." 로) 그리고 명령경로 != 없음 그리고 글자수(명령경로) > 0)이면 {
            문자열 이름1 = 명령끝이름(명령경로).
            문자열 이름2 = 명령끝이름(실험값).
            아닌 문자열_같은가(이름1, 이름2)이면 { 실험값 = 없음. }
            해제(이름1).
            해제(이름2).
        }
    }
    문자열 몸 = 없음.
    몸글 != 없음이면 {
        바이트열_넣기(몸글, 0).
        몸 = 바이트열_자료(몸글).
    }
    해보기이면 {
        바이트열 참조 b3 = 바이트열_만들기().
        날글넣기(b3, "\{").
        제쌍글(b3, "op", 기능id).
        날글넣기(b3, ",").
        제쌍글(b3, "method", 방법).
        날글넣기(b3, ",").
        제쌍글(b3, "path", 길).
        날글넣기(b3, ",\"body\":").
        몸 == 없음이면 { 날글넣기(b3, "null"). } 아니면 { 날글넣기(b3, 몸). }
        세션 != 없음이면 {
            날글넣기(b3, ",").
            제쌍글(b3, "session", 세션).
        }
        실험값 != 없음이면 {
            날글넣기(b3, ",").
            제쌍글(b3, "experiment", 실험값).
        }
        날글넣기(b3, "\}").
        반환 명령내기(b3, 없음).
    }

    (* 7. 보낸다 — 앱이 떠 있는지 먼저(3 초) *)
    문자열 요청머리 = 명령머리(세션).
    위답 참조 핑 = 위묻기덧("GET", 포트, "/api/ping", 없음, 요청머리, 3).
    (핑 == 없음 또는 문자열_찾기(핑→몸 에서, "geulpu") == 없음)이면 {
        반환 명령틀림(짓기("the GeulPU app is not reachable at 127.0.0.1:%lld", 포트), 0, 기능id, "start it: GeulPU --no-open (or geulpu --no-open), or give --app-port / GEULPU_PORT", 명령앱없음).
    }
    위답놓기(핑).
    (* C2 — --experiment: 실험인지 앱에 묻고(experiment show) 그 폴더를 X-GeulPU-Experiment 로. 상대 경로는 이 CLI 의 현재 폴더 기준 *)
    실험값 != 없음이면 {
        문자열 실험물음 = 실험값.
        참거짓 구분있음 = 거짓.
        반복 (정수 e1 = 0: 실험값[e1] != 0: e1 += 1) {
            ((실험값[e1] & 255) == 92 또는 (실험값[e1] & 255) == 47)이면 { 구분있음 = 참. }
        }
        참거짓 절대 = (실험값[0] & 255) == 92 또는 (실험값[0] & 255) == 47 또는 (실험값[1] & 255) == 58.
        (구분있음 그리고 아닌 절대)이면 { 실험물음 = 잇기3(현재_디렉터리(), "\\", 실험값). }
        바이트열 참조 eb = 바이트열_만들기().
        날글넣기(eb, "/api/experiments/show?path=").
        퍼센트쓰기(eb, 실험물음).
        바이트열_넣기(eb, 0).
        위답 참조 er = 위묻기덧("GET", 포트, 바이트열_자료(eb), 없음, 요청머리, 30).
        바이트열_해제(eb).
        (er == 없음 또는 er→코드 != 200)이면 {
            반환 명령틀림(잇기("not an experiment folder: ", 실험값), 0, 기능id, "create one with GeulPU experiment create --name <name>, or give the folder that holds experiment.json", 명령사용법).
        }
        제이슨 참조 eo = 제풀기(er→몸, er→몸길이).
        문자열 실험경로 = 제글값(eo, "path", 실험물음).
        eo != 없음이면 {
            잠그기().
            제놓기(eo).
            풀기().
        }
        위답놓기(er).
        요청머리 = 잇기3(요청머리, "X-GeulPU-Experiment: ", 잇기(실험경로, "\r\n")).
    }
    위답 참조 r = 위묻기덧(방법, 포트, 길, 몸, 요청머리, 초).
    r == 없음이면 { 반환 명령틀림(짓기("no answer within %lld s", 초), 0, 기능id, "wait longer with --timeout <seconds>", 명령실패). }
    r→코드 >= 400이면 {
        문자열 말 = 명령답까닭(r).
        반환 명령틀림(말, r→코드, 기능id, 명령다음(r→코드, 말, 명령이름), 명령실패).
    }
    (* --wait 는 --out 보다 먼저 — 작업이면 끝날 때까지 기다리고, 끝난 작업의 JSON 을 --out 의 파일에(F2) *)
    (기다림 그리고 제참값(기능, "job", 거짓))이면 {
        제이슨 참조 jo = 제풀기(r→몸, r→몸길이).
        정수 번호 = 제정수값(jo, "job", -1).
        jo != 없음이면 {
            잠그기().
            제놓기(jo).
            풀기().
        }
        번호 >= 0이면 { 반환 명령기다리기(포트, 요청머리, 번호, 내보낼파일). }
    }
    (* F3-3 — --select: 답에서 고른 값만(--out 이 있으면 그 파일에) *)
    명령고를것 != 없음이면 {
        바이트열 참조 rb = 바이트열_만들기().
        r→몸길이 == 0이면 { 날글넣기(rb, "\{\"ok\":true\}"). } 아니면 { 바이트열_붙이기(rb, r→몸, r→몸길이). }
        정수 낸것2 = 명령내기(rb, 내보낼파일).
        바이트열_해제(rb).
        반환 낸것2.
    }
    내보낼파일 != 없음이면 {
        아닌 파일쓰기(내보낼파일, r→몸, r→몸길이)이면 { 반환 명령틀림(잇기("cannot write ", 내보낼파일), 0, 기능id, 없음, 명령실패). }
        바이트열 참조 b4 = 바이트열_만들기().
        날글넣기(b4, "\{\"ok\":true,").
        제쌍글(b4, "file", 내보낼파일).
        날글넣기(b4, ",").
        제쌍수(b4, "bytes", r→몸길이).
        날글넣기(b4, "\}").
        명령바이트출력(b4).
        반환 명령성공.
    }
    글자수(r→몸) < r→몸길이이면 { 반환 명령틀림("the answer is binary — save it with --out <file>", r→코드, 기능id, 없음, 명령실패). }
    r→몸길이 == 0이면 { 알림("\{\"ok\":true\}"). } 아니면 { 알림(r→몸). }
    반환 명령성공.
}
