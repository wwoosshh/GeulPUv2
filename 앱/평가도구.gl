        (글자수(w→기준모델) == 0)이면 {
            w→기준모델 = 문자열_복제(m0→아이디).
            w→기준파일 = 파일이름(m0→경로).
            w→기준해시 = "".
            w→기준형식 = 큰형식.
            (m0→모양 != 없음 그리고 m0→모양→형식글 != 없음)이면 { w→기준형식 = 문자열_복제(m0→모양→형식글). }
            w→기준만든 = 변환설정.
            날글넣기(말, 짓기("변환 %s → 기준 모델", 큰형식)).
        } 아니면 {
            평가버전 참조 v0 = 초기할당(1 을, 크기(평가버전)).
            잠그기(). 버전모델채우기(v0, m0). 풀기().
            v0→아이디 = 평가새버전아이디(w).
            v0→만든방법 = "convert".
            v0→만든설정 = 변환설정.
            v0→만든때 = 시각글().
            정수목록_추가(w→버전들, v0 으로 정수).
            w→지금 = 문자열_복제(v0→아이디).
            부모 = v0→아이디.
            날글넣기(말, 짓기("변환 %s → %s", 큰형식, v0→아이디)).
        }
        문자열 받음까닭 = 만들기받음(m0).
        받음까닭 != 없음이면 { 일적기(j, 짓기("%s — 엔진이 받지 않습니다: %s", 파일이름(m0→경로), 받음까닭)). }
    } 아니면 {
        날글넣기(말, "기준 모델에서").
    }
    반복 (정수 k7는 0부터 문자열목록_길이(만든들) 전까지) {
        문자열 t2 = 문자열목록_값(형식들, k7).
        모델 참조 mq = 만들기모델로(문자열목록_값(만든들, k7)).
        바이트열 참조 설 = 바이트열_만들기().
        날글넣기(설, "\{").
        제쌍글(설, "step", "quantize"). 날글넣기(설, ",").
        제쌍글(설, "type", t2). 날글넣기(설, ",").
        제쌍글(설, "based_on", 바탕삼음). 날글넣기(설, ",").
        제쌍글(설, "requantized_from", 다시양자화). 날글넣기(설, ",\"imatrix\":").
        이매파일 == 없음이면 { 날글넣기(설, "null"). }
        아니면 {
            날글넣기(설, "\{").
            제쌍글(설, "mode", 이매방식). 날글넣기(설, ",").
            제쌍글(설, "file", 파일이름(이매경로)). 날글넣기(설, ",").
            제쌍글(설, "path", 이매파일). 날글넣기(설, ",").          (* 4-2 — 개선의 되돌려 측정 · 다시 만들기가 같은 imatrix 를 쓴다 *)
            제쌍글(설, "sha256", 이매해시). 날글넣기(설, "\}").
        }
        날글넣기(설, ",\"tensor_types\":[").
        반복 (정수 k8는 0부터 문자열목록_길이(행렬들) 전까지) {
            k8 > 0이면 { 날글넣기(설, ","). }
            제글넣기(설, 문자열목록_값(행렬들, k8)).
        }
        날글넣기(설, "],").
        제쌍글(설, "llama_cpp", 태그). 날글넣기(설, ",").
        제쌍글(설, "command", 짓기("llama-quantize %s", t2)).
        날글넣기(설, "\}").
        바이트열_넣기(설, 0).
        평가버전 참조 vq = 초기할당(1 을, 크기(평가버전)).
        잠그기(). 버전모델채우기(vq, mq). 풀기().
        vq→아이디 = 평가새버전아이디(w).
        vq→만든방법 = "quantize".
        vq→부모 = 문자열_복제(부모).
        vq→만든설정 = 문자열_복제(바이트열_자료(설)).
        vq→만든때 = 시각글().
        바이트열_해제(설).
        정수목록_추가(w→버전들, vq 으로 정수).
        w→지금 = 문자열_복제(vq→아이디).
        날글넣기(말, 짓기(" · %s %s", t2, vq→아이디)).
        문자열목록_추가(이어버전들, vq→아이디).
        문자열 받음까닭2 = 만들기받음(mq).
        받음까닭2 != 없음이면 { 일적기(j, 짓기("%s — 엔진이 받지 않습니다: %s", 파일이름(mq→경로), 받음까닭2)). }
    }
    작업공간쓰기(w).
    (* 변환 검증(2-2) — 변환한 파일과 원래 모델 폴더 *)
    m0 != 없음이면 {
        일단계(j, "변환한 파일을 원래 모델과 견주는 중(변환 검증)", 950).
        정수[3] 셈.
        문자열 까닭c = 평가검증하기(w→아이디, 부모, m0→아이디, m0→경로, 원본, 셈).
        까닭c != 없음이면 { 날글넣기(말, 짓기(" · 변환 검증 못 함: %s", 까닭c)). }
        아니면 { 날글넣기(말, 짓기(" · 변환 검증 문제 %lld · 확인 필요 %lld · 통과 %lld", 셈[0], 셈[1], 셈[2])). }
    }
    (* 4-2 — 이어서 평가(만든 버전과 고른 버전들을 같은 데이터 · 설정으로) *)
    (이어데이터 != 없음 그리고 문자열목록_길이(만든들) > 0)이면 {
        바이트열 참조 요청 = 바이트열_만들기().
        날글넣기(요청, "\{").
        제쌍글(요청, "workspace", w→아이디). 날글넣기(요청, ",\"versions\":[").
        반복 (정수 ka는 0부터 문자열목록_길이(이어버전들) 전까지) {
            ka > 0이면 { 날글넣기(요청, ","). }
            제글넣기(요청, 문자열목록_값(이어버전들, ka)).
        }
        날글넣기(요청, "],").
        제쌍글(요청, "data", 이어데이터). 날글넣기(요청, ",").
        제쌍글(요청, "mode", "exact"). 날글넣기(요청, ",").
        제쌍수(요청, "max_tokens", 이어최대). 날글넣기(요청, ",").
        제쌍수(요청, "slots", 8).
        날글넣기(요청, "\}").
        바이트열_넣기(요청, 0).
        제이슨 참조 o2 = 제풀기(바이트열_자료(요청), 글자수(바이트열_자료(요청))).
        바이트열_해제(요청).
        문자열[1] 요약칸.
        요약칸[0] = 없음.
        문자열 까닭e = 평가하기(j, o2, 없음, 요약칸).
        o2 != 없음이면 { 잠그기(). 제놓기(o2). 풀기(). }
        일멈췄나(j)이면 { 바이트열_해제(말). 작업공간놓기(w). 일끝(j, 4, 없음). 반환 0. }
        까닭e != 없음이면 { 날글넣기(말, 짓기(" · 이어서 평가 못 함: %s", 까닭e)). }
        아니면 요약칸[0] != 없음이면 { 날글넣기(말, " · "). 날글넣기(말, 요약칸[0]). }
    }
    바이트열_넣기(말, 0).
    문자열 결과말 = 잇기("GGUF 만들기 — ", 바이트열_자료(말)).
    바이트열_해제(말).
    잠그기(). j→요약 = 결과말. 풀기().
    일적기(j, 결과말).
    작업공간놓기(w).
    일끝(j, 2, 없음).
    반환 0.
}

(* GET /api/eval/tools — 도구 목록의 요약(받을 것 · 크기 · 출처), 받은 도구의 상태(state.json), PATH 의 파이썬 후보, 자료 폴더가 ASCII 인가 *)
[바이트열 참조 b에 도구정보넣기]는 {
    제이슨 참조 목록 = 도구목록읽기().
    제이슨 참조 라마 = 제찾기(목록, "llama_cpp").
    제이슨 참조 빌드 = 도구빌드(목록).
    제이슨 참조 변환 = 제찾기(라마, "convert").
    날글넣기(b, "\{").
    제쌍글(b, "tag", 제글보기(라마, "tag", "")). 날글넣기(b, ",").
    제쌍글(b, "license", 제글보기(라마, "license", "")). 날글넣기(b, ",").
    제쌍글(b, "source", 제글보기(라마, "source", "")). 날글넣기(b, ",\"build\":\{").
    제쌍글(b, "file", 제글보기(빌드, "file", "")). 날글넣기(b, ",").
    제쌍글(b, "url", 제글보기(빌드, "url", "")). 날글넣기(b, ",").
    제쌍수(b, "size", 제정수값(빌드, "size", 0)). 날글넣기(b, "\},\"convert\":\{").
    제쌍글(b, "base", 제글보기(변환, "base", "")). 날글넣기(b, ",").
    제쌍글(b, "torch", 제글보기(변환, "torch", "")). 날글넣기(b, ",").
    제쌍글(b, "transformers5", 제글보기(변환, "transformers5", "")). 날글넣기(b, ",").
    제이슨 참조 파일들 = 제찾기(변환, "files").
    정수 합 = 0.
    반복 (정수 k는 0부터 제개수(파일들) 전까지) { 합 += 제정수값(제자식(파일들, k), "size", 0). }
    제쌍수(b, "files", 제개수(파일들)). 날글넣기(b, ",").
    제쌍수(b, "bytes", 합). 날글넣기(b, "\},").
    목록 != 없음이면 { 잠그기(). 제놓기(목록). 풀기(). }
    제쌍글(b, "platform", 앱체계()). 날글넣기(b, ",").
    제쌍참(b, "ascii_ok", 도구경로되나()). 날글넣기(b, ",").
    제쌍글(b, "dir", 도구폴더()). 날글넣기(b, ",\"python_candidates\":[").
    정수 쓴 = 0.
    문자열_같은가(앱체계(), "windows")이면 {
        문자열 py = 실행찾기("py").
        (py != 없음 그리고 아닌 스토어대리인가(py))이면 { 제글넣기(b, 잇기(py, " -3")). 쓴 += 1. }
    }
    문자열 p1 = 실행찾기("python").
    (p1 != 없음 그리고 아닌 스토어대리인가(p1))이면 { 쓴 > 0이면 { 날글넣기(b, ","). } 제글넣기(b, p1). 쓴 += 1. }
    문자열 p2 = 실행찾기("python3").
    (p2 != 없음 그리고 아닌 스토어대리인가(p2))이면 { 쓴 > 0이면 { 날글넣기(b, ","). } 제글넣기(b, p2). 쓴 += 1. }
    날글넣기(b, "],\"state\":").
    정수 n = 0.
    문자열 s = 파일읽기(잇기(도구폴더(), "state.json"), &n).
    s == 없음이면 { 날글넣기(b, "null"). }
    아니면 {
        정수 끝 = n.
        (끝 > 0 그리고 ((s[끝 - 1] & 255) == 10 또는 (s[끝 - 1] & 255) == 13))동안 { 끝 -= 1. }
        바이트열_붙이기(b, s, 끝).
        해제(s).
    }
    날글넣기(b, "\}").
}

(* ===== 2-3 — 원래 모델과 견주기(작업 'orig') ===== *)

(* 결과 폴더의 기준값 폴더(끝에 \) — 없으면 없음 *)
[문자열 작업을 문자열 결과이름을 원래기준폴더]는 -> 문자열 {
    (아닌 평가이름맞나(작업) 또는 아닌 평가이름맞나(결과이름))이면 { 반환 없음. }
    제이슨 참조 sm = 제파일읽기(짓기("%s결과\\%s\\summary.json", 작업공간폴더(작업), 결과이름)).
    sm == 없음이면 { 반환 없음. }
    문자열 기준폴더 = 제글값(sm, "reference_dir", "").
    잠그기(). 제놓기(sm). 풀기().
    글자수(기준폴더) == 0이면 { 반환 없음. }
    아닌 문자열_끝나는가(기준폴더, "\\" 로)이면 { 기준폴더 = 잇기(기준폴더, "\\"). }
    반환 기준폴더.
}

(* 결과의 기준값(GGUF 기준 모델의 답 · 상위 K)을 원래 모델(transformers — GGUF 만들기의 가상 환경 · CPU)에 같은 토큰으로 넣어 견준다 —
   앱 옆의 data\orig_compare.py. 결과는 기준값 폴더의 original.json(같은 기준값을 쓰는 결과들이 함께 본다) *)
[공허 참조 인자를 원래비교일]는 -> 중간정수 {
    일 참조 j = 인자 으로 일 참조.
    제이슨 참조 o = 제풀기(j→인자글, 글자수(j→인자글)).
    o == 없음이면 { 일끝(j, 3, "요청을 읽지 못했습니다"). 반환 0. }
    작업공간 참조 w = 작업공간읽기(제글보기(o, "workspace", "")).
    w == 없음이면 { 잠그기(). 제놓기(o). 풀기(). 일끝(j, 3, "작업 공간이 없습니다"). 반환 0. }
    문자열 결과이름 = 제글값(o, "dir", "").
    문자열 폴더 = 제글값(o, "original_dir", w→원래폴더).
    문자열 정밀 = 제글값(o, "dtype", "float32").
    잠그기(). 제놓기(o). 풀기().
    (아닌 문자열_같은가(정밀, "float32") 그리고 아닌 문자열_같은가(정밀, "bfloat16"))이면 { 작업공간놓기(w). 일끝(j, 3, "계산 형식은 float32 · bfloat16 중 하나입니다"). 반환 0. }
    (폴더 == 없음 또는 아닌 앱폴더인가(폴더) 또는 아닌 파일있음(잇기3(폴더, "\\", "config.json")))이면 { 작업공간놓기(w). 일끝(j, 3, "원래 모델 폴더(Hugging Face 형식 — config.json 과 가중치가 있는 폴더)를 정하세요"). 반환 0. }
    문자열 기준폴더 = 원래기준폴더(w→아이디, 결과이름).
    (기준폴더 == 없음 또는 아닌 파일있음(잇기(기준폴더, "topk.bin")))이면 { 작업공간놓기(w). 일끝(j, 3, "이 결과에는 견줄 기준값(같은 토큰의 확률)이 없습니다"). 반환 0. }
    제이슨 참조 상태 = 도구상태읽기().
    문자열 가파 = 가상파이썬(제글값(제찾기(상태, "python"), "venv", "")).
    문자열[3] 환경칸.                                   (* 원래 모델 폴더를 저장한 transformers 의 큰 판에 맞는 환경(#196) *)
    문자열 환경까닭 = 읽을환경(상태, 폴더, 환경칸).
    상태 != 없음이면 { 잠그기(). 제놓기(상태). 풀기(). }
    아닌 파일있음(가파)이면 { 작업공간놓기(w). 일끝(j, 3, "GGUF 만들기 도구(파이썬 가상 환경)가 준비되지 않았습니다 — '도구 준비'를 먼저 누르세요"). 반환 0. }
    환경까닭 != 없음이면 { 작업공간놓기(w). 일끝(j, 3, 환경까닭). 반환 0. }
    문자열 도움 = 데이터경로("orig_compare.py").
    아닌 파일있음(도움)이면 { 작업공간놓기(w). 일끝(j, 3, "앱의 data\\orig_compare.py 가 없습니다"). 반환 0. }
    (* 기준 모델의 GGUF — 하이퍼파라미터를 원래 모델의 설정과 견주게 넘긴다. 기준값을 만든 모델인지는 orig_compare.py 가 아이디로 본다 *)
    문자열 기준gguf = 없음.
    잠그기().
    모델 참조 rm = 모델찾기(w→기준모델).
    rm != 없음이면 { 기준gguf = 문자열_복제(rm→경로). }
    풀기().
    문자열 출력 = 잇기(기준폴더, "original.json").
    문자열 임시 = 잇기(기준폴더, "original.json.part").
    파일지우기(임시).
    일단계(j, 짓기("원래 모델에 기준 모델의 답을 넣어 견주는 중(transformers · CPU · %s)", 정밀), 100).
    글자수(환경칸[2]) > 0이면 { 일적기(j, 짓기("견주기 환경 — transformers %s(원래 모델 폴더는 transformers %s 로 저장)", 환경칸[1], 환경칸[2])). }
    아니면 { 일적기(j, 짓기("견주기 환경 — transformers %s", 환경칸[1])). }
    문자열목록 참조 l = 문자열목록_만들기().
    문자열목록_추가(l, "-E"). 문자열목록_추가(l, "-s"). 문자열목록_추가(l, "-X"). 문자열목록_추가(l, "utf8").
    문자열목록_추가(l, 도움).
    문자열목록_추가(l, "--hf"). 문자열목록_추가(l, 폴더).
    문자열목록_추가(l, "--ref"). 문자열목록_추가(l, 기준폴더).
    문자열목록_추가(l, "--out"). 문자열목록_추가(l, 임시).
    문자열목록_추가(l, "--dtype"). 문자열목록_추가(l, 정밀).
    (기준gguf != 없음 그리고 파일있음(기준gguf))이면 {
        문자열목록_추가(l, "--gguf"). 문자열목록_추가(l, 기준gguf).
        문자열목록_추가(l, "--gguf-id"). 문자열목록_추가(l, w→기준모델).
    }
    정수 끝 = 만들기돌리기(j, "original", 환경칸[0], l, 0).
    끝 == -2이면 { 파일지우기(임시). 작업공간놓기(w). 일끝(j, 4, 없음). 반환 0. }
    (끝 != 0 또는 아닌 파일있음(임시))이면 {
        파일지우기(임시). 작업공간놓기(w).
        일끝(j, 3, 짓기("원래 모델과 견주지 못했습니다(orig_compare.py): %s", 만들기끝줄(j, "original"))).
        반환 0.
    }
    아닌 파일옮기기(임시, 출력)이면 { 작업공간놓기(w). 일끝(j, 3, "결과를 쓰지 못했습니다"). 반환 0. }
    제이슨 참조 r = 제파일읽기(출력).
    정수 위치 = 제정수값(r, "positions", 0).
    실수 kl = 제실수값(r, "kl_mean", 0.0).
    실수 일치 = 제실수값(r, "top1", 0.0).
    문자열 설정상태 = 제글값(제찾기(r, "config_check"), "status", "").
    r != 없음이면 { 잠그기(). 제놓기(r). 풀기(). }
    w→원래폴더 = 폴더.
    작업공간쓰기(w).
    문자열 결과말 = 짓기("원래 모델과 견주기 — 위치 %lld · KL %s · top-1 %s", 위치, 실수글(kl, 8), 잇기(실수글(일치 * 100.0, 2), " %")).
    문자열_같은가(설정상태, "gguf_differs")이면 { 결과말 = 잇기(결과말, " · GGUF 의 하이퍼파라미터가 원래 모델의 설정과 다릅니다"). }
    잠그기(). j→요약 = 결과말. 풀기().
    일적기(j, 결과말).
    작업공간놓기(w).
    일끝(j, 2, 없음).
    반환 0.
}

(* GET /api/eval/original?workspace=&dir= — 결과의 기준값을 원래 모델과 견준 것(original.json), 없으면 거짓 *)
[바이트열 참조 b에 문자열 작업을 문자열 결과이름을 원래정보넣기]는 -> 참거짓 {
    문자열 기준폴더 = 원래기준폴더(작업, 결과이름).
    기준폴더 == 없음이면 { 반환 거짓. }
    정수 n = 0.
    문자열 s = 파일읽기(잇기(기준폴더, "original.json"), &n).
    s == 없음이면 { 반환 거짓. }
    바이트열_붙이기(b, s, n).
    해제(s).
    반환 참.
}

(* ===== 4-2 — 개선: 행렬 무리마다 되돌려 측정(작업 'improve') =====
   기준 버전(기준 모델에서 양자화한 버전 — 형식 · imatrix · 행렬별 형식)과 같은 설정에, 한 무리만 더 높은 형식(되돌릴 형식 — Q6_K · Q5_K ·
   BF16)으로 바꾼 시험 파일을 무리마다 만들고, 기준 버전과 함께 같은 작은 데이터로 평가해(평가하기) 무리마다 KL divergence 가 얼마나 주는지 ·
   파일이 얼마나 커지는지를 잰다. 무리는 행렬 종류(attn_q · attn_k · attn_v · attn_output · ffn_gate+ffn_up · ffn_down · token_embd · output)와
   층의 세 토막(그 층의 모든 행렬). 시험 파일 · 버전 · 결과는 잰 뒤 지우고 보고서만 남긴다 — 작업 공간의 개선\<시각>.json *)

[문자열 형식을 되돌림형식맞나]는 -> 참거짓 {
    반환 문자열_같은가(형식, "q6_k") 또는 문자열_같은가(형식, "q5_k") 또는 문자열_같은가(형식, "bf16") 또는 문자열_같은가(형식, "f16").
}

(* 층 a … b − 1 의 행렬 모두에 맞는 정규식 덮개(--tensor-type 의 꼴 '패턴=형식') *)
[정수 a를 정수 b를 문자열 형식을 층덮개]는 -> 문자열 {
    바이트열 참조 p = 바이트열_만들기().
    날글넣기(p, "blk\\.(").
    반복 (정수 k = a: k < b: k += 1) {
        k > a이면 { 바이트열_넣기(p, 124). }
        날글넣기(p, 수글(k)).
    }
    날글넣기(p, ")\\.(attn_q|attn_k|attn_v|attn_output|ffn_gate|ffn_up|ffn_down)\\.=").
    날글넣기(p, 형식).
    바이트열_넣기(p, 0).
    문자열 r = 문자열_복제(바이트열_자료(p)).
    바이트열_해제(p).
    반환 r.
}

(* 시험 하나를 더한다 — 이름과 덮개 글들(\n 으로 이은 하나의 글) *)
[문자열목록 참조 이름들에 문자열목록 참조 덮개들에 문자열 이름을 문자열 덮개를 시험더하기]는 {
    문자열목록_추가(이름들, 이름).
    문자열목록_추가(덮개들, 덮개).
}

[문자열 경로를 결과값읽기]는 -> 제이슨 참조 { 반환 제파일읽기(잇기(경로, "summary.json")). }

[공허 참조 인자를 개선일]는 -> 중간정수 {
    일 참조 j = 인자 으로 일 참조.
    제이슨 참조 o = 제풀기(j→인자글, 글자수(j→인자글)).
    o == 없음이면 { 일끝(j, 3, "요청을 읽지 못했습니다"). 반환 0. }
    작업공간 참조 w = 작업공간읽기(제글보기(o, "workspace", "")).
    w == 없음이면 { 잠그기(). 제놓기(o). 풀기(). 일끝(j, 3, "작업 공간이 없습니다"). 반환 0. }
    문자열 바탕버전 = 제글값(o, "base", "").
    문자열 데이터 = 제글값(o, "data", "basic60").
    정수 최대 = 제정수값(o, "max_tokens", 64).
    문자열 되돌림 = 제글값(o, "restore", "q6_k").
    참거짓 층나눔 = 제참값(o, "layer_ranges", 참).
    잠그기(). 제놓기(o). 풀기().
    (최대 < 8 또는 최대 > 1024)이면 { 최대 = 64. }
    아닌 되돌림형식맞나(되돌림)이면 { 작업공간놓기(w). 일끝(j, 3, "되돌릴 형식은 q6_k · q5_k · bf16 · f16 중 하나입니다"). 반환 0. }
    평가버전 참조 v = 버전찾기(w, 바탕버전).
    (v == 없음 또는 아닌 문자열_같은가(v→만든방법, "quantize") 또는 v→만든설정 == 없음)이면 { 작업공간놓기(w). 일끝(j, 3, "기준 버전은 GGUF 만들기로 양자화한 버전이어야 합니다(만든 설정이 있어야 함)"). 반환 0. }
    아닌 도구경로되나()이면 { 작업공간놓기(w). 일끝(j, 3, "자료 폴더의 경로에 ASCII 가 아닌 글자가 있어 llama.cpp 의 도구를 쓸 수 없습니다"). 반환 0. }
    (* 기준 버전의 설정 *)
    제이슨 참조 설 = 제풀기(v→만든설정, 글자수(v→만든설정)).
    문자열 형식 = 제글값(설, "type", "").
    문자열 다시양자화 = 제글값(설, "requantized_from", 없음).
    문자열 이매파일 = 제글값(제찾기(설, "imatrix"), "path", 없음).
    문자열목록 참조 바탕덮개 = 문자열목록_만들기().
    제이슨 참조 tt = 제찾기(설, "tensor_types").
    (tt != 없음 그리고 tt→종류 == 5)이면 {
        반복 (정수 k는 0부터 제개수(tt) 전까지) {
            제이슨 참조 e = 제자식(tt, k).
            (e != 없음 그리고 e→종류 == 4)이면 { 문자열목록_추가(바탕덮개, 문자열_복제(e→글)). }
        }
    }
    설 != 없음이면 { 잠그기(). 제놓기(설). 풀기(). }
    아닌 양자화형식맞나(형식)이면 { 작업공간놓기(w). 일끝(j, 3, "기준 버전의 양자화 형식을 읽지 못했습니다"). 반환 0. }
    (이매파일 != 없음 그리고 아닌 파일있음(이매파일))이면 { 작업공간놓기(w). 일끝(j, 3, 잇기("기준 버전의 imatrix 파일이 없습니다: ", 이매파일)). 반환 0. }
    (* 도구 · 기준 모델 *)
    제이슨 참조 상태 = 도구상태읽기().
    문자열 빈폴더 = 제글값(제찾기(상태, "llama_cpp"), "bin", "").
    문자열 태그 = 제글값(제찾기(상태, "llama_cpp"), "tag", "").
    상태 != 없음이면 { 잠그기(). 제놓기(상태). 풀기(). }
    문자열 양자화 = 잇기(빈폴더, 실행이름("llama-quantize.exe")).
    아닌 파일있음(양자화)이면 { 작업공간놓기(w). 일끝(j, 3, "GGUF 만들기 도구가 준비되지 않았습니다 — '도구 준비'를 먼저 누르세요"). 반환 0. }
    문자열 기준경로 = 없음.
    정수 층수 = 0.
    참거짓 출력있음 = 거짓.
    잠그기().
    모델 참조 rm = 모델찾기(w→기준모델).
    rm != 없음이면 {
        기준경로 = 문자열_복제(rm→경로).
        rm→모양 != 없음이면 { 층수 = rm→모양→층수. 출력있음 = rm→모양→머리형식 >= 0. }
    }
    풀기().
    (기준경로 == 없음 또는 아닌 파일있음(기준경로))이면 { 작업공간놓기(w). 일끝(j, 3, "기준 모델이 앱의 모델 목록에 없습니다"). 반환 0. }
    문자열 바탕크기글 = 없음.
    정수 바탕바이트 = 0.
    잠그기().
    모델 참조 bm = 모델찾기(v→모델).
    bm != 없음이면 { 바탕바이트 = bm→바이트. }
    풀기().
    문자열 시험터 = 짓기("%s%s\\trials-%s\\", 만든폴더(), w→아이디, 시각도장()).
    폴더만들기(시험터).
    문자열 바탕파일 = 기준경로.
    (문자열_같은가(앱체계(), "windows") 그리고 아닌 아스키인가(기준경로))이면 {
        바탕파일 = 잇기(시험터, "reference-copy.gguf").
        일단계(j, "기준 모델을 ASCII 경로로 복사하는 중(llama.cpp 의 도구가 읽게)", 20).
        아닌 평가파일복사(기준경로, 바탕파일)이면 { 작업공간놓기(w). 일끝(j, 3, "기준 모델을 복사하지 못했습니다(디스크 공간)"). 반환 0. }
    }
    (* 시험 목록 *)
    문자열목록 참조 이름들 = 문자열목록_만들기().
    문자열목록 참조 덮개들 = 문자열목록_만들기().
    시험더하기(이름들, 덮개들, "attn_q", 짓기("attn_q=%s", 되돌림)).
    시험더하기(이름들, 덮개들, "attn_k", 짓기("attn_k=%s", 되돌림)).
    시험더하기(이름들, 덮개들, "attn_v", 짓기("attn_v=%s", 되돌림)).
    시험더하기(이름들, 덮개들, "attn_output", 짓기("attn_output=%s", 되돌림)).
    시험더하기(이름들, 덮개들, "ffn_gate+ffn_up", 짓기("ffn_gate=%s\nffn_up=%s", 되돌림, 되돌림)).
    시험더하기(이름들, 덮개들, "ffn_down", 짓기("ffn_down=%s", 되돌림)).
    시험더하기(이름들, 덮개들, "token_embd", 짓기("token_embd=%s", 되돌림)).
    출력있음이면 { 시험더하기(이름들, 덮개들, "output", 짓기("^output\\.weight=%s", 되돌림)). }
    (층나눔 그리고 층수 >= 3)이면 {
        정수 a1 = 층수 / 3.
        정수 a2 = (2 * 층수) / 3.
        시험더하기(이름들, 덮개들, 짓기("blk 0-%lld", a1 - 1), 층덮개(0, a1, 되돌림)).
        시험더하기(이름들, 덮개들, 짓기("blk %lld-%lld", a1, a2 - 1), 층덮개(a1, a2, 되돌림)).
        시험더하기(이름들, 덮개들, 짓기("blk %lld-%lld", a2, 층수 - 1), 층덮개(a2, 층수, 되돌림)).
    }
    정수 n시험 = 문자열목록_길이(이름들).
    일적기(j, 짓기("개선 측정 — 기준 버전 %s(%s) · 되돌릴 형식 %s · 시험 %lld 개 · 데이터 %s · 답 %lld 토큰", v→아이디, 형식, 되돌림, n시험, 데이터, 최대)).
    (* 시험 파일 · 버전 *)
    문자열목록 참조 시험버전들 = 문자열목록_만들기().
    문자열목록 참조 시험파일들 = 문자열목록_만들기().
    문자열목록 참조 시험모델들 = 문자열목록_만들기().
    문자열목록 참조 시험까닭들 = 문자열목록_만들기().         (* 시험을 재지 못한 까닭(재면 "") *)
    반복 (정수 ki는 0부터 n시험 전까지) {
        일멈췄나(j)이면 { 탈출. }
        문자열 이름 = 문자열목록_값(이름들, ki).
        문자열목록 참조 이번덮개 = 문자열_나누기(문자열목록_값(덮개들, ki), "\n" 로).
        문자열 출력 = 짓기("%strial-%lld.gguf", 시험터, ki + 1).
        일단계(j, 짓기("시험 파일을 만드는 중 — %s(%lld/%lld)", 이름, ki + 1, n시험), 30 + (250 * ki) / 평가큰값(n시험, 1)).
        문자열목록 참조 lq = 문자열목록_만들기().
        다시양자화 != 없음이면 { 문자열목록_추가(lq, "--allow-requantize"). }
        이매파일 != 없음이면 { 문자열목록_추가(lq, "--imatrix"). 문자열목록_추가(lq, 이매파일). }
        반복 (정수 kd는 0부터 문자열목록_길이(이번덮개) 전까지) { 문자열목록_추가(lq, "--tensor-type"). 문자열목록_추가(lq, 문자열목록_값(이번덮개, kd)). }
        반복 (정수 kb는 0부터 문자열목록_길이(바탕덮개) 전까지) { 문자열목록_추가(lq, "--tensor-type"). 문자열목록_추가(lq, 문자열목록_값(바탕덮개, kb)). }
        문자열목록_추가(lq, 바탕파일). 문자열목록_추가(lq, 출력). 문자열목록_추가(lq, 형식).
        정수 끝q = 만들기돌리기(j, 짓기("trial-%lld", ki + 1), 양자화, lq, 0).
        (끝q != 0 또는 아닌 파일있음(출력))이면 {
            일적기(j, 짓기("[%s] 시험 파일을 만들지 못했습니다 — 건너뜀", 이름)).
            문자열목록_추가(시험버전들, "").
            문자열목록_추가(시험파일들, "").
            문자열목록_추가(시험모델들, "").
            문자열목록_추가(시험까닭들, "시험 파일을 만들지 못했습니다").
            계속.
        }
        파일바이트(출력) == 바탕바이트이면 {                   (* 덮개에 맞는 행렬이 없다(묶인 임베딩의 output 따위) — 재지 않는다 *)
            일적기(j, 짓기("[%s] 바뀐 행렬이 없습니다(기준 버전과 같은 크기) — 건너뜀", 이름)).
            파일지우기(출력).
            문자열목록_추가(시험버전들, "").
            문자열목록_추가(시험파일들, "").
            문자열목록_추가(시험모델들, "").
            문자열목록_추가(시험까닭들, "바뀐 행렬이 없습니다(기준 버전과 같은 크기)").
            계속.
        }
        문자열목록_추가(시험까닭들, "").
        모델 참조 mt = 만들기모델로(출력).
        평가버전 참조 vt = 초기할당(1 을, 크기(평가버전)).
        잠그기(). 버전모델채우기(vt, mt). 풀기().
        vt→아이디 = 평가새버전아이디(w).
        vt→만든방법 = "trial".
        vt→부모 = 문자열_복제(v→아이디).
        vt→만든설정 = 짓기("\{\"step\":\"trial\",\"name\":\"%s\"\}", 이름).
        vt→만든때 = 시각글().
        정수목록_추가(w→버전들, vt 으로 정수).
        문자열목록_추가(시험버전들, vt→아이디).
        문자열목록_추가(시험파일들, 출력).
        문자열목록_추가(시험모델들, mt→아이디).
    }
    정수 n만듦 = 문자열목록_길이(시험버전들).            (* 멈췄으면 n시험 보다 적다 *)
    작업공간쓰기(w).
    (* 평가 — 기준 버전과 시험들을 같은 데이터 · 설정으로 *)
    문자열목록 참조 결과들 = 문자열목록_만들기().
    문자열 까닭e = 없음.
    아닌 일멈췄나(j)이면 {
        바이트열 참조 요청 = 바이트열_만들기().
        날글넣기(요청, "\{").
        제쌍글(요청, "workspace", w→아이디). 날글넣기(요청, ",\"versions\":[").
        제글넣기(요청, v→아이디).
        반복 (정수 kv는 0부터 n만듦 전까지) {
            글자수(문자열목록_값(시험버전들, kv)) > 0이면 { 날글넣기(요청, ","). 제글넣기(요청, 문자열목록_값(시험버전들, kv)). }
        }
        날글넣기(요청, "],").
        제쌍글(요청, "data", 데이터). 날글넣기(요청, ",").
        제쌍글(요청, "mode", "exact"). 날글넣기(요청, ",").
        제쌍수(요청, "max_tokens", 최대). 날글넣기(요청, ",").
        제쌍수(요청, "slots", 8).
        날글넣기(요청, "\}").
        바이트열_넣기(요청, 0).
        제이슨 참조 o2 = 제풀기(바이트열_자료(요청), 글자수(바이트열_자료(요청))).
        바이트열_해제(요청).
        문자열[1] 요약칸.
        요약칸[0] = 없음.
        까닭e = 평가하기(j, o2, 결과들, 요약칸).
        o2 != 없음이면 { 잠그기(). 제놓기(o2). 풀기(). }
    }
    (* 보고서 — 결과들[0] 은 기준 버전, 뒤는 시험(만든 것만) 차례 *)
    실수 바탕KL = -1.0.
    실수 바탕일치 = 0.0.
    (문자열목록_길이(결과들) > 0 그리고 글자수(문자열목록_값(결과들, 0)) > 0)이면 {
        제이슨 참조 s0 = 결과값읽기(문자열목록_값(결과들, 0)).
        바탕KL = 제실수값(제찾기(s0, "metrics"), "kl_mean", -1.0).
        바탕일치 = 제실수값(제찾기(s0, "metrics"), "top1", 0.0).
        s0 != 없음이면 { 잠그기(). 제놓기(s0). 풀기(). }
    }
    바이트열 참조 b = 바이트열_만들기().
    날글넣기(b, "\{").
    제쌍글(b, "format", "geulpu-eval-improve/1"). 날글넣기(b, ",").
    제쌍글(b, "workspace", w→아이디). 날글넣기(b, ",\"base\":\{").
    제쌍글(b, "version", v→아이디). 날글넣기(b, ",").
    제쌍글(b, "file", v→파일). 날글넣기(b, ",").
    제쌍글(b, "type", 형식). 날글넣기(b, ",").
    제쌍글(b, "imatrix", 이매파일). 날글넣기(b, ",\"tensor_types\":[").
    반복 (정수 kt는 0부터 문자열목록_길이(바탕덮개) 전까지) {
        kt > 0이면 { 날글넣기(b, ","). }
        제글넣기(b, 문자열목록_값(바탕덮개, kt)).
    }
    날글넣기(b, "],").
    제쌍수(b, "size", 바탕바이트). 날글넣기(b, ",").
    제쌍실수(b, "kl_mean", 바탕KL, 12). 날글넣기(b, ",").
    제쌍실수(b, "top1", 바탕일치, 12). 날글넣기(b, "\},").
    제쌍글(b, "restore", 되돌림). 날글넣기(b, ",").
    제쌍글(b, "data", 데이터). 날글넣기(b, ",").
    제쌍수(b, "max_tokens", 최대). 날글넣기(b, ",").
    제쌍글(b, "llama_cpp", 태그). 날글넣기(b, ",\"rows\":[").
    정수 결과자리 = 1.
    정수 쓴줄 = 0.
    문자열 가장이름 = 없음.                (* KL 을 가장 크게 줄인 시험 *)
    실수 가장줄임 = 0.0.
    반복 (정수 kr는 0부터 n만듦 전까지) {
        문자열 시험v = 문자열목록_값(시험버전들, kr).
        쓴줄 > 0이면 { 날글넣기(b, ","). }
        쓴줄 += 1.
        날글넣기(b, "\{").
        제쌍글(b, "name", 문자열목록_값(이름들, kr)). 날글넣기(b, ",\"tensor_types\":[").
        문자열목록 참조 덮 = 문자열_나누기(문자열목록_값(덮개들, kr), "\n" 로).
        반복 (정수 kq는 0부터 문자열목록_길이(덮) 전까지) {
            kq > 0이면 { 날글넣기(b, ","). }
            제글넣기(b, 문자열목록_값(덮, kq)).
        }
        날글넣기(b, "]").
        글자수(시험v) > 0이면 {
            정수 시험바이트 = 파일바이트(문자열목록_값(시험파일들, kr)).
            날글넣기(b, ","). 제쌍수(b, "size", 시험바이트).
            문자열 받음 = 없음.
            잠그기().
            모델 참조 mm = 모델찾기(문자열목록_값(시험모델들, kr)).
            풀기().
            mm != 없음이면 { 받음 = 만들기받음(mm). }
            받음 != 없음이면 { 날글넣기(b, ","). 제쌍글(b, "error", 받음). }
            결과자리 < 문자열목록_길이(결과들)이면 {
                문자열 rp = 문자열목록_값(결과들, 결과자리).
                글자수(rp) > 0이면 {
                    제이슨 참조 sr = 결과값읽기(rp).
                    실수 시험KL = 제실수값(제찾기(sr, "metrics"), "kl_mean", -1.0).
                    날글넣기(b, ","). 제쌍실수(b, "kl_mean", 시험KL, 12).
                    날글넣기(b, ","). 제쌍실수(b, "top1", 제실수값(제찾기(sr, "metrics"), "top1", 0.0), 12).
                    sr != 없음이면 { 잠그기(). 제놓기(sr). 풀기(). }
                    (바탕KL > 0.0 그리고 시험KL >= 0.0 그리고 바탕KL - 시험KL > 가장줄임)이면 { 가장줄임 = 바탕KL - 시험KL. 가장이름 = 문자열목록_값(이름들, kr). }
                }
                아니면 받음 == 없음이면 { 날글넣기(b, ","). 제쌍글(b, "error", "평가하지 못했습니다(작업 기록 참고)"). }
            }
            결과자리 += 1.
        }
        아니면 { 날글넣기(b, ","). 제쌍글(b, "error", 문자열목록_값(시험까닭들, kr)). }
        날글넣기(b, "\}").
    }
    날글넣기(b, "],").
    제쌍글(b, "finished", 시각글()).
    날글넣기(b, "\}\n").
    문자열 보고터 = 잇기(작업공간폴더(w→아이디), "개선\\").
    폴더만들기(보고터).
    문자열 보고 = 짓기("%s%s.json", 보고터, 시각도장()).
    바이트열파일쓰기(보고, b).
    바이트열_해제(b).
    (* 치우기 — 시험 버전 · 결과 · 모델 · 파일(기준 버전의 결과는 둔다). 평가하기가 작업 공간을 다시 썼으므로 다시 읽는다 *)
    문자열 작업아이디 = 문자열_복제(w→아이디).
    작업공간놓기(w).
    작업공간 참조 w2 = 작업공간읽기(작업아이디).
    w2 != 없음이면 {
        정수목록 참조 남김 = 정수목록_만들기().
        반복 (정수 kw는 0부터 정수목록_길이(w2→버전들) 전까지) {
            평가버전 참조 vv = 버전칸(w2, kw).
            문자열_같은가(vv→만든방법, "trial")이면 { 해제(vv). } 아니면 { 정수목록_추가(남김, vv 으로 정수). }
        }
        정수목록_해제(w2→버전들).
        w2→버전들 = 남김.
        (w2→지금 == 없음 또는 버전찾기(w2, w2→지금) == 없음)이면 { w2→지금 = 문자열_복제(바탕버전). }
        작업공간쓰기(w2).
        작업공간놓기(w2).
    }
    반복 (정수 kc는 1부터 문자열목록_길이(결과들) 전까지) {
        문자열 rp2 = 문자열목록_값(결과들, kc).
        글자수(rp2) > 1이면 { 폴더통째지우기(문자열_자르기(rp2, 0, 글자수(rp2) - 1)). }
    }
    잠그기().
    정수목록 참조 새모델 = 정수목록_만들기().
    반복 (정수 km는 0부터 정수목록_길이(모델들) 전까지) {
        모델 참조 mx = 정수목록_값(모델들, km) 으로 모델 참조.
        참거짓 시험것 = 거짓.
        반복 (정수 kn는 0부터 문자열목록_길이(시험모델들) 전까지) {
            (글자수(문자열목록_값(시험모델들, kn)) > 0 그리고 문자열_같은가(mx→아이디, 문자열목록_값(시험모델들, kn)))이면 { 시험것 = 참. }
        }
        아닌 시험것이면 { 정수목록_추가(새모델, mx 으로 정수). }
    }
    모델들 = 새모델.
    풀기().
    모델목록쓰기().
    폴더통째지우기(문자열_자르기(시험터, 0, 글자수(시험터) - 1)).
    일멈췄나(j)이면 { 일끝(j, 4, 없음). 반환 0. }
    까닭e != 없음이면 { 일끝(j, 3, 잇기("시험을 평가하지 못했습니다: ", 까닭e)). 반환 0. }
    문자열 결과말 = 없음.
    (가장이름 != 없음 그리고 바탕KL > 0.0)이면 {
        결과말 = 짓기("개선 측정 — %s 기준 · 시험 %lld 개 · 가장 크게 줄인 것 %s(KL %s → %s, −%s)", 바탕버전, n시험, 가장이름, 실수글(바탕KL, 4), 실수글(바탕KL - 가장줄임, 4),
            잇기(실수글(100.0 * 가장줄임 / 바탕KL, 1), " %")).
    } 아니면 {
        결과말 = 짓기("개선 측정 — %s 기준 · 시험 %lld 개 · KL 을 줄인 시험이 없습니다", 바탕버전, n시험).
    }
    잠그기(). j→요약 = 결과말. 풀기().
    일적기(j, 결과말).
    일끝(j, 2, 없음).
    반환 0.
}

(* GET /api/eval/improve?workspace= — 작업 공간의 마지막 개선 측정 보고서, 없으면 거짓 *)
[바이트열 참조 b에 문자열 작업을 개선보고넣기]는 -> 참거짓 {
    아닌 평가이름맞나(작업)이면 { 반환 거짓. }
    문자열 곳 = 잇기(작업공간폴더(작업), "개선\\").
    문자열목록 참조 l = 앱폴더목록(곳).
    l == 없음이면 { 반환 거짓. }
    문자열 고른 = 없음.
    반복 (정수 k는 0부터 문자열목록_길이(l) 전까지) {
        문자열 f = 문자열목록_값(l, k).
        문자열_끝나는가(f, ".json" 로)이면 {
            (고른 == 없음 또는 문자열_비교(f, 고른) > 0)이면 { 고른 = f. }
        }
    }
    고른 == 없음이면 { 반환 거짓. }
    정수 n = 0.
    문자열 s = 파일읽기(잇기(곳, 고른), &n).
    s == 없음이면 { 반환 거짓. }
    바이트열_붙이기(b, s, n).
    해제(s).
    반환 참.
}
