(* #96 2단계 — Jacobian lens(계약 5.4): J 파일(geulpu-jlens/1 — safetensors)을 열고, 호스트에서 u_l = J_l x_l 을 배정밀도의 차례 합으로
   셈한다. 계약/jlens읽기.py 의 읽기 · 계약/정수계약.py 의 J곱 과 비트까지 같다. 서버 --jlens 파일 이 J열기 로 연다(제이슨.gl · 파일.gl ·
   해시.gl 뒤에 포함한다). *)

문자열 J경로 = 없음.          (* --jlens 의 경로 *)
문자열 J자료 = 없음.          (* 파일 통째(사상 — 쪽은 처음 닿을 때 OS 의 파일 캐시에서) *)
문자열 J해시 = 없음.          (* 파일의 SHA-256(16진) — 응답 · 상태에 *)
문자열 J까닭 = 없음.          (* 열지 못한 까닭(상태에 보인다) *)
정수[512] J자리.              (* 원천 층 l 의 J_l(행 우선 [D][D] 반실수)이 J자료 의 어디서 시작하는가(바이트) — 없으면 −1 *)
정수 J층수 = 0.               (* J 파일의 원천 층 수 *)
실수 참조 반표 = 없음.        (* 반실수 비트(0 … 65535) → 배정밀도(값 그대로 — 비정규수도) *)
실수 J문턱 = 0.0.             (* 2⁻¹²⁶ − 2⁻¹⁵¹ — 규칙 R 의 끝(정수계약.py 의 _문턱): 크기가 이보다 작으면 가수 24 비트로 반올림해도 2⁻¹²⁶ 아래 *)
실수 J막정규 = 0.0.           (* 2⁻¹²⁶ — 규칙 R 의 입력 읽기(이보다 작은 짧은실수는 부호를 지킨 0) *)

[J반표짓기]는 {
    반표 != 없음이면 { 반환. }
    반표 = 할당(65536 * 8).
    반복 (정수 h는 0부터 65536 전까지) {
        정수 s = (h >> 15) & 1.
        정수 e = (h >> 10) & 31.
        정수 f = h & 1023.
        e == 0이면 {
            실수 v = (f 으로 실수) * 비트실수값((1023 - 24) << 52).             (* f · 2⁻²⁴ (정확) *)
            s == 1이면 { v = v * -1.0. }                                      (* −0 도 *)
            반표[h] = v.
        }
        아니면 { 반표[h] = 비트실수값((s << 63) | ((e - 15 + 1023) << 52) | (f << 42)). }   (* e = 31(무한 · NaN)은 J열기 가 받지 않는다 *)
    }
    J문턱 = 비트실수값(4039728865482899456).          (* 0x380FFFFFF0000000 *)
    J막정규 = 비트실수값(4039728865751334912).        (* 0x3810000000000000 *)
}

(* 제이슨 객체의 글 값이 s 인가 *)
[제이슨 참조 v에서 문자열 열쇠를 문자열 s를 J글같나]는 -> 참거짓 {
    제이슨 참조 m = 제찾기(v, 열쇠).
    (m == 없음 또는 m→종류 != 4)이면 { 반환 거짓. }
    반환 문자열_같은가(m→글, s).
}

(* 글 값을 정수로(없거나 수가 아니면 −1) *)
[제이슨 참조 v에서 문자열 열쇠를 J글수]는 -> 정수 {
    제이슨 참조 m = 제찾기(v, 열쇠).
    (m == 없음 또는 m→종류 != 4 또는 m→글길이 < 1 또는 m→글길이 > 9)이면 { 반환 -1. }
    정수 n = 0.
    문자열 g = m→글.
    반복 (정수 i는 0부터 m→글길이 전까지) {
        정수 c = g[i] & 255.
        (c < 48 또는 c > 57)이면 { 반환 -1. }
        n = n * 10 + (c - 48).
    }
    반환 n.
}

(* 정수 마디의 값(아니면 −1) *)
[제이슨 참조 m을 J정수]는 -> 정수 {
    (m == 없음 또는 m→종류 != 3 또는 아닌 m→정수인가 또는 m→정수값 < 0)이면 { 반환 -1. }
    반환 m→정수값.
}

(* J 파일을 연다 — 너비 D · 층 수 L 의 모델. 꼴이 틀리면 거짓(까닭은 J까닭). 계약 5.4 의 1: 텐서는 J.<l>(0 ≤ l ≤ L − 2) 만, F16 [D][D],
   자료는 빈틈 없이 이어지고 남는 바이트가 없다. 무한 · NaN 인 반실수는 받지 않는다 *)
[문자열 경로를 정수 D를 정수 L을 J열기]는 -> 참거짓 {
    J경로 = 경로.
    반복 (정수 i는 0부터 512 전까지) { J자리[i] = -1. }
    L > 512이면 { J까닭 = "층이 512 개를 넘는 모델은 받지 않는다". 반환 거짓. }
    문자열 p = 통째사상(경로).
    p == 없음이면 { J까닭 = 서식글("J 파일을 열지 못했다: %s", 경로). 반환 거짓. }
    정수 전체 = 통째길이.
    정수 hn = 0.
    전체 >= 8이면 {
        반복 (정수 k는 0부터 8 전까지) { hn = hn | ((p[k] & 255) << (8 * k)). }
    }
    (전체 < 10 또는 hn < 2 또는 hn > 전체 - 8 또는 (p[8] & 255) != 123)이면 { J까닭 = "safetensors 파일이 아니다". 사상풀기(p). 반환 거짓. }
    제이슨 참조 v = 제이슨풀기(p + 8, hn).
    (v == 없음 또는 v→종류 != 6)이면 { J까닭 = "safetensors 의 머리(JSON)를 풀지 못했다". 사상풀기(p). 반환 거짓. }
    제이슨 참조 메 = 제찾기(v, "__metadata__").
    (메 == 없음 또는 메→종류 != 6 또는 아닌 J글같나(메, "format", "geulpu-jlens/1"))이면 {
        J까닭 = "J 파일이 아니다(__metadata__ 의 format 이 geulpu-jlens/1 이 아니다)". 제놓기(v). 사상풀기(p). 반환 거짓.
    }
    (J글수(메, "d_model") != D 또는 J글수(메, "n_layers") != L)이면 {
        J까닭 = 서식글("J 파일의 층 · 너비(%lld · %lld)가 모델(%lld · %lld)과 다르다", J글수(메, "n_layers"), J글수(메, "d_model"), L, D).
        제놓기(v). 사상풀기(p). 반환 거짓.
    }
    정수 칸 = D * D * 2.
    정수 바탕 = 8 + hn.
    정수 자료길이 = 전체 - 바탕.
    정수 n = 0.
    문자열 틀림 = 없음.
    반복 (정수 q는 0부터 제개수(v) 전까지) {
        문자열 이름 = 정수목록_값(v→열쇠들, q) 으로 문자열.
        문자열_같은가(이름, "__metadata__")이면 { 계속. }
        제이슨 참조 t = 제자식(v, q).
        정수 nl = 글자수(이름).
        정수 l = -1.
        (nl >= 3 그리고 nl <= 5 그리고 (이름[0] & 255) == 74 그리고 (이름[1] & 255) == 46)이면 {    (* "J." *)
            l = 0.
            반복 (정수 i는 2부터 nl 전까지) {
                정수 c = 이름[i] & 255.
                (c < 48 또는 c > 57)이면 { l = -1. 탈출. }
                l = l * 10 + (c - 48).
            }
        }
        (l < 0 또는 l > L - 2)이면 { 틀림 = 서식글("모르는 텐서(J.<0 … %lld> 만): %s", L - 2, 이름). 탈출. }
        J자리[l] >= 0이면 { 틀림 = 서식글("같은 층의 텐서가 둘: %s", 이름). 탈출. }
        제이슨 참조 꼴 = 제찾기(t, "shape").
        제이슨 참조 자 = 제찾기(t, "data_offsets").
        (아닌 J글같나(t, "dtype", "F16") 또는 꼴 == 없음 또는 꼴→종류 != 5 또는 제개수(꼴) != 2 또는 J정수(제자식(꼴, 0)) != D 또는
         J정수(제자식(꼴, 1)) != D)이면 { 틀림 = 서식글("%s 가 F16 [%lld][%lld] 가 아니다", 이름, D, D). 탈출. }
        (자 == 없음 또는 자→종류 != 5 또는 제개수(자) != 2)이면 { 틀림 = 서식글("%s 의 data_offsets 가 없다", 이름). 탈출. }
        정수 a = J정수(제자식(자, 0)).
        정수 b = J정수(제자식(자, 1)).
        (a < 0 또는 b - a != 칸 또는 b > 자료길이 또는 a % 칸 != 0)이면 { 틀림 = 서식글("%s 의 자리 [%lld, %lld) 가 틀렸다", 이름, a, b). 탈출. }
        J자리[l] = 바탕 + a.
        n += 1.
    }
    제놓기(v).
    (틀림 == 없음 그리고 n * 칸 != 자료길이)이면 { 틀림 = "자료에 빈틈 · 겹침 · 남는 바이트가 있다". }
    (틀림 == 없음 그리고 n == 0)이면 { 틀림 = "원천 층이 하나도 없다". }
    틀림 == 없음이면 {                                                      (* 자리가 칸의 배수 · 서로 다름 · 합이 자료 길이 → 빈틈 없이 잇는다 *)
        참거짓 참조 쓴자리 = 초기할당(n 을, 8).
        반복 (정수 l2는 0부터 L - 1 전까지) {
            J자리[l2] >= 0이면 {
                정수 i2 = (J자리[l2] - 바탕) / 칸.
                (i2 >= n 또는 쓴자리[i2])이면 { 틀림 = "자료의 자리가 겹친다". }
                아니면 { 쓴자리[i2] = 참. }
            }
        }
        해제(쓴자리).
    }
    틀림 == 없음이면 {
        반복 (정수 k2는 0부터 자료길이 / 2 전까지) {
            (((p[바탕 + 2 * k2 + 1] & 255) & 124) == 124)이면 { 틀림 = "J 에 무한 · NaN 인 반실수가 있다". 탈출. }    (* 지수 칸(비트 10 … 14)이 모두 1 *)
        }
    }
    틀림 != 없음이면 {
        J까닭 = 문자열_합치기("J 파일의 꼴이 틀렸다 — ", 틀림).
        반복 (정수 i3는 0부터 512 전까지) { J자리[i3] = -1. }
        사상풀기(p).
        반환 거짓.
    }
    J반표짓기().
    J해시 = 해시(p 으로 공허 참조, 전체).
    J자료 = p.
    J층수 = n.
    J까닭 = 없음.
    반환 참.
}

(* 계약 5.4 의 2 — u_l = J_l x_l(너비 D): 칸 i 마다 배정밀도 s ← +0 에서 j = 0 … D − 1 차례로 s ← s + J[i][j] · x_j(곱은 정확, 더하기마다
   가까운 반올림 — 곱해더하기 없음), x 는 규칙 R 의 입력처럼(비정규수는 부호를 지킨 0). u_i 는 크기가 J문턱 보다 작으면 s 의 부호를 지킨 0,
   아니면 짧은실수(s)(가까운 반올림 한 번). J 가 없는 층은 u = x. 칸 i 끼리는 따로라 일꾼 스레드로 나눈다 — 단위 g = l · D + i 를 스레드마다
   이어진 몫으로(나눔과 상관없이 같은 비트). 너비 D 는 엔진의 너비 *)
묶음 J일은 정수 x, 정수 u, 정수 g0, 정수 g1.         (* x = 잔차 [층][D], u = 출력 [층][D] (주소), 단위 [g0, g1) *)

[J일 참조 w를 J일하기]는 {
    정수 D = 너비.
    짧은실수 참조 x = w→x 으로 짧은실수 참조.
    짧은실수 참조 u = w→u 으로 짧은실수 참조.
    실수 참조 xd = 할당(D * 8).
    정수 앞층 = -1.
    반복 (정수 g는 w→g0부터 w→g1 전까지) {
        정수 l = g / D.
        정수 i = g - l * D.
        (l >= 512 또는 J자리[l] < 0)이면 { u[g] = x[g]. 계속. }
        l != 앞층이면 {
            반복 (정수 j는 0부터 D 전까지) {
                실수 a = x[l * D + j] 으로 실수.
                (a != 0.0 그리고 a < J막정규 그리고 a > 0.0 - J막정규)이면 { a = a * 0.0. }
                xd[j] = a.
            }
            앞층 = l.
        }
        문자열 행 = J자료 + J자리[l] + 2 * i * D.
        실수 s = 0.0.
        정수 o = 0.
        반복 (정수 j2는 0부터 D 전까지) {
            정수 h = (행[o] & 255) | ((행[o + 1] & 255) << 8).
            s = s + 반표[h] * xd[j2].
            o += 2.
        }
        (s < J문턱 그리고 s > 0.0 - J문턱)이면 { u[g] = (s * 0.0) 으로 짧은실수. }
        아니면 { u[g] = s 으로 짧은실수. }
    }
    해제(xd).
}

[공허 참조 인자를 J일꾼]는 -> 중간정수 {
    (인자 으로 J일 참조)를 J일하기하다.
    반환 0.
}

(* 층 0 … 층들 − 1 의 u_l = J_l x_l — 잔차 [층들][D] → 출력 [층들][D] *)
[짧은실수 참조 잔차를 짧은실수 참조 출력을 정수 층들을 J곱들]는 {
    정수 U = 층들 * 너비.
    U < 1이면 { 반환. }
    정수 스레드수 = 코어수().
    스레드수 > 16이면 { 스레드수 = 16. }
    스레드수 < 1이면 { 스레드수 = 1. }
    J일 참조 일들 = 초기할당(스레드수 을, 크기(J일)).
    정수 참조 핸들들 = 초기할당(스레드수 을, 8).
    정수 덩 = (U + 스레드수 - 1) / 스레드수.
    [공허 참조 -> 중간정수] 함수 = J일꾼.
    반복 (정수 t는 0부터 스레드수 전까지) {
        J일 참조 w = 일들 + t.
        w→x = 잔차 으로 정수.
        w→u = 출력 으로 정수.
        w→g0 = t * 덩.
        w→g1 = (t + 1) * 덩.
        w→g0 > U이면 { w→g0 = U. }
        w→g1 > U이면 { w→g1 = U. }
        (t > 0 그리고 w→g0 < w→g1)이면 {
            핸들들[t] = 일꾼띄우기(함수 으로 공허 참조, w 으로 공허 참조) 으로 정수.
            핸들들[t] == 0이면 { w를 J일하기하다. }
        }
    }
    일들를 J일하기하다.
    반복 (정수 t2는 1부터 스레드수 전까지) { 핸들들[t2] != 0이면 { 일꾼기다림(핸들들[t2] 으로 공허 참조). } }
    해제(일들).
    해제(핸들들).
}
