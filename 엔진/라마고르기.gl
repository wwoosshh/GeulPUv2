(* llama.cpp 재현 5단계(문서/라마재현.md) — llama-server(b12008)의 CPU 고르기 사슬(common/sampling.cpp · src/llama-sampler.cpp)을 비트까지:
   top_k(k ≤ 128 — MSVC std::partial_sort) → top_p(float softmax · 누적) → min_p(정렬된 갈래) → temperature → dist(seed).
   dist 의 난수는 std::mt19937 과 MSVC uniform_real_distribution<double>(generate_canonical<double, 53>) — 판 1: VS 2022 17.12 부터
   (P0952R2 — (g2 << 21) + (g1 >> 11) 을 2⁻⁵³ 배), 판 0: 그 전(double 로 g1 + g2·2³² 를 더해 2⁶⁴ 로 나눔). 둘의 차이는 2⁻⁵³ 안이다.
   라마로그확률.gl 의 칸(라로값 · 라로번호 · 라로확률)을 쓴다 — 로그 확률 셈과 차례로 *)
포함 "라마로그확률.gl"

정수 참조 라고상태 = 없음.            (* std::mt19937 의 624 칸(32 비트 값) *)
정수 라고자리 = 624.

(* 36단계 — 사슬의 맨 앞(common_sampler_init): logit_bias(요청의 것 — ignore_eos 면 EOG 의 −inf 까지), 그다음 params.samplers 의
   차례에서 penalties(llama_sampler_penalties — 기본 차례의 첫째). 벌점은 서버가 사슬에 받아들인 토큰(요청의 프롬프트 토큰 모두, 그다음
   고른 토큰마다 — server-context.cpp init_sampler · common_sampler_accept)의 마지막 repeat_last_n 개에서 토큰마다 센 수를 쓴다(고리
   버퍼). 둘 다 심지 않으면 아무것도 하지 않는다(5단계의 사슬 그대로) *)
정수 라고V = 0.
정수 라고벌n = 0.                    (* repeat_last_n — 0 이면 받아들이지도 않는다 *)
짧은실수 참조 라고벌값 = 없음.        (* [0] repeat · [1] frequency · [2] presence *)
정수 참조 라고셈 = 없음.              (* 토큰마다 고리 안의 수 [V] *)
정수 참조 라고고리 = 없음.            (* 마지막 n 개(차례) *)
정수 라고고리수 = 0.
정수 라고고리머리 = 0.
정수 라고편향수 = 0.
정수 참조 라고편향토큰 = 없음.
짧은실수 참조 라고편향값 = 없음.

(* 벌점을 심는다 — 요청마다 새 사슬(센 수 · 고리를 비운다) *)
[정수 V를 정수 n을 짧은실수 되풀이를 짧은실수 빈도를 짧은실수 있음을 라고벌심기]는 {
    라고V = V.
    라고셈 != 없음이면 { 해제(라고셈). }
    라고셈 = 초기할당(V + 1 을, 8).
    라고고리 != 없음이면 { 해제(라고고리). }
    정수 m = n.
    m < 1이면 { m = 1. }
    라고고리 = 할당(m * 8 + 8).
    라고고리수 = 0.
    라고고리머리 = 0.
    라고벌n = n.
    라고벌값 == 없음이면 { 라고벌값 = 할당(16). }
    라고벌값[0] = 되풀이.
    라고벌값[1] = 빈도.
    라고벌값[2] = 있음.
}

(* logit_bias 를 심는다 — 차례대로 더한다(같은 토큰이 두 번이면 두 번) *)
[정수 개수를 정수 참조 토큰들을 짧은실수 참조 값들을 라고편향심기]는 {
    라고편향토큰 != 없음이면 { 해제(라고편향토큰). 해제(라고편향값). }
    라고편향토큰 = 할당(개수 * 8 + 8).
    라고편향값 = 할당(개수 * 4 + 4).
    반복 (정수 k는 0부터 개수 전까지) { 라고편향토큰[k] = 토큰들[k]. 라고편향값[k] = 값들[k]. }
    라고편향수 = 개수.
}

(* llama_sampler_penalties_accept — 센 수를 올리고, 고리가 차 있으면 가장 오래된 토큰의 수를 내린 뒤 그 자리에 쓴다 *)
[정수 토큰을 라고받기]는 {
    라고벌n == 0이면 { 반환. }
    (토큰 < 0 또는 토큰 >= 라고V)이면 { 반환. }
    라고셈[토큰] += 1.
    라고고리수 >= 라고벌n이면 {
        정수 옛 = 라고고리[라고고리머리].
        라고셈[옛] -= 1.
        라고고리[라고고리머리] = 토큰.
        라고고리머리 = (라고고리머리 + 1) % 라고벌n.
    } 아니면 {
        라고고리[(라고고리머리 + 라고고리수) % 라고벌n] = 토큰.
        라고고리수 += 1.
    }
}

(* 36단계 — 사슬의 덧붙임(8 바이트 정수): [repeat_last_n] [repeat 비트] [frequency 비트] [presence 비트] [편향 수 b]
   [(토큰, 편향 비트) × b] [이력 수 h] [이력 토큰 × h — 요청의 프롬프트 토큰의 끝 h 개]. 심고 이력을 받아들인다. 돌려줌: 읽은 바이트(틀리면 −1) *)
[문자열 s를 정수 길이를 정수 V를 라고덧심기]는 -> 정수 {
    길이 < 48이면 { 반환 -1. }
    정수 참조 a = s 으로 정수 참조.
    정수 n = a[0].
    (n < 0 또는 n > 1000000)이면 { 반환 -1. }
    라고벌심기(V, n, 라로실수(a[1]), 라로실수(a[2]), 라로실수(a[3])).
    정수 b = a[4].
    (b < 0 또는 40 + 16 * b + 8 > 길이)이면 { 반환 -1. }
    정수 참조 토 = 할당(b * 8 + 8).
    짧은실수 참조 값 = 할당(b * 4 + 4).
    반복 (정수 k는 0부터 b 전까지) { 토[k] = a[5 + 2 * k]. 값[k] = 라로실수(a[6 + 2 * k]). }
    라고편향심기(b, 토, 값).
    해제(토). 해제(값).
    정수 hi = 5 + 2 * b.
    정수 h = a[hi].
    (h < 0 또는 (hi + 1 + h) * 8 > 길이)이면 { 반환 -1. }
    반복 (정수 k2는 0부터 h 전까지) { 라고받기(a[hi + 1 + k2]). }
    반환 (hi + 1 + h) * 8.
}

(* 사슬의 앞 — 라로값 · 라로번호가 아직 어휘 차례(data[i].id == i)일 때: logit_bias(llama_sampler_logit_bias_apply — 번호 자리에 바로),
   penalties(llama_sampler_penalties_apply — is_disabled 면 건너뜀: n 0 이거나 repeat 1 · frequency 0 · presence 0). 센 수가 있는 토큰의
   logit 이 0 이하면 repeat 을 곱하고 아니면 나눈 뒤, count · frequency + presence 를 뺀다(짧은실수) *)
[정수 V를 라고앞손질]는 {
    반복 (정수 b는 0부터 라고편향수 전까지) {
        정수 t = 라고편향토큰[b].
        (t >= 0 그리고 t < V)이면 { 라로값[t] = 라로값[t] + 라고편향값[b]. }
    }
    라고벌n == 0이면 { 반환. }
    (라고벌값[0] == (1.0 으로 짧은실수) 그리고 라고벌값[1] == (0.0 으로 짧은실수) 그리고 라고벌값[2] == (0.0 으로 짧은실수))이면 { 반환. }
    정수 끝 = V.
    끝 > 라고V이면 { 끝 = 라고V. }
    반복 (정수 i는 0부터 끝 전까지) {
        정수 c = 라고셈[i].
        c > 0이면 {
            짧은실수 l = 라로값[i].
            l <= (0.0 으로 짧은실수)이면 { l = l * 라고벌값[0]. } 아니면 { l = l / 라고벌값[0]. }
            짧은실수 cf = c 으로 짧은실수.
            짧은실수 뺄 = cf * 라고벌값[1] + 라고벌값[2].
            라로값[i] = l - 뺄.
        }
    }
}

(* std::mt19937(씨앗) — init_genrand *)
[정수 씨앗을 라고심기]는 {
    라고상태 == 없음이면 { 라고상태 = 할당(624 * 8). }
    라고상태[0] = 씨앗 & 4294967295.
    반복 (정수 i는 1부터 624 전까지) {
        정수 앞 = 라고상태[i - 1].
        라고상태[i] = (1812433253 * (앞 ^ (앞 >> 30)) + i) & 4294967295.
    }
    라고자리 = 624.
}

[라고뽑기]는 -> 정수 {
    라고자리 >= 624이면 {
        반복 (정수 k는 0부터 624 전까지) {
            정수 y = (라고상태[k] & 2147483648) | (라고상태[(k + 1) % 624] & 2147483647).
            정수 v = 라고상태[(k + 397) % 624] ^ (y >> 1).
            (y & 1) != 0이면 { v = v ^ 2567483615. }
            라고상태[k] = v.
        }
        라고자리 = 0.
    }
    정수 y = 라고상태[라고자리].
    라고자리 += 1.
    y = y ^ (y >> 11).
    y = y ^ ((y << 7) & 2636928640).
    y = y ^ ((y << 15) & 4022730752).
    y = y ^ (y >> 18).
    반환 y & 4294967295.
}

(* uniform_real_distribution<double>(0, 1) 한 번 *)
[정수 판을 라고고름수]는 -> 실수 {
    정수 g1 = 라고뽑기().
    정수 g2 = 라고뽑기().
    판 == 1이면 { 반환 (((g2 << 21) + (g1 >> 11)) 으로 실수) * 0.00000000000000011102230246251565404236316680908203125. }
    실수 ans = g1 으로 실수.
    ans = ans + (g2 으로 실수) * 4294967296.0.
    반환 ans / 18446744073709551616.0.
}

(* 사슬 — 로짓 한 줄(V 개)에서 고른 토큰 번호. 위k 는 1 … 128(정렬된 갈래만). 난수는 라고심기 로 심은 것을 이어 쓴다 *)
[짧은실수 참조 로짓을 정수 V를 정수 위k를 짧은실수 위p를 짧은실수 최소p를 짧은실수 온도를 정수 최소유지를 정수 판을 라마고르기]는 -> 정수 {
    라로칸(V).
    반복 (정수 i는 0부터 V 전까지) {
        라로값[i] = 로짓[i].
        라로번호[i] = i 으로 중간정수.
    }
    라고앞손질(V).                                    (* 36단계 — logit_bias · penalties(심지 않았으면 그대로) *)
    정수 n = 위k.
    n > V이면 { n = V. }
    라로부분정렬(V, n).
    (* top_p — llama_sampler_softmax_impl(정렬됨): 맨 앞이 최댓값, float 합 · 나눗셈, 그다음 float 누적 *)
    위p < (1.0 으로 짧은실수)이면 {
        짧은실수 큰 = 라로값[0].
        짧은실수 합 = 0.0 으로 짧은실수.
        반복 (정수 i2는 0부터 n 전까지) {
            짧은실수 p = 씨지수(라로값[i2] - 큰).
            라로확률[i2] = p.
            합 = 합 + p.
        }
        반복 (정수 i3는 0부터 n 전까지) { 라로확률[i3] = 라로확률[i3] / 합. }
        짧은실수 누적 = 0.0 으로 짧은실수.
        정수 끝 = n.
        참거짓 찾음 = 거짓.
        반복 (정수 i4는 0부터 n 전까지) {
            아닌 찾음이면 {
                누적 = 누적 + 라로확률[i4].
                (누적 >= 위p 그리고 i4 + 1 >= 최소유지)이면 {
                    끝 = i4 + 1.
                    찾음 = 참.
                }
            }
        }
        n = 끝.
    }
    (* min_p — 정렬된 갈래: 맨 앞 logit + logf(p) 보다 작고 min_keep 이상인 첫 자리에서 자른다(첫 토큰은 늘 남음) *)
    (최소p > (0.0 으로 짧은실수) 그리고 n > 0)이면 {
        짧은실수 하한 = 라로값[0] + 씨로그(최소p).
        정수 i5 = 1.
        참거짓 더 = i5 < n.
        (더) 동안 {
            (라로값[i5] < 하한 그리고 i5 >= 최소유지)이면 { 더 = 거짓. }
            아니면 {
                i5 += 1.
                더 = i5 < n.
            }
        }
        n = i5.
    }
    (* temperature — 0 이하면 처음 만난 가장 큰 logit 만 남긴다(나머지 −inf) *)
    온도 <= (0.0 으로 짧은실수)이면 {
        정수 큰자리 = 0.
        반복 (정수 i6는 1부터 n 전까지) {
            라로값[i6] > 라로값[큰자리]이면 {
                라로값[큰자리] = 라로실수(4286578688).        (* −inf 0xFF800000 *)
                큰자리 = i6.
            } 아니면 { 라로값[i6] = 라로실수(4286578688). }
        }
    } 아니면 {
        반복 (정수 i7는 0부터 n 전까지) { 라로값[i7] = 라로값[i7] / 온도. }
    }
    (* dist(seed) — 후보가 하나여도 난수 한 번 *)
    n == 1이면 {
        라고고름수(판).
        반환 라로번호[0] 으로 정수.
    }
    짧은실수 큰2 = 라로값[0].
    실수 합2 = 0.0.
    반복 (정수 i8는 0부터 n 전까지) {
        짧은실수 p2 = 씨지수(라로값[i8] - 큰2).
        라로확률[i8] = p2.
        합2 = 합2 + (p2 으로 실수).
    }
    실수 표적 = 합2 * 라고고름수(판).
    실수 달림 = 0.0.
    반복 (정수 i9는 0부터 n 전까지) {
        달림 = 달림 + (라로확률[i9] 으로 실수).
        달림 >= 표적이면 { 반환 라로번호[i9] 으로 정수. }
    }
    반환 라로번호[n - 1] 으로 정수.
}
