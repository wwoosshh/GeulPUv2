(* llama.cpp 재현 5단계(문서/라마재현.md) — llama-server(b12008)의 CPU 고르기 사슬(common/sampling.cpp · src/llama-sampler.cpp)을 비트까지:
   top_k(k ≤ 128 — MSVC std::partial_sort) → top_p(float softmax · 누적) → min_p(정렬된 갈래) → temperature → dist(seed).
   dist 의 난수는 std::mt19937 과 MSVC uniform_real_distribution<double>(generate_canonical<double, 53>) — 판 1: VS 2022 17.12 부터
   (P0952R2 — (g2 << 21) + (g1 >> 11) 을 2⁻⁵³ 배), 판 0: 그 전(double 로 g1 + g2·2³² 를 더해 2⁶⁴ 로 나눔). 둘의 차이는 2⁻⁵³ 안이다.
   라마로그확률.gl 의 칸(라로값 · 라로번호 · 라로확률)을 쓴다 — 로그 확률 셈과 차례로 *)
포함 "라마로그확률.gl"

정수 참조 라고상태 = 없음.            (* std::mt19937 의 624 칸(32 비트 값) *)
정수 라고자리 = 624.

(* std::mt19937(씨앗) — init_genrand *)
[정수 씨앗을 라고심기]는 {
    라고상태 == 없음이면 { 라고상태 = 할당(624 * 8). }
    라고상태[0] = 씨앗 & 4294967295.
    반복 (정수 i는 1부터 624 전까지) {
        정수 앞 = 라고상태[i - 1].
        라고상태[i] = (1812433253 * (앞 ^ (앞 >> 30)) + i) & 4294967295.
    }
    라고자리 = 624.
}

[라고뽑기]는 -> 정수 {
    라고자리 >= 624이면 {
        반복 (정수 k는 0부터 624 전까지) {
            정수 y = (라고상태[k] & 2147483648) | (라고상태[(k + 1) % 624] & 2147483647).
            정수 v = 라고상태[(k + 397) % 624] ^ (y >> 1).
            (y & 1) != 0이면 { v = v ^ 2567483615. }
            라고상태[k] = v.
        }
        라고자리 = 0.
    }
    정수 y = 라고상태[라고자리].
    라고자리 += 1.
    y = y ^ (y >> 11).
    y = y ^ ((y << 7) & 2636928640).
    y = y ^ ((y << 15) & 4022730752).
    y = y ^ (y >> 18).
    반환 y & 4294967295.
}

(* uniform_real_distribution<double>(0, 1) 한 번 *)
[정수 판을 라고고름수]는 -> 실수 {
    정수 g1 = 라고뽑기().
    정수 g2 = 라고뽑기().
    판 == 1이면 { 반환 (((g2 << 21) + (g1 >> 11)) 으로 실수) * 0.00000000000000011102230246251565404236316680908203125. }
    실수 ans = g1 으로 실수.
    ans = ans + (g2 으로 실수) * 4294967296.0.
    반환 ans / 18446744073709551616.0.
}

(* 사슬 — 로짓 한 줄(V 개)에서 고른 토큰 번호. 위k 는 1 … 128(정렬된 갈래만). 난수는 라고심기 로 심은 것을 이어 쓴다 *)
[짧은실수 참조 로짓을 정수 V를 정수 위k를 짧은실수 위p를 짧은실수 최소p를 짧은실수 온도를 정수 최소유지를 정수 판을 라마고르기]는 -> 정수 {
    라로칸(V).
    반복 (정수 i는 0부터 V 전까지) {
        라로값[i] = 로짓[i].
        라로번호[i] = i 으로 중간정수.
    }
    정수 n = 위k.
    n > V이면 { n = V. }
    라로부분정렬(V, n).
    (* top_p — llama_sampler_softmax_impl(정렬됨): 맨 앞이 최댓값, float 합 · 나눗셈, 그다음 float 누적 *)
    위p < (1.0 으로 짧은실수)이면 {
        짧은실수 큰 = 라로값[0].
        짧은실수 합 = 0.0 으로 짧은실수.
        반복 (정수 i2는 0부터 n 전까지) {
            짧은실수 p = 씨지수(라로값[i2] - 큰).
            라로확률[i2] = p.
            합 = 합 + p.
        }
        반복 (정수 i3는 0부터 n 전까지) { 라로확률[i3] = 라로확률[i3] / 합. }
        짧은실수 누적 = 0.0 으로 짧은실수.
        정수 끝 = n.
        참거짓 찾음 = 거짓.
        반복 (정수 i4는 0부터 n 전까지) {
            아닌 찾음이면 {
                누적 = 누적 + 라로확률[i4].
                (누적 >= 위p 그리고 i4 + 1 >= 최소유지)이면 {
                    끝 = i4 + 1.
                    찾음 = 참.
                }
            }
        }
        n = 끝.
    }
    (* min_p — 정렬된 갈래: 맨 앞 logit + logf(p) 보다 작고 min_keep 이상인 첫 자리에서 자른다(첫 토큰은 늘 남음) *)
    (최소p > (0.0 으로 짧은실수) 그리고 n > 0)이면 {
        짧은실수 하한 = 라로값[0] + 씨로그(최소p).
        정수 i5 = 1.
        참거짓 더 = i5 < n.
        (더) 동안 {
            (라로값[i5] < 하한 그리고 i5 >= 최소유지)이면 { 더 = 거짓. }
            아니면 {
                i5 += 1.
                더 = i5 < n.
            }
        }
        n = i5.
    }
    (* temperature — 0 이하면 처음 만난 가장 큰 logit 만 남긴다(나머지 −inf) *)
    온도 <= (0.0 으로 짧은실수)이면 {
        정수 큰자리 = 0.
        반복 (정수 i6는 1부터 n 전까지) {
            라로값[i6] > 라로값[큰자리]이면 {
                라로값[큰자리] = 라로실수(4286578688).        (* −inf 0xFF800000 *)
                큰자리 = i6.
            } 아니면 { 라로값[i6] = 라로실수(4286578688). }
        }
    } 아니면 {
        반복 (정수 i7는 0부터 n 전까지) { 라로값[i7] = 라로값[i7] / 온도. }
    }
    (* dist(seed) — 후보가 하나여도 난수 한 번 *)
    n == 1이면 {
        라고고름수(판).
        반환 라로번호[0] 으로 정수.
    }
    짧은실수 큰2 = 라로값[0].
    실수 합2 = 0.0.
    반복 (정수 i8는 0부터 n 전까지) {
        짧은실수 p2 = 씨지수(라로값[i8] - 큰2).
        라로확률[i8] = p2.
        합2 = 합2 + (p2 으로 실수).
    }
    실수 표적 = 합2 * 라고고름수(판).
    실수 달림 = 0.0.
    반복 (정수 i9는 0부터 n 전까지) {
        달림 = 달림 + (라로확률[i9] 으로 실수).
        달림 >= 표적이면 { 반환 라로번호[i9] 으로 정수. }
    }
    반환 라로번호[n - 1] 으로 정수.
}
