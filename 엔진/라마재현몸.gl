        실수 dt = 정밀시각_밀리초() - t0.
        걸음합 += dt.
        k < 3이면 { 파일에_쓰기(표준출력(), "걸음 %lld (위치 %lld, 토큰 %lld): %.2f ms\n", k + 1, 위치, 토큰, dt). }
    }
    걸음수 > 0이면 { 파일에_쓰기(표준출력(), "생성 걸음 %lld 개: 평균 %.2f ms(걸음마다 동기화 · 로짓 내려받기 포함)\n", 걸음수, 걸음합 / (걸음수 으로 실수)). }
