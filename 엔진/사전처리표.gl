    (번 == 61 그리고 k == 1)이면 { 반환 "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    (번 == 62 그리고 k == 0)이면 { 반환 "[^\\r\\n\\p\{L\}\\p\{N\}]?((?=[\\p\{L\}\\p\{M\}])([^a-z]))*((?=[\\p\{L\}\\p\{M\}])([^A-Z]))+(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|[^\\r\\n\\p\{L\}\\p\{N\}]?((?=[\\p\{L\}\\p\{M\}])([^a-z]))+((?=[\\p\{L\}\\p\{M\}])([^A-Z]))*(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|\\p\{N\}\{1,3\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n/]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    (번 == 63 그리고 k == 0)이면 { 반환 "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    (번 == 64 그리고 k == 0)이면 { 반환 "\\p\{N\}". }
    (번 == 64 그리고 k == 1)이면 { 반환 "'s|'t|'re|'ve|'m|'ll|'d| ?\\p\{L\}+| ?\\p\{N\}+| ?[^\\s\\p\{L\}\\p\{N\}]+|\\s+(?!\\S)". }
    (번 == 65 그리고 k == 0)이면 { 반환 "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?(?:\\p\{L\}|\\p\{M\}|\\u200C|\\u200D)+|\\p\{N\}\{1,3\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    반환 없음.
}

(* 기본 갈래(이름 "default" · 빈 이름)의 k 째 정규식 *)
[정수 k를 사전처리기본정규식]는 -> 문자열 {
    k == 0이면 { 반환 "[\\p\{P\}\\$\\+<=>\\^~\\|]+". }
    k == 1이면 { 반환 "'s|'t|'re|'ve|'m|'ll|'d| ?\\p\{L\}+| ?\\p\{N\}+| ?[^\\s\\p\{L\}\\p\{N\}]+|\\s+(?!\\S)". }
    k == 2이면 { 반환 "\\p\{N\}+". }
    k == 3이면 { 반환 "[0-9][0-9][0-9]". }
    반환 없음.
}

(* 정규식의 빠른 길 번호(없으면 0) *)
[문자열 식을 정규빠른길]는 -> 정수 {
    문자열_같은가(식, "'s|'t|'re|'ve|'m|'ll|'d| ?\\p\{L\}+| ?\\p\{N\}+| ?[^\\s\\p\{L\}\\p\{N\}]+|\\s+(?!\\S)")이면 { 반환 1. }
    문자열_같은가(식, "(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}\{1,3\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+")이면 { 반환 2. }
    문자열_같은가(식, "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}\{1,3\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+")이면 { 반환 2. }
    문자열_같은가(식, "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+")이면 { 반환 3. }
    문자열_같은가(식, "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?[\\p\{L\}\\p\{M\}]+|\\p\{N\}| ?[^\\s\\p\{L\}\\p\{M\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+")이면 { 반환 4. }
    문자열_같은가(식, "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?(?:\\p\{L\}|\\p\{M\}|\\u200C|\\u200D)+|\\p\{N\}\{1,3\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+")이면 { 반환 5. }
    문자열_같은가(식, "\\p\{Han\}+")이면 { 반환 6. }
    문자열_같은가(식, "\\p\{AFMoE_digits\}")이면 { 반환 7. }
    문자열_같은가(식, "[^\\n]+|[\\n]+")이면 { 반환 8. }
    문자열_같은가(식, "\\d\{1,3\}(?=(?:\\d\{3\})*\\b)")이면 { 반환 7. }
    반환 0.
}
