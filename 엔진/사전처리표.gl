(* 번호의 ignore_merges(조각 통째가 낱말이면 합치기 없이) *)
[정수 번을 사전처리합침무시]는 -> 참거짓 {
    번 == 2이면 { 반환 참. }
    번 == 3이면 { 반환 참. }
    번 == 4이면 { 반환 참. }
    번 == 9이면 { 반환 참. }
    번 == 30이면 { 반환 참. }
    번 == 33이면 { 반환 참. }
    번 == 46이면 { 반환 참. }
    반환 거짓.
}

(* 번호의 갈래가 바이트 꼴(GPT-2 의 바이트 글자)인가 — 아니면 SentencePiece 꼴의 BPE(엔진이 받지 않는다) *)
[정수 번을 사전처리바이트]는 -> 참거짓 {
    번 == 15이면 { 반환 거짓. }
    번 == 16이면 { 반환 거짓. }
    번 == 17이면 { 반환 거짓. }
    번 == 19이면 { 반환 거짓. }
    번 == 43이면 { 반환 거짓. }
    반환 참.
}

(* 번호의 k 째 정규식(없으면 없음) — 갈래에 정규식 목록이 따로 없으면 llama.cpp 의 기본 목록 *)
[정수 번을 정수 k를 사전처리정규식]는 -> 문자열 {
    (번 == 0 그리고 k == 0)이면 { 반환 "\\p\{N\}\{1,3\}". }
    (번 == 0 그리고 k == 1)이면 { 반환 "[一-龥぀-ゟ゠-ヿ]+". }
    (번 == 0 그리고 k == 2)이면 { 반환 "[^\\r\\n\\p\{L\}\\p\{N\}]?[\\p\{Lu\}\\p\{Lt\}\\p\{Lm\}\\p\{Lo\}\\p\{M\}]*[\\p\{Ll\}\\p\{Lm\}\\p\{Lo\}\\p\{M\}]+(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|[^\\r\\n\\p\{L\}\\p\{N\}]?[\\p\{Lu\}\\p\{Lt\}\\p\{Lm\}\\p\{Lo\}\\p\{M\}]+[\\p\{Ll\}\\p\{Lm\}\\p\{Lo\}\\p\{M\}]*(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?| ?[\\p\{P\}\\p\{S\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    (번 == 1 그리고 k == 0)이면 { 반환 "[\\p\{P\}\\$\\+<=>\\^~\\|]+". }
    (번 == 1 그리고 k == 1)이면 { 반환 "'s|'t|'re|'ve|'m|'ll|'d| ?\\p\{L\}+| ?\\p\{N\}+| ?[^\\s\\p\{L\}\\p\{N\}]+|\\s+(?!\\S)". }
    (번 == 1 그리고 k == 2)이면 { 반환 "\\p\{N\}+". }
    (번 == 1 그리고 k == 3)이면 { 반환 "[0-9][0-9][0-9]". }
    (번 == 2 그리고 k == 0)이면 { 반환 "\\p\{N\}\{1,3\}". }
    (번 == 2 그리고 k == 1)이면 { 반환 "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}+| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    (번 == 3 그리고 k == 0)이면 { 반환 "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}\{1,3\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    (번 == 4 그리고 k == 0)이면 { 반환 "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])|[^\\r\\n\\p\{L\}\\p\{N\}]?\\p\{L\}+|\\p\{N\}\{1,3\}| ?[^\\s\\p\{L\}\\p\{N\}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+". }
    (번 == 5 그리고 k == 0)이면 { 반환 "[\r\n]". }
    (번 == 5 그리고 k == 1)이면 { 반환 "\\s?[A-Za-zµÀ-ÖØ-öø-ƺƼ-ƿǄ-ʓʕ-ʯͰ-ͳͶͷͻ-ͽͿΆΈ-ΊΌΎ-ΡΣ-ϵϷ-ҁҊ-ԯԱ-ՖႠ-ჅᎠ-Ᏽᏸ-ᏽᲐ-ᲺᲽ-Ჿᴀ-ᴫᵫ-ᵷᵹ-ᶚḀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ᾼιῂ-ῄῆ-ῌῐ-ΐῖ-Ίῠ-Ῥῲ-ῴῶ-ῼℂℇℊ-ℓℕℙ-ℝℤΩℨK-ℭℯ-ℴℹℼ-ℿⅅ-ⅉⅎↃↄⰀ-ⱻⱾ-ⳤⳫ-ⳮⳲⳳꙀ-ꙭꚀ-ꚛꜢ-ꝯꝱ-ꞇꞋ-ꞎꭰ-ꮿﬀ-ﬆﬓ-ﬗＡ-Ｚａ-ｚ𐐀-𐑏𐒰-𐓓𐓘-𐓻𐲀-𐲲𐳀-𐳲𑢠-𑣟𞤀-𞥃]+". }
    (번 == 5 그리고 k == 2)이면 { 반환 "\\s?[!-/:-~！-／：-～‘-‟　-。]+". }
    (번 == 5 그리고 k == 3)이면 { 반환 "\\s+$". }
    (번 == 5 그리고 k == 4)이면 { 반환 "[一-龥ࠀ-一가-퟿]+". }
    (번 == 5 그리고 k == 5)이면 { 반환 "\\p\{N\}+". }
    (번 == 6 그리고 k == 0)이면 { 반환 "[\r\n]". }
    (번 == 6 그리고 k == 1)이면 { 반환 "\\s?\\p\{L\}+". }
    (번 == 6 그리고 k == 2)이면 { 반환 "\\s?\\p\{P\}+". }
    (번 == 6 그리고 k == 3)이면 { 반환 "[一-龥ࠀ-一가-퟿]+". }
    (번 == 6 그리고 k == 4)이면 { 반환 "\\p\{N\}". }
