(* 시험_베이스64 — JSON 의 base64 쓰기(제이슨.gl 의 제베이스64쓰기 — 서버의 geulpu.logits 가 쓴다)를 GPU 없이(빠른점검 · CI 가 윈도 ·
   리눅스에서 돌린다). RFC 4648 10 절의 시험 벡터(길이를 3 으로 나눈 나머지 0 · 1 · 2 — 패딩 없음 · '==' · '='), 가운데 구간,
   128 이상의 바이트, fp32(짧은실수)의 바이트를 기대하는 문자열과 비교한다. 하나라도 다르면 1 로 끝난다. *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "표준/바이트열.gl"
포함 "표준/목록.gl"
포함 "표준/수학.gl"
포함 "제이슨.gl"

정수 셈 = 0.
정수 틀림 = 0.

(* 원본[시작 … 시작 + n) 을 쓴 것이 따옴표 안의 기대 와 같은가 *)
[바이트열 참조 원본을 정수 시작을 정수 n을 문자열 기대를 문자열 뜻을 검사줄]는 {
    바이트열 참조 b = 바이트열_만들기().
    제베이스64쓰기(b, 바이트열_자료(원본) + 시작, n).
    바이트열_넣기(b, 0).
    문자열 답 = 바이트열_자료(b).
    문자열 따옴표기대 = 문자열_합치기(문자열_합치기("\"", 기대), "\"").
    문자열 표 = "통과".
    아닌 문자열_같은가(답, 따옴표기대)이면 {
        표 = "틀림".
        틀림 += 1.
    }
    셈 += 1.
    쓰기("%s  %s [%lld, %lld) → %s(기대 %s)\n", 표, 뜻, 시작, 시작 + n, 답, 따옴표기대).
    바이트열_해제(b).
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    바이트열 참조 글 = 바이트열_만들기().
    바이트열_글넣기(글, "foobar").
    검사줄(글, 0, 0, "", "foobar(RFC 4648)").
    검사줄(글, 0, 1, "Zg==", "foobar(RFC 4648)").
    검사줄(글, 0, 2, "Zm8=", "foobar(RFC 4648)").
    검사줄(글, 0, 3, "Zm9v", "foobar(RFC 4648)").
    검사줄(글, 0, 4, "Zm9vYg==", "foobar(RFC 4648)").
    검사줄(글, 0, 5, "Zm9vYmE=", "foobar(RFC 4648)").
    검사줄(글, 0, 6, "Zm9vYmFy", "foobar(RFC 4648)").
    검사줄(글, 1, 3, "b29i", "foobar 의 가운데").
    검사줄(글, 3, 2, "YmE=", "foobar 의 가운데").
    검사줄(글, 5, 1, "cg==", "foobar 의 끝").
    바이트열 참조 높은 = 바이트열_만들기().        (* fb ff bf ff fe 00 80 — 128 이상의 바이트 · 알파벳의 끝(+ · /) *)
    바이트열_넣기(높은, 251).
    바이트열_넣기(높은, 255).
    바이트열_넣기(높은, 191).
    바이트열_넣기(높은, 255).
    바이트열_넣기(높은, 254).
    바이트열_넣기(높은, 0).
    바이트열_넣기(높은, 128).
    검사줄(높은, 0, 3, "+/+/", "128 이상의 바이트").
    검사줄(높은, 3, 1, "/w==", "128 이상의 바이트").
    검사줄(높은, 3, 2, "//4=", "128 이상의 바이트").
    검사줄(높은, 5, 2, "AIA=", "128 이상의 바이트").
    검사줄(높은, 0, 7, "+/+///4AgA==", "128 이상의 바이트").
    바이트열 참조 행 = 바이트열_만들기().          (* fp32 −2.5 · 1.0 의 리틀 엔디언 바이트 — 로짓 행의 형식 *)
    바이트열_넣기32(행, 3223322624).                (* −2.5 = 0xc0200000 *)
    바이트열_넣기32(행, 1065353216).                (* 1.0 = 0x3f800000 *)
    검사줄(행, 0, 8, "AAAgwAAAgD8=", "fp32 둘").
    검사줄(행, 4, 4, "AACAPw==", "fp32 하나").
    틀림 > 0이면 {
        쓰기("base64 쓰기: %lld 경우 중 %lld 틀림\n", 셈, 틀림).
        반환 1.
    }
    쓰기("base64 쓰기: %lld 경우 모두 통과\n", 셈).
    반환 0.
}
