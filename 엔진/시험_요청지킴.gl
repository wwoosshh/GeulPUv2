(* 시험_요청지킴 — 추론 서버의 브라우저 지킴(요청지킴.gl)을 GPU 없이(빠른점검 · CI 가 윈도 · 리눅스에서 돌린다). 경우마다 Host ·
   Origin 과 기대하는 답(0 받음 · 1 Host 가 다름 · 2 Origin 이 있음)을 두고 서버 포트 44545 로 묻는다. 하나라도 다르면 1 로 끝난다. *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "요청지킴.gl"

정수 셈 = 0.
정수 틀림 = 0.

[문자열 s를 보임]는 -> 문자열 {
    s == 없음이면 { 반환 "(없음)". }
    반환 s.
}

[문자열 호스트를 문자열 출처를 정수 기대를 문자열 뜻을 검사줄]는 {
    정수 답 = 요청지킴(호스트, 출처, 44545).
    문자열 표 = "통과".
    답 != 기대이면 {
        표 = "틀림".
        틀림 += 1.
    }
    셈 += 1.
    쓰기("%s  Host=%s · Origin=%s → %lld(기대 %lld) — %s\n", 표, 보임(호스트), 보임(출처), 답, 기대, 뜻).
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    검사줄("127.0.0.1:44545", 없음, 0, "프로그램(OpenAI SDK · curl)").
    검사줄("localhost:44545", 없음, 0, "프로그램(localhost)").
    검사줄("127.0.0.1", 없음, 0, "앱의 /v1 프록시(포트 없이 보낸다)").
    검사줄("localhost", 없음, 0, "포트 없는 localhost").
    검사줄(없음, 없음, 0, "Host 없는 HTTP/1.0").
    검사줄("127.0.0.1:44546", 없음, 1, "다른 포트").
    검사줄("evil.example:44545", 없음, 1, "DNS 리바인딩").
    검사줄("127.0.0.1.evil.example:44545", 없음, 1, "127.0.0.1 로 시작하는 다른 이름").
    검사줄("localhost.evil.example", 없음, 1, "localhost 로 시작하는 다른 이름").
    검사줄("", 없음, 1, "빈 Host").
    검사줄("127.0.0.1:", 없음, 1, "포트 자리가 빔").
    검사줄("127.0.0.1:445450", 없음, 1, "포트가 여섯 자리").
    검사줄("127.0.0.1:4454x", 없음, 1, "포트에 숫자가 아닌 글자").
    검사줄("LOCALHOST:44545", 없음, 1, "대문자(앱 관리자와 같이 그대로만)").
    검사줄("[::1]:44545", 없음, 1, "IPv6(서버는 127.0.0.1 에만 묶인다)").
    검사줄("127.0.0.1:44545", "https://evil.example", 2, "다른 웹사이트").
    검사줄("127.0.0.1:44545", "null", 2, "샌드박스 iframe · file://").
    검사줄("127.0.0.1:44545", "http://127.0.0.1:44544", 2, "앱 화면의 출처도(프록시는 Origin 을 넘기지 않는다)").
    검사줄("evil.example:44545", "http://evil.example:44545", 1, "리바인딩된 페이지(Host 를 먼저 본다)").
    틀림 > 0이면 {
        쓰기("요청 지킴: %lld 경우 중 %lld 틀림\n", 셈, 틀림).
        반환 1.
    }
    쓰기("요청 지킴: %lld 경우 모두 통과\n", 셈).
    반환 0.
}
