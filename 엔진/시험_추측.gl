(* GeulPUv2 3단계 — 추측 검증 걸음의 비트 시험: 같은 슬롯의 이어진 위치 B 행(B = 2 … 8)의 표 걸음이 행 하나씩의 표 걸음과 로짓 ·
   가장 큰 번호까지 같은가. 그리고 (1) 거절 — 틀린 초안으로 걸은 뒤 같은 위치를 바른 토큰으로 다시 걸어도 같은가(낡은 KV 를 되돌리지
   않는다), (2) 반쯤 맞은 초안, (3) 두 슬롯의 행이 섞인 걸음. 문맥은 조각(64) · 묶음(1,024) 경계를 지나게.
     시험_추측 <gguf> <ptx> <재기 입력(재기_7B 와 같은)>
   출력: 문맥마다의 다른 칸 · 다른 번호, 끝에 합(모두 0 이면 종료 0). *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "표준/바이트열.gl"
포함 "표준/사전.gl"
포함 "표준/수학.gl"
포함 "표준/시간.gl"
포함 "쿠다.gl"
포함 "파일.gl"
포함 "해시.gl"
포함 "gguf.gl"
포함 "가중치.gl"
포함 "로프.gl"
포함 "토크나이저.gl"
포함 "엔진.gl"

(* 두 로짓 행(n 칸)의 다른 칸 수 — 비트로 *)
[짧은실수 참조 앞것을 짧은실수 참조 뒤것을 정수 n을 다른칸수]는 -> 정수 {
    중간정수 참조 p = 앞것 으로 중간정수 참조.
    중간정수 참조 q = 뒤것 으로 중간정수 참조.
    정수 d = 0.
    반복 (정수 k는 0부터 n 전까지) { p[k] != q[k]이면 { d += 1. } }
    반환 d.
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    argc < 4이면 { "사용법: 시험_추측 <gguf> <ptx> <재기 입력>\n"을 쓰다. 반환 3. }
    문자열 입력 = 통째읽기(argv[3]).
    입력 == 없음이면 { "입력을 읽을 수 없다\n"을 쓰다. 반환 1. }
    정수 o = 0.
    정수 pc = 읽기64(입력, o). o += 8 + pc * 8.
    정수 pl = 읽기64(입력, o). o += 8.
    pl < 8192이면 { "재기 입력의 긴 글이 8,192 토큰보다 짧다\n"을 쓰다. 반환 1. }
    정수 참조 긴 = (입력 + o) 으로 정수 참조.
    쿠다열기().
    GGUF 참조 g = GGUF열기(argv[1]).
    슬롯수 = 2.
    엔진만들기(g, argv[2], 1024, 8448, 걸음행최대).
    판미리고르기().
    표칸준비().
    정수 V = 어휘수.
    짧은실수 참조 참조행 = 할당(8 * V * 4) 으로 짧은실수 참조.
    짧은실수 참조 시험행 = 할당(8 * V * 4) 으로 짧은실수 참조.
    짧은실수 참조 참조행1 = 할당(4 * V * 4) 으로 짧은실수 참조.
    정수[8] 참조번호. 정수[8] 시험번호. 정수[4] 참조번호1.
    정수[8] 토큰들. 정수[8] 위치들. 정수[8] 슬롯들.
    정수[8] 문맥들.
    문맥들[0] = 1. 문맥들[1] = 60. 문맥들[2] = 64. 문맥들[3] = 1017.
    문맥들[4] = 1024. 문맥들[5] = 2041. 문맥들[6] = 4096. 문맥들[7] = 8184.
    정수 모두칸 = 0.
    정수 모두번호 = 0.
    반복 (정수 ci는 0부터 8 전까지) {
        정수 n = 문맥들[ci].
        정수 m = (n % 700) + 5.                       (* 슬롯 1 의 문맥 — 긴 글의 100 번째 토큰부터 *)
        캐시비우기().
        슬롯넣기(0, 긴, n, 0).
        슬롯넣기(1, 긴 + 100, m, 0).
        맞추기().
        (* 참조: 행 하나씩 — 슬롯 0 의 n … n + 7, 슬롯 1 의 m … m + 3 *)
        반복 (정수 b는 0부터 8 전까지) {
            토큰들[0] = 긴[n + b]. 위치들[0] = n + b. 슬롯들[0] = 0.
            표걸음(1, 토큰들, 위치들, 슬롯들).
            맞추기().
            내리기(참조행 + b * V, 로짓칸, V * 4).
            정수 t0 = 0.
            내리기(&t0, 생성칸, 8).
            참조번호[b] = t0.
        }
        반복 (정수 b1는 0부터 4 전까지) {
            토큰들[0] = 긴[100 + m + b1]. 위치들[0] = m + b1. 슬롯들[0] = 1.
            표걸음(1, 토큰들, 위치들, 슬롯들).
            맞추기().
            내리기(참조행1 + b1 * V, 로짓칸, V * 4).
            정수 t1 = 0.
            내리기(&t1, 생성칸, 8).
            참조번호1[b1] = t1.
        }
        정수 칸합 = 0.
        정수 번호합 = 0.
        ci == 0이면 {                                   (* 시험이 다름을 잡는가 — 참조의 행 0 과 행 1 은 달라야 한다 *)
            쓰기("대조(달라야 함): 참조 행 0 · 1 의 다른 칸 %lld\n", 다른칸수(참조행, 참조행 + V, V)).
        }
        (* (0) B 행 — 모두 바른 토큰 *)
        반복 (정수 B = 2: B <= 8: B += 1) {
            반복 (정수 b2는 0부터 B 전까지) { 토큰들[b2] = 긴[n + b2]. 위치들[b2] = n + b2. 슬롯들[b2] = 0. }
            표걸음(B, 토큰들, 위치들, 슬롯들).
            맞추기().
            내리기(시험행, 로짓칸, B * V * 4).
            내리기(시험번호, 생성칸, B * 8).
            반복 (정수 b3는 0부터 B 전까지) {
                칸합 += 다른칸수(시험행 + b3 * V, 참조행 + b3 * V, V).
                시험번호[b3] != 참조번호[b3]이면 { 번호합 += 1. }
            }
        }
        (* (1) 거절 — 행 0 만 바르고 1 … 7 은 틀린 초안. 그 뒤 위치 n + 1 … n + 7 을 바른 토큰으로(낡은 KV 를 덮어쓴다) *)
        반복 (정수 b4는 0부터 8 전까지) {
            토큰들[b4] = 긴[n + b4].
            b4 > 0이면 { 토큰들[b4] = (긴[n + b4] + 1 + b4 * 7919) % V. }
            위치들[b4] = n + b4. 슬롯들[b4] = 0.
        }
        표걸음(8, 토큰들, 위치들, 슬롯들).
        맞추기().
        내리기(시험행, 로짓칸, V * 4).
        내리기(시험번호, 생성칸, 8).
        칸합 += 다른칸수(시험행, 참조행, V).
        시험번호[0] != 참조번호[0]이면 { 번호합 += 1. }
        반복 (정수 b5는 0부터 7 전까지) { 토큰들[b5] = 긴[n + 1 + b5]. 위치들[b5] = n + 1 + b5. 슬롯들[b5] = 0. }
        표걸음(7, 토큰들, 위치들, 슬롯들).
        맞추기().
        내리기(시험행, 로짓칸, 7 * V * 4).
        내리기(시험번호, 생성칸, 7 * 8).
        반복 (정수 b6는 0부터 7 전까지) {
            칸합 += 다른칸수(시험행 + b6 * V, 참조행 + (b6 + 1) * V, V).
            시험번호[b6] != 참조번호[b6 + 1]이면 { 번호합 += 1. }
        }
        (* (2) 반쯤 — 행 0 … 2 는 바르고 3 … 7 은 틀림. 바른 행은 그대로 같아야 하고, 그 뒤 n + 3 … n + 7 을 다시 *)
        반복 (정수 b7는 0부터 8 전까지) {
            토큰들[b7] = 긴[n + b7].
            b7 > 2이면 { 토큰들[b7] = (긴[n + b7] + 3 + b7 * 104729) % V. }
            위치들[b7] = n + b7. 슬롯들[b7] = 0.
        }
        표걸음(8, 토큰들, 위치들, 슬롯들).
        맞추기().
        내리기(시험행, 로짓칸, 3 * V * 4).
        내리기(시험번호, 생성칸, 3 * 8).
        반복 (정수 b8는 0부터 3 전까지) {
            칸합 += 다른칸수(시험행 + b8 * V, 참조행 + b8 * V, V).
            시험번호[b8] != 참조번호[b8]이면 { 번호합 += 1. }
        }
        반복 (정수 b9는 0부터 5 전까지) { 토큰들[b9] = 긴[n + 3 + b9]. 위치들[b9] = n + 3 + b9. 슬롯들[b9] = 0. }
        표걸음(5, 토큰들, 위치들, 슬롯들).
        맞추기().
        내리기(시험행, 로짓칸, 5 * V * 4).
        내리기(시험번호, 생성칸, 5 * 8).
        반복 (정수 c1는 0부터 5 전까지) {
            칸합 += 다른칸수(시험행 + c1 * V, 참조행 + (c1 + 3) * V, V).
            시험번호[c1] != 참조번호[c1 + 3]이면 { 번호합 += 1. }
        }
        (* (3) 두 슬롯 섞임 — 슬롯 0 의 n … n + 3 과 슬롯 1 의 m … m + 3 을 번갈아 한 걸음에 *)
        반복 (정수 c2는 0부터 4 전까지) {
            토큰들[2 * c2] = 긴[n + c2]. 위치들[2 * c2] = n + c2. 슬롯들[2 * c2] = 0.
            토큰들[2 * c2 + 1] = 긴[100 + m + c2]. 위치들[2 * c2 + 1] = m + c2. 슬롯들[2 * c2 + 1] = 1.
        }
        표걸음(8, 토큰들, 위치들, 슬롯들).
        맞추기().
        내리기(시험행, 로짓칸, 8 * V * 4).
        내리기(시험번호, 생성칸, 8 * 8).
        반복 (정수 c3는 0부터 4 전까지) {
            칸합 += 다른칸수(시험행 + (2 * c3) * V, 참조행 + c3 * V, V).
            칸합 += 다른칸수(시험행 + (2 * c3 + 1) * V, 참조행1 + c3 * V, V).
            시험번호[2 * c3] != 참조번호[c3]이면 { 번호합 += 1. }
            시험번호[2 * c3 + 1] != 참조번호1[c3]이면 { 번호합 += 1. }
        }
        쓰기("문맥 %lld (슬롯 1 은 %lld) — 다른 칸 %lld · 다른 번호 %lld\n", n, m, 칸합, 번호합).
        모두칸 += 칸합.
        모두번호 += 번호합.
    }
    정수 오류 = 엔진오류칸().
    쓰기("끝 — 다른 칸 %lld · 다른 번호 %lld · 오류칸 %lld\n", 모두칸, 모두번호, 오류).
    쿠다닫기().
    (모두칸 == 0 그리고 모두번호 == 0 그리고 오류 == 0)이면 { 반환 0. }
    반환 1.
}
