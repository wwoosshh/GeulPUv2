(* 0.12.0 12-G2 — 토크나이저를 GPU 없이 llama.cpp 의 어휘 시험(models/ggml-vocab-*.gguf · .inp · .out — tests/test-tokenizer-0)과 같은
   꼴로: 입력은 '\n__ggml_vocab_test__\n' 으로 끝나는 글들, 경우마다 BOS 없이 · 제어 토큰의 글을 풀지 않고(add_special 거짓 ·
   parse_special 거짓 — test-tokenizer-0 과 같다. 사용자 정의 토큰은 llama.cpp 처럼 뗀다) 나눠 한 줄(' 번호 번호 …')로 쓴다.
   시험/어휘시험.py 가 .out 과 견준다.
     시험_토큰 <어휘.gguf> <입력.inp> <출력> *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "표준/바이트열.gl"
포함 "표준/목록.gl"
포함 "표준/사전.gl"
포함 "파일.gl"
포함 "gguf.gl"
포함 "토크나이저.gl"

(* 토크나이저.gl 의 유니코드 표가 쓴다 — 해시.gl 의 것과 같다(해시.gl 은 GPU 층을 끌어와 이 도구는 포함하지 않는다) *)
[문자열 글을 정수목록 참조 목록에 십육진낱말들]는 {
    정수 v = 0.
    정수 자리 = 0.
    반복 (정수 k = 0: 글[k] != 0: k += 1) {
        정수 c = 글[k] & 255.
        정수 d = -1.
        (c >= 48 그리고 c <= 57)이면 { d = c - 48. }
        (c >= 97 그리고 c <= 102)이면 { d = c - 87. }
        (c >= 65 그리고 c <= 70)이면 { d = c - 55. }
        d >= 0이면 { v = v * 16 + d. 자리 += 1. }
        아니면 자리 > 0이면 { 정수목록_추가(목록, v). v = 0. 자리 = 0. }
    }
    자리 > 0이면 { 정수목록_추가(목록, v). }
}

(* 0 이상의 정수를 십진 글로 *)
[바이트열 참조 b에 정수 v를 십진넣기]는 {
    정수[24] 자리글.
    정수 k = 0.
    v == 0이면 { 자리글[0] = 48. k = 1. }
    (v > 0)동안 {
        자리글[k] = 48 + v % 10.
        v = v / 10.
        k += 1.
    }
    (k > 0)동안 {
        k -= 1.
        바이트열_넣기(b, 자리글[k]).
    }
}

(* --표: 사전처리표.gl 의 이름마다 정규식을 지어 본다 — 받는 갈래 · 받지 않는 갈래(SentencePiece 꼴 · 빠른 길만 있는 것 · 짓지 못함) *)
[사전처리표시험]는 -> 정수 {
    정수 받음 = 0.
    정수 안받음 = 0.
    정수 번 = 0.
    (사전처리갈래(번) != 없음)동안 {
        문자열 까닭 = 없음.
        아닌 사전처리바이트(번)이면 { 까닭 = "SentencePiece 꼴의 BPE". }
        정수 k = 0.
        (까닭 == 없음 그리고 사전처리정규식(번, k) != 없음)동안 {
            문자열 식 = 사전처리정규식(번, k).
            정규빠른길없음(정규빠른길(식))이면 { 까닭 = "손으로 짠 나누기만 있는 정규식". }
            아니면 정규식짓기(식) == 없음이면 { 까닭 = 정규틀림. }
            k += 1.
        }
        까닭 == 없음이면 {
            쓰기("받음    %lld %s (정규식 %lld)\n", 번, 사전처리갈래(번), k).
            받음 += 1.
        }
        아니면 {
            쓰기("안받음  %lld %s — %s\n", 번, 사전처리갈래(번), 까닭).
            안받음 += 1.
        }
        번 += 1.
    }
    쓰기("사전 처리 표: 이름 묶음 %lld · 받음 %lld · 안받음 %lld\n", 받음 + 안받음, 받음, 안받음).
    반환 0.
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    (argc == 2 그리고 문자열_같은가(argv[1], "--표"))이면 { 반환 사전처리표시험(). }
    argc < 4이면 {
        "사용법: 시험_토큰 <어휘.gguf> <입력.inp> <출력>\n"을 쓰다.
        반환 3.
    }
    GGUF 참조 g = GGUF열기(argv[1]).
    토크나이저열기(g).
    문자열 입력 = 통째읽기(argv[2]).
    입력 == 없음이면 {
        "입력을 읽을 수 없다\n"을 쓰다.
        반환 1.
    }
    정수 n = 통째길이.
    문자열 구분 = "\n__ggml_vocab_test__\n".
    정수 m = 글자수(구분).
    바이트열 참조 나감 = 바이트열_만들기().
    정수 경우수 = 0.
    정수 a = 0.
    (a < n)동안 {
        정수 e = a.
        (e + m <= n 그리고 메모리_비교(입력 + e, 구분, m) != 0)동안 { e += 1. }
        정수 다음 = e + m.
        e + m > n이면 {                                   (* 구분 없는 끝 조각(test-tokenizer-0 처럼 경우 하나) *)
            e = n.
            다음 = n.
        }
        정수목록 참조 ids = 없음.
        e > a이면 {
            정수 저장 = 입력[e] & 255.                        (* 경우 하나를 0 끝 글로 *)
            입력[e] = 0.
            ids = 나누기꼴(입력 + a, 거짓).
            입력[e] = 저장.
        }
        아니면 { ids = 정수목록_만들기(). }
        반복 (정수 k는 0부터 정수목록_길이(ids) 전까지) {
            바이트열_넣기(나감, 32).
            십진넣기(나감, 정수목록_값(ids, k)).
        }
        바이트열_넣기(나감, 10).
        정수목록_해제(ids).
        경우수 += 1.
        a = 다음.
    }
    아닌 통째쓰기(argv[3], 바이트열_자료(나감) 으로 공허 참조, 바이트열_길이(나감))이면 {
        "출력을 쓸 수 없다\n"을 쓰다.
        반환 1.
    }
    쓰기("경우 %lld\n", 경우수).
    반환 0.
}
