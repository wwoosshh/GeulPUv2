(* GeulPUv2 — 긴 문맥 실사용 재기(문서/긴문맥재기.md): 세션이 길어질 때의 세 값.
     (가) 빈 캐시에서 프롬프트 N 토큰 — 프롬프트 길(최대행 1,024 덩이). llama-bench 의 pp N 과 같은 꼴(세션을 처음부터 통째로 넣을 때).
     (나) 세션 깊이 d 를 채운 뒤 새 입력 1,024 토큰 — llama-bench -p 1024 -d d 와 같은 꼴(긴 대화에서 한 차례의 입력 — 캐시를 쓰므로
          새 토큰만 넣지만 새 토큰마다 앞 d 토큰을 어텐션으로 읽는다).
     (다) 깊이 d 에서 생성 걸음 — 서버의 생성과 같은 표 걸음(행 1, 그리고 추측 검증의 행 8), 그래프 50 번 × 세 번의 가운데.
     재기_긴문맥 <gguf> <ptx> <재기 입력(재기_7B 꼴 — 긴 글 ≥ 가장 큰 길이 + 1,024)> <출력> <최대길이> [--빈 N,…] [--깊이 d,…] [--생성끝 N]
       [--rows N]
     (--생성끝 N: 깊이가 N 을 넘으면 (다)를 건너뛴다. --rows N: 프롬프트 청크의 행(기본 1,024 — 서버의 기본은 512, 131,072 근처는 그룹
     상태 버퍼 때문에 512 — 시험_긴문맥 과 같다))
   (가) · (나)는 데우기 한 번 뒤 세 번의 가운데(맞추기 → 넣기 → 맞추기). 출력 줄: "빈 N ms t" · "깊이 d 새 1024 ms t" · "깊이 d 생성 B ms t". *)
포함 "표준/입출력.gl"
포함 "표준/문자열.gl"
포함 "표준/바이트열.gl"
포함 "표준/사전.gl"
포함 "표준/수학.gl"
포함 "표준/시간.gl"
포함 "쿠다.gl"
포함 "파일.gl"
포함 "해시.gl"
포함 "gguf.gl"
포함 "가중치.gl"
포함 "로프.gl"
포함 "토크나이저.gl"
포함 "엔진.gl"

[실수 참조 v를 정수 n을 중앙값]는 -> 실수 {
    반복 (정수 i는 1부터 n 전까지) {
        정수 j = i.
        (j > 0 그리고 v[j - 1] > v[j])동안 {
            실수 t = v[j]. v[j] = v[j - 1]. v[j - 1] = t.
            j -= 1.
        }
    }
    반환 v[n / 2].
}

(* 그래프(계획 주소)를 n 번 — 걸음 하나의 ms (다섯 번 데운 뒤) — 재기_추측 과 같다 *)
[정수 계획을 정수 n을 걸음재기]는 -> 실수 {
    계획 참조 p = 계획으로(계획).
    반복 (정수 i는 0부터 5 전까지) {
        중간정수 r = cuGraphLaunch(p→실행본, 없음).
        r != 0이면 { r를 "그래프 실행(cuGraphLaunch)"으로 쿠다확인하다. }
    }
    공허 참조 e0 = 새이벤트().
    공허 참조 e1 = 새이벤트().
    이벤트기록(e0).
    반복 (정수 i2는 0부터 n 전까지) {
        중간정수 r2 = cuGraphLaunch(p→실행본, 없음).
        r2 != 0이면 { r2를 "그래프 실행(cuGraphLaunch)"으로 쿠다확인하다. }
    }
    이벤트기록(e1).
    실수 ms = 이벤트사이(e0, e1) / (n 으로 실수).
    이벤트없애기(e0).
    이벤트없애기(e1).
    반환 ms.
}

(* "16384,32768" 같은 글에서 정수들을 칸에(최대 개까지) — 개수 *)
[문자열 s를 정수 참조 칸을 정수 최대를 수목록읽기]는 -> 정수 {
    정수 n = 0.
    정수 v = 0.
    참거짓 있음 = 거짓.
    반복 (정수 k = 0: s[k] != 0: k += 1) {
        정수 c = s[k] & 255.
        (c >= 48 그리고 c <= 57)이면 {
            v = v * 10 + (c - 48).
            있음 = 참.
        }
        아니면 {
            (있음 그리고 n < 최대)이면 {
                칸[n] = v.
                n += 1.
            }
            v = 0.
            있음 = 거짓.
        }
    }
    (있음 그리고 n < 최대)이면 {
        칸[n] = v.
        n += 1.
    }
    반환 n.
}

(* 프롬프트 길로 슬롯 0 의 위치 p 부터 토큰 n 개를 넣는 시간(ms) *)
[정수 참조 ids를 정수 n을 정수 p를 잰넣기]는 -> 실수 {
    맞추기().
    실수 t0 = 정밀시각_밀리초().
    슬롯넣기(0, ids, n, p).
    맞추기().
    반환 정밀시각_밀리초() - t0.
}

[정수 argc를 문자열 참조 argv를 시작하기]는 -> 정수 {
    argc < 6이면 { "사용법: 재기_긴문맥 <gguf> <ptx> <재기 입력> <출력> <최대길이> [--빈 N,…] [--깊이 d,…] [--생성끝 N]\n"을 쓰다. 반환 3. }
    문자열 입력 = 통째읽기(argv[3]).
    입력 == 없음이면 { "입력을 읽을 수 없다\n"을 쓰다. 반환 1. }
    정수 o = 0.
    정수 pc = 읽기64(입력, o). o += 8 + pc * 8.
    정수 pl = 읽기64(입력, o). o += 8.
    정수 참조 긴 = (입력 + o) 으로 정수 참조.
    정수 L = 정수로_변환(argv[5]).
    정수[8] 빈들. 정수 빈수 = 0.
    정수[8] 깊이들. 정수 깊이수 = 0.
    정수 생성끝 = 1 << 40.
    정수 행 = 1024.
    반복 (정수 a = 6: a < argc: a += 1) {
        (문자열_같은가(argv[a], "--빈") 그리고 a + 1 < argc)이면 {
            빈수 = 수목록읽기(argv[a + 1], 빈들, 8).
            a += 1.
        }
        아니면 (문자열_같은가(argv[a], "--깊이") 그리고 a + 1 < argc)이면 {
            깊이수 = 수목록읽기(argv[a + 1], 깊이들, 8).
            a += 1.
        }
        아니면 (문자열_같은가(argv[a], "--생성끝") 그리고 a + 1 < argc)이면 {
            생성끝 = 정수로_변환(argv[a + 1]).            (* 깊이가 이보다 크면 생성 걸음은 건너뛴다(생성 길의 접기가 10,240 너머에서 틀린 동안 — 문서/긴문맥재기.md) *)
            a += 1.
        }
        아니면 (문자열_같은가(argv[a], "--rows") 그리고 a + 1 < argc)이면 {
            행 = 정수로_변환(argv[a + 1]).
            a += 1.
        }
        아니면 (문자열_같은가(argv[a], "--far") 그리고 a + 1 < argc)이면 {      (* GeulPUv2 ③c — 앞쪽 그룹의 한도 "행 하나,행 여럿[,넷표 격자]"(엔진.gl) *)
            정수[3] 먼둘.
            정수 먼개수 = 수목록읽기(argv[a + 1], 먼둘, 3).
            먼개수 >= 2이면 { 먼한도 = 먼둘[0]. 먼한도여럿 = 먼둘[1]. }
            먼개수 == 3이면 { 표넷격자 = 먼둘[2]. }
            a += 1.
        }
    }
    반복 (정수 i는 0부터 빈수 전까지) {
        (빈들[i] > pl 또는 빈들[i] > L)이면 { 쓰기("빈 %lld: 긴 글(%lld) · 최대길이(%lld)를 넘는다\n", 빈들[i], pl, L). 반환 1. }
    }
    반복 (정수 i2는 0부터 깊이수 전까지) {
        (깊이들[i2] + 1024 > pl 또는 깊이들[i2] + 1024 > L)이면 { 쓰기("깊이 %lld: 긴 글(%lld) · 최대길이(%lld)에 + 1,024 가 들지 않는다\n", 깊이들[i2], pl, L). 반환 1. }
    }
    쿠다열기().
    GGUF 참조 g = GGUF열기(argv[1]).
    슬롯수 = 1.
    엔진만들기(g, argv[2], 행, L, 걸음행최대).
    판미리고르기().
    표칸준비().
    쓰기("엔진: 최대행 %lld · 최대길이 %lld · 긴 글 %lld · 앞쪽 그룹 %s(한도 %lld · %lld · 넷표 격자 %lld)\n", 행, 최대길이, pl, k조각어텐션묶음표 != 없음 ? "있음" : "없음", 먼한도, 먼한도여럿, 표넷격자).
    바이트열 참조 출력 = 바이트열_만들기().
    (* (가) 빈 캐시에서 N *)
    반복 (정수 ci는 0부터 빈수 전까지) {
        정수 N = 빈들[ci].
        실수[3] 셋.
        반복 (정수 r는 0부터 4 전까지) {
            캐시비우기().
            실수 t = 잰넣기(긴, N, 0).
            r >= 1이면 { 셋[r - 1] = t. }
        }
        실수 m = 중앙값(셋, 3).
        쓰기("빈 %lld ms %.2f\n", N, m).
        바이트열_글넣기(출력, 서식글("빈 %lld ms %.3f\n", N, m)).
        __글_출력비우기().
    }
    (* (나) · (다) 깊이 d *)
    정수[8] 토큰들. 정수[8] 위치들. 정수[8] 슬롯들.
    반복 (정수 di는 0부터 깊이수 전까지) {
        정수 d = 깊이들[di].
        캐시비우기().
        잰넣기(긴, d, 0).
        정수 q = d.                                       (* 생성은 깊이 d 에서(llama-bench 의 tg 와 같다) — 쓴 KV 는 아래 새 입력이 같은 토큰으로 덮는다 *)
        반복 (정수 B = 1: B <= 8: B += 7) {
            d > 생성끝이면 { 계속. }
            반복 (정수 b는 0부터 B 전까지) { 토큰들[b] = 긴[q + b]. 위치들[b] = q + b. 슬롯들[b] = 0. }
            표걸음(B, 토큰들, 위치들, 슬롯들).
            맞추기().
            실수[3] 셋3.
            반복 (정수 r3는 0부터 3 전까지) { 셋3[r3] = 걸음재기(표지금계획 으로 정수, 50). }
            실수 m3 = 중앙값(셋3, 3).
            쓰기("깊이 %lld 생성 %lld ms %.3f\n", d, B, m3).
            바이트열_글넣기(출력, 서식글("깊이 %lld 생성 %lld ms %.4f\n", d, B, m3)).
        }
        실수[3] 셋2.
        반복 (정수 r2는 0부터 4 전까지) {
            실수 t2 = 잰넣기(긴 + d, 1024, d).                (* 같은 위치를 같은 토큰으로 되풀이 — 캐시는 그대로 *)
            r2 >= 1이면 { 셋2[r2 - 1] = t2. }
        }
        실수 m2 = 중앙값(셋2, 3).
        쓰기("깊이 %lld 새 1024 ms %.2f\n", d, m2).
        바이트열_글넣기(출력, 서식글("깊이 %lld 새 1024 ms %.3f\n", d, m2)).
        __글_출력비우기().
    }
    통째쓰기(argv[4], 바이트열_자료(출력), 바이트열_길이(출력)).
    쓰기("오류칸 %lld\n", 엔진오류칸()).
    쿠다닫기().
    반환 0.
}
