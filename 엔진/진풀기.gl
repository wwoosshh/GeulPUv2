(* 0.12.0 12-G1 — jinja 템플릿 해석기의 풀기: 템플릿 글 → 마디 나무. transformers 가 채팅 템플릿에 쓰는 jinja2 환경과 같은 문법 —
   trim_blocks · lstrip_blocks(블록 · 주석 태그), '-' · '+' 공백 다루기, 끝의 줄바꿈 하나 떼기(keep_trailing_newline 거짓), 줄바꿈 맞추기
   (\r\n · \r → \n), loopcontrols(break · continue). 식의 문법과 우선순위는 jinja2 의 parser.py 를 그대로 옮겼다(~ 가 + · − 보다
   단단하다, 거르개 · 시험은 홑셈의 뒤에, 조건식 a if b else c). 풀린 나무는 진틀 하나가 가진다(진틀놓기 로 놓는다). *)
포함 "진값.gl"

(* 마디 종류 — 문장 *)
상수 정수 진글토막 = 1.       (* 글 — 글 · 글길이(원문의 조각) *)
상수 정수 진찍기 = 2.         (* {{ 식 }} — 첫째 = 식 *)
상수 정수 진만약 = 3.         (* if — 첫째 = 조건, 목록 = 몸, 둘째 = 아니면(elif 의 진만약 · else 의 진덩이 · 0) *)
상수 정수 진돌기 = 4.         (* for — 첫째 = 받는 이름(들), 둘째 = 돌 것, 셋째 = 거르는 조건(0), 목록 = 몸, 목록둘 = else 몸 *)
상수 정수 진두기문 = 5.       (* set 이름 = 식 — 첫째 = 받는 것, 둘째 = 식 *)
상수 정수 진덩이두기 = 6.     (* set 이름 … endset — 첫째 = 받는 것, 목록 = 몸 *)
상수 정수 진매크로문 = 7.   (* macro — 글 = 이름, 목록 = 몸, 목록둘 = 매개변수(진이름 — 첫째 = 기본값 식 · 0) *)
상수 정수 진멈춤 = 8.
상수 정수 진넘김 = 9.
상수 정수 진덩이 = 10.        (* 목록 = 문장들 *)
상수 정수 진거르개덩이 = 11.  (* filter … endfilter — 첫째 = 거르개 사슬(맨 안의 받는 값 0), 목록 = 몸 *)
(* 마디 종류 — 식 *)
상수 정수 진상수 = 20.        (* 값 = 마디 *)
상수 정수 진이름 = 21.        (* 글 *)
상수 정수 진속성 = 22.        (* 첫째 = 값, 글 = 이름 *)
상수 정수 진첨자 = 23.        (* 첫째 = 값, 둘째 = 열쇠 식 *)
상수 정수 진자르기 = 24.      (* 첫째 = 값, 목록 = [시작 · 끝 · 걸음] (없으면 0) *)
상수 정수 진부르기 = 25.      (* 첫째 = 부를 것, 목록 = 인자, 목록둘 = 이름 붙은 인자(진열쇠인자) *)
상수 정수 진거르개 = 26.      (* 첫째 = 받는 값(덩이 거르개는 0), 글 = 이름, 목록 · 목록둘 = 인자 *)
상수 정수 진시험 = 27.        (* 첫째 = 값, 글 = 이름, 목록 · 목록둘 = 인자 *)
상수 정수 진셈 = 28.          (* 첫째 · 둘째, 셋째 = 셈(1 + · 2 − · 3 × · 4 / · 5 // · 6 % · 7 거듭제곱) *)
상수 정수 진홑셈 = 29.        (* 첫째, 셋째 = 1 − · 2 + *)
상수 정수 진견주기 = 30.      (* 첫째 = 처음 값, 목록 = 견줌(1 == · 2 != · 3 < · 4 > · 5 <= · 6 >= · 7 in · 8 not in), 목록둘 = 값들 *)
상수 정수 진그리고 = 31.      (* 첫째 · 둘째 *)
상수 정수 진또는 = 32.
상수 정수 진아닌 = 33.        (* 첫째 *)
상수 정수 진조건식 = 34.      (* 첫째 = 조건, 둘째 = 참일 때, 셋째 = 아닐 때(0 이면 Undefined) *)
상수 정수 진목록식 = 35.      (* 목록 *)
상수 정수 진사전식 = 36.      (* 목록 = 열쇠 식, 목록둘 = 값 식 *)
상수 정수 진튜플식 = 37.      (* 목록 *)
상수 정수 진잇기 = 38.        (* ~ — 목록 *)
상수 정수 진열쇠인자 = 39.    (* 이름 = 식 — 글 = 이름, 첫째 = 식 *)
상수 정수 진이름공간참조 = 40. (* set ns.x — 글 = ns, 둘째 = 0, 첫째 = 속성 이름의 진상수(글) *)

묶음 진마디는 정수 종류, 정수 첫째, 정수 둘째, 정수 셋째, 문자열 글, 정수 글길이, 정수목록 참조 목록, 정수목록 참조 목록둘,
    제이슨 참조 값.

(* 풀린 템플릿 — 뿌리 = 진덩이, 원문 = 줄바꿈을 맞춘 베낌(글토막이 가리킨다), 마디들 · 상수들 · 글들 = 놓을 것 *)
묶음 진틀은 진마디 참조 뿌리, 문자열 원문, 정수 원문길이, 정수목록 참조 마디들, 정수목록 참조 상수들, 정수목록 참조 글들.

진틀 참조 진풀틀 = 없음.     (* 풀고 있는 템플릿 *)

[정수 종류를 진새마디]는 -> 진마디 참조 {
    진마디 참조 m = 초기할당(1 을, 크기(진마디)).
    m→종류 = 종류.
    정수목록_추가(진풀틀→마디들, m 으로 정수).
    반환 m.
}

[진마디 참조 m을 진목록주기]는 -> 정수목록 참조 {
    m→목록 == 없음이면 { m→목록 = 정수목록_만들기(). }
    반환 m→목록.
}

[진마디 참조 m을 진목록둘주기]는 -> 정수목록 참조 {
    m→목록둘 == 없음이면 { m→목록둘 = 정수목록_만들기(). }
    반환 m→목록둘.
}

(* 상수 마디(템플릿이 가진다 — 그리기마다 놓지 않는다) *)
[정수 종류를 진상수값]는 -> 제이슨 참조 {
    제이슨 참조 v = 초기할당(1 을, 크기(제이슨)).
    v→종류 = 종류.
    정수목록_추가(진풀틀→상수들, v 으로 정수).
    반환 v.
}

(* 템플릿이 가지는 글(끝에 0) *)
[문자열 s를 정수 n을 진틀글]는 -> 문자열 {
    문자열 p = 할당(n + 1).
    n > 0이면 { 메모리_복사(p 에, s 에서, n 을). }
    p[n] = 0.
    정수목록_추가(진풀틀→글들, p 으로 정수).
    반환 p.
}

[진틀 참조 t를 진틀놓기]는 {
    t == 없음이면 { 반환. }
    반복 (정수 k는 0부터 정수목록_길이(t→마디들) 전까지) {
        진마디 참조 m = 정수목록_값(t→마디들, k) 으로 진마디 참조.
        m→목록 != 없음이면 { 정수목록_해제(m→목록). }
        m→목록둘 != 없음이면 { 정수목록_해제(m→목록둘). }
        해제(m).
    }
    정수목록_해제(t→마디들).
    반복 (정수 k2는 0부터 정수목록_길이(t→상수들) 전까지) { 해제(정수목록_값(t→상수들, k2) 으로 공허 참조). }
    정수목록_해제(t→상수들).
    반복 (정수 k3는 0부터 정수목록_길이(t→글들) 전까지) { 해제(정수목록_값(t→글들, k3) 으로 문자열). }
    정수목록_해제(t→글들).
    t→원문 != 없음이면 { 해제(t→원문). }
    해제(t).
}

(* ===== 나누기 — 글 · {{ }} · {% %} 조각(주석은 버린다)과 공백 다루기 ===== *)

문자열 진원 = 없음.
정수 진원길이 = 0.
정수목록 참조 진조각들 = 없음.     (* 조각마다 (종류 0 글 · 1 {{ }} · 2 {% %}, 시작, 끝) *)

[정수 c를 진빈칸인가]는 -> 참거짓 { 반환 c == 32 또는 (c >= 9 그리고 c <= 13). }

[정수 종류를 정수 시작을 정수 끝을 진조각넣기]는 {
    정수목록_추가(진조각들, 종류).
    정수목록_추가(진조각들, 시작).
    정수목록_추가(진조각들, 끝).
}

(* 자리 i 의 태그 시작 — 0 아님 · 1 {{ · 2 {% · 3 {# *)
[정수 i를 진태그시작]는 -> 정수 {
    (i + 1 >= 진원길이 또는 (진원[i] & 255) != 123)이면 { 반환 0. }
    정수 c = 진원[i + 1] & 255.
    c == 123이면 { 반환 1. }
    c == 37이면 { 반환 2. }
    c == 35이면 { 반환 3. }
    반환 0.
}

정수 진끝꾸밈 = 0.      (* 찾은 태그 끝 앞의 '-'(45) · '+'(43) · 0 *)

(* 태그 안쪽의 끝(닫는 두 글자 '}}' · '%}' 의 앞 — 꾸밈 글자가 있으면 그 앞) — 글 · 괄호 안은 건너뛴다. 없으면 −1 *)
[정수 자리를 정수 종류를 진태그끝]는 -> 정수 {
    정수 닫음 = 125.
    종류 == 2이면 { 닫음 = 37. }
    정수 깊이 = 0.
    정수 i = 자리.
    (i < 진원길이)동안 {
        정수 c = 진원[i] & 255.
        (c == 39 또는 c == 34)이면 {
            i += 1.
            (i < 진원길이 그리고 (진원[i] & 255) != c)동안 {
                (진원[i] & 255) == 92이면 { i += 2. } 아니면 { i += 1. }
            }
            i += 1.
            계속.
        }
        깊이 == 0이면 {
            (c == 45 또는 c == 43)이면 {
                (i + 2 < 진원길이 그리고 (진원[i + 1] & 255) == 닫음 그리고 (진원[i + 2] & 255) == 125)이면 {
                    (c == 45 또는 종류 == 2)이면 {
                        진끝꾸밈 = c.
                        반환 i.
                    }
                }
            }
            (c == 닫음 그리고 i + 1 < 진원길이 그리고 (진원[i + 1] & 255) == 125)이면 {
                진끝꾸밈 = 0.
                반환 i.
            }
        }
        (c == 40 또는 c == 91 또는 c == 123)이면 { 깊이 += 1. }
        아니면 ((c == 41 또는 c == 93 또는 c == 125) 그리고 깊이 > 0)이면 { 깊이 -= 1. }
        i += 1.
    }
    반환 -1.
}

(* [a, b) 가 모두 공백(비지 않음)인가 *)
[정수 a를 정수 b를 진모두빈칸인가]는 -> 참거짓 {
    a >= b이면 { 반환 거짓. }
    반복 (정수 k = a: k < b: k += 1) {
        아닌 진빈칸인가(진원[k] & 255)이면 { 반환 거짓. }
    }
    반환 참.
}

(* 태그 안쪽 [a, b) 의 앞뒤 공백을 뺀 글이 낱말 w 인가 *)
[정수 a를 정수 b를 문자열 w를 진안쪽낱말인가]는 -> 참거짓 {
    (a < b 그리고 진빈칸인가(진원[a] & 255))동안 { a += 1. }
    (b > a 그리고 진빈칸인가(진원[b - 1] & 255))동안 { b -= 1. }
    정수 m = 글자수(w).
    b - a != m이면 { 반환 거짓. }
    반환 메모리_비교(진원 + a, w, m) == 0.
}

(* {% endraw %} 찾기(자리부터) — 태그의 시작 자리, 진끝꾸밈 · 진날끝 = 끝 다음 자리 *)
정수 진날끝 = 0.
[정수 자리를 진날끝찾기]는 -> 정수 {
    반복 (정수 i = 자리: i + 1 < 진원길이: i += 1) {
        진태그시작(i) == 2이면 {
            정수 a = i + 2.
            (a < 진원길이 그리고 ((진원[a] & 255) == 45 또는 (진원[a] & 255) == 43))이면 { a += 1. }
            정수 e = 진태그끝(a, 2).
            (e >= 0 그리고 진안쪽낱말인가(a, e, "endraw"))이면 {
                진날끝 = e + 2.
                진끝꾸밈 != 0이면 { 진날끝 += 1. }
                반환 i.
            }
        }
    }
    반환 -1.
}

(* 원문을 조각으로 — 틀리면 거짓(진오류) *)
[진나누기]는 -> 참거짓 {
    정수 자리 = 0.
    참거짓 줄시작 = 참.
    (자리 < 진원길이)동안 {
        정수 찾음 = -1.
        정수 종류 = 0.
        반복 (정수 i = 자리: i + 1 < 진원길이: i += 1) {
            정수 t = 진태그시작(i).
            t != 0이면 {
                찾음 = i.
                종류 = t.
                탈출.
            }
        }
        찾음 < 0이면 {
            진조각넣기(0, 자리, 진원길이).
            반환 참.
        }
        정수 왼꾸밈 = 0.
        (찾음 + 2 < 진원길이 그리고 ((진원[찾음 + 2] & 255) == 45 또는 (진원[찾음 + 2] & 255) == 43))이면 { 왼꾸밈 = 진원[찾음 + 2] & 255. }
        정수 글끝 = 찾음.
        왼꾸밈 == 45이면 {
            (글끝 > 자리 그리고 진빈칸인가(진원[글끝 - 1] & 255))동안 { 글끝 -= 1. }
        }
        아니면 (왼꾸밈 != 43 그리고 종류 != 1)이면 {
            정수 줄자리 = 자리.
            참거짓 줄있음 = 거짓.
            반복 (정수 k = 글끝 - 1: k >= 자리: k -= 1) {
                (진원[k] & 255) == 10이면 {
                    줄자리 = k + 1.
                    줄있음 = 참.
                    탈출.
                }
            }
            ((줄있음 또는 줄시작) 그리고 진모두빈칸인가(줄자리, 글끝))이면 { 글끝 = 줄자리. }
        }
        글끝 > 자리이면 { 진조각넣기(0, 자리, 글끝). }
        정수 안시작 = 찾음 + 2.
        왼꾸밈 != 0이면 { 안시작 += 1. }
        정수 다음 = 0.
        정수 오른꾸밈 = 0.
        종류 == 3이면 {
            정수 j = -1.
            반복 (정수 i2 = 안시작: i2 + 1 < 진원길이: i2 += 1) {
                ((진원[i2] & 255) == 35 그리고 (진원[i2 + 1] & 255) == 125)이면 {
                    j = i2.
                    탈출.
                }
            }
            j < 0이면 {
                진틀림("틀 문법 오류: 주석이 끝나지 않았다").
                반환 거짓.
            }
            (j - 1 >= 안시작 그리고 ((진원[j - 1] & 255) == 45 또는 (진원[j - 1] & 255) == 43))이면 { 오른꾸밈 = 진원[j - 1] & 255. }
            다음 = j + 2.
        }
        아니면 {
            정수 e = 진태그끝(안시작, 종류).
            e < 0이면 {
                진틀림("틀 문법 오류: 태그가 끝나지 않았다").
                반환 거짓.
            }
            오른꾸밈 = 진끝꾸밈.
            다음 = e + 2.
            오른꾸밈 != 0이면 { 다음 += 1. }
            (종류 == 2 그리고 진안쪽낱말인가(안시작, e, "raw"))이면 {
                (* {% raw %} … {% endraw %} — 안은 글 그대로 *)
                오른꾸밈 == 45이면 {
                    (다음 < 진원길이 그리고 진빈칸인가(진원[다음] & 255))동안 { 다음 += 1. }
                }
                아니면 (오른꾸밈 != 43 그리고 다음 < 진원길이 그리고 (진원[다음] & 255) == 10)이면 { 다음 += 1. }
                정수 r = 진날끝찾기(다음).
                r < 0이면 {
                    진틀림("틀 문법 오류: raw 가 끝나지 않았다").
                    반환 거짓.
                }
                정수 r끝 = r.
                (r + 2 < 진원길이 그리고 (진원[r + 2] & 255) == 45)이면 {
                    (r끝 > 다음 그리고 진빈칸인가(진원[r끝 - 1] & 255))동안 { r끝 -= 1. }
                }
                r끝 > 다음이면 { 진조각넣기(0, 다음, r끝). }
                다음 = 진날끝.
                오른꾸밈 = 진끝꾸밈.
            }
            아니면 { 진조각넣기(종류, 안시작, e). }
        }
        오른꾸밈 == 45이면 {
            (다음 < 진원길이 그리고 진빈칸인가(진원[다음] & 255))동안 { 다음 += 1. }
        }
        아니면 (종류 != 1 그리고 오른꾸밈 != 43 그리고 다음 < 진원길이 그리고 (진원[다음] & 255) == 10)이면 { 다음 += 1. }
        줄시작 = 다음 > 0 그리고 (진원[다음 - 1] & 255) == 10.
        자리 = 다음.
    }
    반환 참.
}

(* ===== 식의 토큰 ===== *)

정수 진식자리 = 0.
정수 진식끝 = 0.
정수 진토종류 = 0.        (* 0 끝 · 1 이름 · 2 글 · 3 정수 · 4 실수 · 5 연산 *)
정수 진토시작 = 0.
정수 진토길이 = 0.
정수 진토정수 = 0.
실수 진토실수 = 0.0.
정수 진토연산 = 0.        (* 한 글자는 그 글자, // 1001 · ** 1002 · == 1003 · != 1004 · <= 1005 · >= 1006 *)
바이트열 참조 진토글 = 없음.

[정수 c를 진이름글자인가]는 -> 참거짓 { 반환 (c >= 65 그리고 c <= 90) 또는 (c >= 97 그리고 c <= 122) 또는 c == 95 또는 (c >= 48 그리고 c <= 57) 또는 c >= 128. }
[정수 c를 진숫자글자인가]는 -> 참거짓 { 반환 c >= 48 그리고 c <= 57. }

[정수 c를 진십육값]는 -> 정수 {
    (c >= 48 그리고 c <= 57)이면 { 반환 c - 48. }
    (c >= 65 그리고 c <= 70)이면 { 반환 c - 55. }
    (c >= 97 그리고 c <= 102)이면 { 반환 c - 87. }
    반환 -1.
}

(* 코드포인트를 UTF-8 로 *)
[바이트열 참조 b에 정수 cp를 진UTF8넣기]는 {
    cp < 128이면 { 바이트열_넣기(b, cp). 반환. }
    cp < 2048이면 {
        바이트열_넣기(b, 192 | (cp >> 6)).
        바이트열_넣기(b, 128 | (cp & 63)).
        반환.
    }
    cp < 65536이면 {
        바이트열_넣기(b, 224 | (cp >> 12)).
        바이트열_넣기(b, 128 | ((cp >> 6) & 63)).
        바이트열_넣기(b, 128 | (cp & 63)).
        반환.
    }
    바이트열_넣기(b, 240 | (cp >> 18)).
    바이트열_넣기(b, 128 | ((cp >> 12) & 63)).
    바이트열_넣기(b, 128 | ((cp >> 6) & 63)).
    바이트열_넣기(b, 128 | (cp & 63)).
}

(* 글 토큰 [a, b) (따옴표 안쪽)의 값을 진토글에 — 파이썬의 unicode-escape *)
[정수 a를 정수 b를 진글풀기]는 {
    진토글→길이 = 0.
    정수 i = a.
    (i < b)동안 {
        정수 c = 진원[i] & 255.
        (c != 92 또는 i + 1 >= b)이면 {
            바이트열_넣기(진토글, c).
            i += 1.
            계속.
        }
        정수 d = 진원[i + 1] & 255.
        i += 2.
        d == 110이면 { 바이트열_넣기(진토글, 10). }
        아니면 d == 116이면 { 바이트열_넣기(진토글, 9). }
        아니면 d == 114이면 { 바이트열_넣기(진토글, 13). }
        아니면 (d == 92 또는 d == 39 또는 d == 34)이면 { 바이트열_넣기(진토글, d). }
        아니면 d == 98이면 { 바이트열_넣기(진토글, 8). }
        아니면 d == 102이면 { 바이트열_넣기(진토글, 12). }
        아니면 d == 118이면 { 바이트열_넣기(진토글, 11). }
        아니면 d == 97이면 { 바이트열_넣기(진토글, 7). }
        아니면 d == 10이면 { }
        아니면 (d == 120 또는 d == 117 또는 d == 85)이면 {
            정수 자릿수 = 2.
            d == 117이면 { 자릿수 = 4. }
            d == 85이면 { 자릿수 = 8. }
            정수 v = 0.
            참거짓 맞음 = i + 자릿수 <= b.
            반복 (정수 k는 0부터 자릿수 전까지) {
                맞음이면 {
                    정수 h = 진십육값(진원[i + k] & 255).
                    h < 0이면 { 맞음 = 거짓. } 아니면 { v = v * 16 + h. }
                }
            }
            (아닌 맞음 또는 v > 1114111)이면 {
                진틀림("틀 문법 오류: 글의 \\x · \\u 탈출이 틀렸다").
                반환.
            }
            진UTF8넣기(진토글, v).
            i += 자릿수.
        }
        아니면 (d >= 48 그리고 d <= 55)이면 {
            정수 v2 = d - 48.
            정수 k2 = 0.
            (k2 < 2 그리고 i < b 그리고 (진원[i] & 255) >= 48 그리고 (진원[i] & 255) <= 55)동안 {
                v2 = v2 * 8 + ((진원[i] & 255) - 48).
                i += 1.
                k2 += 1.
            }
            진UTF8넣기(진토글, v2).
        }
        아니면 {
            바이트열_넣기(진토글, 92).
            바이트열_넣기(진토글, d).
        }
    }
}

(* 다음 토큰 *)
[진토읽기]는 {
    (진식자리 < 진식끝 그리고 진빈칸인가(진원[진식자리] & 255))동안 { 진식자리 += 1. }
    진토시작 = 진식자리.
    진식자리 >= 진식끝이면 {
        진토종류 = 0.
        진토길이 = 0.
        반환.
    }
    정수 c = 진원[진식자리] & 255.
    ((c >= 65 그리고 c <= 90) 또는 (c >= 97 그리고 c <= 122) 또는 c == 95 또는 c >= 128)이면 {
        (진식자리 < 진식끝 그리고 진이름글자인가(진원[진식자리] & 255))동안 { 진식자리 += 1. }
        진토종류 = 1.
        진토길이 = 진식자리 - 진토시작.
        반환.
    }
    진숫자글자인가(c)이면 {
        정수 v = 0.
        (진식자리 < 진식끝 그리고 (진숫자글자인가(진원[진식자리] & 255) 또는 (진원[진식자리] & 255) == 95))동안 {
            (진원[진식자리] & 255) != 95이면 { v = v * 10 + ((진원[진식자리] & 255) - 48). }
            진식자리 += 1.
        }
        참거짓 실수꼴 = 거짓.
        (진식자리 + 1 < 진식끝 그리고 (진원[진식자리] & 255) == 46 그리고 진숫자글자인가(진원[진식자리 + 1] & 255))이면 {
            실수꼴 = 참.
            진식자리 += 1.
            (진식자리 < 진식끝 그리고 (진숫자글자인가(진원[진식자리] & 255) 또는 (진원[진식자리] & 255) == 95))동안 { 진식자리 += 1. }
        }
        (진식자리 < 진식끝 그리고 ((진원[진식자리] & 255) == 101 또는 (진원[진식자리] & 255) == 69))이면 {
            정수 e = 진식자리 + 1.
            (e < 진식끝 그리고 ((진원[e] & 255) == 43 또는 (진원[e] & 255) == 45))이면 { e += 1. }
            (e < 진식끝 그리고 진숫자글자인가(진원[e] & 255))이면 {
                실수꼴 = 참.
                진식자리 = e.
                (진식자리 < 진식끝 그리고 진숫자글자인가(진원[진식자리] & 255))동안 { 진식자리 += 1. }
            }
        }
        진토길이 = 진식자리 - 진토시작.
        실수꼴이면 {
            바이트열 참조 nb = 바이트열_만들기().
            반복 (정수 k = 진토시작: k < 진식자리: k += 1) {
                (진원[k] & 255) != 95이면 { 바이트열_넣기(nb, 진원[k] & 255). }
            }
            바이트열_넣기(nb, 0).
            진토실수 = 실수로_변환(바이트열_자료(nb)).
            바이트열_해제(nb).
            진토종류 = 4.
        }
        아니면 {
            진토정수 = v.
            진토종류 = 3.
        }
        반환.
    }
    (c == 39 또는 c == 34)이면 {
        정수 i = 진식자리 + 1.
        (i < 진식끝 그리고 (진원[i] & 255) != c)동안 {
            (진원[i] & 255) == 92이면 { i += 2. } 아니면 { i += 1. }
        }
        i >= 진식끝이면 {
            진틀림("틀 문법 오류: 글이 끝나지 않았다").
            진토종류 = 0.
            반환.
        }
        진글풀기(진식자리 + 1, i).
        진식자리 = i + 1.
        진토종류 = 2.
        진토길이 = 진식자리 - 진토시작.
        반환.
    }
    진토종류 = 5.
    정수 d = 0.
    진식자리 + 1 < 진식끝이면 { d = 진원[진식자리 + 1] & 255. }
    (c == 47 그리고 d == 47)이면 { 진토연산 = 1001. 진식자리 += 2. }
    아니면 (c == 42 그리고 d == 42)이면 { 진토연산 = 1002. 진식자리 += 2. }
    아니면 (c == 61 그리고 d == 61)이면 { 진토연산 = 1003. 진식자리 += 2. }
    아니면 (c == 33 그리고 d == 61)이면 { 진토연산 = 1004. 진식자리 += 2. }
    아니면 (c == 60 그리고 d == 61)이면 { 진토연산 = 1005. 진식자리 += 2. }
    아니면 (c == 62 그리고 d == 61)이면 { 진토연산 = 1006. 진식자리 += 2. }
    아니면 {
        진토연산 = c.
        진식자리 += 1.
    }
    진토길이 = 진식자리 - 진토시작.
}

(* 지금 토큰이 이름 w 인가 *)
[문자열 w를 진토이름인가]는 -> 참거짓 {
    진토종류 != 1이면 { 반환 거짓. }
    정수 m = 글자수(w).
    진토길이 != m이면 { 반환 거짓. }
    반환 메모리_비교(진원 + 진토시작, w, m) == 0.
}

[정수 op를 진토연산인가]는 -> 참거짓 { 반환 진토종류 == 5 그리고 진토연산 == op. }

(* 다음 토큰이 이름 w 인가(읽지 않고 본다) *)
[문자열 w를 진다음이름인가]는 -> 참거짓 {
    정수 i = 진식자리.
    (i < 진식끝 그리고 진빈칸인가(진원[i] & 255))동안 { i += 1. }
    정수 m = 글자수(w).
    i + m > 진식끝이면 { 반환 거짓. }
    메모리_비교(진원 + i, w, m) != 0이면 { 반환 거짓. }
    (i + m < 진식끝 그리고 진이름글자인가(진원[i + m] & 255))이면 { 반환 거짓. }
    반환 참.
}

[문자열 무엇을 진문법틀림]는 -> 진마디 참조 {
    진틀림이름("틀 문법 오류: ", 무엇, 글자수(무엇), "").
    반환 없음.
}

[정수 op를 진연산받기]는 -> 참거짓 {
    아닌 진토연산인가(op)이면 {
        바이트열 참조 b = 바이트열_만들기().
        날글넣기(b, "틀 문법 오류: '").
        op < 1000이면 { 바이트열_넣기(b, op). }
        날글넣기(b, "' 가 와야 하는데 '").
        진토길이 > 0이면 { 바이트열_붙이기(b, 진원 + 진토시작, 진토길이). } 아니면 { 날글넣기(b, "끝"). }
        날글넣기(b, "'").
        바이트열_넣기(b, 0).
        진틀림(바이트열_자료(b)).
        바이트열_해제(b).
        반환 거짓.
    }
    진토읽기().
    반환 참.
}

(* 지금 토큰(이름)의 글을 템플릿의 글로 *)
[진토이름글]는 -> 문자열 { 반환 진틀글(진원 + 진토시작, 진토길이). }

(* ===== 식 ===== *)

[진이름식만들기]는 -> 진마디 참조 {
    진마디 참조 m = 진새마디(진이름).
    m→글 = 진토이름글().
    m→글길이 = 진토길이.
    반환 m.
}

[제이슨 참조 v를 진상수식]는 -> 진마디 참조 {
    진마디 참조 m = 진새마디(진상수).
    m→값 = v.
    반환 m.
}

(* 끝인가 — 지금 토큰이 식의 끝(태그 끝 · 닫는 괄호 · 끝말) *)
[문자열 끝말들을 진튜플끝인가]는 -> 참거짓 {
    진토종류 == 0이면 { 반환 참. }
    (진토연산인가(41) 또는 진토연산인가(93) 또는 진토연산인가(125))이면 { 반환 참. }
    (끝말들 != 없음 그리고 진토종류 == 1)이면 {
        바이트열 참조 b = 바이트열_만들기().
        바이트열_넣기(b, 32).
        바이트열_붙이기(b, 진원 + 진토시작, 진토길이).
        바이트열_넣기(b, 32).
        바이트열_넣기(b, 0).
        참거짓 있음 = 문자열_포함(끝말들 에서, 바이트열_자료(b)).
        바이트열_해제(b).
        반환 있음.
    }
    반환 거짓.
}

(* parse_tuple — 쉼표가 있으면 튜플. 간단(이름 · 으뜸만) · 조건식 허용 · 괄호 안(빈 튜플 허용) *)
[참거짓 간단을 참거짓 조건식을 참거짓 괄호안을 문자열 끝말들을 진튜플풀기]는 -> 진마디 참조 {
    진마디 참조 t = 진새마디(진튜플식).
    정수목록 참조 원소 = 진목록주기(t).
    참거짓 튜플임 = 거짓.
    (참)동안 {
        정수목록_길이(원소) > 0이면 {
            아닌 진연산받기(44)이면 { 반환 없음. }
        }
        진튜플끝인가(끝말들)이면 { 탈출. }
        진마디 참조 e = 없음.
        간단이면 { e = 진으뜸풀기(). }
        아니면 조건식이면 { e = 진식풀기(). }
        아니면 { e = 진또는풀기(). }
        진틀렸음이면 { 반환 없음. }
        정수목록_추가(원소, e 으로 정수).
        진토연산인가(44)이면 { 튜플임 = 참. } 아니면 { 탈출. }
    }
    아닌 튜플임이면 {
        정수목록_길이(원소) > 0이면 { 반환 정수목록_값(원소, 0) 으로 진마디 참조. }
        아닌 괄호안이면 { 반환 진문법틀림("식이 와야 한다"). }
    }
    반환 t.
}

(* 풀기의 겹침 깊이 — 망가진 템플릿의 '((((…' 가 스택을 넘기지 않게 *)
정수 진풀깊이 = 0.
상수 정수 진풀깊이한도 = 40.

(* parse_expression(조건식 포함) *)
[진식풀기]는 -> 진마디 참조 {
    진풀깊이 += 1.
    진풀깊이 > 진풀깊이한도이면 { 반환 진문법틀림("식이 너무 깊이 겹쳤다"). }
    진마디 참조 결 = 진식풀기안().
    진풀깊이 -= 1.
    반환 결.
}

[진식풀기안]는 -> 진마디 참조 {
    진마디 참조 e1 = 진또는풀기().
    진틀렸음이면 { 반환 없음. }
    (진토이름인가("if"))동안 {
        진토읽기().
        진마디 참조 e2 = 진또는풀기().
        진틀렸음이면 { 반환 없음. }
        진마디 참조 e3 = 없음.
        진토이름인가("else")이면 {
            진토읽기().
            e3 = 진식풀기().
            진틀렸음이면 { 반환 없음. }
        }
