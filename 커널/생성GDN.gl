(* 0.12.0 12-3e-2 — Qwen3.5 의 선형 어텐션 GDN(계약 4.10 — 계약/계약.md 4 절 10)의 판. 커널생성 … --GDN 이 모듈 끝에 붙인다(시험 —
   시험/판GDN.py, 엔진은 12-3e-3). 판 다섯:
     GDN합성곱      채널마다 커널 4 의 인과 합성곱(앞 행은 합성곱 상태) + SiLU — 행 · 채널마다 스레드 하나
     GDN합성곱상태  합성곱 상태 [3][채널] 를 이 덩이의 끝 세 행으로(제자리 — 채널마다 스레드 하나, 행 0 · 1 · 2 차례)
     GDN정규화      q · k 의 헤드(128)마다 L2 정규화(머리정규화128 과 같은 접기), q 는 × c_k — 워프 하나 = (행, 헤드) 하나, 제자리
     GDN게이트값    v 헤드마다 β = σ(b), γ = 적힌지수(softplus(a + dt) · A)
     GDN순환        v 헤드마다 상태 S[i][j](128 × 128 짧은실수)를 토큰 차례로 — 열 j 마다 스레드 넷(행 블록 b = 레인 % 4 — 블록마다 S 의 32 칸을
                    레지스터에), 열 합은 블록마다 곱해더하기 사슬 32 걸음과 레인 둘의 트리((P₀ + P₁) + (P₂ + P₃) — 덧셈은 바꿈 법칙이라 네 레인이 같은 값)
   덩이의 행 배치: y [행][채널] = [q (k머리 · 128) | k (k머리 · 128) | v (v머리 · 128)] — 합성곱 · 정규화가 제자리로 쓴다 *)

(* 새 짧은실수 dst = silu(x) — 계약 4.3 의 s(SwiGLU식 의 정밀 판과 같은 식) *)
[문자열 dst를 문자열 x를 문자열 ind를 문자열 접을 실루식]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{ind}짧은실수 sa{접} = 0.0 - 큰쪽({x}, 0.0 - {x}).")).
    줄들(L, 적힌지수식(서식글("짧은실수 se{접}"), 서식글("sa{접}"), ind, 서식글("s{접}"))).
    줄(L, 서식글("{ind}짧은실수 sd{접} = 1.0 + se{접}.")).
    줄(L, 서식글("{ind}짧은실수 {dst} = {x} / sd{접}.")).
    줄(L, 서식글("{ind}{x} < 0.0이면 \{ {dst} = ({x} * se{접}) / sd{접}. \}")).
    반환 L.
}

(* 새 짧은실수 dst = σ(x) — 계약 4.9: e = 적힌지수(0 − |x|), x ≥ 0 이면 1 / (1 + e), 아니면 e / (1 + e) *)
[문자열 dst를 문자열 x를 문자열 ind를 문자열 접을 시그모이드식]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{ind}짧은실수 ta{접} = 0.0 - 큰쪽({x}, 0.0 - {x}).")).
    줄들(L, 적힌지수식(서식글("짧은실수 te{접}"), 서식글("ta{접}"), ind, 서식글("t{접}"))).
    줄(L, 서식글("{ind}짧은실수 td{접} = 1.0 + te{접}.")).
    줄(L, 서식글("{ind}짧은실수 {dst} = 1.0 / td{접}.")).
    줄(L, 서식글("{ind}{x} < 0.0이면 \{ {dst} = te{접} / td{접}. \}")).
    반환 L.
}

(* 새 짧은실수 dst = log1p(x), 0 ≤ x ≤ 1 — 계약 4.10 4(fdlibm s_log1pf.c 를 [0, 1] 로 줄인 식, 상수는 그 짧은실수) *)
[문자열 dst를 문자열 x를 문자열 ind를 문자열 접을 로그1p식]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{ind}짧은실수 lu{접} = 1.0 + {x}.")).
    줄(L, 서식글("{ind}짧은실수 lc{접} = {x} - (lu{접} - 1.0).")).
    줄(L, 서식글("{ind}짧은실수 lm{접} = lu{접}.")).
    줄(L, 서식글("{ind}짧은실수 lh{접} = 0.0.")).
    줄(L, 서식글("{ind}짧은실수 ll{접} = 0.0.")).
    줄(L, 서식글("{ind}lu{접} >= 1.41421353816986083984375이면 \{ lm{접} = lu{접} * 0.5. lh{접} = 0.69313812255859375. ll{접} = 0.0000090580006144591607153415679931640625. \}")).
    줄(L, 서식글("{ind}짧은실수 lf{접} = lm{접} - 1.0.")).
    줄(L, 서식글("{ind}짧은실수 ls{접} = lf{접} / (2.0 + lf{접}).")).
    줄(L, 서식글("{ind}짧은실수 lz{접} = ls{접} * ls{접}.")).
    줄(L, 서식글("{ind}짧은실수 lq{접} = (0.5 * lf{접}) * lf{접}.")).
    줄(L, 서식글("{ind}짧은실수 lt{접} = 곱해더하기(0.14798198640346527099609375, lz{접}, 0.15313838422298431396484375).")).
    줄(L, 서식글("{ind}lt{접} = 곱해더하기(lt{접}, lz{접}, 0.18183572590351104736328125).")).
    줄(L, 서식글("{ind}lt{접} = 곱해더하기(lt{접}, lz{접}, 0.22222198545932769775390625).")).
    줄(L, 서식글("{ind}lt{접} = 곱해더하기(lt{접}, lz{접}, 0.2857142984867095947265625).")).
    줄(L, 서식글("{ind}lt{접} = 곱해더하기(lt{접}, lz{접}, 0.4000000059604644775390625).")).
    줄(L, 서식글("{ind}lt{접} = 곱해더하기(lt{접}, lz{접}, 0.666666686534881591796875).")).
    줄(L, 서식글("{ind}짧은실수 lr{접} = lz{접} * lt{접}.")).
    줄(L, 서식글("{ind}짧은실수 lb{접} = ll{접} + lc{접} / lu{접}.")).
    줄(L, 서식글("{ind}짧은실수 li{접} = lq{접} - (ls{접} * (lq{접} + lr{접}) + lb{접}).")).
    줄(L, 서식글("{ind}짧은실수 {dst} = lh{접} - (li{접} - lf{접}).")).
    반환 L.
}

[GDN합성곱판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.12.0 12-3e-2 — GDN 합성곱(계약 4.10 2): y = w₀ · x(t−3), 곱해더하기 w₁ · w₂ · w₃ 차례, t 앞의 행은 상태 [3][채널](행 0 이 가장 오래된), 그다음 SiLU *)").
    줄(L, "[짧은실수 참조 입력에서 짧은실수 참조 가중에서 짧은실수 참조 상태에서 짧은실수 참조 출력에 정수 행수로 정수 채널로 GDN합성곱]는 \{").
    줄(L, "    정수 i = 실행번호().").
    줄(L, "    i < 행수 * 채널이면 \{").
    줄(L, "        정수 t = i / 채널.").
    줄(L, "        정수 c = i % 채널.").
    줄(L, "        짧은실수 x0 = 0.0.").
    줄(L, "        짧은실수 x1 = 0.0.").
    줄(L, "        짧은실수 x2 = 0.0.").
    줄(L, "        t >= 3이면 \{ x0 = 입력[(t - 3) * 채널 + c]. \} 아니면 \{ x0 = 상태[t * 채널 + c]. \}").
    줄(L, "        t >= 2이면 \{ x1 = 입력[(t - 2) * 채널 + c]. \} 아니면 \{ x1 = 상태[(t + 1) * 채널 + c]. \}").
    줄(L, "        t >= 1이면 \{ x2 = 입력[(t - 1) * 채널 + c]. \} 아니면 \{ x2 = 상태[(t + 2) * 채널 + c]. \}").
    줄(L, "        짧은실수 cy = 가중[c * 4] * x0.").
    줄(L, "        cy = 곱해더하기(가중[c * 4 + 1], x1, cy).").
    줄(L, "        cy = 곱해더하기(가중[c * 4 + 2], x2, cy).").
    줄(L, "        cy = 곱해더하기(가중[c * 4 + 3], 입력[i], cy).").
    줄들(L, 실루식("cs", "cy", "        ", "c")).
    줄(L, "        출력[i] = cs.").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

[GDN합성곱상태판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.12.0 12-3e-2 — GDN 합성곱 상태를 이 덩이(행수 행)의 끝 세 행으로 — 행 r 은 입력의 행 행수 − 3 + r, 그 행이 덩이 앞이면 옛 상태의 행 행수 + r *)").
    줄(L, "[짧은실수 참조 입력에서 짧은실수 참조 상태에 정수 행수로 정수 채널로 GDN합성곱상태]는 \{").
    줄(L, "    정수 c = 실행번호().").
    줄(L, "    c < 채널이면 \{").
    반복 (정수 r는 0부터 3 전까지) {
        줄(L, 서식글("        행수 - 3 + {r} >= 0이면 \{ 상태[{r} * 채널 + c] = 입력[(행수 - 3 + {r}) * 채널 + c]. \} 아니면 \{ 상태[{r} * 채널 + c] = 상태[(행수 + {r}) * 채널 + c]. \}")).
    }
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

[GDN정규화판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.12.0 12-3e-2 — q · k 의 헤드(128)마다 L2 정규화(계약 4.10 3 — 머리정규화128 의 접기): r = 1 / max(제곱근(S), eps), y = x · r, q 는 × c_k *)").
    줄(L, "[짧은실수 참조 y에 정수 행수로 정수 k머리로 정수 채널로 GDN정규화]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 w = 블록가로() * 4 + tid / 32.").
    줄(L, "    w < 행수 * k머리 * 2이면 \{").
    줄(L, "        정수 hh = w % (k머리 * 2).").
    줄(L, "        정수 바탕 = (w / (k머리 * 2)) * 채널 + hh * 128 + lane.").
    반복 (정수 i는 0부터 4 전까지) { 줄(L, 서식글("        짧은실수 x{i} = y[바탕 + {32 * i}].")). }
    줄(L, "        짧은실수 s = (x0 * x0 + x2 * x2) + (x1 * x1 + x3 * x3).").
    반복 (정수 k = 16: k >= 1: k = k / 2) { 줄(L, 서식글("        s = s + 레인에서받기(s, lane ^ {k}).")). }
    줄(L, 서식글("        짧은실수 역 = 1.0 / 큰쪽(제곱근(s), {RMS_eps}).")).
    줄(L, "        hh < k머리이면 \{").
    반복 (정수 i2는 0부터 4 전까지) { 줄(L, 서식글("            y[바탕 + {32 * i2}] = (x{i2} * 역) * 0.088388346135616302490234375.")). }
    줄(L, "        \}").
    줄(L, "        아니면 \{").
    반복 (정수 i3는 0부터 4 전까지) { 줄(L, 서식글("            y[바탕 + {32 * i3}] = x{i3} * 역.")). }
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

[GDN게이트값판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.12.0 12-3e-2 — v 헤드마다 β = σ(b), u = a + dt, sp = u > 0 이면 u + L 아니면 L(L = log1p(적힌지수(0 − |u|))), γ = 적힌지수(sp · A) — 계약 4.10 4 *)").
    줄(L, "[짧은실수 참조 b에서 짧은실수 참조 a에서 짧은실수 참조 dt에서 짧은실수 참조 감쇠에서 짧은실수 참조 베타에 짧은실수 참조 감마에 정수 행수로 정수 v머리로 GDN게이트값]는 \{").
    줄(L, "    정수 i = 실행번호().").
    줄(L, "    i < 행수 * v머리이면 \{").
    줄(L, "        정수 h = i % v머리.").
    줄(L, "        짧은실수 bx = b[i].").
    줄들(L, 시그모이드식("bt", "bx", "        ", "b")).
    줄(L, "        베타[i] = bt.").
    줄(L, "        짧은실수 u = a[i] + dt[h].").
    줄(L, "        짧은실수 ua = 0.0 - 큰쪽(u, 0.0 - u).").
    줄들(L, 적힌지수식("짧은실수 ue", "ua", "        ", "u")).
    줄들(L, 로그1p식("lg", "ue", "        ", "p")).
    줄(L, "        짧은실수 sp = lg.").
    줄(L, "        u > 0.0이면 \{ sp = u + lg. \}").
    줄(L, "        짧은실수 g = sp * 감쇠[h].").
    줄들(L, 적힌지수식("짧은실수 gm", "g", "        ", "g")).
    줄(L, "        감마[i] = gm.").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 열 합 — 레지스터 s0 … s31(행 블록 b 의 S[32b + n][j])과 x0 … x31(x[32b + n])의 곱해더하기 사슬, 레인 넷의 트리 → 새 짧은실수 dst *)
[문자열 dst를 문자열 x를 문자열 ind를 문자열 접을 열합식]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{ind}짧은실수 P{접} = s0 * {x}0.")).
    반복 (정수 n는 1부터 32 전까지) { 줄(L, 서식글("{ind}P{접} = 곱해더하기(s{n}, {x}{n}, P{접}).")). }
    줄(L, 서식글("{ind}짧은실수 Q{접} = P{접} + 레인에서받기(P{접}, lane ^ 1).")).
    줄(L, 서식글("{ind}짧은실수 {dst} = Q{접} + 레인에서받기(Q{접}, lane ^ 2).")).
    반환 L.
}

[GDN순환판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.12.0 12-3e-2 — GDN 의 순환 계산(계약 4.10 5): 블록 하나 = (v 헤드, 열 32 개), 스레드 = (열 j, 행 블록 b = 레인 % 4), 상태 32 칸을 레지스터에.").
    줄(L, "   토큰마다 S ← γ · S, kv = 열 합(k), δ = (v − kv) · β, S ← 곱해더하기(k, δ, S), o = 열 합(q) — 블록가로 = v 헤드 · 4 + 열 무리, 블록세로 = 시퀀스 *)").
    줄(L, "[짧은실수 참조 y에서 짧은실수 참조 베타에서 짧은실수 참조 감마에서 짧은실수 참조 상태에 짧은실수 참조 출력에 정수 행수로 정수 k머리로 정수 v머리로 정수 채널로 GDN순환]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 h = 블록가로() / 4.").
    줄(L, "    정수 j = (블록가로() % 4) * 32 + (tid / 32) * 8 + lane / 4.").
    줄(L, "    정수 b = lane % 4.").
    줄(L, "    정수 kh = h % k머리.").
    줄(L, "    정수 sb = (h * 128 + b * 32) * 128 + j.").
    반복 (정수 n는 0부터 32 전까지) { 줄(L, 서식글("    짧은실수 s{n} = 상태[sb + {128 * n}].")). }
    줄(L, "    반복 (정수 t = 0: t < 행수: t += 1) \{").
    줄(L, "        정수 qa = t * 채널 + kh * 128 + b * 32.").
    줄(L, "        정수 ka = qa + k머리 * 128.").
    줄(L, "        짧은실수 gm = 감마[t * v머리 + h].").
    줄(L, "        짧은실수 bt = 베타[t * v머리 + h].").
    줄(L, "        짧은실수 vj = y[t * 채널 + k머리 * 256 + h * 128 + j].").
    반복 (정수 n2는 0부터 32 전까지) { 줄(L, 서식글("        s{n2} = s{n2} * gm.")). }
    반복 (정수 n3는 0부터 32 전까지) { 줄(L, 서식글("        짧은실수 k{n3} = y[ka + {n3}].")). }
    줄들(L, 열합식("kv", "k", "        ", "k")).
    줄(L, "        짧은실수 dl = (vj - kv) * bt.").
    반복 (정수 n4는 0부터 32 전까지) { 줄(L, 서식글("        s{n4} = 곱해더하기(k{n4}, dl, s{n4}).")). }
    반복 (정수 n5는 0부터 32 전까지) { 줄(L, 서식글("        짧은실수 q{n5} = y[qa + {n5}].")). }
    줄들(L, 열합식("ov", "q", "        ", "q")).
    줄(L, "        b == 0이면 \{ 출력[(t * v머리 + h) * 128 + j] = ov. \}").
    줄(L, "    \}").
    반복 (정수 n6는 0부터 32 전까지) { 줄(L, 서식글("    상태[sb + {128 * n6}] = s{n6}.")). }
    줄(L, "\}").
    반환 L.
}

(* 모듈 끝에 붙이는 GDN 의 판 *)
[문자열목록 참조 L에 GDN판들넣기]는 {
    줄들(L, GDN합성곱판()). 줄(L, "").
    줄들(L, GDN합성곱상태판()). 줄(L, "").
    줄들(L, GDN정규화판()). 줄(L, "").
    줄들(L, GDN게이트값판()). 줄(L, "").
    줄들(L, GDN순환판()).
}
