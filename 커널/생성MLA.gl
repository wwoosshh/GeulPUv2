(* 프롬프트의 그룹 상태를 행이 보는 첫 그룹부터 차례로 병합해 O / L(계약 3 절) — 접기젬마 의 값 512 판(fp32 출력 [행][머리][512]) *)
[접기MLA판]는 -> 문자열목록 참조 {
    정수 DV = 512.
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.24.0 24-2 — MLA 의 그룹 상태 병합(계약 3 절): 블록 하나 = (헤드, 행), 스레드 = 값의 차원(512) — 접기젬마 와 같은 식 *)").
    줄(L, "[짧은실수 참조 묶음칸에서 짧은실수 참조 출력에 정수 행수로 정수 머리로 정수 위치시작으로 정수 최대길이로 정수 창으로 정수 행시작으로 정수 묶음칸수로 접기MLA]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 h = 블록가로().").
    줄(L, "    정수 r = 행시작 + 블록세로().").
    줄(L, "    정수 위치 = 위치시작 + r.").
    줄(L, "    정수 끝 = 위치 / 1024.").
    줄(L, "    정수 첫보임 = 위치 - 창 + 1.").
    줄(L, "    정수 g0 = 0.").
    줄(L, "    첫보임 > 0이면 \{ g0 = 첫보임 / 1024. \}").
    줄(L, "    짧은실수 M = 0.0.").
    줄(L, "    짧은실수 Lg = 0.0.").
    줄(L, "    짧은실수 Od = 0.0.").
    줄(L, "    반복 (정수 g = g0: g <= 끝: g += 1) \{").
    줄(L, 서식글("        정수 바탕 = (((r - 행시작) * 머리 + h) * 묶음칸수 + g % 묶음칸수) * {DV + 4}.")).
    줄(L, "        짧은실수 mg = 묶음칸[바탕].").
    줄(L, "        짧은실수 lg = 묶음칸[바탕 + 1].").
    줄(L, "        짧은실수 og = 묶음칸[바탕 + 4 + tid].").
    줄(L, "        g == g0이면 \{ M = mg. Lg = lg. Od = og. \}").
    줄(L, "        아니면 \{").
    줄(L, "            짧은실수 M2 = 큰쪽(M, mg).").
    줄들(L, 적힌지수식("짧은실수 fa", "M - M2", "            ", "a")).
    줄들(L, 적힌지수식("짧은실수 fb", "mg - M2", "            ", "b")).
    줄(L, "            Lg = 곱해더하기(lg, fb, Lg * fa).").
    줄(L, "            Od = 곱해더하기(og, fb, Od * fa).").
    줄(L, "            M = M2.").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, 서식글("    출력[(r * 머리 + h) * {DV} + tid] = Od / Lg.")).
    줄(L, "\}").
    반환 L.
}

(* 생성(행 넷까지)의 어텐션 첫째 — 조각어텐션젬마 의 키 576 · 값 512 판, 질의 헤드 G 는 32 까지(점수의 스레드 (키, 헤드 넷 × 여덟)) *)
[조각어텐션MLA판]는 -> 문자열목록 참조 {
    어텐션자리로().
    정수 WK = 18.
    정수 WV = 16.
    정수 DKW = 144.
    정수 DVW = 128.
    정수 DK = 576.
    정수 DV = 512.
    정수 GM = 32.                     (* 질의 헤드의 한도(Kanana-2 의 32) *)
    정수 QN = GM / 4.
    정수 QW = 0.                      (* 공유(fp32 칸): q 자리 [헤드 GM][자리 2][DKW] 낱말 · 2^(E_q − 13) [헤드 GM][WK] · 점수 → e [헤드 GM][64] *)
    정수 PQ = GM * 2 * DKW.
    정수 SB = PQ + GM * WK.
    정수 공크기 = 공유판크기((SB + GM * 64) * 4).
    문자열 공유 = 서식글("공유판{공크기}()").
    문자열 I3 = "            ".
    문자열 I5 = "                    ".
    문자열 I6 = "                        ".
    문자열 I4 = "                ".
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.24.0 24-2 — MLA 의 생성 어텐션(행 넷까지) 첫째: 블록 하나 = (행, KV 헤드, 타일)의 질의 헤드 G 개(32 까지)의 타일 상태 (m, l, o 512) — 조각어텐션젬마 와 같은 식 · 차례 *)").
    줄(L, "[중간정수 참조 q자리에서 정수 참조 qE에서 중간정수 참조 k자리에서 정수 참조 kE에서 중간정수 참조 v자리에서 정수 참조 vE에서 짧은실수 참조 조각칸에 정수 행수로 정수 머리로 정수 KV머리로 정수 위치시작으로 정수 고리로 정수 창으로 정수 눈금비트로 정수 슬롯수로 정수 슬롯걸음으로 조각어텐션MLA]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 wv = tid / 32.").
    줄(L, "    정수 G = 머리 / KV머리.").
    줄(L, "    정수 kh = 블록가로() % KV머리.").
    줄(L, "    정수 슬롯0 = 블록가로() / KV머리.").
    줄(L, "    정수 r = 블록세로().").
    줄(L, "    정수 위치 = 위치시작 + r.").
    줄(L, "    정수 첫0 = 위치시작 - 창 + 1.").
    줄(L, "    정수 바탕조각 = 0.").
    줄(L, "    첫0 > 0이면 \{ 바탕조각 = 첫0 / 64. \}").
    줄(L, "    정수 첫보임 = 위치 - 창 + 1.").
    줄(L, "    짧은실수 눈금 = 비트실수(눈금비트 으로 중간정수).").
    줄(L, 서식글("    짧은실수 참조 판 = {공유}.")).
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    정수 끝슬롯 = 위치 / 64 - 바탕조각.").
    줄(L, "    슬롯0 <= 끝슬롯이면 \{").
    줄(L, 서식글("        반복 (정수 c = tid: c < G * {2 * DKW}: c += 256) \{")).
    줄(L, 서식글("            정수 hl = c / {2 * DKW}.")).
    줄(L, 서식글("            정수 j = (c / {DKW}) % 2.")).
    줄(L, 서식글("            판i[{QW} + c] = q자리[(j * 행수 * 머리 * {DK} + r * 머리 * {DK} + (kh * G + hl) * {DK}) / 4 + c % {DKW}].")).
    줄(L, "        \}").
    줄(L, 서식글("        반복 (정수 c2 = tid: c2 < G * {WK}: c2 += 256) \{")).
    줄(L, 서식글("            판[{PQ} + c2] = 비트실수(((qE[r * 머리 * {WK} + kh * G * {WK} + c2] + 114) << 23) 으로 중간정수).")).
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, "        반복 (정수 슬롯 = 슬롯0: 슬롯 <= 끝슬롯 그리고 슬롯 < 슬롯수: 슬롯 += 슬롯걸음) \{").
    줄(L, "        정수 k0 = (바탕조각 + 슬롯) * 64.").
    줄(L, "        정수 c0 = k0 % 고리.").
    줄(L, "        k0 + 63 >= 첫보임이면 \{").
    줄(L, "        \{").
    줄(L, "            정수 t = tid % 64.").
    줄(L, "            정수 hs = tid / 64.").
    줄(L, "            정수 kp = k0 + t.").
    줄(L, 서식글("            정수 ka = (kh * 고리 + c0 + t) * {DKW}.")).
    줄(L, 서식글("            정수 k면 = KV머리 * 고리 * {DKW}.")).
    줄(L, 서식글("            정수 kb = (kh * 고리 + c0 + t) * {WK}.")).
    반복 (정수 q는 0부터 QN 전까지) { 줄(L, 서식글("            짧은실수 s{q} = -3.0e38.")). }
    줄(L, "            (kp <= 위치 그리고 위치 - kp < 창)이면 \{").
    줄(L, 서식글("                반복 (정수 w = 0: w < {WK}: w += 1) \{")).
    반복 (정수 i는 0부터 8 전까지) {
        줄(L, 서식글("{I5}중간정수 k0w{i} = k자리[ka + w * 8 + {i}].")).
        줄(L, 서식글("{I5}중간정수 k1w{i} = k자리[k면 + ka + w * 8 + {i}].")).
    }
    줄(L, 서식글("{I5}짧은실수 pk = 비트실수(((kE[kb + w] + 114) << 23) 으로 중간정수).")).
    반복 (정수 q2는 0부터 QN 전까지) {
        줄(L, 서식글("{I5}(hs + {4 * q2} < G)이면 \{")).
        줄(L, 서식글("{I6}정수 qa{q2} = {QW} + (hs + {4 * q2}) * {2 * DKW} + w * 8.")).
        줄(L, 서식글("{I6}중간정수 hh{q2} = 0.")).
        줄(L, 서식글("{I6}중간정수 sm{q2} = 0.")).
        줄(L, 서식글("{I6}중간정수 ll{q2} = 0.")).
        반복 (정수 i2는 0부터 8 전까지) {
            줄(L, 서식글("{I6}중간정수 qx{q2}_{i2} = 판i[qa{q2} + {i2}].")).
            줄(L, 서식글("{I6}중간정수 qy{q2}_{i2} = 판i[qa{q2} + {DKW + i2}].")).
            줄(L, 서식글("{I6}hh{q2} = 바이트넷곱더하기(qy{q2}_{i2}, k1w{i2}, hh{q2}).")).
            줄(L, 서식글("{I6}sm{q2} = 바이트넷곱더하기(qy{q2}_{i2}, k0w{i2}, sm{q2}).")).
            줄(L, 서식글("{I6}sm{q2} = 바이트넷곱더하기(qx{q2}_{i2}, k1w{i2}, sm{q2}).")).
            줄(L, 서식글("{I6}ll{q2} = 바이트넷곱더하기(qx{q2}_{i2}, k0w{i2}, ll{q2}).")).
        }
        줄들(L, 정수곱읽기(서식글("짧은실수 u{q2}"), 서식글("hh{q2}"), 서식글("sm{q2}"), 서식글("ll{q2}"), I6, 서식글("q{q2}"), 거짓)).
        줄(L, 서식글("{I6}짧은실수 pt{q2} = u{q2} * 판[{PQ} + (hs + {4 * q2}) * {WK} + w].")).
        줄(L, 서식글("{I6}w == 0이면 \{ s{q2} = pt{q2} * pk. \}")).
        줄(L, 서식글("{I6}아니면 \{ s{q2} = 곱해더하기(pt{q2}, pk, s{q2}). \}")).
        줄(L, 서식글("{I5}\}")).
    }
    줄(L, "                \}").
    반복 (정수 q3는 0부터 QN 전까지) { 줄(L, 서식글("                s{q3} = s{q3} * 눈금.")). }
    줄(L, "            \}").
    반복 (정수 q4는 0부터 QN 전까지) { 줄(L, 서식글("            (hs + {4 * q4} < G)이면 \{ 판[{SB} + (hs + {4 * q4}) * 64 + t] = s{q4}. \}")). }
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, "        반복 (정수 hl = wv: hl < G: hl += 8) \{").
    줄(L, 서식글("            짧은실수 sa = 판[{SB} + hl * 64 + lane].")).
    줄(L, 서식글("            짧은실수 sb = 판[{SB} + hl * 64 + lane + 32].")).
    줄(L, "            짧은실수 mx = 큰쪽(sa, sb).").
    반복 (정수 k = 16: k >= 1: k = k / 2) { 줄(L, 서식글("            mx = 큰쪽(mx, 레인에서받기(mx, lane ^ {k})).")). }
    줄(L, "            짧은실수 ea = 0.0.").
    줄(L, "            짧은실수 eb = 0.0.").
    줄(L, "            정수 ka2 = k0 + lane.").
    줄(L, "            정수 kb2 = k0 + lane + 32.").
    줄(L, "            (ka2 <= 위치 그리고 위치 - ka2 < 창)이면 \{").
    줄들(L, 적힌지수식("ea", "sa - mx", I4, "a")).
    줄(L, "            \}").
    줄(L, "            (kb2 <= 위치 그리고 위치 - kb2 < 창)이면 \{").
    줄들(L, 적힌지수식("eb", "sb - mx", I4, "b")).
    줄(L, "            \}").
    줄(L, 서식글("            판[{SB} + hl * 64 + lane] = ea.")).
    줄(L, 서식글("            판[{SB} + hl * 64 + lane + 32] = eb.")).
    줄(L, "            중간정수 ln = 가까운정수(ea * 8388608.0) + 가까운정수(eb * 8388608.0).").
    반복 (정수 k2 = 16: k2 >= 1: k2 = k2 / 2) { 줄(L, 서식글("            ln = ln + 정수레인에서받기(ln, lane ^ {k2}).")). }
    줄(L, "            lane == 0이면 \{").
    줄(L, 서식글("                정수 sb0 = ((r * 머리 + kh * G + hl) * 슬롯수 + 슬롯) * {DV + 4}.")).
    줄(L, "                조각칸[sb0] = mx.").
    줄(L, "                조각칸[sb0 + 1] = (ln 으로 짧은실수) * 0.00000011920928955078125.").
    줄(L, "            \}").
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, 서식글("        반복 (정수 w = wv: w < {WV}: w += 8) \{")).
    줄(L, "            정수 dim = w * 32 + lane.").
    줄(L, 서식글("            정수 v면 = KV머리 * 고리 * {DVW}.")).
    반복 (정수 j는 0부터 2 전까지) {
        줄(L, 서식글("{I3}정수 vb{j} = ((kh * 고리 + c0 + {32 * j}) / 32 * {DV} + dim) * 8.")).
        반복 (정수 i3는 0부터 8 전까지) {
            줄(L, 서식글("{I3}중간정수 v0_{j}_{i3} = v자리[vb{j} + {i3}].")).
            줄(L, 서식글("{I3}중간정수 v1_{j}_{i3} = v자리[v면 + vb{j} + {i3}].")).
        }
        줄(L, 서식글("{I3}정수 kj{j} = k0 + {32 * j} + lane.")).
        줄(L, 서식글("{I3}참거짓 보j{j} = kj{j} <= 위치 그리고 위치 - kj{j} < 창.")).
        줄(L, 서식글("{I3}짧은실수 pv{j} = 0.0.")).
        줄(L, 서식글("{I3}보j{j}이면 \{ pv{j} = 비트실수(((vE[(kh * 고리 + c0 + {32 * j} + lane) * {WV} + w] + 114) << 23) 으로 중간정수). \}")).
    }
    줄(L, "            반복 (정수 hl2 = 0: hl2 < G: hl2 += 1) \{").
    반복 (정수 j2는 0부터 2 전까지) {
        줄(L, 서식글("{I4}짧은실수 ep{j2} = 0.0.")).
        줄(L, 서식글("{I4}보j{j2}이면 \{ ep{j2} = 판[{SB} + hl2 * 64 + {32 * j2} + lane] * pv{j2}. \}")).
        줄(L, 서식글("{I4}짧은실수 em{j2} = ep{j2}.")).
        반복 (정수 k3 = 16: k3 >= 1: k3 = k3 / 2) { 줄(L, 서식글("{I4}em{j2} = 큰쪽(em{j2}, 레인에서받기(em{j2}, lane ^ {k3})).")). }
        줄(L, 서식글("{I4}정수 Ee{j2} = -98.")).
        줄(L, 서식글("{I4}em{j2} > 0.0이면 \{")).
        줄(L, 서식글("{I4}    Ee{j2} = ((실수비트(em{j2}) >> 23) & 255) - 127.")).
        줄(L, 서식글("{I4}    Ee{j2} < -98이면 \{ Ee{j2} = -98. \}")).
        줄(L, 서식글("{I4}    Ee{j2} > 100이면 \{ Ee{j2} = 100. \}")).
        줄(L, 서식글("{I4}\}")).
        줄(L, 서식글("{I4}짧은실수 es{j2} = 비트실수(((140 - Ee{j2}) << 23) 으로 중간정수).")).
        줄(L, 서식글("{I4}중간정수 ne{j2} = 실수비트(곱해더하기(ep{j2}, es{j2}, 8388736.0)) - 1258291328.")).
        줄(L, 서식글("{I4}중간정수 e0{j2} = ((ne{j2} + 128) & 255) - 128.")).
        줄(L, 서식글("{I4}중간정수 e1{j2} = (ne{j2} - e0{j2}) >> 8.")).
        줄(L, 서식글("{I4}중간정수 x{j2} = (e0{j2} & 255) | ((e1{j2} & 255) << 8).")).
        줄(L, 서식글("{I4}중간정수 y{j2} = x{j2} | (정수아래에서받기(x{j2}, 1) << 16).")).
        줄(L, 서식글("{I4}중간정수 z{j2} = 정수아래에서받기(y{j2}, 2).")).
        줄(L, 서식글("{I4}중간정수 ea{j2} = 바이트고르기(y{j2}, z{j2}, 25632).")).
        줄(L, 서식글("{I4}중간정수 eb{j2} = 바이트고르기(y{j2}, z{j2}, 30001).")).
        줄(L, 서식글("{I4}중간정수 ph{j2} = 0.")).
        줄(L, 서식글("{I4}중간정수 pm{j2} = 0.")).
        줄(L, 서식글("{I4}중간정수 pl{j2} = 0.")).
        반복 (정수 i4는 0부터 8 전까지) {
            줄(L, 서식글("{I4}중간정수 Ex{j2}_{i4} = 정수레인에서받기(ea{j2}, {4 * i4}).")).
            줄(L, 서식글("{I4}중간정수 Ey{j2}_{i4} = 정수레인에서받기(eb{j2}, {4 * i4}).")).
            줄(L, 서식글("{I4}ph{j2} = 바이트넷곱더하기(Ey{j2}_{i4}, v1_{j2}_{i4}, ph{j2}).")).
            줄(L, 서식글("{I4}pm{j2} = 바이트넷곱더하기(Ey{j2}_{i4}, v0_{j2}_{i4}, pm{j2}).")).
            줄(L, 서식글("{I4}pm{j2} = 바이트넷곱더하기(Ex{j2}_{i4}, v1_{j2}_{i4}, pm{j2}).")).
            줄(L, 서식글("{I4}pl{j2} = 바이트넷곱더하기(Ex{j2}_{i4}, v0_{j2}_{i4}, pl{j2}).")).
        }
        줄들(L, 정수곱읽기(서식글("짧은실수 uo{j2}"), 서식글("ph{j2}"), 서식글("pm{j2}"), 서식글("pl{j2}"), I4, 서식글("o{j2}"), 거짓)).
        줄(L, 서식글("{I4}짧은실수 P{j2} = 비트실수(((Ee{j2} + 114) << 23) 으로 중간정수).")).
    }
    줄(L, 서식글("{I4}조각칸[((r * 머리 + kh * G + hl2) * 슬롯수 + 슬롯) * {DV + 4} + 4 + dim] = 곱해더하기(uo1, P1, uo0 * P0).")).
    줄(L, "            \}").
    줄(L, "        \}").
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 생성의 어텐션 둘째 — 조각접기젬마 의 값 512 판(fp32 출력) *)
[조각접기MLA판]는 -> 문자열목록 참조 {
    정수 DV = 512.
    문자열 I4 = "                ".
    문자열 I3 = "            ".
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.24.0 24-2 — MLA 의 생성 어텐션(행 넷까지) 둘째: 타일 상태를 그룹 안에서 · 그룹끼리 차례로 병합해 O / L — 블록 하나 = (헤드, 행), 스레드 = 값의 차원 *)").
    줄(L, "[짧은실수 참조 조각칸에서 짧은실수 참조 출력에 정수 행수로 정수 머리로 정수 위치시작으로 정수 최대길이로 정수 창으로 정수 슬롯수로 조각접기MLA]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 h = 블록가로().").
    줄(L, "    정수 r = 블록세로().").
    줄(L, "    정수 위치 = 위치시작 + r.").
    줄(L, "    정수 첫0 = 위치시작 - 창 + 1.").
    줄(L, "    정수 바탕조각 = 0.").
    줄(L, "    첫0 > 0이면 \{ 바탕조각 = 첫0 / 64. \}").
    줄(L, "    정수 첫보임 = 위치 - 창 + 1.").
    줄(L, "    정수 g0 = 0.").
    줄(L, "    첫보임 > 0이면 \{ g0 = 첫보임 / 1024. \}").
    줄(L, "    정수 끝 = 위치 / 1024.").
    줄(L, "    정수 상바탕 = (r * 머리 + h) * 슬롯수 - 바탕조각.").
    줄(L, "    짧은실수 M = 0.0.").
    줄(L, "    짧은실수 Lg = 0.0.").
    줄(L, "    짧은실수 Od = 0.0.").
    줄(L, "    반복 (정수 g = g0: g <= 끝: g += 1) \{").
    줄(L, "        정수 시작조각 = g * 16.").
    줄(L, "        (첫보임 > 0 그리고 첫보임 / 64 > 시작조각)이면 \{ 시작조각 = 첫보임 / 64. \}").
    줄(L, "        정수 끝조각 = 위치 / 64.").
    줄(L, "        끝조각 > g * 16 + 15이면 \{ 끝조각 = g * 16 + 15. \}").
    줄(L, "        짧은실수 Mg = 0.0.").
    줄(L, "        짧은실수 Lt = 0.0.").
    줄(L, "        짧은실수 Ot = 0.0.").
    줄(L, "        반복 (정수 조각 = 시작조각: 조각 <= 끝조각: 조각 += 1) \{").
    줄(L, 서식글("            정수 바탕 = (상바탕 + 조각) * {DV + 4}.")).
    줄(L, "            짧은실수 mt = 조각칸[바탕].").
    줄(L, "            짧은실수 lt = 조각칸[바탕 + 1].").
    줄(L, "            짧은실수 ot = 조각칸[바탕 + 4 + tid].").
    줄(L, "            조각 == 시작조각이면 \{ Mg = mt. Lt = lt. Ot = ot. \}").
    줄(L, "            아니면 \{").
    줄(L, "                짧은실수 M2 = 큰쪽(Mg, mt).").
    줄들(L, 적힌지수식("짧은실수 fa", "Mg - M2", I4, "a")).
    줄들(L, 적힌지수식("짧은실수 fb", "mt - M2", I4, "b")).
    줄(L, "                Lt = 곱해더하기(lt, fb, Lt * fa).").
    줄(L, "                Ot = 곱해더하기(ot, fb, Ot * fa).").
    줄(L, "                Mg = M2.").
    줄(L, "            \}").
    줄(L, "        \}").
    줄(L, "        g == g0이면 \{ M = Mg. Lg = Lt. Od = Ot. \}").
    줄(L, "        아니면 \{").
    줄(L, "            짧은실수 M3 = 큰쪽(M, Mg).").
    줄들(L, 적힌지수식("짧은실수 ga", "M - M3", I3, "c")).
    줄들(L, 적힌지수식("짧은실수 gb", "Mg - M3", I3, "d")).
    줄(L, "            Lg = 곱해더하기(Lt, gb, Lg * ga).").
    줄(L, "            Od = 곱해더하기(Ot, gb, Od * ga).").
    줄(L, "            M = M3.").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, 서식글("    출력[(r * 머리 + h) * {DV} + tid] = Od / Lg.")).
    줄(L, "\}").
    반환 L.
}

(* 계약 4.13 8 — 시그모이드 라우팅. 워프 하나 = 행 하나(블록 하나에 워프 넷) — MoE라우팅 의 꼴에서 점수만 다르다 *)
[MoE라우팅시그판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.24.0 24-2 — 시그모이드 라우팅(계약 4.13 8): p = σ(로짓)(4.9), 고르는 점수 s = p + 치우침(덧셈 하나), 상위 k 는 s 의 내림차순(같으면 작은 번호 —").
    줄(L, "   MoE라우팅 과 같은 나비), 가중치는 고른 전문가의 p — 정규화가 0 이 아니면 순위 차례의 합 · max(합, 2⁻¹⁴) 로 나눗셈 하나, 배율비트 가 1.0 의 비트가").
    줄(L, "   아니면 그다음 곱 하나. 공유 게이트 칸은 1(MoE합 의 곱해더하기(1, y_s, o) = o + y_s). 개수 [E] 는 0 에서(MoE배치 가 되돌린다) *)").
    줄(L, "[짧은실수 참조 로짓에서 짧은실수 참조 치우침에서 정수 참조 고른에 짧은실수 참조 무게에 정수 참조 개수에 정수 참조 순번에 짧은실수 참조 공유게이트에 정수 행수로 정수 전문가로 정수 고름으로 정수 로짓폭으로 정수 정규화로 정수 배율비트로 MoE라우팅시그]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 r = 블록가로() * 4 + tid / 32.").
    줄(L, "    r < 행수이면 \{").
    줄(L, "        정수 바탕 = r * 로짓폭.").
    줄(L, "        정수 쓴 = 0.").
    줄(L, "        짧은실수 s = 0.0.").
    줄(L, "        반복 (정수 q = 0: q < 고름: q += 1) \{").
    줄(L, "            짧은실수 bv = 0.0.").
    줄(L, "            정수 bi = 전문가.").
    줄(L, "            정수 j = 0.").
    줄(L, "            반복 (정수 i3 = lane: i3 < 전문가: i3 += 32) \{").
    줄(L, "                ((쓴 >> j) & 1) == 0이면 \{").
    줄(L, "                    짧은실수 lx = 로짓[바탕 + i3].").
    줄들(L, 시그모이드식("px", "lx", "                    ", "p")).
    줄(L, "                    짧은실수 v = px + 치우침[i3].").
    줄(L, "                    (bi == 전문가 또는 v > bv)이면 \{ bv = v. bi = i3. \}").
    줄(L, "                \}").
    줄(L, "                j += 1.").
    줄(L, "            \}").
    반복 (정수 k3 = 16: k3 >= 1: k3 = k3 / 2) {
        줄(L, 서식글("            짧은실수 ov{k3} = 레인에서받기(bv, lane ^ {k3}).")).
        줄(L, 서식글("            정수 oi{k3} = 정수레인에서받기(bi, lane ^ {k3}).")).
        줄(L, 서식글("            (oi{k3} < 전문가 그리고 (bi == 전문가 또는 ov{k3} > bv 또는 (ov{k3} == bv 그리고 oi{k3} < bi)))이면 \{ bv = ov{k3}. bi = oi{k3}. \}")).
    }
    줄(L, "            bi % 32 == lane이면 \{ 쓴 = 쓴 | (1 << (bi / 32)). \}").
    줄(L, "            짧은실수 lb = 로짓[바탕 + bi].").
    줄들(L, 시그모이드식("pq", "lb", "            ", "q")).
    줄(L, "            s = s + pq.").
    줄(L, "            lane == 0이면 \{").
    줄(L, "                정수 o = r * 고름 + q.").
    줄(L, "                고른[o] = bi.").
    줄(L, "                무게[o] = pq.").
    줄(L, "                순번[o] = 원자더하기(개수 에, bi 를, 1 로).").
    줄(L, "            \}").
    줄(L, "        \}").
    줄(L, "        lane == 0이면 \{").
    줄(L, "            짧은실수 sd = 큰쪽(s, 0.00006103515625).").
    줄(L, "            짧은실수 배 = 비트실수(배율비트 으로 중간정수).").
    줄(L, "            반복 (정수 q2 = 0: q2 < 고름: q2 += 1) \{").
    줄(L, "                짧은실수 w = 무게[r * 고름 + q2].").
    줄(L, "                정규화 != 0이면 \{ w = w / sd. \}").
    줄(L, "                배율비트 != 1065353216이면 \{ w = w * 배. \}").
    줄(L, "                무게[r * 고름 + q2] = w.").
    줄(L, "            \}").
    줄(L, "            공유게이트[r] = 1.0.").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

[deepseek2표시판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 0.24.0 24-2 — deepseek2 모듈(커널생성 deepseek2큰)의 표시(엔진이 모듈을 올린 뒤 찾는다 — 하는 일은 없다) *)").
    줄(L, "[중간정수 참조 답칸에 deepseek2표시]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    tid > 1024이면 \{ 답칸[0] = 0. \}").
    줄(L, "\}").
    반환 L.
}

(* 모듈 끝에 붙이는 MLA 의 판 *)
[문자열목록 참조 L에 MLA판들넣기]는 {
    MLA질의LoRA > 0이면 { 줄들(L, RMS정규화정수줄MLA판(MLA질의LoRA)). 줄(L, ""). }
    줄들(L, KV쓰기MLA판()). 줄(L, "").
    줄들(L, Q조립MLA판()). 줄(L, "").
    줄들(L, 머리행렬곱MLA판()). 줄(L, "").
    MLA머리K이면 { 줄들(L, 머리행렬곱MLAK판()). 줄(L, ""). }
    줄들(L, 타일어텐션MLA판()). 줄(L, "").
    줄들(L, 접기MLA판()). 줄(L, "").
    줄들(L, 조각어텐션MLA판()). 줄(L, "").
    줄들(L, 조각접기MLA판()). 줄(L, "").
    선형자리로().
    줄들(L, MoE라우팅시그판()). 줄(L, "").
    줄들(L, deepseek2표시판()).
}
