                    줄(L, 서식글("{J}중간정수 vb{자2}_0 = 판i[vw{dt2} + {(j7 * 2 + 자2) * 1024}].")).
                    줄(L, 서식글("{J}중간정수 vb{자2}_1 = 판i[vw{dt2} + {(j7 * 2 + 자2) * 1024 + 1}].")).
                }
                문자열 VA1 = 서식글("ea{b9}_{j7}_1_0, ea{b9}_{j7}_1_1, ea{b9}_{j7}_1_2, ea{b9}_{j7}_1_3").
                문자열 VA0 = 서식글("ea{b9}_{j7}_0_0, ea{b9}_{j7}_0_1, ea{b9}_{j7}_0_2, ea{b9}_{j7}_0_3").
                반복 (정수 c14는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 phh{c14} = 정수텐서곱({c14}, {VA1}, vb1_0, vb1_1, 영i, 영i, 영i, 영i).")). }
                반복 (정수 c15는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 psm{c15} = 정수텐서곱({c15}, {VA1}, vb0_0, vb0_1, 영i, 영i, 영i, 영i).")). }
                반복 (정수 c16는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 psmb{c16} = 정수텐서곱({c16}, {VA0}, vb1_0, vb1_1, psm0, psm1, psm2, psm3).")). }
                반복 (정수 c17는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 pll{c17} = 정수텐서곱({c17}, {VA0}, vb0_0, vb0_1, 영i, 영i, 영i, 영i).")). }
                반복 (정수 c18는 0부터 4 전까지) {
