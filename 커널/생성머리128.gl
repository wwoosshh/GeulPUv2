            반복 (정수 c4는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 hh{c4} = 정수텐서곱({c4}, {A1}, {B1}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c5는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 sm{c5} = 정수텐서곱({c5}, {A1}, {B0}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c6는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 smb{c6} = 정수텐서곱({c6}, {A0}, {B1}, sm0, sm1, sm2, sm3).")). }
            반복 (정수 c7는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 ll{c7} = 정수텐서곱({c7}, {A0}, {B0}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c8는 0부터 4 전까지) {
                줄들(L, 정수곱읽기(서식글("짧은실수 u{c8}"), 서식글("hh{c8}"), 서식글("smb{c8}"), 서식글("ll{c8}"), J, 서식글("{c8}"), 거짓)).
            }
            반복 (정수 c9는 0부터 4 전까지) {
                정수 h4 = c9 >> 1.
                정수 e2 = c9 & 1.
                b5 == 0이면 { 줄(L, 서식글("{J}s{n}_{c9} = (u{c9} * pqs0_{h4}) * pk{n}_{e2}_0.")). }
                아니면 { 줄(L, 서식글("{J}s{n}_{c9} = 곱해더하기(u{c9} * pqs{b5}_{h4}, pk{n}_{e2}_{b5}, s{n}_{c9}).")). }
            }
