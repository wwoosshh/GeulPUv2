        줄(L, 서식글("{I}mx{h6} = 큰쪽(mx{h6}, 레인에서받기(mx{h6}, lane ^ 2)).")).
        줄(L, 서식글("{I}정수 ml{h6} = 0.")).
    }
    반복 (정수 n4는 0부터 8 전까지) {
        반복 (정수 c12는 0부터 4 전까지) {
            정수 h7 = c12 >> 1.
            줄들(L, 적힌지수식(서식글("짧은실수 e{n4}_{c12}"), 서식글("s{n4}_{c12} - mx{h7}"), I, 서식글("e{n4}_{c12}"))).
            줄(L, 서식글("{I}ml{h7} = ml{h7} + ((실수비트(곱해더하기(e{n4}_{c12}, 8388608.0, 8388608.0)) - 1258291200) 으로 정수).")).
