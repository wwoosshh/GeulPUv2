}

(* ---- 23단계 — 생성(가상 행 16 개 안 — 행 둘까지)의 조각 셈을 워프 넷으로 ----
   점수 · 가림 · 지수는 워프 w 가 키 [16w, 16w + 16) (n 조각 2w, 2w + 1), 가중합은 워프 w 가 값의 블록 w (d [32w, 32w + 32)).
   행의 최댓값(정확 — 차례와 상관없다)과 정수 합 ml(정수 — 차례와 상관없다)은 판(큰넷판)으로 모으고, 지수 e 는 키 자리 판(점수 뒤에 빈다)으로
   나눈다. 식 하나하나가 큰조각셈 · 큰e자리줄들과 같다 — 비트까지 같다. 읽는 이름: 큰조각셈과 같고 w, 내는 이름: mx{h} · l{h} ·
   o{i}_{c} (d 조각 4w + i) *)
상수 정수 큰넷판 = 8704.

(* 큰e자리줄들(b = w) — 지수 f{n}_{c} (판에서 읽은 키 64 개)와 값 지수 pv{n}_{e} 로 ea{j}_{자리}_{0..3} · Pe{j}_{h} *)
[문자열 I를 큰e자리줄들넷]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    반복 (정수 j는 0부터 2 전까지) {
        반복 (정수 h0는 0부터 2 전까지) { 줄(L, 서식글("{I}짧은실수 Pe{j}_{h0} = 영.")). }
        반복 (정수 자0는 0부터 2 전까지) {
            반복 (정수 k0는 0부터 4 전까지) { 줄(L, 서식글("{I}중간정수 ea{j}_{자0}_{k0} = 0.")). }
        }
        반복 (정수 c는 0부터 4 전까지) {
            정수 e = c & 1.
            반복 (정수 n = 4 * j: n < 4 * j + 4: n += 1) { 줄(L, 서식글("{I}짧은실수 ep{n}_{c} = f{n}_{c} * pv{n}_{e}.")). }
        }
        반복 (정수 h는 0부터 2 전까지) {
            문자열목록 참조 xs = 줄목록().
            반복 (정수 n2 = 4 * j: n2 < 4 * j + 4: n2 += 1) {
                줄(xs, 서식글("ep{n2}_{2 * h}")).
                줄(xs, 서식글("ep{n2}_{2 * h + 1}")).
            }
            문자열 expr = 최대사슬(xs).
            줄(L, 서식글("{I}\{")).
            줄(L, 서식글("{I}    짧은실수 m = {expr}.")).
            줄(L, 서식글("{I}    m = 큰쪽(m, 레인에서받기(m, lane ^ 1)).")).
            줄(L, 서식글("{I}    m = 큰쪽(m, 레인에서받기(m, lane ^ 2)).")).
            줄들(L, 지수식(서식글("{I}    "))).
            줄(L, 서식글("{I}    Pe{j}_{h} = 비트실수(((E + 114) << 23) 으로 중간정수).")).
            반복 (정수 n3 = 4 * j: n3 < 4 * j + 4: n3 += 1) {
                반복 (정수 e2는 0부터 2 전까지) {
                    정수 c2 = 2 * h + e2.
                    줄(L, 서식글("{I}    중간정수 me{n3}_{c2} = 실수비트(곱해더하기(ep{n3}_{c2}, s, 8388736.0)) - 1258291200.")).
                }
            }
            반복 (정수 half는 0부터 2 전까지) {
                정수 n0 = 4 * j + 2 * half.
                정수 n1 = 4 * j + 2 * half + 1.
                줄(L, 서식글("{I}    중간정수 p01_{half} = 바이트고르기(me{n0}_{2 * h}, me{n0}_{2 * h + 1}, 20800).")).
                줄(L, 서식글("{I}    중간정수 p23_{half} = 바이트고르기(me{n1}_{2 * h}, me{n1}_{2 * h + 1}, 20800).")).
                줄(L, 서식글("{I}    ea{j}_0_{2 * half + h} = 바이트고르기(p01_{half}, p23_{half}, 21520) ^ (-2139062144).")).
                줄(L, 서식글("{I}    ea{j}_1_{2 * half + h} = 바이트고르기(p01_{half}, p23_{half}, 30258).")).
            }
            줄(L, 서식글("{I}\}")).
        }
    }
    반환 L.
}

(* 큰조각셈넷의 가운데 — 가림 · 최댓값(워프 넷) · 지수 · 합 · 지수를 키 자리 판에 · f 읽기(협력 판도 같은 줄) *)
[문자열 I를 큰지수줄들넷]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{I}tb + 63 > p0이면 \{")).
    반복 (정수 i2는 0부터 2 전까지) {
        반복 (정수 c11는 0부터 4 전까지) {
            정수 h5 = c11 >> 1.
            정수 e3 = c11 & 1.
            줄(L, 서식글("{I}    tb + nn{i2} * 8 + t * 2 + {e3} > pq{h5}이면 \{ s{i2}_{c11} = -3.0e38. \}")).
        }
    }
    줄(L, 서식글("{I}\}")).
    (* 행의 최댓값 — 워프의 키 16 개, 그다음 워프 넷 (최댓값은 차례와 상관없이 정확하다) *)
    반복 (정수 h6는 0부터 2 전까지) {
        문자열목록 참조 xs = 줄목록().
        반복 (정수 i3는 0부터 2 전까지) {
            줄(xs, 서식글("s{i3}_{2 * h6}")).
            줄(xs, 서식글("s{i3}_{2 * h6 + 1}")).
        }
        문자열 expr = 최대사슬(xs).
        줄(L, 서식글("{I}짧은실수 wm{h6} = {expr}.")).
        줄(L, 서식글("{I}wm{h6} = 큰쪽(wm{h6}, 레인에서받기(wm{h6}, lane ^ 1)).")).
        줄(L, 서식글("{I}wm{h6} = 큰쪽(wm{h6}, 레인에서받기(wm{h6}, lane ^ 2)).")).
    }
    (* 34단계 — 공유32: 워프끼리 칸을 키 자리 판 안([1024, 1152) — 지수 칸 [0, 1024) 뒤)에. 모든 워프가 점수(키 읽기)를 마친 뒤에 쓴다.
       35단계 — 공유32 의 협력 판(큰판32): 값이 키 자리에 올라오므로 워프끼리 칸 · 지수 칸을 키 · 값 자리 밖(큰넷판32 · 큰지수판32)에 *)
    정수 NP = 큰넷판.
    정수 EB = 큰KS.
    큰판32이면 {
        NP = 큰넷판32.
        EB = 큰지수판32.
    }
    아니면 공유32이면 {
        NP = 1024.
        줄(L, 서식글("{I}동기화().")).
    }
    줄(L, 서식글("{I}t == 0이면 \{ 판[{NP} + w * 16 + g] = wm0. 판[{NP + 8} + w * 16 + g] = wm1. \}")).
    줄(L, 서식글("{I}동기화().")).
    반복 (정수 h7는 0부터 2 전까지) {
        줄(L, 서식글("{I}짧은실수 mx{h7} = 큰쪽(큰쪽(판[{NP + 8 * h7} + g], 판[{NP + 16 + 8 * h7} + g]), 큰쪽(판[{NP + 32 + 8 * h7} + g], 판[{NP + 48 + 8 * h7} + g])).")).
        줄(L, 서식글("{I}정수 ml{h7} = 0.")).
    }
    (* 지수 — 워프의 키, ml 몫, 그리고 지수를 키 자리 판에 [n][c][레인] *)
    반복 (정수 i4는 0부터 2 전까지) {
        반복 (정수 c12는 0부터 4 전까지) {
            정수 h8 = c12 >> 1.
            줄들(L, 적힌지수식(서식글("짧은실수 e{i4}_{c12}"), 서식글("s{i4}_{c12} - mx{h8}"), I, 서식글("e{i4}_{c12}"))).
            줄(L, 서식글("{I}ml{h8} = ml{h8} + ((실수비트(곱해더하기(e{i4}_{c12}, 8388608.0, 8388608.0)) - 1258291200) 으로 정수).")).
            줄(L, 서식글("{I}판[{EB} + (nn{i4} * 4 + {c12}) * 32 + lane] = e{i4}_{c12}.")).
        }
    }
    반복 (정수 h9는 0부터 2 전까지) {
        줄(L, 서식글("{I}ml{h9} = ml{h9} + 정수레인에서받기(ml{h9}, lane ^ 1).")).
        줄(L, 서식글("{I}ml{h9} = ml{h9} + 정수레인에서받기(ml{h9}, lane ^ 2).")).
    }
    줄(L, 서식글("{I}t == 0이면 \{ 판i[{NP + 64} + w * 16 + g] = ml0 으로 중간정수. 판i[{NP + 72} + w * 16 + g] = ml1 으로 중간정수. \}")).
    줄(L, 서식글("{I}동기화().")).
    반복 (정수 h10는 0부터 2 전까지) {
        문자열목록 참조 ms = 줄목록().
        반복 (정수 w2는 0부터 4 전까지) { 줄(ms, 서식글("(판i[{NP + 64 + 16 * w2 + 8 * h10} + g] 으로 정수)")). }
        문자열 합식 = 글잇기(ms, " + ").
        줄(L, 서식글("{I}정수 mlt{h10} = {합식}.")).
        줄(L, 서식글("{I}짧은실수 l{h10} = (mlt{h10} 으로 짧은실수) * 0.00000011920928955078125.")).
    }
    반복 (정수 n6는 0부터 8 전까지) {
        반복 (정수 c13는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 f{n6}_{c13} = 판[{EB + (n6 * 4 + c13) * 32} + lane].")). }
    }
    반환 L.
}

(* 34단계 — 큰조각셈넷의 협력 판: 워프 w 가 키 [16w, 16w + 16)(협력 타일 하나)의 점수와 값의 블록 w(d [32w, 32w + 32) — 타일 둘)의
   가중합을 협력 행렬로. 그 사이(최댓값 · 합을 판으로 모으기, 지수를 키 자리 판에)는 큰조각셈넷과 같다 *)
[문자열 I를 문자열 J를 문자열 c128을 큰조각셈넷협력]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    반복 (정수 i는 0부터 2 전까지) {
        줄(L, 서식글("{I}정수 nn{i} = w * 2 + {i}.")).
        반복 (정수 c3는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 s{i}_{c3} = 영.")). }
    }
    반복 (정수 b5는 0부터 4 전까지) {
        줄(L, 서식글("{I}워프동기화().")).
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 h는 0부터 2 전까지) {
                반복 (정수 x는 0부터 2 전까지) {
                    정수 qo = j * 큰QJ + 8 * h * 협AS + x.
                    줄(L, 서식글("{I}판i[QW + {qo} + g * {협AS} + t * 2] = qa{j}_{b5}_{h}_{x}.")).
                }
            }
        }
        줄(L, 서식글("{I}워프동기화().")).
        정수 k1 = 큰KS + 2048 + b5 * 512.
        정수 k0 = 큰KS + b5 * 512.
        줄(L, 서식글("{I}\{")).
        줄들(L, 큰협력세곱(J, "QW1", "QW", 서식글("{k1} + w * 128"), 서식글("{k0} + w * 128"), 8, "")).
        반복 (정수 i2는 0부터 2 전까지) {
            반복 (정수 e는 0부터 2 전까지) {
                공유32이면 {                           (* 35단계 — 지수를 전역에서 *)
                    문자열 kx = 서식글("kx{i2}_{e}").
                    문자열 kxs = 큰지수낱말식("키지수w", 서식글("nn{i2} * 8 + t * 2 + {e}")).
                    문자열 pks = 큰지수풀기식(kx, 서식글("{b5}")).
                    줄(L, 서식글("{J}중간정수 {kx} = {kxs}.")).
                    줄(L, 서식글("{J}짧은실수 pk{i2}_{e}_{b5} = {pks}.")).
                }
                아니면 { 줄(L, 서식글("{J}짧은실수 pk{i2}_{e}_{b5} = 판[{큰PK} + (nn{i2} * 8 + t * 2 + {e}) * 4 + {b5}].")). }
            }
            반복 (정수 c는 0부터 4 전까지) {
                정수 h4 = c >> 1.
                정수 e2 = c & 1.
                줄들(L, 정수곱읽기(서식글("짧은실수 u{i2}_{c}"), 서식글("hh{i2}_{c}"), 서식글("mm{i2}_{c}"), 서식글("ll{i2}_{c}"), J, 서식글("k{i2}{c}"), 거짓)).
                b5 == 0이면 { 줄(L, 서식글("{J}s{i2}_{c} = (u{i2}_{c} * pqs0_{h4}) * pk{i2}_{e2}_0.")). }
                아니면 { 줄(L, 서식글("{J}s{i2}_{c} = 곱해더하기(u{i2}_{c} * pqs{b5}_{h4}, pk{i2}_{e2}_{b5}, s{i2}_{c}).")). }
            }
        }
        줄(L, 서식글("{I}\}")).
    }
    반복 (정수 i3는 0부터 2 전까지) { 반복 (정수 c10는 0부터 4 전까지) { 줄(L, 서식글("{I}s{i3}_{c10} = s{i3}_{c10} * {c128}.")). } }
    줄들(L, 큰지수줄들넷(I)).
    큰판32이면 { 줄들(L, 큰값올리기32("조각", I)). }         (* 35단계 — 점수 뒤 값을 키 자리에(큰지수줄들넷 의 장벽 뒤) *)
    (* 가중합 — 값의 블록 w *)
    반복 (정수 n5는 0부터 8 전까지) {
        반복 (정수 e4는 0부터 2 전까지) {
            공유32이면 {
                문자열 vx = 서식글("vx{n5}_{e4}").
                문자열 vxs = 큰지수낱말식("값지수w", 서식글("{8 * n5} + t * 2 + {e4}")).
                문자열 pvs = 큰지수풀기식(vx, "w").
                줄(L, 서식글("{I}중간정수 {vx} = {vxs}.")).
                줄(L, 서식글("{I}짧은실수 pv{n5}_{e4} = {pvs}.")).
            }
            아니면 { 줄(L, 서식글("{I}짧은실수 pv{n5}_{e4} = 판[{큰PV} + ({8 * n5} + t * 2 + {e4}) * 4 + w].")). }
        }
    }
    줄들(L, 큰e자리줄들넷(I)).
    반복 (정수 i5는 0부터 4 전까지) {
        반복 (정수 j6는 0부터 2 전까지) { 반복 (정수 c14는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 uo{i5}_{j6}_{c14} = 영.")). } }
    }
    반복 (정수 j7는 0부터 2 전까지) {
        줄(L, 서식글("{I}워프동기화().")).
        반복 (정수 자는 0부터 2 전까지) {
            반복 (정수 k는 0부터 4 전까지) {
                정수 eo = 자 * 큰QJ + 8 * (k & 1) * 협AS + (k >> 1).
                줄(L, 서식글("{I}판i[QW + {eo} + g * {협AS} + t * 2] = ea{j7}_{자}_{k}.")).
            }
        }
        줄(L, 서식글("{I}워프동기화().")).
        반복 (정수 q는 0부터 2 전까지) {
            정수 v1 = 큰값바탕() + j7 * 2048 + 1024 + 16 * q * 8.
            정수 v0 = 큰값바탕() + j7 * 2048 + 16 * q * 8.
            줄(L, 서식글("{I}\{")).
            줄들(L, 큰협력세곱(J, "QW1", "QW", 서식글("{v1} + w * 256"), 서식글("{v0} + w * 256"), 8, "p")).
            반복 (정수 nn2는 0부터 2 전까지) {
                정수 i6 = 2 * q + nn2.
                반복 (정수 c19는 0부터 4 전까지) {
                    줄들(L, 정수곱읽기(서식글("uo{i6}_{j7}_{c19}"), 서식글("phh{nn2}_{c19}"), 서식글("pmm{nn2}_{c19}"), 서식글("pll{nn2}_{c19}"), J, 서식글("v{nn2}{c19}"), 거짓)).
                }
            }
            줄(L, 서식글("{I}\}")).
        }
    }
    반복 (정수 i7는 0부터 4 전까지) {
        반복 (정수 c20는 0부터 4 전까지) {
            정수 h11 = c20 >> 1.
            줄(L, 서식글("{I}짧은실수 o{i7}_{c20} = 곱해더하기(uo{i7}_1_{c20}, Pe1_{h11}, uo{i7}_0_{c20} * Pe0_{h11}).")).
        }
    }
    반환 L.
}

[문자열 I를 문자열 J를 문자열 c128을 큰조각셈넷]는 -> 문자열목록 참조 {
    큰협력이면 { 반환 큰조각셈넷협력(I, J, c128). }          (* 34단계 *)
    문자열목록 참조 L = 줄목록().
    반복 (정수 i는 0부터 2 전까지) {
        줄(L, 서식글("{I}정수 nn{i} = w * 2 + {i}.")).
        줄(L, 서식글("{I}정수 kr{i} = nn{i} * 8 + g.")).
        반복 (정수 b3는 0부터 4 전까지) {
            줄(L, 서식글("{I}정수 kw{i}_{b3} = {큰KS} + kr{i} * 32 + (({2 * b3} + (t >> 1)) ^ ((kr{i} & 3) * 2)) * 4 + (t & 1) * 2.")).
            반복 (정수 j2는 0부터 2 전까지) {
                줄(L, 서식글("{I}중간정수 kb{i}_{b3}_{j2}_0 = 판i[kw{i}_{b3} + {j2 * 2048}].")).
                줄(L, 서식글("{I}중간정수 kb{i}_{b3}_{j2}_1 = 판i[kw{i}_{b3} + {j2 * 2048 + 1}].")).
            }
        }
        반복 (정수 e는 0부터 2 전까지) {
            문자열 kx = 서식글("kx{i}_{e}").
            공유32이면 {
                문자열 kxs = 큰지수낱말식("키지수w", 서식글("nn{i} * 8 + t * 2 + {e}")).
                줄(L, 서식글("{I}중간정수 {kx} = {kxs}.")).
            }
            반복 (정수 b4는 0부터 4 전까지) {
                공유32이면 {
                    문자열 pks = 큰지수풀기식(kx, 서식글("{b4}")).
                    줄(L, 서식글("{I}짧은실수 pk{i}_{e}_{b4} = {pks}.")).
                }
                아니면 { 줄(L, 서식글("{I}짧은실수 pk{i}_{e}_{b4} = 판[{큰PK} + (nn{i} * 8 + t * 2 + {e}) * 4 + {b4}].")). }
            }
        }
        반복 (정수 c3는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 s{i}_{c3} = 영.")). }
        반복 (정수 b5는 0부터 4 전까지) {
            문자열 A1 = 서식글("qa1_{b5}_0_0, qa1_{b5}_1_0, qa1_{b5}_0_1, qa1_{b5}_1_1").
            문자열 A0 = 서식글("qa0_{b5}_0_0, qa0_{b5}_1_0, qa0_{b5}_0_1, qa0_{b5}_1_1").
            문자열 B1 = 서식글("kb{i}_{b5}_1_0, kb{i}_{b5}_1_1").
            문자열 B0 = 서식글("kb{i}_{b5}_0_0, kb{i}_{b5}_0_1").
            줄(L, 서식글("{I}\{")).
            반복 (정수 c4는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 hh{c4} = 정수텐서곱({c4}, {A1}, {B1}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c5는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 sm{c5} = 정수텐서곱({c5}, {A1}, {B0}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c6는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 smb{c6} = 정수텐서곱({c6}, {A0}, {B1}, sm0, sm1, sm2, sm3).")). }
            반복 (정수 c7는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 ll{c7} = 정수텐서곱({c7}, {A0}, {B0}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c8는 0부터 4 전까지) {
                줄들(L, 정수곱읽기(서식글("짧은실수 u{c8}"), 서식글("hh{c8}"), 서식글("smb{c8}"), 서식글("ll{c8}"), J, 서식글("{c8}"), 거짓)).
            }
            반복 (정수 c9는 0부터 4 전까지) {
                정수 h4 = c9 >> 1.
                정수 e2 = c9 & 1.
                b5 == 0이면 { 줄(L, 서식글("{J}s{i}_{c9} = (u{c9} * pqs0_{h4}) * pk{i}_{e2}_0.")). }
                아니면 { 줄(L, 서식글("{J}s{i}_{c9} = 곱해더하기(u{c9} * pqs{b5}_{h4}, pk{i}_{e2}_{b5}, s{i}_{c9}).")). }
            }
            줄(L, 서식글("{I}\}")).
        }
        반복 (정수 c10는 0부터 4 전까지) { 줄(L, 서식글("{I}s{i}_{c10} = s{i}_{c10} * {c128}.")). }
    }
    줄들(L, 큰지수줄들넷(I)).
    (* 가중합 — 값의 블록 w *)
    반복 (정수 n5는 0부터 8 전까지) {
        반복 (정수 e4는 0부터 2 전까지) {
            공유32이면 {
                문자열 vx = 서식글("vx{n5}_{e4}").
                문자열 vxs = 큰지수낱말식("값지수w", 서식글("{8 * n5} + t * 2 + {e4}")).
                문자열 pvs = 큰지수풀기식(vx, "w").
                줄(L, 서식글("{I}중간정수 {vx} = {vxs}.")).
                줄(L, 서식글("{I}짧은실수 pv{n5}_{e4} = {pvs}.")).
            }
            아니면 { 줄(L, 서식글("{I}짧은실수 pv{n5}_{e4} = 판[{큰PV} + ({8 * n5} + t * 2 + {e4}) * 4 + w].")). }
        }
    }
    줄들(L, 큰e자리줄들넷(I)).
    반복 (정수 i5는 0부터 4 전까지) {
        줄(L, 서식글("{I}정수 vw{i5} = {큰VS} + ((w * 4 + {i5}) * 8 + g) * 8 + t * 2.")).
        반복 (정수 j6는 0부터 2 전까지) { 반복 (정수 c14는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 uo{i5}_{j6}_{c14} = 영.")). } }
        반복 (정수 j7는 0부터 2 전까지) {
            줄(L, 서식글("{I}\{")).
            반복 (정수 자2는 0부터 2 전까지) {
                줄(L, 서식글("{J}중간정수 vb{자2}_0 = 판i[vw{i5} + {(j7 * 2 + 자2) * 1024}].")).
                줄(L, 서식글("{J}중간정수 vb{자2}_1 = 판i[vw{i5} + {(j7 * 2 + 자2) * 1024 + 1}].")).
            }
            문자열 VA1 = 서식글("ea{j7}_1_0, ea{j7}_1_1, ea{j7}_1_2, ea{j7}_1_3").
            문자열 VA0 = 서식글("ea{j7}_0_0, ea{j7}_0_1, ea{j7}_0_2, ea{j7}_0_3").
            반복 (정수 c15는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 phh{c15} = 정수텐서곱({c15}, {VA1}, vb1_0, vb1_1, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c16는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 psm{c16} = 정수텐서곱({c16}, {VA1}, vb0_0, vb0_1, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c17는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 psmb{c17} = 정수텐서곱({c17}, {VA0}, vb1_0, vb1_1, psm0, psm1, psm2, psm3).")). }
            반복 (정수 c18는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 pll{c18} = 정수텐서곱({c18}, {VA0}, vb0_0, vb0_1, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c19는 0부터 4 전까지) {
                줄들(L, 정수곱읽기(서식글("uo{i5}_{j7}_{c19}"), 서식글("phh{c19}"), 서식글("psmb{c19}"), 서식글("pll{c19}"), J, 서식글("{c19}"), 거짓)).
            }
            줄(L, 서식글("{I}\}")).
        }
        반복 (정수 c20는 0부터 4 전까지) {
            정수 h11 = c20 >> 1.
            줄(L, 서식글("{I}짧은실수 o{i5}_{c20} = 곱해더하기(uo{i5}_1_{c20}, Pe1_{h11}, uo{i5}_0_{c20} * Pe0_{h11}).")).
        }
    }
    반환 L.
}

(* 정수 KV 계약의 프롬프트 어텐션 — 묶음 판, 머리 128. 블록 하나(스레드 128 — 워프마다 질의 16)가 (머리, 질의 64, 묶음 하나)의 묶음 상태를 묶음칸에 *)
[정수어텐션묶음128]는 -> 문자열목록 참조 {
    정수 Q = 64.
    정수 T = 128.
    정수 SH = 큰머리 + 4.                       (* 묶음 상태 하나의 칸: M, L, 빈 둘, O *)
    문자열 c128 = "0.088388346135616302490234375".   (* 짧은실수(1/√128) — 0x3DB504F3 (바른 반올림) *)
    문자열 이름 = "정수어텐션묶음".
    문자열 kv = 정수KV선언().
    큰협력 = 협력판 그리고 (아닌 공유32 또는 공유32새).   (* 34단계 — --협력 이면 큰조각셈이 협력 판으로(34m 의 공유32 는 아니다) *)
    큰판32 = 협력판 그리고 공유32 그리고 공유32새.     (* 35단계 — 공유32 의 협력 판(키 · 값을 번갈아 — 32 KB) *)
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 22단계 — 정수 KV 계약의 프롬프트 어텐션 묶음 판(머리 128): 블록 하나가 (머리, 질의 64, 묶음 하나)의 묶음 상태를 묶음칸에. 점수 = 블록 넷의 사슬 × 짧은실수(1/√128) *)").
    줄(L, 서식글("(* 실행한도 {이름} {T} 2 *)")).
    줄(L, 서식글("[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 {kv} 짧은실수 참조 묶음칸에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, 서식글("    정수 질조각수 = (묶음안행수 + {Q - 1}) / {Q}.")).
    줄(L, "    정수 질조각 = 블록가로() % 질조각수.").
    줄(L, "    정수 머리묶음 = 블록가로() / 질조각수.").
    줄(L, 서식글("    정수 머리 = 머리묶음 % {머리수}.")).
    줄(L, 서식글("    정수 묶g = 머리묶음 / {머리수}.")).
    줄(L, "    정수 문장 = 블록세로().").
    줄(L, 서식글("    정수 r0 = 질조각 * {Q}.")).
    문자열 머리식 = KV머리식("문장", "머리").
    줄(L, 서식글("    정수 끝r = r0 + {Q - 1}.")).
    줄(L, "    끝r >= 묶음안행수이면 \{ 끝r = 묶음안행수 - 1. \}").
    줄(L, "    정수 p0 = 위치시작 + r0.").
    줄(L, "    정수 끝조각 = (위치시작 + 끝r) / 64.").
    줄(L, "    정수 행바탕 = 문장 * 묶음안행수.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    정수 머리바탕 = {머리식}.")).
    줄(L, "    정수 키바탕 = 머리바탕 * 2 * 최대길이 * 32.").
    줄(L, "    정수 값바탕 = 머리바탕 * (최대길이 / 32) * 2048.").
    줄(L, "    정수 지수바이트 = 머리바탕 * 최대길이 * 4.").
    공유32이면 { 줄들(L, 큰지수전역머리("    ")). }
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 g = lane / 4.").
    줄(L, "    정수 t = lane % 4.").
    줄(L, "    정수 w = tid / 32.").
    큰판32이면 {                                       (* 35단계 — 키 · 값 자리 [0, 4096) 뒤에 질의 판 · D 판 *)
        줄(L, "    짧은실수 참조 판 = 공유판32().").
        줄(L, 서식글("    정수 QW = {큰QW32} + w * {2 * 큰QJ}.")).
        줄(L, 서식글("    정수 QW1 = QW + {큰QJ}.")).
        줄(L, 서식글("    정수 DW = {큰DW32} + w * {16 * 협DS}.")).
        줄(L, 서식글("    정수 dr = DW + g * {협DS} + t * 2.")).
    }
    아니면 큰협력이면 {
        줄(L, "    짧은실수 참조 판 = 공유판48().").
        줄(L, 서식글("    정수 QW = {큰QW바탕} + w * {2 * 큰QJ}.")).
        줄(L, 서식글("    정수 QW1 = QW + {큰QJ}.")).                (* 둘째 자리 — 한 변수로(뒷단이 같은 값의 읽기를 다시 쓴다) *)
        줄(L, 서식글("    정수 DW = {큰DW바탕} + w * {16 * 협DS}.")).
        줄(L, 서식글("    정수 dr = DW + g * {협DS} + t * 2.")).
    }
    아니면 공유32이면 { 줄(L, "    짧은실수 참조 판 = 공유판32()."). }       (* 34단계 — 키 · 값 자리만 *)
    아니면 { 줄(L, "    짧은실수 참조 판 = 공유판36()."). }
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    짧은실수 참조 키넓 = 키칸 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 값넓 = 값칸 으로 짧은실수 참조.").
    줄(L, "    중간정수 영i = 0.").
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    줄(L, "    정수 조각시작 = 묶g * 16.").
    줄(L, "    정수 조각끝 = 조각시작 + 15.").
    줄(L, "    조각끝 > 끝조각이면 \{ 조각끝 = 끝조각. \}").
    줄(L, "    조각시작 <= 끝조각이면 \{").
    반복 (정수 h는 0부터 2 전까지) {
        줄(L, 서식글("    정수 qr{h} = r0 + w * 16 + g + {8 * h}.")).
        줄(L, 서식글("    qr{h} > 끝r이면 \{ qr{h} = 끝r. \}")).
        줄(L, 서식글("    정수 pq{h} = 위치시작 + qr{h}.")).
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 b는 0부터 4 전까지) {
                줄(L, 서식글("    정수 qo{j}_{b}_{h} = ({j} * 행수 + 행바탕 + qr{h}) * {너비 / 4} + (머리 * 4 + {b}) * 8 + t * 2.")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_0 = 자릿값q[qo{j}_{b}_{h}].")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_1 = 자릿값q[qo{j}_{b}_{h} + 1].")).
            }
        }
        반복 (정수 b2는 0부터 4 전까지) {
            줄(L, 서식글("    짧은실수 pqs{b2}_{h} = 비트실수(정보q[(머리 * 4 + {b2}) * 정보폭 + 행바탕 + qr{h}] - {빼기둘}).")).
        }
    }
    반복 (정수 u는 0부터 1024 / T 전까지) {
        문자열 c = 서식글("(tid + {T * u})").
        줄(L, 서식글("    정수 kj{u} = {c} / 512.")).
        줄(L, 서식글("    정수 kk{u} = ({c} % 512) / 8.")).
        줄(L, 서식글("    정수 kq{u} = {c} % 8.")).
        큰협력이면 { 줄(L, 서식글("    정수 k저장{u} = {큰KS} + kj{u} * 2048 + (kq{u} / 2) * 512 + kk{u} * 8 + (kq{u} % 2) * 4.")). }   (* 블록마다 열 먼저 *)
        아니면 { 줄(L, 서식글("    정수 k저장{u} = {큰KS} + kj{u} * 2048 + kk{u} * 32 + (kq{u} ^ ((kk{u} & 3) * 2)) * 4.")). }
        줄(L, 서식글("    정수 k원본{u} = 키바탕 + kj{u} * 최대길이 * 32 + kk{u} * 32 + kq{u} * 4.")).
        정수 VB = 큰값바탕().
        줄(L, 서식글("    정수 v저장{u} = {VB} + ({c} / 512) * 2048 + (({c} % 512) / 256) * 1024 + (({c} % 256) / 2) * 8 + ({c} % 2) * 4.")).
        줄(L, 서식글("    정수 v원본{u} = 값바탕 + ({c} / 512) * 2048 + (({c} % 512) / 256) * 1024 + (({c} % 256) / 2) * 8 + ({c} % 2) * 4.")).
    }
    반복 (정수 h2는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 M{h2} = 영.")). }
    반복 (정수 h3는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 L{h3} = 영.")). }
    반복 (정수 dt는 0부터 16 전까지) { 반복 (정수 c2는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 O{dt}_{c2} = 영.")). } }
    줄(L, "    반복 (정수 조각 = 조각시작: 조각 <= 조각끝: 조각 += 1) \{").
    줄(L, "        동기화().").
    줄(L, "        \{").
    줄들(L, 큰어텐션올리기("조각", "            ")).
    줄(L, "        \}").
    줄(L, "        비동기묶기().").
    줄(L, "        \{").
    줄들(L, 큰어텐션지수풀기("조각", "            ")).
    줄(L, "        \}").
    줄(L, "        비동기기다리기(0).").
    줄(L, "        동기화().").
    줄(L, "        정수 tb = 조각 * 64.").
    큰판32이면 { 줄(L, "        \{"). }            (* 35단계 — 블록 장벽이 셈 안에 있어 모든 워프가 셈한다(쉬는 워프의 행은 끝 행으로 묶였고 쓰기만 막힌다) *)
    아니면 { 줄(L, "        (r0 + w * 16 <= 끝r)이면 \{"). }
    문자열 I = "        ".
    문자열 J = "            ".
    줄들(L, 큰조각셈(I, J, c128)).
    반복 (정수 h11는 0부터 2 전까지) {
        줄(L, 서식글("{I}pq{h11} >= tb이면 \{")).
        줄(L, 서식글("{I}    조각 == 조각시작이면 \{")).
        줄(L, 서식글("{I}        M{h11} = mx{h11}.")).
        줄(L, 서식글("{I}        L{h11} = l{h11}.")).
        반복 (정수 dt3는 0부터 16 전까지) {
            줄(L, 서식글("{I}        O{dt3}_{2 * h11} = o{dt3}_{2 * h11}.")).
            줄(L, 서식글("{I}        O{dt3}_{2 * h11 + 1} = o{dt3}_{2 * h11 + 1}.")).
        }
        줄(L, 서식글("{I}    \}")).
        줄(L, 서식글("{I}    아니면 \{")).
        줄(L, 서식글("{I}        짧은실수 새큰 = 큰쪽(M{h11}, mx{h11}).")).
        줄들(L, 적힌지수식("짧은실수 옛", 서식글("M{h11} - 새큰"), 서식글("{I}        "), 서식글("f{h11}a"))).
        줄들(L, 적힌지수식("짧은실수 새", 서식글("mx{h11} - 새큰"), 서식글("{I}        "), 서식글("f{h11}b"))).
        줄(L, 서식글("{I}        L{h11} = 곱해더하기(l{h11}, 새, L{h11} * 옛).")).
        반복 (정수 dt4는 0부터 16 전까지) {
            줄(L, 서식글("{I}        O{dt4}_{2 * h11} = 곱해더하기(o{dt4}_{2 * h11}, 새, O{dt4}_{2 * h11} * 옛).")).
            줄(L, 서식글("{I}        O{dt4}_{2 * h11 + 1} = 곱해더하기(o{dt4}_{2 * h11 + 1}, 새, O{dt4}_{2 * h11 + 1} * 옛).")).
        }
        줄(L, 서식글("{I}        M{h11} = 새큰.")).
        줄(L, 서식글("{I}    \}")).
        줄(L, 서식글("{I}\}")).
    }
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "    정수 묶음수 = (최대길이 + 1023) / 1024.").
    반복 (정수 h13는 0부터 2 전까지) {
        줄(L, 서식글("    (r0 + w * 16 + g + {8 * h13} <= 끝r 그리고 pq{h13} >= 조각시작 * 64)이면 \{")).
        줄(L, 서식글("        정수 상바탕 = (((행바탕 + r0 + w * 16 + g + {8 * h13}) * {머리수} + 머리) * 묶음수 + 묶g) * {SH}.")).
        줄(L, 서식글("        t == 0이면 \{ 묶음칸[상바탕] = M{h13}. 묶음칸[상바탕 + 1] = L{h13}. \}")).
        반복 (정수 dt7는 0부터 16 전까지) {
            반복 (정수 e5는 0부터 2 전까지) {
                줄(L, 서식글("        묶음칸[상바탕 + {4 + 8 * dt7 + e5} + t * 2] = O{dt7}_{2 * h13 + e5}.")).
            }
        }
        줄(L, "    \}").
    }
    줄(L, "    \}").
    줄(L, "\}").
    큰협력 = 거짓.
    큰판32 = 거짓.
    반환 L.
}

(* 프롬프트 어텐션의 둘째 층(머리 128): 블록 하나(스레드 128)가 (머리, 행) 하나 — 묶음 상태를 차례로 접어 출력. 짧은 = 거짓: c_proj 의 자리 둘 ·
   정보로(타일 판의 입력), 참: 짧은실수 [행][너비] 로(줄 판의 입력 — 줄 판이 같은 규칙으로 자리 둘로 바꾼다) *)
[참거짓 실수출력을 정수묶음접기128]는 -> 문자열목록 참조 {
    정수 SH = 큰머리 + 4.
    문자열 이름 = "정수묶음접기".
    실수출력이면 { 이름 = "정수묶음접기짧은". }
    문자열 출력 = "중간정수 참조 정보와 중간정수 참조 자릿값에".
    실수출력이면 { 출력 = "짧은실수 참조 출력에". }
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 22단계 — 정수 KV 계약의 프롬프트 어텐션 묶음 접기(머리 128): 블록 하나가 (머리, 행), 묶음 상태를 차례로 접는다 *)").
    줄(L, 서식글("(* 실행한도 {이름} 128 8 *)")).
    줄(L, 서식글("[짧은실수 참조 묶음칸에서 {출력} 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 머리 = 블록가로().").
    줄(L, "    정수 행 = 블록세로().").
    줄(L, "    정수 묶음끝 = (위치시작 + 행 % 묶음안행수) / 1024.").
    줄(L, "    정수 묶음수 = (최대길이 + 1023) / 1024.").
    줄(L, 서식글("    정수 바탕 = (행 * {머리수} + 머리) * 묶음수 * {SH}.")).
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 w = tid / 32.").
    줄(L, "    짧은실수 참조 판 = 공유판4().").
    (* 접는 배율 — 스레드 0 … 63(워프 둘)이 묶음 둘씩: 누적 최댓값(앞까지 · 여기까지)에서 가 · 나 *)
    줄(L, "    tid < 64이면 \{").
    줄(L, "        정수 a = tid * 2.").
    줄(L, "        짧은실수 x0 = -3.0e38.").
    줄(L, "        짧은실수 x1 = -3.0e38.").
    줄(L, 서식글("        a <= 묶음끝이면 \{ x0 = 묶음칸[바탕 + a * {SH}]. \}")).
    줄(L, 서식글("        a + 1 <= 묶음끝이면 \{ x1 = 묶음칸[바탕 + a * {SH} + {SH}]. \}")).
    줄(L, "        짧은실수 sc = 큰쪽(x0, x1).").
    반복 (정수 k = 1: k <= 16: k = k * 2) {
        줄(L, 서식글("        정수 kk{k} = lane - {k}.")).
        줄(L, 서식글("        lane < {k}이면 \{ kk{k} = lane. \}")).
        줄(L, 서식글("        sc = 큰쪽(sc, 레인에서받기(sc, kk{k})).")).
    }
    줄(L, "        짧은실수 앞 = 레인에서받기(sc, kk1).").
    줄(L, "        tid == 31이면 \{ 판[256] = sc. \}").
    줄(L, "        판[512 + tid] = x0.").
    줄(L, "        판[576 + tid] = x1.").
    줄(L, "        판[640 + tid] = sc.").
    줄(L, "        판[704 + tid] = 앞.").
    줄(L, "    \}").
    줄(L, "    동기화().").
    줄(L, "    tid < 64이면 \{").
    줄(L, "        정수 a = tid * 2.").
    줄(L, "        짧은실수 x0 = 판[512 + tid].").
    줄(L, "        짧은실수 x1 = 판[576 + tid].").
    줄(L, "        짧은실수 sc = 판[640 + tid].").
    줄(L, "        짧은실수 앞 = 판[704 + tid].").
    줄(L, "        w == 1이면 \{").
    줄(L, "            sc = 큰쪽(판[256], sc).").
    줄(L, "            lane == 0이면 \{ 앞 = 판[256]. \}").
    줄(L, "            아니면 \{ 앞 = 큰쪽(판[256], 앞). \}").
    줄(L, "        \}").
    줄(L, "        짧은실수 Pa = x0.").
    줄(L, "        tid > 0이면 \{ Pa = 큰쪽(앞, x0). \}").
    줄(L, "        (a >= 1 그리고 a <= 묶음끝)이면 \{").
    줄들(L, 적힌지수식("판[a]", "앞 - Pa", "            ", "a가")).
    줄들(L, 적힌지수식("판[128 + a]", "x0 - Pa", "            ", "a나")).
    줄(L, "        \}").
    줄(L, "        a + 1 <= 묶음끝이면 \{").
    줄들(L, 적힌지수식("판[a + 1]", "Pa - sc", "            ", "b가")).
    줄들(L, 적힌지수식("판[129 + a]", "x1 - sc", "            ", "b나")).
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "    동기화().").
    줄(L, "    짧은실수 Lr = 묶음칸[바탕 + 1].").
    줄(L, "    짧은실수 Or = 묶음칸[바탕 + 4 + tid].").
    줄(L, "    반복 (정수 i0 = 1: i0 <= 묶음끝: i0 += 8) \{").
    반복 (정수 u는 0부터 8 전까지) { 줄(L, 서식글("        정수 ii{u} = i0 + {u}.")). }
    반복 (정수 u2는 1부터 8 전까지) { 줄(L, 서식글("        ii{u2} > 묶음끝이면 \{ ii{u2} = 묶음끝. \}")). }
    반복 (정수 u3는 0부터 8 전까지) { 줄(L, 서식글("        짧은실수 lo{u3} = 묶음칸[바탕 + ii{u3} * {SH} + 1].")). }
    반복 (정수 u4는 0부터 8 전까지) { 줄(L, 서식글("        짧은실수 oo{u4} = 묶음칸[바탕 + ii{u4} * {SH} + 4 + tid].")). }
    줄(L, "        Lr = 곱해더하기(lo0, 판[128 + ii0], Lr * 판[ii0]).").
    줄(L, "        Or = 곱해더하기(oo0, 판[128 + ii0], Or * 판[ii0]).").
    반복 (정수 u5는 1부터 8 전까지) {
        줄(L, 서식글("        i0 + {u5} <= 묶음끝이면 \{")).
        줄(L, 서식글("            Lr = 곱해더하기(lo{u5}, 판[128 + ii{u5}], Lr * 판[ii{u5}]).")).
        줄(L, 서식글("            Or = 곱해더하기(oo{u5}, 판[128 + ii{u5}], Or * 판[ii{u5}]).")).
        줄(L, "        \}").
    }
    줄(L, "    \}").
    줄(L, "    짧은실수 x = Or / Lr.").
    실수출력이면 {
        줄(L, 서식글("    출력[행 * {너비} + 머리 * 128 + tid] = x.")).
        줄(L, "\}").
        반환 L.
    }
    줄(L, "    짧은실수 m = 큰쪽(x, 0.0 - x).").
    반복 (정수 k2 = 1: k2 <= 16: k2 = k2 * 2) { 줄(L, 서식글("    m = 큰쪽(m, 레인에서받기(m, lane ^ {k2})).")). }
    줄들(L, 지수식("    ")).
    줄들(L, 넷자리식("x", "    ", "q")).
    문자열 위치식 = 낱말위치("lane / 4").
    반복 (정수 j는 0부터 자리수 전까지) {
        줄(L, 서식글("    정수 반{j} = (dq{j} & 255) 으로 정수.")).
        줄(L, 서식글("    정수 옆{j}_1 = 정수레인에서받기(반{j}, lane + 1).")).
        줄(L, 서식글("    정수 옆{j}_2 = 정수레인에서받기(반{j}, lane + 2).")).
        줄(L, 서식글("    정수 옆{j}_3 = 정수레인에서받기(반{j}, lane + 3).")).
        줄(L, 서식글("    lane % 4 == 0이면 \{ 자릿값[({j} * 행수 + 행) * {너비 / 4} + (머리 * 4 + w) * 8 + {위치식}] = (반{j} | (옆{j}_1 << 8) | (옆{j}_2 << 16) | (옆{j}_3 << 24)) 으로 중간정수. \}")).
    }
    문자열 마법 = 마법수0().
    줄(L, 서식글("    lane == 0이면 \{ 정보[(머리 * 4 + w) * 정보폭 + 행] = {마법}. \}")).
    줄(L, "\}").
    반환 L.
}

(* 37단계 — 머리마다 Q · K 정규화(Qwen3 — 계약 4.6): 버qkv [행][QKV] 의 q 머리 · k 머리를 제자리에서(v 는 그대로). 워프 하나 = (행, 머리)
   하나 — 머리 h < 머리수 는 q(무게 q무게), 그 뒤 KV머리수 개는 k(무게 k무게). 레인 l 이 d = l + 32·i (i = 0 … 3)를 맡으면 계약의 접기가
   그대로 나온다: 64 접기를 둘로(a = p_l + p_{l+64}, b = p_{l+32} + p_{l+96}), 32 접기 a + b, 셔플 xor 16 · 8 · 4 · 2 · 1(덧셈은 교환 법칙이
   있어 두 레인이 같은 비트) — RMS정규화몸 을 D = 128 로 한 것과 같은 비트(가닥 t < 128 에 칸 하나씩, 128 접기는 +0). 위치와 상관없어
   칸판이 없다. 공유 메모리를 쓰지 않고 매개 넷 — 밀기 상수 128 바이트 장치(AMD)에서도 그대로. 블록 128(워프 넷),
   격자 ⌈행수 · (머리수 + KV머리수) / 4⌉ *)
[머리정규화128]는 -> 문자열목록 참조 {
    정수 H = 머리수 + KV머리수.
    정수 QKV = 너비 + 2 * 큰머리 * KV머리수.
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 37단계 — 머리마다 Q · K 정규화(Qwen3): 워프 하나 = (행, 머리) 하나, 계약 4.6 의 접기 *)").
    줄(L, "[짧은실수 참조 버qkv에 짧은실수 참조 q무게와 짧은실수 참조 k무게와 정수 행수로 머리정규화128]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 w = 블록가로() * 4 + tid / 32.").
    줄(L, 서식글("    w < 행수 * {H}이면 \{")).
    줄(L, 서식글("        정수 바탕 = (w / {H}) * {QKV} + (w % {H}) * 128 + lane.")).
    반복 (정수 i는 0부터 4 전까지) {
        줄(L, 서식글("        짧은실수 x{i} = 버qkv[바탕 + {32 * i}].")).
        줄(L, 서식글("        짧은실수 g{i} = 0 으로 짧은실수.")).
    }
    줄(L, 서식글("        w % {H} < {머리수}이면 \{")).
    반복 (정수 i2는 0부터 4 전까지) { 줄(L, 서식글("            g{i2} = q무게[lane + {32 * i2}].")). }
    줄(L, "        \}").
    줄(L, "        아니면 \{").
    반복 (정수 i3는 0부터 4 전까지) { 줄(L, 서식글("            g{i3} = k무게[lane + {32 * i3}].")). }
    줄(L, "        \}").
    줄(L, "        짧은실수 s = (x0 * x0 + x2 * x2) + (x1 * x1 + x3 * x3).").
    반복 (정수 k = 16: k >= 1: k = k / 2) { 줄(L, 서식글("        s = s + 레인에서받기(s, lane ^ {k}).")). }
    줄(L, 서식글("        짧은실수 역rms = 1.0 / 제곱근(s / 128.0 + {RMS_eps}).")).
    반복 (정수 i4는 0부터 4 전까지) { 줄(L, 서식글("        버qkv[바탕 + {32 * i4}] = (x{i4} * 역rms) * g{i4}.")). }
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}
