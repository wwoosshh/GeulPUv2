(* GeulPU 22단계 — 커널 생성기: 머리 크기 128 (7B — Qwen2.5-7B-Instruct)의 정수 KV 계약 커널. 0.5B(머리 64)의 커널은 그대로 두고(19a — 바이트가
   같아야 한다) 머리 128 판을 따로 쓴다. 계약은 문서/22단계.md · 계약.md 의 "머리 크기 128":
     점수 = 32 칸 블록 넷의 곱해더하기 사슬(b 오름차순) × 짧은실수(1/√128) (곱 한 번 — 반올림 하나), RoPE 표 [위치][64] · 짝 (i, i + 64),
     가중합 o_d 는 값의 블록 넷마다 머리 64 와 같은 식.
   캐시 배치(머리 128): 키 [KV머리][자리 2][위치][128 바이트](블록마다 낱말 차례) · 키 지수 [KV머리][위치][4],
     값 [KV머리][키 블록(32)][자리 2][d 128][32 바이트] · 값 지수 [KV머리][위치][4]. 묶음 상태는 (M, L, 빈 둘, O 128) = 132 칸. *)

상수 정수 큰머리 = 128.

(* 28단계 — 표 판: 참이면 RoPEKV정수로128 · 정수조각어텐션128 · 정수조각접기128 이 '표' 판을 낸다 — 문장(행 / 묶음안행수)마다의 위치 ·
   KV 슬롯을 장치의 표(위치표 · 슬롯표)에서 읽는다(서버의 생성 걸음 — 슬롯마다 위치가 다른 문장 여럿이 함께). 식 · 차례는 그대로 *)
참거짓 표판 = 거짓.

(* ---- RoPE + KV (줄 길 · 프롬프트 모두 — 행마다): qkv 짧은실수 [행][QKV] → q 의 자리 둘 · 정보, 키 · 값 캐시 ---- *)
[RoPEKV정수로128]는 -> 문자열목록 참조 {
    정수 QKV = 너비 + 2 * 큰머리 * KV머리수.
    정수 KBq = 너비 / 32.
    정수 KBk = (너비 + 큰머리 * KV머리수) / 32.
    문자열 kv = 정수KV선언().
    문자열 이름 = "RoPEKV정수로".
    문자열 위치매개 = "정수 참조 위치표로 정수 참조 슬롯표로".
    문자열 슬롯식 = "슬롯표[문장]".
    아닌 표판이면 { 위치매개 = "정수 위치시작으로". }
    표판이면 { 이름 = "RoPEKV정수로표". }
    (표판 그리고 공유32)이면 {              (* 34단계 — 푸시 상수 128 바이트 장치(Vulkan 의 최소 — AMD 등): 매개변수 열넷 → 열셋. 슬롯표는 표칸에서
                                             위치표 바로 뒤(정수 여덟 뒤)라 위치표 하나로 읽는다 — 엔진표.gl 의 RoPEKV정수로표하나 *)
        이름 = "RoPEKV정수로표하나".
        위치매개 = "정수 참조 위치표로".
        슬롯식 = "위치표[8 + 문장]".
    }
    문자열목록 참조 L = 줄목록().
    표판이면 { 줄(L, "(* 28단계 — 표 판: RoPEKV정수로 와 같은 식, 문장마다의 위치 · KV 슬롯을 위치표 · 슬롯표에서 *)"). }
    아니면 { 줄(L, "(* 22단계 — 줄 길의 QKV 바꾸기(머리 128): RoPE(q · k — 짝 i, i + 64, 표 [위치][64]) + 정수 KV 계약. 레인 여덟이 32 칸 블록 하나 *)"). }
    줄(L, 서식글("[짧은실수 참조 입력에서 중간정수 참조 자릿값q에 중간정수 참조 정보q에 {kv} 짧은실수 참조 코사인과 짧은실수 참조 사인과 정수 행수로 정수 묶음안행수로 {위치매개} 정수 최대길이로 {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 r = 블록세로().").
    줄(L, 서식글("    정수 블록수 = {QKV / 32}.")).
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, "    정수 b0 = 블록가로() * 32 + (tid / 32) * 4 + lane / 8.").
    줄(L, "    정수 b = b0.").
    줄(L, "    b >= 블록수이면 \{ b = 블록수 - 1. \}").
    줄(L, 서식글("    정수 xa = r * {QKV} + b * 32 + (lane % 8) * 4.")).
    줄(L, "    정수 문장 = r / 묶음안행수.").
    표판이면 { 줄(L, "    정수 위치 = 위치표[문장] + r % 묶음안행수."). }
    아니면 { 줄(L, "    정수 위치 = 위치시작 + r % 묶음안행수."). }
    줄(L, "    정수 bb = b % 4.").
    줄(L, "    정수 머리 = b / 4.").
    줄(L, 서식글("    b >= {KBq}이면 \{ 머리 = (b - {KBq}) / 4. \}")).
    줄(L, 서식글("    b >= {KBk}이면 \{ 머리 = (b - {KBk}) / 4. \}")).
    표판이면 { 줄(L, 서식글("    정수 머리바탕 = {슬롯식} * {KV머리수} + 머리.")). }
    아니면 { 줄(L, 서식글("    정수 머리바탕 = 문장 * {KV머리수} + 머리.")). }
    줄(L, "    작은정수 참조 값바이트 = 값칸 으로 작은정수 참조.").
    반복 (정수 i는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 rx{i} = 입력[xa + {i}].")). }
    줄(L, 서식글("    b < {KBk}이면 \{")).
    줄(L, "        정수 짝 = xa + 64.").
    줄(L, "        bb >= 2이면 \{ 짝 = xa - 64. \}").
    줄(L, "        정수 ti = 위치 * 64 + (bb % 2) * 32 + (lane % 8) * 4.").
    반복 (정수 i2는 0부터 4 전까지) {
        줄(L, 서식글("        짧은실수 p{i2} = 입력[짝 + {i2}].")).
        줄(L, 서식글("        짧은실수 cs{i2} = 코사인[ti + {i2}].")).
        줄(L, 서식글("        짧은실수 sn{i2} = 사인[ti + {i2}].")).
        줄(L, 서식글("        bb < 2이면 \{ rx{i2} = 곱해더하기(rx{i2}, cs{i2}, -(p{i2} * sn{i2})). \}")).
        줄(L, 서식글("        아니면 \{ rx{i2} = 곱해더하기(rx{i2}, cs{i2}, p{i2} * sn{i2}). \}")).
    }
    줄(L, "    \}").
    줄(L, "    중간정수 M0 = 0.").
    줄들(L, 블록바꾸기몸("rx@", "정수 자@ = 0. 자@", "M0 = @.", "    ")).
    문자열 pos식 = 낱말위치("lane % 8").
    줄(L, 서식글("    정수 pos = {pos식}.")).
    줄(L, "    b0 < 블록수이면 \{").
    줄(L, 서식글("        b < {KBq}이면 \{")).
    반복 (정수 j는 0부터 2 전까지) { 줄(L, 서식글("            자릿값q[({j} * 행수 + r) * {너비 / 4} + b * 8 + pos] = 자{j}.")). }
    줄(L, "            lane % 8 == 0이면 \{ 정보q[b * 정보폭 + r] = M0. \}").
    줄(L, "        \}").
    줄(L, 서식글("        아니면 b < {KBk}이면 \{")).
    반복 (정수 j2는 0부터 2 전까지) { 줄(L, 서식글("            키칸[(머리바탕 * 2 + {j2}) * 최대길이 * 32 + 위치 * 32 + bb * 8 + pos] = 자{j2}.")). }
    줄(L, "            lane % 8 == 0이면 \{ 키지수[(머리바탕 * 최대길이 + 위치) * 4 + bb] = (E + 114) 으로 부호없는 작은정수. \}").
    줄(L, "        \}").
    줄(L, "        아니면 \{").
    줄(L, "            정수 r32 = 위치 % 32.").
    줄(L, "            정수 r16 = r32 % 16.").
    줄(L, "            정수 낱말 = ((r16 % 8) / 2) * 2 + r32 / 16.").
    줄(L, "            정수 바이트 = (r16 / 8) * 2 + r16 % 2.").
    줄(L, "            정수 d0 = bb * 32 + (lane % 8) * 4.").
    줄(L, "            정수 값바탕 = ((머리바탕 * (최대길이 / 32) + 위치 / 32) * 2) * 4096.").
    반복 (정수 j3는 0부터 2 전까지) {
        반복 (정수 i3는 0부터 4 전까지) {
            줄(L, 서식글("            값바이트[값바탕 + {j3} * 4096 + (d0 + {i3}) * 32 + 낱말 * 4 + 바이트] = d{i3}{j3} 으로 작은정수.")).
        }
    }
    줄(L, "            lane % 8 == 0이면 \{ 값지수[(머리바탕 * 최대길이 + 위치) * 4 + bb] = (E + 114) 으로 부호없는 작은정수. \}").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* ---- 프롬프트 어텐션 묶음 판(머리 128) ---- *)
(* 판(공유 36 KB, 낱말): 키 자리 [2][64 키][32 낱말] (16 바이트 조각을 (키 & 3)·2 로 섞어), 값 자리 [키 블록 2][자리 2][d 128][8 낱말],
   키 지수 짧은실수 [64 키][4], 값 지수 짧은실수 [64 키][4]. 한 벌(머리 128 은 두 벌이 36 KB 를 넘는다).
   34단계 — 공유32(공유 메모리 32 KB 장치 — AMD · Intel 의 Vulkan): 지수를 판에 두지 않는다. 스레드가 쓸 키의 지수 낱말(키 하나의 바이트
   넷 — 바이트 b 가 블록 b)을 전역에서 읽어 같은 식(2^(E − 13) = 바이트 << 23 의 비트)으로 푼다 — 판의 값과 비트까지 같다. 판은 키 · 값
   자리(32 KB)뿐이고, 생성 넷 판의 워프끼리 칸(큰넷판)은 점수 뒤에 빈 키 자리 판 안(지수 칸 [0, 1024) 뒤)으로 *)
상수 정수 큰KS = 0.
상수 정수 큰VS = 4096.
상수 정수 큰PK = 8192.
상수 정수 큰PV = 8448.
참거짓 큰판32 = 거짓.               (* 35단계 — 공유32 의 협력 판(키 · 값을 번갈아 [0, 4096) 에 — 아래 큰QW32 의 설명). 커널 머리가 정한다 *)

(* 34단계 — 공유32 의 지수: 낱말(식)의 바이트(식 — 0 … 3)를 2^(E − 13) 짧은실수로(큰어텐션지수풀기 와 같은 비트) *)
[문자열 낱말을 문자열 바이트를 큰지수풀기식]는 -> 문자열 {
    반환 서식글("비트실수(((({낱말}) >> (8 * ({바이트}))) & 255) << 23)").
}

(* 키 조각의 키 k(식 — 0 … 63)의 지수 낱말(키 · 값) — 지수낱말 = 지수바이트 / 4, 조각 = 키 조각 번호 *)
[문자열 표를 문자열 k를 큰지수낱말식]는 -> 문자열 {
    반환 서식글("{표}[지수낱말 + 조각 * 64 + {k}]").
}

(* 공유32 의 판 머리 — 지수 낱말의 칸(전역)을 낱말로 본다 *)
[문자열 ind를 큰지수전역머리]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}중간정수 참조 키지수w = 키지수 으로 중간정수 참조.")).
    줄(o, 서식글("{ind}중간정수 참조 값지수w = 값지수 으로 중간정수 참조.")).
    줄(o, 서식글("{ind}정수 지수낱말 = 지수바이트 / 4.")).
    반환 o.
}

(* 조각(식)의 키 · 값 자리를 판으로 — 스레드 128 이 16 바이트 조각을 키 여덟 · 값 여덟 *)
[문자열 조각을 문자열 ind를 큰어텐션올리기]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}정수 kt = ({조각}) * 64.")).
    반복 (정수 u는 0부터 8 전까지) { 줄(o, 서식글("{ind}비동기복사16(판 에, k저장{u} 를, 키넓 에서, k원본{u} + kt * 32 로).")). }
    큰판32이면 { 반환 o. }                         (* 35단계 — 값은 점수 뒤에(큰값올리기32) *)
    반복 (정수 u2는 0부터 8 전까지) { 줄(o, 서식글("{ind}비동기복사16(판 에, v저장{u2} 를, 값넓 에서, v원본{u2} + ({조각}) * 4096 로).")). }
    반환 o.
}

(* 조각(식)의 지수 바이트를 2^(E − 13) 짧은실수로 판에 — 스레드 0 … 63 이 키, 64 … 127 이 값(키 하나의 블록 넷씩) *)
[문자열 조각을 문자열 ind를 큰어텐션지수풀기]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    공유32이면 { 반환 o. }                     (* 34단계 — 공유32: 지수는 셈에서 전역으로 읽는다(큰지수풀기식) *)
    줄(o, 서식글("{ind}정수 풀바탕 = {큰PK} + tid * 4.")).
    줄(o, 서식글("{ind}정수 지바탕 = 지수바이트 + ({조각}) * 256 + (tid & 63) * 4.")).
    문자열목록 참조 키 = 줄목록().
    문자열목록 참조 값 = 줄목록().
    반복 (정수 i는 0부터 4 전까지) {
        줄(키, 서식글("판[풀바탕 + {i}] = 비트실수((키지수[지바탕 + {i}] 으로 중간정수) << 23).")).
        줄(값, 서식글("판[풀바탕 + {i}] = 비트실수((값지수[지바탕 + {i}] 으로 중간정수) << 23).")).
    }
    문자열 키줄 = 글잇기(키, " ").
    문자열 값줄 = 글잇기(값, " ").
    줄(o, 서식글("{ind}tid < 64이면 \{ {키줄} \}")).
    줄(o, 서식글("{ind}아니면 \{ {값줄} \}")).
    반환 o.
}

(* e′ = e · 2^(E_v,b − 13) 를 값의 블록 b(상수) 하나에 대해, 키 32 개 블록 j 마다 자리 둘로 → A 조각 ea{b}_{j}_{자리}_{0..3}, 배율 Pe{b}_{j}_{h} *)
[정수 b를 문자열 I를 큰e자리줄들]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    반복 (정수 j는 0부터 2 전까지) {
        반복 (정수 h0는 0부터 2 전까지) { 줄(L, 서식글("{I}짧은실수 Pe{b}_{j}_{h0} = 영.")). }
        반복 (정수 자0는 0부터 2 전까지) {
            반복 (정수 k0는 0부터 4 전까지) { 줄(L, 서식글("{I}중간정수 ea{b}_{j}_{자0}_{k0} = 0.")). }
        }
        반복 (정수 c는 0부터 4 전까지) {
            정수 e = c & 1.
            반복 (정수 n = 4 * j: n < 4 * j + 4: n += 1) { 줄(L, 서식글("{I}짧은실수 ep{b}_{n}_{c} = e{n}_{c} * pv{n}_{e}_{b}.")). }
        }
        반복 (정수 h는 0부터 2 전까지) {
            문자열목록 참조 xs = 줄목록().
            반복 (정수 n2 = 4 * j: n2 < 4 * j + 4: n2 += 1) {
                줄(xs, 서식글("ep{b}_{n2}_{2 * h}")).
                줄(xs, 서식글("ep{b}_{n2}_{2 * h + 1}")).
            }
            문자열 expr = 최대사슬(xs).
            줄(L, 서식글("{I}\{")).
            줄(L, 서식글("{I}    짧은실수 m = {expr}.")).
            줄(L, 서식글("{I}    m = 큰쪽(m, 레인에서받기(m, lane ^ 1)).")).
            줄(L, 서식글("{I}    m = 큰쪽(m, 레인에서받기(m, lane ^ 2)).")).
            줄들(L, 지수식(서식글("{I}    "))).
            줄(L, 서식글("{I}    Pe{b}_{j}_{h} = 비트실수(((E + 114) << 23) 으로 중간정수).")).
            반복 (정수 n3 = 4 * j: n3 < 4 * j + 4: n3 += 1) {
                반복 (정수 e2는 0부터 2 전까지) {
                    정수 c2 = 2 * h + e2.
                    줄(L, 서식글("{I}    중간정수 me{n3}_{c2} = 실수비트(곱해더하기(ep{b}_{n3}_{c2}, s, 8388736.0)) - 1258291200.")).
                }
            }
            반복 (정수 half는 0부터 2 전까지) {
                정수 n0 = 4 * j + 2 * half.
                정수 n1 = 4 * j + 2 * half + 1.
                줄(L, 서식글("{I}    중간정수 p01_{half} = 바이트고르기(me{n0}_{2 * h}, me{n0}_{2 * h + 1}, 20800).")).
                줄(L, 서식글("{I}    중간정수 p23_{half} = 바이트고르기(me{n1}_{2 * h}, me{n1}_{2 * h + 1}, 20800).")).
                줄(L, 서식글("{I}    ea{b}_{j}_0_{2 * half + h} = 바이트고르기(p01_{half}, p23_{half}, 21520) ^ (-2139062144).")).
                줄(L, 서식글("{I}    ea{b}_{j}_1_{2 * half + h} = 바이트고르기(p01_{half}, p23_{half}, 30258).")).
            }
            줄(L, 서식글("{I}\}")).
        }
    }
    반환 L.
}

(* 34단계 — 협력 판(--협력)의 프롬프트 어텐션: 키를 블록마다 열 먼저([자리][블록][키][낱말 8])로 판에 두고, 워프마다 질의 · e′ 의 자리
   판(QW — 자리마다 행 16 × 48 바이트)과 D 판(16 × 16 정수)을 판 뒤에 둔다 *)
참거짓 큰협력 = 거짓.
상수 정수 큰QJ = 192.               (* 자리 하나의 행 16 × 협AS(낱말) *)
상수 정수 큰QW바탕 = 8832.          (* 큰넷판(8704 — 생성 넷 판의 워프끼리 최댓값 · 합) + 128 뒤 *)
상수 정수 큰DW바탕 = 10368.         (* 큰QW바탕 + 워프 넷 × 2 · 큰QJ — 끝 11648 낱말(46.6 KB) *)

(* 35단계 — 공유32 의 협력 판(판 32 KB): 키를 [0, 4096) 에 올려 점수를 내고, 같은 자리에 값을 올려 가중합을 낸다(키와 값이 같은 때
   판에 있지 않다). 그 뒤에 워프마다의 질의 판 · D 판, 생성 넷 판의 워프끼리 칸 · 지수 칸 — 끝 8064 낱말(31.5 KB). 지수는 전역에서 *)
상수 정수 큰QW32 = 4096.
상수 정수 큰DW32 = 5632.
상수 정수 큰넷판32 = 6912.
상수 정수 큰지수판32 = 7040.

(* 값 자리의 판 바탕 — 큰판32 이면 키 자리와 같은 0 *)
[큰값바탕]는 -> 정수 {
    큰판32이면 { 반환 0. }
    반환 큰VS.
}

(* 큰판32 — 점수 뒤 값을 판에 올린다(모든 워프가 키 읽기를 마친 뒤 — 앞의 장벽은 부르는 쪽이) *)
[문자열 조각을 문자열 ind를 큰값올리기32]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    반복 (정수 u2는 0부터 8 전까지) { 줄(o, 서식글("{ind}비동기복사16(판 에, v저장{u2} 를, 값넓 에서, v원본{u2} + ({조각}) * 4096 로).")). }
    줄(o, 서식글("{ind}비동기묶기().")).
    줄(o, 서식글("{ind}비동기기다리기(0).")).
    줄(o, 서식글("{ind}동기화().")).
    반환 o.
}

(* 세 곱 — 상·상 A1 · B1, 엇갈림 A1 · B0 + A0 · B1, 하·하 A0 · B0 을 차례로 D 판에 두고 스레드의 칸(행 g · g + 8, 열 8 · nn + 2t + e)을
   {이름앞}hh · mm · ll{nn}_{c} 로 읽는다 *)
[문자열 J를 문자열 a1을 문자열 a0을 문자열 b1을 문자열 b0을 정수 bn을 문자열 이름앞을 큰협력세곱]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    문자열[3] 이름.
    이름[0] = 서식글("{이름앞}hh").
    이름[1] = 서식글("{이름앞}mm").
    이름[2] = 서식글("{이름앞}ll").
    협력레인이면 {                                       (* --레인: D 를 판에 두지 않고 레인의 성분으로(생성협력타일.gl 의 차례) *)
        줄(L, 서식글("{J}정수 ca1 = {a1}.")).
        줄(L, 서식글("{J}정수 ca0 = {a0}.")).
        줄(L, 서식글("{J}정수 cb1 = {b1}.")).
        줄(L, 서식글("{J}정수 cb0 = {b0}.")).
        반복 (정수 k2는 0부터 3 전까지) {
            문자열 nm2 = 이름[k2].
            반복 (정수 j는 0부터 8 전까지) {
                정수 nn2 = 레인열조각(j).
                정수 c2 = 레인칸(j).
                문자열 부름 = 서식글("정수행렬판곱성분({j}, 판, ca1, {협AS}, cb1, {bn})").
                k2 == 1이면 { 부름 = 서식글("정수행렬판곱짝성분({j}, 판, ca1, ca0, {협AS}, cb0, cb1, {bn})"). }
                k2 == 2이면 { 부름 = 서식글("정수행렬판곱성분({j}, 판, ca0, {협AS}, cb0, {bn})"). }
                줄(L, 서식글("{J}중간정수 {nm2}{nn2}_{c2} = {부름}.")).
            }
        }
        반환 L.
    }
    반복 (정수 k는 0부터 3 전까지) {
        k == 0이면 { 줄(L, 서식글("{J}정수행렬판곱(판, {a1}, {협AS}, {b1}, {bn}, DW, {협DS}).")). }
        아니면 k == 1이면 { 줄(L, 서식글("{J}정수행렬판곱짝(판, {a1}, {a0}, {협AS}, {b0}, {b1}, {bn}, DW, {협DS}).")). }
        아니면 { 줄(L, 서식글("{J}정수행렬판곱(판, {a0}, {협AS}, {b0}, {bn}, DW, {협DS}).")). }
        줄(L, 서식글("{J}워프동기화().")).
        문자열 nm = 이름[k].
        반복 (정수 nn는 0부터 2 전까지) {
            반복 (정수 c는 0부터 4 전까지) {
                정수 off = 8 * (c >> 1) * 협DS + 8 * nn + (c & 1).
                줄(L, 서식글("{J}중간정수 {nm}{nn}_{c} = 판i[dr + {off}].")).
            }
        }
        줄(L, 서식글("{J}워프동기화().")).
    }
    반환 L.
}

(* 큰조각셈의 협력 판 — 같은 식 · 같은 차례(점수는 블록 b 차례, 가중합은 값의 블록 b 마다 키 블록 j 차례), 곱만 협력 행렬로. 질의의
   자리(점수)와 e′ 의 자리(가중합)를 QW 에 키 · 값의 저장 차례 그대로 쓴다 — 질의와 키는 같은 차례로 저장되어 있고, e′ 의 ea_k 는
   행 g + 8 · (k & 1) · 낱말 2t + (k >> 1) 이 값의 저장 낱말과 같은 키다 *)
[문자열 I를 문자열 J를 문자열 c128을 큰조각셈협력]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    반복 (정수 n는 0부터 8 전까지) { 반복 (정수 c는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 s{n}_{c} = 영.")). } }
    반복 (정수 b5는 0부터 4 전까지) {
        줄(L, 서식글("{I}워프동기화().")).
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 h는 0부터 2 전까지) {
                반복 (정수 x는 0부터 2 전까지) {
                    정수 qo = j * 큰QJ + 8 * h * 협AS + x.
                    줄(L, 서식글("{I}판i[QW + {qo} + g * {협AS} + t * 2] = qa{j}_{b5}_{h}_{x}.")).
                }
            }
        }
        줄(L, 서식글("{I}워프동기화().")).
        반복 (정수 p는 0부터 4 전까지) {
            정수 k1 = 큰KS + 2048 + b5 * 512 + p * 128.
            정수 k0 = 큰KS + b5 * 512 + p * 128.
            줄(L, 서식글("{I}\{")).
            줄들(L, 큰협력세곱(J, "QW1", "QW", 서식글("{k1}"), 서식글("{k0}"), 8, "")).
            반복 (정수 nn는 0부터 2 전까지) {
                정수 n = 2 * p + nn.
                반복 (정수 e는 0부터 2 전까지) {
                    공유32이면 {                       (* 35단계 — 지수를 전역에서(34m 과 같은 비트) *)
                        문자열 kx = 서식글("kx{n}_{e}").
                        문자열 kxs = 큰지수낱말식("키지수w", 서식글("{8 * n} + t * 2 + {e}")).
                        문자열 pks = 큰지수풀기식(kx, 서식글("{b5}")).
                        줄(L, 서식글("{J}중간정수 {kx} = {kxs}.")).
                        줄(L, 서식글("{J}짧은실수 pk{n}_{e}_{b5} = {pks}.")).
                    }
                    아니면 { 줄(L, 서식글("{J}짧은실수 pk{n}_{e}_{b5} = 판[{큰PK} + ({8 * n} + t * 2 + {e}) * 4 + {b5}].")). }
                }
                반복 (정수 c는 0부터 4 전까지) {
                    정수 h4 = c >> 1.
                    정수 e2 = c & 1.
                    줄들(L, 정수곱읽기(서식글("짧은실수 u{nn}_{c}"), 서식글("hh{nn}_{c}"), 서식글("mm{nn}_{c}"), 서식글("ll{nn}_{c}"), J, 서식글("k{nn}{c}"), 거짓)).
                    b5 == 0이면 { 줄(L, 서식글("{J}s{n}_{c} = (u{nn}_{c} * pqs0_{h4}) * pk{n}_{e2}_0.")). }
                    아니면 { 줄(L, 서식글("{J}s{n}_{c} = 곱해더하기(u{nn}_{c} * pqs{b5}_{h4}, pk{n}_{e2}_{b5}, s{n}_{c}).")). }
                }
            }
            줄(L, 서식글("{I}\}")).
        }
    }
    반복 (정수 n2는 0부터 8 전까지) { 반복 (정수 c2는 0부터 4 전까지) { 줄(L, 서식글("{I}s{n2}_{c2} = s{n2}_{c2} * {c128}.")). } }
    줄들(L, 큰지수줄들(I)).
    큰판32이면 {                                 (* 35단계 — 모든 워프가 키 읽기를 마친 뒤 같은 자리에 값을 *)
        줄(L, 서식글("{I}동기화().")).
        줄들(L, 큰값올리기32("조각", I)).
    }
    반복 (정수 b9는 0부터 4 전까지) {
        반복 (정수 n5는 0부터 8 전까지) {
            반복 (정수 e4는 0부터 2 전까지) {
                공유32이면 {
                    문자열 vx = 서식글("vx{n5}_{e4}_{b9}").
                    문자열 vxs = 큰지수낱말식("값지수w", 서식글("{8 * n5} + t * 2 + {e4}")).
                    문자열 pvs = 큰지수풀기식(vx, 서식글("{b9}")).
                    줄(L, 서식글("{I}중간정수 {vx} = {vxs}.")).
                    줄(L, 서식글("{I}짧은실수 pv{n5}_{e4}_{b9} = {pvs}.")).
                }
                아니면 { 줄(L, 서식글("{I}짧은실수 pv{n5}_{e4}_{b9} = 판[{큰PV} + ({8 * n5} + t * 2 + {e4}) * 4 + {b9}].")). }
            }
        }
        줄들(L, 큰e자리줄들(b9, I)).
        반복 (정수 dt2 = 4 * b9: dt2 < 4 * b9 + 4: dt2 += 1) {
            반복 (정수 j6는 0부터 2 전까지) { 반복 (정수 c13는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 uo{dt2}_{j6}_{c13} = 영.")). } }
        }
        반복 (정수 j7는 0부터 2 전까지) {
            줄(L, 서식글("{I}워프동기화().")).
            반복 (정수 자는 0부터 2 전까지) {
                반복 (정수 k는 0부터 4 전까지) {
                    정수 eo = 자 * 큰QJ + 8 * (k & 1) * 협AS + (k >> 1).
                    줄(L, 서식글("{I}판i[QW + {eo} + g * {협AS} + t * 2] = ea{b9}_{j7}_{자}_{k}.")).
                }
            }
            줄(L, 서식글("{I}워프동기화().")).
            반복 (정수 q는 0부터 2 전까지) {
                정수 v1 = 큰값바탕() + j7 * 2048 + 1024 + (32 * b9 + 16 * q) * 8.
                정수 v0 = 큰값바탕() + j7 * 2048 + (32 * b9 + 16 * q) * 8.
                줄(L, 서식글("{I}\{")).
                줄들(L, 큰협력세곱(J, "QW1", "QW", 서식글("{v1}"), 서식글("{v0}"), 8, "p")).
                반복 (정수 nn2는 0부터 2 전까지) {
                    정수 dt3 = 4 * b9 + 2 * q + nn2.
                    반복 (정수 c18는 0부터 4 전까지) {
                        줄들(L, 정수곱읽기(서식글("uo{dt3}_{j7}_{c18}"), 서식글("phh{nn2}_{c18}"), 서식글("pmm{nn2}_{c18}"), 서식글("pll{nn2}_{c18}"), J, 서식글("v{nn2}{c18}"), 거짓)).
                    }
                }
                줄(L, 서식글("{I}\}")).
            }
        }
        반복 (정수 dt4 = 4 * b9: dt4 < 4 * b9 + 4: dt4 += 1) {
            반복 (정수 c19는 0부터 4 전까지) {
                정수 h9 = c19 >> 1.
                줄(L, 서식글("{I}짧은실수 o{dt4}_{c19} = 곱해더하기(uo{dt4}_1_{c19}, Pe{b9}_1_{h9}, uo{dt4}_0_{c19} * Pe{b9}_0_{h9}).")).
            }
        }
    }
    반환 L.
}

(* 키 조각 하나(판에 올린 키 · 값 · 지수)의 셈 — 점수(블록 넷의 사슬 × 짧은실수(1/√128)) · 가림 · 최댓값 · 적힌지수 · 합 · e′ 자리 · 가중합.
   묶음 판과 생성의 조각 판이 같은 줄을 쓴다. 읽는 이름: tb · p0 · pq{h} · qa · pqs · 판 · 판i · lane · g · t · 영 · 영i, 내는 이름: mx{h} · l{h} · o{dt}_{c} *)
[문자열 I를 문자열 J를 문자열 c128을 큰조각셈]는 -> 문자열목록 참조 {
    큰협력이면 { 반환 큰조각셈협력(I, J, c128). }          (* 34단계 *)
    문자열목록 참조 L = 줄목록().
    반복 (정수 n는 0부터 8 전까지) {
        줄(L, 서식글("{I}정수 kr{n} = {8 * n} + g.")).
        반복 (정수 b3는 0부터 4 전까지) {
            줄(L, 서식글("{I}정수 kw{n}_{b3} = {큰KS} + kr{n} * 32 + (({2 * b3} + (t >> 1)) ^ ((kr{n} & 3) * 2)) * 4 + (t & 1) * 2.")).
            반복 (정수 j2는 0부터 2 전까지) {
                줄(L, 서식글("{I}중간정수 kb{n}_{b3}_{j2}_0 = 판i[kw{n}_{b3} + {j2 * 2048}].")).
                줄(L, 서식글("{I}중간정수 kb{n}_{b3}_{j2}_1 = 판i[kw{n}_{b3} + {j2 * 2048 + 1}].")).
            }
        }
        반복 (정수 e는 0부터 2 전까지) {
            문자열 kx = 서식글("kx{n}_{e}").
            공유32이면 {
                문자열 kxs = 큰지수낱말식("키지수w", 서식글("{8 * n} + t * 2 + {e}")).
                줄(L, 서식글("{I}중간정수 {kx} = {kxs}.")).
            }
            반복 (정수 b4는 0부터 4 전까지) {
                공유32이면 {
                    문자열 pks = 큰지수풀기식(kx, 서식글("{b4}")).
                    줄(L, 서식글("{I}짧은실수 pk{n}_{e}_{b4} = {pks}.")).
                }
                아니면 { 줄(L, 서식글("{I}짧은실수 pk{n}_{e}_{b4} = 판[{큰PK} + ({8 * n} + t * 2 + {e}) * 4 + {b4}].")). }
            }
        }
        반복 (정수 c3는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 s{n}_{c3} = 영.")). }
        반복 (정수 b5는 0부터 4 전까지) {
            문자열 A1 = 서식글("qa1_{b5}_0_0, qa1_{b5}_1_0, qa1_{b5}_0_1, qa1_{b5}_1_1").
            문자열 A0 = 서식글("qa0_{b5}_0_0, qa0_{b5}_1_0, qa0_{b5}_0_1, qa0_{b5}_1_1").
            문자열 B1 = 서식글("kb{n}_{b5}_1_0, kb{n}_{b5}_1_1").
            문자열 B0 = 서식글("kb{n}_{b5}_0_0, kb{n}_{b5}_0_1").
