    줄(L, 서식글("{J}    반복 (정수 cg = 블록: cg < {G줄l}: cg += 격자수) \{")).
    줄(L, 서식글("{J}        cg + 격자수 < {G줄l}이면 \{")).
    줄들(L, 묶음미리(4, "", "cg + 격자수", 서식글("{J}            "))).
    줄(L, 서식글("{J}        \}")).
    문자열목록 참조 로짓끝 = 줄목록().
    줄(로짓끝, 서식글("기록 == 1이면 \{ 로짓칸[(s - 1) * {V} + 열] = v. \}")).
