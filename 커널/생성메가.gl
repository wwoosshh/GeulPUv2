    줄(L, 서식글("{J}    tid == 0이면 \{ 부분값[블록] = 최고. 부분번호[블록] = 최고번호. \}")).
    줄(L, 서식글("{J}\}")).
    줄들(L, 메장벽(J, "")).
    줄(L, 서식글("{J}블록 == 0이면 \{")).
    줄(L, 서식글("{J}    tid < 32이면 \{")).
    줄(L, 서식글("{J}        짧은실수 큰2 = 부분값[tid].")).
    줄(L, 서식글("{J}        정수 큰번호2 = 부분번호[tid].")).
    줄(L, 서식글("{J}        반복 (정수 i = tid + 32: i < 격자수: i += 32) \{")).
    줄(L, 서식글("{J}            (부분값[i] > 큰2 또는 (부분값[i] == 큰2 그리고 부분번호[i] < 큰번호2))이면 \{ 큰2 = 부분값[i]. 큰번호2 = 부분번호[i]. \}")).
    줄(L, 서식글("{J}        \}")).
    반복 (정수 sft = 16: sft >= 1: sft = sft / 2) {
        줄(L, 서식글("{J}        짧은실수 남값{sft} = 아래에서받기(큰2, {sft}).")).
        줄(L, 서식글("{J}        정수 남번호{sft} = 정수아래에서받기(큰번호2, {sft}).")).
        줄(L, 서식글("{J}        (tid + {sft} < 32 그리고 (남값{sft} > 큰2 또는 (남값{sft} == 큰2 그리고 남번호{sft} < 큰번호2)))이면 \{ 큰2 = 남값{sft}. 큰번호2 = 남번호{sft}. \}")).
    }
    줄(L, 서식글("{J}        tid == 0이면 \{ 생성칸[토큰시작 + s] = 큰번호2. 번판[{번 + 1}] = 큰번호2. \}")).
    줄(L, 서식글("{J}    \}")).
    줄(L, 서식글("{J}    동기화().")).
    줄(L, 서식글("{J}    정수 다음토큰 = 번판[{번 + 1}].")).
    반복 (정수 i는 0부터 (D + T - 1) / T 전까지) {
        문자열 c = 서식글("tid + {T * i}").
        T * (i + 1) <= D이면 { 줄(L, 서식글("{J}    \{")). }
        아니면 { 줄(L, 서식글("{J}    {c} < {D}이면 \{")). }
        줄들(L, 낱말풀기("다음토큰", c, 서식글("낱값{i}"), 서식글("{J}        "))).
        줄(L, 서식글("{J}        숨칸[{c}] = 낱값{i}.")).
        줄(L, 서식글("{J}    \}")).
    }
    줄(L, 서식글("{J}\}")).
    줄(L, 서식글("{J}(블록 > 0 그리고 블록 < {QKV / wq})이면 \{")).
    줄들(L, 묶음미리(0, "0", "블록", 서식글("{J}    "))).
    줄(L, 서식글("{J}\}")).
    줄들(L, 메장벽(J, "")).
    줄(L, 서식글("{J}정수 방금 = 획득읽기(생성칸 에서, 토큰시작 + s 로).")).
    줄(L, 서식글("{J}(방금 == 끝1 또는 방금 == 끝2)이면 \{ s = 생성수. \}")).
    줄(L, 서식글("{I}\}")).
    줄(L, "\}").
    반환 L.
}
