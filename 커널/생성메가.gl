    줄(L, 서식글("{J}            열수끝 > {wl}이면 \{ 열수끝 = {wl}. \}")).
    줄(L, 서식글("{J}            반복 (정수 c = 0: c < 열수끝: c += 1) \{")).
    줄(L, 서식글("{J}                판[{VS} + c] > 최고이면 \{ 최고 = 판[{VS} + c]. 최고번호 = cg * {wl} + c. \}")).
    줄(L, 서식글("{J}            \}")).
    줄(L, 서식글("{J}        \}")).
    줄(L, 서식글("{J}        동기화().")).
