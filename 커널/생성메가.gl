    줄들(L, 정수열곱(서식글("{D / 4}"), 서식글("{KBd}"), 서식글("{V}"), 서식글("{(V + 63) / 64 * 64}"), 서식글("{wl}"), "머리표", "머리척도", "", "", DX, DM0, US, "판", SD, T, "영칸[열]", 로짓끝, "cg", 서식글("{J}        "))).
    줄(L, 서식글("{J}        tid == 0이면 \{")).
