(* GeulPU 19단계 — 커널 생성기의 Qwen2 길(글 언어): 머리줄 · 정수로 · RMS · 정수 행렬곱(줄 판 · 타일 판) · 끝손질 · 줄 길의 판.
   파이썬 커널생성.py 의 같은 이름의 함수를 옮긴 것(줄의 글자 그대로). *)

[머리줄]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 커널생성.py 가 만든 파일 — 고치지 말 것. 순서의 약속은 커널생성.py 의 설명 그대로. *)").
    줄(L, "(* 31단계 — 짧은실수 연산은 비정규수를 버린다(계약의 규칙 R — 문서/31단계.md). 아래 표시가 PTX 뒷단의 .ftz 를 켠다. *)").
    줄(L, "(* 비정규수버림 *)").
    줄(L, "").
    줄(L, "외부 [블록안가로]는 -> 정수.").
    줄(L, "외부 [블록가로]는 -> 정수.").
    줄(L, "외부 [블록세로]는 -> 정수.").
    반복 (정수 kb = 4: kb < 49: kb += 4) { 줄(L, 서식글("외부 [공유판{kb}]는 -> 짧은실수 참조.")). }
    줄(L, "외부 [동기화]는.").
    줄(L, "외부 [짧은실수 x를 짧은실수 y를 큰쪽]는 -> 짧은실수.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 짧은실수 참조 원본에서 정수 색인으로 비동기복사]는.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 짧은실수 참조 원본에서 정수 색인으로 비동기복사16]는.").
    줄(L, "외부 [비동기묶기]는.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 짧은실수 참조 원본에서 정수 색인으로 넓게미리올리기]는.").
    줄(L, "외부 [정수 n을 비동기기다리기]는.").
    줄(L, "외부 [짧은실수 참조 원본에서 정수 색인으로 미리읽기]는.").
    줄(L, "외부 [실행번호]는 -> 정수.").
    줄(L, "외부 [실행개수]는 -> 정수.").
    줄(L, "외부 [공유메모리2]는 -> 정수 참조.").
    줄(L, "외부 [울타리]는.").
    줄(L, "외부 [정수 참조 칸에 정수 i를 정수 v로 원자더하기]는 -> 정수.").
    줄(L, "외부 [정수 참조 칸에서 정수 i로 획득읽기]는 -> 정수.").
    줄(L, "외부 [짧은실수 x를 제곱근]는 -> 짧은실수.").
    줄(L, "외부 [시각]는 -> 정수.").
    줄(L, "외부 [짧은실수 v를 정수 s를 아래에서받기]는 -> 짧은실수.").
    줄(L, "외부 [짧은실수 v를 정수 k를 레인에서받기]는 -> 짧은실수.").
    줄(L, "외부 [정수 v를 정수 s를 정수아래에서받기]는 -> 정수.").
    줄(L, "외부 [정수 v를 정수 k를 정수레인에서받기]는 -> 정수.").
    줄(L, "외부 [워프동기화]는.").
    줄(L, "외부 [짧은실수 x를 짧은실수 y를 짧은실수 z를 곱해더하기]는 -> 짧은실수.").
    줄(L, "외부 [짧은실수 x를 근사지수]는 -> 짧은실수.").
    줄(L, "").
    반환 L.
}

[정수머리줄]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "외부 [정수 j를 중간정수 a0를 중간정수 a1를 중간정수 a2를 중간정수 a3를 중간정수 b0를 중간정수 b1를 중간정수 c0를 중간정수 c1를 중간정수 c2를 중간정수 c3를 정수텐서곱]는 -> 중간정수.").
    줄(L, "외부 [중간정수 a를 중간정수 b를 중간정수 c를 바이트넷곱더하기]는 -> 중간정수.").
    줄(L, "외부 [중간정수 a를 중간정수 b를 중간정수 c를 바이트넷곱더하기_나부호없음]는 -> 중간정수.").
    줄(L, "외부 [짧은실수 x를 실수비트]는 -> 중간정수.").
    줄(L, "외부 [중간정수 i를 비트실수]는 -> 짧은실수.").
    줄(L, "외부 [짧은실수 x를 가까운정수]는 -> 중간정수.").
    줄(L, "외부 [중간정수 a를 중간정수 b를 중간정수 선택자를 바이트고르기]는 -> 중간정수.").
    줄(L, "외부 [공유판33]는 -> 짧은실수 참조.").
    줄(L, "외부 [정수 j를 중간정수 참조 판을 정수 i를 행렬조각읽기]는 -> 중간정수.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 정수 수로 장벽만들기]는.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 장벽도착]는.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 복사도착]는.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 정수 짝으로 장벽기다리기]는.").
    줄(L, "(* 상수나눗셈 *)").
    줄(L, "").
    반환 L.
}

(* 활성값 x [행][깊이] → 자리 [자리][행][깊이] · 정보 [블록][정보폭] *)
[정수로커널]는 -> 문자열목록 참조 {   (* 파이썬의 정수로() *)
    문자열목록 참조 L = 줄목록().
    문자열 몇 = "두".
    자리수 == 4이면 { 몇 = "네". }
    자리수 == 1이면 { 몇 = "한". }                (* 33단계 — 자리 하나(V1) *)
    줄(L, 서식글("(* 정수 블록 계약의 활성값 바꾸기 — 블록마다 지수, {8 * 자리수 - 2} 비트 고정소수점, 균형 256진 {몇} 자리, 마법수 *)")).
    줄(L, "[짧은실수 참조 입력에서 중간정수 참조 자릿값에 중간정수 참조 정보에 정수 행수로 정수 깊이로 정수로]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 r = 블록세로().").
    줄(L, "    정수 블록수 = 깊이 / 32.").
    줄(L, "    정수 깊이4 = 깊이 / 4 * 4.").
    줄(L, "    정수 면 = 깊이 / 4.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, "    정수 b0 = 블록가로() * 32 + (tid / 32) * 4 + lane / 8.").
    줄(L, "    정수 b = b0.").
    줄(L, "    b >= 블록수이면 \{ b = 블록수 - 1. \}").
    줄(L, "    정수 xa = r * 깊이4 + b * 32 + (lane % 8) * 4.").
    줄들(L, 블록바꾸기몸("입력[xa + @]", "정수 자@ = 0. 자@", "b0 < 블록수이면 \{ 정보[b * 정보폭 + r] = @. \}", "    ")).
    줄(L, "    b0 < 블록수이면 \{").
    반복 (정수 j는 0부터 자리수 전까지) {
        줄(L, 서식글("        자릿값[({j} * 행수 + r) * 면 + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자{j}.")).
    }
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* RMSNorm 의 역rms — 블록(256 스레드)이 한 행. 판[판바탕 + tid] 를 쓴다 *)
[문자열 ind를 문자열 입력을 문자열 바탕을 문자열 판바탕을 RMS정규화몸]는 -> 문자열목록 참조 {
    정수 D = 너비.
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{ind}짧은실수 부분 = 0 으로 짧은실수.")).
    줄(L, 서식글("{ind}반복 (정수 c = tid: c < {D}: c += 256) \{")).
    줄(L, 서식글("{ind}    짧은실수 xc = {입력}[{바탕} + c].")).
    줄(L, 서식글("{ind}    부분 += xc * xc.")).
    줄(L, 서식글("{ind}\}")).
    줄(L, 서식글("{ind}판[{판바탕} + tid] = 부분.")).
    줄(L, 서식글("{ind}동기화().")).
    줄(L, 서식글("{ind}반복 (정수 접기 = 128: 접기 > 0: 접기 /= 2) \{")).
    줄(L, 서식글("{ind}    tid < 접기이면 \{ 판[{판바탕} + tid] = 판[{판바탕} + tid] + 판[{판바탕} + tid + 접기]. \}")).
    줄(L, 서식글("{ind}    동기화().")).
    줄(L, 서식글("{ind}\}")).
    줄(L, 서식글("{ind}짧은실수 역rms = 1.0 / 제곱근(판[{판바탕}] / {D}.0 + {RMS_eps}).")).
    반환 L.
}

[RMS정규화정수줄]는 -> 문자열목록 참조 {
    정수 D = 너비.
    정수 KB = 너비 / 32.
    정수 공유 = 공유판크기((D + 256) * 4).
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 14단계 — RMSNorm + 정수 블록 계약의 활성값 바꾸기: 블록 하나가 한 행(256 스레드). 커널생성.py 의 설명 *)").
    줄(L, "[짧은실수 참조 입력에서 짧은실수 참조 감마와 중간정수 참조 자릿값에 중간정수 참조 정보에 정수 행수로 RMS정규화정수줄]는 \{").
    줄(L, "    정수 행 = 블록가로().").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{공유}().")).
    줄(L, 서식글("    정수 바탕 = 행 * {D}.")).
    줄들(L, RMS정규화몸("    ", "입력", "바탕", 서식글("{D}"))).
    줄(L, 서식글("    반복 (정수 c = tid: c < {D}: c += 256) \{ 판[c] = (입력[바탕 + c] * 역rms) * 감마[c]. \}")).
    줄(L, "    동기화().").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    반복 (정수 bb = 0: bb < {KB}: bb += 32) \{")).
    줄(L, "        정수 b0 = bb + tid / 8.").
    줄(L, "        정수 b = b0.").
    줄(L, 서식글("        b >= {KB}이면 \{ b = {KB - 1}. \}")).
    줄들(L, 블록바꾸기몸("판[b * 32 + (lane % 8) * 4 + @]", "정수 자@ = 0. 자@", 서식글("b0 < {KB}이면 \{ 정보[b * 정보폭 + 행] = @. \}"), "        ")).
    줄(L, 서식글("        b0 < {KB}이면 \{")).
    반복 (정수 j는 0부터 자리수 전까지) {
        줄(L, 서식글("            자릿값[({j} * 행수 + 행) * {D / 4} + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자{j}.")).
    }
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

[RMS정규화줄]는 -> 문자열목록 참조 {
    정수 D = 너비.
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 14단계 — RMSNorm(짧은실수 출력): 블록 하나가 한 행(256 스레드) — RMS정규화정수줄과 같은 산술 *)").
    줄(L, "[짧은실수 참조 입력에서 짧은실수 참조 감마와 짧은실수 참조 출력에 RMS정규화줄]는 \{").
    줄(L, "    정수 행 = 블록가로().").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    짧은실수 참조 판 = 공유판4().").
    줄(L, 서식글("    정수 바탕 = 행 * {D}.")).
    줄들(L, RMS정규화몸("    ", "입력", "바탕", "0")).
    줄(L, 서식글("    반복 (정수 c = tid: c < {D}: c += 256) \{ 출력[바탕 + c] = (입력[바탕 + c] * 역rms) * 감마[c]. \}")).
    줄(L, "\}").
    반환 L.
}
