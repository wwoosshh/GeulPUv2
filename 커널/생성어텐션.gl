            문자열 expr2 = 절댓값최대식(xs2).
            줄(L, 서식글("        짧은실수 m = {expr2}.")).
            줄(L, "        m = 큰쪽(m, 레인에서받기(m, lane ^ 1)).").
            줄(L, "        m = 큰쪽(m, 레인에서받기(m, lane ^ 2)).").
            줄들(L, 지수식("        ")).
            반복 (정수 dt10 = 4 * b10: dt10 < 4 * b10 + 4: dt10 += 1) {
                반복 (정수 e8는 0부터 2 전까지) { 줄들(L, 넷자리식(서식글("x{dt10}_{e8}"), "        ", 서식글("{dt10}_{e8}"))). }
            }
            반복 (정수 dt11 = 4 * b10: dt11 < 4 * b10 + 4: dt11 += 1) {
                반복 (정수 j7는 0부터 2 전까지) {
                    문자열 위치식 = 낱말위치(서식글("{2 * (dt11 - 4 * b10)} + t / 2")).
                    줄(L, 서식글("        정수 반{dt11}_{j7} = ((d{dt11}_0{j7} & 255) | ((d{dt11}_1{j7} & 255) << 8)) 으로 정수.")).
                    줄(L, 서식글("        정수 옆{dt11}_{j7} = 정수레인에서받기(반{dt11}_{j7}, lane + 1).")).
                    줄(L, 서식글("        (쓰{h14} == 1 그리고 t % 2 == 0)이면 \{ 자릿값[({j7} * 행수 + 행{h14}) * {너비 / 4} + (머리 * 2 + {b10}) * 8 + {위치식}] = (반{dt11}_{j7} | (옆{dt11}_{j7} << 16)) 으로 중간정수. \}")).
                }
            }
            줄(L, 서식글("        (쓰{h14} == 1 그리고 t == 0)이면 \{ 정보[(머리 * 2 + {b10}) * 정보폭 + 행{h14}] = {마법}. \}")).
            줄(L, "    \}").
        }
    }
    줄(L, "\}").
    반환 L.
}

(* 두층칸의 자리 — 낱말 k_ 는 넷 (k_ / 4) 의 칸 k_ % 4: (k_ // 4) * 4 * T + k_ % 4 *)
[정수 k를 정수 T를 두층자리]는 -> 정수 { 반환 (k / 4) * 4 * T + k % 4. }

(* e′ = e · 2^(E_v − 13) 를 값의 블록 b 마다, 키 32 개 블록 j 마다 자리 둘로 → A 조각 ea{b}_{j}_{자리}_{0..3} (정수어텐션 · 갈래가 함께) *)
[문자열 I를 e자리줄들]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    반복 (정수 b는 0부터 2 전까지) {
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 c는 0부터 4 전까지) {
                정수 e = c & 1.
                반복 (정수 n = 4 * j: n < 4 * j + 4: n += 1) { 줄(L, 서식글("{I}짧은실수 ep{b}_{n}_{c} = e{n}_{c} * pv{n}_{e}_{b}.")). }
            }
            반복 (정수 h는 0부터 2 전까지) {
                문자열목록 참조 xs = 줄목록().
                반복 (정수 n2 = 4 * j: n2 < 4 * j + 4: n2 += 1) {
                    줄(xs, 서식글("ep{b}_{n2}_{2 * h}")).
                    줄(xs, 서식글("ep{b}_{n2}_{2 * h + 1}")).
                }
                문자열 expr = 최대사슬(xs).
                줄(L, 서식글("{I}\{")).
                줄(L, 서식글("{I}    짧은실수 m = {expr}.")).
                줄(L, 서식글("{I}    m = 큰쪽(m, 레인에서받기(m, lane ^ 1)).")).
                줄(L, 서식글("{I}    m = 큰쪽(m, 레인에서받기(m, lane ^ 2)).")).
                줄들(L, 지수식(서식글("{I}    "))).
                줄(L, 서식글("{I}    Pe{b}_{j}_{h} = 비트실수(((E + 114) << 23) 으로 중간정수).")).
                반복 (정수 n3 = 4 * j: n3 < 4 * j + 4: n3 += 1) {
                    반복 (정수 e2는 0부터 2 전까지) {
                        정수 c2 = 2 * h + e2.
                        줄(L, 서식글("{I}    중간정수 me{n3}_{c2} = 실수비트(곱해더하기(ep{b}_{n3}_{c2}, s, 8388736.0)) - 1258291200.")).
                    }
                }
                반복 (정수 half는 0부터 2 전까지) {
                    정수 n0 = 4 * j + 2 * half.
                    정수 n1 = 4 * j + 2 * half + 1.
                    줄(L, 서식글("{I}    중간정수 p01_{half} = 바이트고르기(me{n0}_{2 * h}, me{n0}_{2 * h + 1}, 20800).")).
                    줄(L, 서식글("{I}    중간정수 p23_{half} = 바이트고르기(me{n1}_{2 * h}, me{n1}_{2 * h + 1}, 20800).")).
                    줄(L, 서식글("{I}    ea{b}_{j}_0_{2 * half + h} = 바이트고르기(p01_{half}, p23_{half}, 21520) ^ (-2139062144).")).
                    줄(L, 서식글("{I}    ea{b}_{j}_1_{2 * half + h} = 바이트고르기(p01_{half}, p23_{half}, 30258).")).
                }
                줄(L, 서식글("{I}\}")).
            }
        }
    }
    반환 L.
}

(* 13단계 — 프롬프트 어텐션의 둘째 층(묶음 판 다음): 블록 하나(64 스레드)가 (머리, 행) 하나 *)
[정수묶음접기]는 -> 문자열목록 참조 {
    문자열 이름 = "정수묶음접기".
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 13단계 — 정수 KV 계약의 프롬프트 어텐션 묶음 접기: 블록 하나가 (머리, 행), 묶음 상태를 차례로 접어 출력 자리로. 순서 약속은 커널생성.py 의 설명 *)").
    줄(L, 서식글("(* 실행한도 {이름} 64 16 *)")).
    줄(L, 서식글("[짧은실수 참조 묶음칸에서 중간정수 참조 정보와 중간정수 참조 자릿값에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 머리 = 블록가로().").
    줄(L, "    정수 행 = 블록세로().").
    줄(L, "    정수 묶음끝 = (위치시작 + 행 % 묶음안행수) / 1024.").
    줄(L, "    정수 묶음수 = (최대길이 + 1023) / 1024.").
    줄(L, 서식글("    정수 바탕 = (행 * {머리수} + 머리) * 묶음수 * 68.")).
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 w = tid / 32.").
    줄(L, "    짧은실수 참조 판 = 공유판4().").
    줄(L, "    정수 a = tid * 2.").
    줄(L, "    짧은실수 x0 = -3.0e38.").
    줄(L, "    짧은실수 x1 = -3.0e38.").
    줄(L, "    a <= 묶음끝이면 \{ x0 = 묶음칸[바탕 + a * 68]. \}").
    줄(L, "    a + 1 <= 묶음끝이면 \{ x1 = 묶음칸[바탕 + a * 68 + 68]. \}").
    줄(L, "    짧은실수 sc = 큰쪽(x0, x1).").
    반복 (정수 k = 1: k <= 16: k = k * 2) {
        줄(L, 서식글("    정수 kk{k} = lane - {k}.")).
        줄(L, 서식글("    lane < {k}이면 \{ kk{k} = lane. \}")).
        줄(L, 서식글("    sc = 큰쪽(sc, 레인에서받기(sc, kk{k})).")).
    }
    줄(L, "    짧은실수 앞 = 레인에서받기(sc, kk1).").
    줄(L, "    tid == 31이면 \{ 판[256] = sc. \}").
    줄(L, "    동기화().").
    줄(L, "    w == 1이면 \{").
    줄(L, "        sc = 큰쪽(판[256], sc).").
    줄(L, "        lane == 0이면 \{ 앞 = 판[256]. \}").
    줄(L, "        아니면 \{ 앞 = 큰쪽(판[256], 앞). \}").
    줄(L, "    \}").
    줄(L, "    짧은실수 Pa = x0.").
    줄(L, "    tid > 0이면 \{ Pa = 큰쪽(앞, x0). \}").
    줄(L, "    (a >= 1 그리고 a <= 묶음끝)이면 \{").
    줄들(L, 적힌지수식("판[a]", "앞 - Pa", "        ", "a가")).
    줄들(L, 적힌지수식("판[128 + a]", "x0 - Pa", "        ", "a나")).
    줄(L, "    \}").
    줄(L, "    a + 1 <= 묶음끝이면 \{").
    줄들(L, 적힌지수식("판[a + 1]", "Pa - sc", "        ", "b가")).
    줄들(L, 적힌지수식("판[129 + a]", "x1 - sc", "        ", "b나")).
    줄(L, "    \}").
    줄(L, "    동기화().").
    줄(L, "    짧은실수 Lr = 묶음칸[바탕 + 1].").
    줄(L, "    짧은실수 Or = 묶음칸[바탕 + 4 + tid].").
    줄(L, "    반복 (정수 i0 = 1: i0 <= 묶음끝: i0 += 8) \{").
    반복 (정수 u는 0부터 8 전까지) { 줄(L, 서식글("        정수 ii{u} = i0 + {u}.")). }
    반복 (정수 u2는 1부터 8 전까지) { 줄(L, 서식글("        ii{u2} > 묶음끝이면 \{ ii{u2} = 묶음끝. \}")). }
    반복 (정수 u3는 0부터 8 전까지) { 줄(L, 서식글("        짧은실수 lo{u3} = 묶음칸[바탕 + ii{u3} * 68 + 1].")). }
    반복 (정수 u4는 0부터 8 전까지) { 줄(L, 서식글("        짧은실수 oo{u4} = 묶음칸[바탕 + ii{u4} * 68 + 4 + tid].")). }
    줄(L, "        Lr = 곱해더하기(lo0, 판[128 + ii0], Lr * 판[ii0]).").
    줄(L, "        Or = 곱해더하기(oo0, 판[128 + ii0], Or * 판[ii0]).").
    반복 (정수 u5는 1부터 8 전까지) {
        줄(L, 서식글("        i0 + {u5} <= 묶음끝이면 \{")).
        줄(L, 서식글("            Lr = 곱해더하기(lo{u5}, 판[128 + ii{u5}], Lr * 판[ii{u5}]).")).
        줄(L, 서식글("            Or = 곱해더하기(oo{u5}, 판[128 + ii{u5}], Or * 판[ii{u5}]).")).
        줄(L, "        \}").
    }
    줄(L, "    \}").
    줄(L, "    짧은실수 x = Or / Lr.").
    줄(L, "    짧은실수 m = 큰쪽(x, 0.0 - x).").
    반복 (정수 k2 = 1: k2 <= 16: k2 = k2 * 2) { 줄(L, 서식글("    m = 큰쪽(m, 레인에서받기(m, lane ^ {k2})).")). }
    줄들(L, 지수식("    ")).
    줄들(L, 넷자리식("x", "    ", "q")).
    문자열 위치식 = 낱말위치("lane / 4").
    반복 (정수 j는 0부터 2 전까지) {
        줄(L, 서식글("    정수 반{j} = (dq{j} & 255) 으로 정수.")).
        줄(L, 서식글("    정수 옆{j}_1 = 정수레인에서받기(반{j}, lane + 1).")).
        줄(L, 서식글("    정수 옆{j}_2 = 정수레인에서받기(반{j}, lane + 2).")).
        줄(L, 서식글("    정수 옆{j}_3 = 정수레인에서받기(반{j}, lane + 3).")).
        줄(L, 서식글("    lane % 4 == 0이면 \{ 자릿값[({j} * 행수 + 행) * {너비 / 4} + (머리 * 2 + w) * 8 + {위치식}] = (반{j} | (옆{j}_1 << 8) | (옆{j}_2 << 16) | (옆{j}_3 << 24)) 으로 중간정수. \}")).
    }
    문자열 마법 = 마법수0().
    줄(L, 서식글("    lane == 0이면 \{ 정보[(머리 * 2 + w) * 정보폭 + 행] = {마법}. \}")).
    줄(L, "\}").
    반환 L.
}
