(* GeulPU 19단계 — 커널 생성기의 Qwen2 길(글 언어): 정수 KV 계약의 어텐션 — 프롬프트(차례 · 묶음 · 두층), 갈래(차례 · 묶음), 묶음 접기,
   생성 조각(워프 · 머리들), 접기(정수접기 · 메가두층접기). 커널생성.py 의 같은 이름의 함수(줄의 글자 그대로). *)

(* ---- 정수어텐션 의 함수 안 함수들이 읽는 값 ---- *)
정수 어T = 0.
정수 어ST = 0.

(* 31단계 — 공유 메모리 32 KB 장치(Intel 의 Vulkan 등)의 판: 커널생성 qwen2Q8 <출력.gl> --공유32. 프롬프트 어텐션(차례 · 묶음 · 두층)은
   버퍼 하나(36 KB → 20 KB — 다음 조각을 미리 올리지 않는다, 셈의 차례는 같다), 갈래 판(36 KB)은 내지 않는다(엔진이 차례 · 묶음 판으로) *)
참거짓 공유32 = 거짓.
참거짓 공유32새 = 참.      (* 35단계 — 거짓(커널생성 --35없이)이면 공유32 판이 34단계(34m) 그대로: 협력 어텐션 32 KB · 줄 타일 판의 S 줄임을 끈다 — 같은 때 번갈아 재는 데 *)

(* 정수어텐션의 올리기(조각, 버퍼, ind) *)
[문자열 조각을 문자열 버퍼를 문자열 ind를 어텐션올리기]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}정수 올바탕 = ({버퍼}) * {어ST}.")).
    줄(o, 서식글("{ind}정수 kt = ({조각}) * 64.")).
    반복 (정수 u는 0부터 512 / 어T 전까지) { 줄(o, 서식글("{ind}비동기복사16(판 에, 올바탕 + k저장{u} 를, 키넓 에서, k원본{u} + kt * 16 로).")). }
    반복 (정수 u2는 0부터 512 / 어T 전까지) { 줄(o, 서식글("{ind}비동기복사16(판 에, 올바탕 + v저장{u2} 를, 값넓 에서, v원본{u2} + ({조각}) * 2048 로).")). }
    반환 o.
}

(* 정수어텐션의 지수풀기(조각, 버퍼, ind) — 조각의 지수 바이트를 2^(E−13) 짧은실수로 판에 *)
[문자열 조각을 문자열 버퍼를 문자열 ind를 어텐션지수풀기]는 -> 문자열목록 참조 {
    정수 PK = 4160.
    정수 NP = 256 / 어T.
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}정수 풀바탕 = ({버퍼}) * {어ST} + {PK} + tid * {NP}.")).
    줄(o, 서식글("{ind}정수 지바탕 = 지수바이트 + ({조각}) * 128 + (tid & {128 / NP - 1}) * {NP}.")).
    문자열목록 참조 키 = 줄목록().
    문자열목록 참조 값 = 줄목록().
    반복 (정수 i는 0부터 NP 전까지) {
        줄(키, 서식글("판[풀바탕 + {i}] = 비트실수((키지수[지바탕 + {i}] 으로 중간정수) << 23).")).
        줄(값, 서식글("판[풀바탕 + {i}] = 비트실수((값지수[지바탕 + {i}] 으로 중간정수) << 23).")).
    }
    문자열 키줄 = 글잇기(키, " ").
    문자열 값줄 = 글잇기(값, " ").
    줄(o, 서식글("{ind}tid < {128 / NP}이면 \{ {키줄} \}")).
    줄(o, 서식글("{ind}아니면 \{ {값줄} \}")).
    반환 o.
}

(* 프롬프트 처리의 어텐션 — 정수 KV 계약. 판: "차례" · "묶음" · "두층" *)
[문자열 판을 정수어텐션]는 -> 문자열목록 참조 {
    정수 KS = 0. 정수 VS = 2048. 정수 EK = 4096. 정수 EV = 4128. 정수 PK = 4160. 정수 ST = 4416.
    정수 Q = 64.
    정수 T = Q * 2.
    어T = T.
    어ST = ST.
    문자열 이름 = "정수어텐션".
    문자열 머리말 = "(* 정수 KV 계약의 프롬프트 어텐션 — 블록 하나가 (머리, 질의 64 개), 워프마다 16. 순서 약속은 커널생성.py 의 설명 *)".
    문자열 출력 = "중간정수 참조 정보와 중간정수 참조 자릿값에".
    문자열_같은가(판, "묶음")이면 {
        이름 = "정수어텐션묶음".
        머리말 = "(* 13단계 — 정수 KV 계약의 프롬프트 어텐션 묶음 판: 블록 하나가 (머리, 질의 64, 묶음 하나)의 묶음 상태를 묶음칸에. 순서 약속은 커널생성.py 의 설명 *)".
        출력 = "짧은실수 참조 묶음칸에".
    }
    문자열_같은가(판, "두층")이면 {
        이름 = "정수어텐션두층".
        머리말 = "(* 13단계 — 정수 KV 계약의 프롬프트 어텐션 두 층 차례 판: 묶음 끝마다 행의 누적 상태(두층칸)와 접는다. 순서 약속은 커널생성.py 의 설명 *)".
        출력 = "짧은실수 참조 두층칸과 중간정수 참조 정보와 중간정수 참조 자릿값에".
    }
    참거짓 묶음판 = 문자열_같은가(판, "묶음").
    참거짓 두층판 = 문자열_같은가(판, "두층").
    문자열 kv = 정수KV선언().
    문자열목록 참조 L = 줄목록().
    줄(L, 머리말).
    줄(L, 서식글("(* 실행한도 {이름} {T} {256 / T} *)")).
    줄(L, 서식글("[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 {kv} {출력} 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    묶음판이면 {
        줄(L, 서식글("    정수 질조각수 = (묶음안행수 + {Q - 1}) / {Q}.")).
        줄(L, "    정수 질조각 = 블록가로() % 질조각수.").
        줄(L, "    정수 머리묶음 = 블록가로() / 질조각수.").
        줄(L, 서식글("    정수 머리 = 머리묶음 % {머리수}.")).
        줄(L, 서식글("    정수 묶g = 머리묶음 / {머리수}.")).
        줄(L, "    정수 문장 = 블록세로().").
        줄(L, 서식글("    정수 r0 = 질조각 * {Q}.")).
    }
    아니면 {
        줄(L, "    정수 머리 = 블록가로().").
        줄(L, 서식글("    정수 질조각수 = (묶음안행수 + {Q - 1}) / {Q}.")).
        줄(L, "    정수 문장 = 블록세로() / 질조각수.").
        줄(L, 서식글("    정수 r0 = (질조각수 - 1 - 블록세로() % 질조각수) * {Q}.")).
    }
    문자열 머리식 = KV머리식("문장", "머리").
    줄(L, 서식글("    정수 끝r = r0 + {Q - 1}.")).
    줄(L, "    끝r >= 묶음안행수이면 \{ 끝r = 묶음안행수 - 1. \}").
    줄(L, "    정수 p0 = 위치시작 + r0.").
    줄(L, "    정수 끝조각 = (위치시작 + 끝r) / 64.").
    줄(L, "    정수 행바탕 = 문장 * 묶음안행수.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    정수 머리바탕 = {머리식}.")).
    줄(L, "    정수 키바탕 = 머리바탕 * 2 * 최대길이 * 16.").
    줄(L, "    정수 값바탕 = 머리바탕 * (최대길이 / 32) * 1024.").
    줄(L, "    정수 지수바이트 = 머리바탕 * 최대길이 * 2.").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 g = lane / 4.").
    줄(L, "    정수 t = lane % 4.").
    줄(L, "    정수 w = tid / 32.").
    공유32이면 { 줄(L, "    짧은실수 참조 판 = 공유판20()."). }        (* 31단계 — 버퍼 하나(4416 칸 · 17664 바이트) *)
    아니면 { 줄(L, "    짧은실수 참조 판 = 공유판36()."). }
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    부호없는 작은정수 참조 판b = 판 으로 부호없는 작은정수 참조.").
    줄(L, "    짧은실수 참조 키넓 = 키칸 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 값넓 = 값칸 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 키지넓 = 키지수 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 값지넓 = 값지수 으로 짧은실수 참조.").
    줄(L, "    중간정수 영i = 0.").
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    묶음판이면 {
        줄(L, "    정수 조각시작 = 묶g * 16.").
        줄(L, "    정수 조각끝 = 조각시작 + 15.").
        줄(L, "    조각끝 > 끝조각이면 \{ 조각끝 = 끝조각. \}").
        줄(L, "    조각시작 <= 끝조각이면 \{").
    }
    문자열 시작 = "0".
    문자열 끝 = "끝조각".
    묶음판이면 { 시작 = "조각시작". 끝 = "조각끝". }
    정수 빼기 = 빼기둘 + 3 * 8388608.
    반복 (정수 h는 0부터 2 전까지) {
        줄(L, 서식글("    정수 qr{h} = r0 + w * 16 + g + {8 * h}.")).
        줄(L, 서식글("    qr{h} > 끝r이면 \{ qr{h} = 끝r. \}")).
        줄(L, 서식글("    정수 pq{h} = 위치시작 + qr{h}.")).
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 b는 0부터 2 전까지) {
                줄(L, 서식글("    정수 qo{j}_{b}_{h} = ({j} * 행수 + 행바탕 + qr{h}) * {너비 / 4} + (머리 * 2 + {b}) * 8 + t * 2.")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_0 = 자릿값q[qo{j}_{b}_{h}].")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_1 = 자릿값q[qo{j}_{b}_{h} + 1].")).
            }
        }
        반복 (정수 b2는 0부터 2 전까지) {
            줄(L, 서식글("    짧은실수 pqs{b2}_{h} = 비트실수(정보q[(머리 * 2 + {b2}) * 정보폭 + 행바탕 + qr{h}] - {빼기}).")).
        }
    }
    반복 (정수 u는 0부터 512 / T 전까지) {
        문자열 c = 서식글("(tid + {T * u})").
        줄(L, 서식글("    정수 kj{u} = {c} / 256.")).
        줄(L, 서식글("    정수 kk{u} = ({c} % 256) / 4.")).
        줄(L, 서식글("    정수 kq{u} = {c} % 4.")).
        줄(L, 서식글("    정수 k저장{u} = {KS} + kj{u} * 1024 + kk{u} * 16 + (kq{u} ^ (kk{u} & 2)) * 4.")).
        줄(L, 서식글("    정수 k원본{u} = 키바탕 + kj{u} * 최대길이 * 16 + kk{u} * 16 + kq{u} * 4.")).
        줄(L, 서식글("    정수 v저장{u} = {VS} + ({c} / 256) * 1024 + (({c} % 256) / 128) * 512 + (({c} % 128) / 2) * 8 + ({c} % 2) * 4.")).
        줄(L, 서식글("    정수 v원본{u} = 값바탕 + ({c} / 256) * 1024 + (({c} % 256) / 128) * 512 + (({c} % 128) / 2) * 8 + ({c} % 2) * 4.")).
    }
    줄(L, "    \{").
    줄들(L, 어텐션올리기(시작, "0", "        ")).
    줄(L, "    \}").
    줄(L, "    비동기묶기().").
    줄(L, "    \{").
    줄들(L, 어텐션지수풀기(시작, "0", "        ")).
    줄(L, "    \}").
    반복 (정수 h2는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 M{h2} = 영.")). }
    반복 (정수 h3는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 L{h3} = 영.")). }
    반복 (정수 dt는 0부터 8 전까지) { 반복 (정수 c2는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 O{dt}_{c2} = 영.")). } }
    줄(L, "    정수 버퍼 = 0.").
    줄(L, 서식글("    반복 (정수 조각 = {시작}: 조각 <= {끝}: 조각 += 1) \{")).
    줄(L, "        비동기기다리기(0).").
    줄(L, "        동기화().").
    아닌 공유32이면 {                                    (* 다음 조각을 다른 버퍼에 미리(겹쳐) 올린다 *)
        줄(L, 서식글("        조각 < {끝}이면 \{")).
        줄들(L, 어텐션올리기("조각 + 1", "1 - 버퍼", "            ")).
        줄(L, "        \}").
        줄(L, "        비동기묶기().").
    }
    줄(L, 서식글("        정수 SB = 버퍼 * {ST}.")).
    줄(L, "        정수 tb = 조각 * 64.").
    참거짓 워프가림 = 묶음판.
    워프가림이면 { 줄(L, "        (r0 + w * 16 <= 끝r)이면 \{"). }
    문자열 I = "        ".
    문자열 J = "            ".
    반복 (정수 n는 0부터 8 전까지) {
        줄(L, 서식글("{I}정수 kr{n} = {8 * n} + g.")).
        반복 (정수 b3는 0부터 2 전까지) {
            줄(L, 서식글("{I}정수 kw{n}_{b3} = SB + {KS} + kr{n} * 16 + (({2 * b3} + (t >> 1)) ^ (kr{n} & 2)) * 4 + (t & 1) * 2.")).
            반복 (정수 j2는 0부터 2 전까지) {
                줄(L, 서식글("{I}중간정수 kb{n}_{b3}_{j2}_0 = 판i[kw{n}_{b3} + {j2 * 1024}].")).
                줄(L, 서식글("{I}중간정수 kb{n}_{b3}_{j2}_1 = 판i[kw{n}_{b3} + {j2 * 1024 + 1}].")).
            }
        }
        반복 (정수 e는 0부터 2 전까지) {
            반복 (정수 b4는 0부터 2 전까지) {
                줄(L, 서식글("{I}짧은실수 pk{n}_{e}_{b4} = 판[SB + {PK} + ({8 * n} + t * 2 + {e}) * 2 + {b4}].")).
            }
        }
        반복 (정수 c3는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 s{n}_{c3} = 영.")). }
        반복 (정수 b5는 0부터 2 전까지) {
            문자열 A1 = 서식글("qa1_{b5}_0_0, qa1_{b5}_1_0, qa1_{b5}_0_1, qa1_{b5}_1_1").
            문자열 A0 = 서식글("qa0_{b5}_0_0, qa0_{b5}_1_0, qa0_{b5}_0_1, qa0_{b5}_1_1").
            문자열 B1 = 서식글("kb{n}_{b5}_1_0, kb{n}_{b5}_1_1").
            문자열 B0 = 서식글("kb{n}_{b5}_0_0, kb{n}_{b5}_0_1").
            줄(L, 서식글("{I}\{")).
            반복 (정수 c4는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 hh{c4} = 정수텐서곱({c4}, {A1}, {B1}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c5는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 sm{c5} = 정수텐서곱({c5}, {A1}, {B0}, 영i, 영i, 영i, 영i).")). }
