(* GeulPU 19단계 — 커널 생성기의 Qwen2 길(글 언어): 어텐션의 갈래 판(차례 · 묶음), 생성의 조각 어텐션(워프 · 머리들)과 접기
   (정수접기 · 메가두층접기). 커널생성.py 의 같은 이름의 함수(줄의 글자 그대로). *)

(* 12단계 — 프롬프트 어텐션의 갈래 판: 블록 하나(워프 여덟)가 (머리, 질의 16) — 판 "차례" · "묶음" *)
[문자열 판을 정수어텐션갈래]는 -> 문자열목록 참조 {
    정수 W = 8.
    정수 OB = 0.
    정수 MLB = W * 16 * 64.
    정수 FA = MLB + W * 32.
    정수 FN = FA + 16 * W.
    정수 FM = FN + 16 * W.
    정수 판크기 = 48.
    (FM + 32) * 4 <= 40 * 1024이면 { 판크기 = 40. }
    (FM + 32) * 4 <= 36 * 1024이면 { 판크기 = 36. }
    참거짓 묶음판 = 문자열_같은가(판, "묶음").
    문자열 이름 = "정수어텐션갈래".
    묶음판이면 { 이름 = "정수어텐션갈래묶음". }
    문자열 kv = 정수KV선언().
    문자열목록 참조 L = 줄목록().
    아닌 묶음판이면 {
        줄(L, "(* 정수 KV 계약의 프롬프트 어텐션 — 갈래 판: 블록 하나가 (머리, 질의 16), 워프마다 키 조각 하나씩 여덟을 함께 계산하고 차례대로 접는다. 순서 약속은 커널생성.py 의 설명 *)").
        줄(L, 서식글("(* 실행한도 {이름} {32 * W} 1 *)")).
        줄(L, 서식글("[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 {kv} 중간정수 참조 정보와 중간정수 참조 자릿값에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 {이름}]는 \{")).
        줄(L, "    정수 tid = 블록안가로().").
        줄(L, "    정수 머리 = 블록가로().").
        줄(L, "    정수 질조각수 = (묶음안행수 + 15) / 16.").
        줄(L, "    정수 문장 = 블록세로() / 질조각수.").
        줄(L, "    정수 r0 = (질조각수 - 1 - 블록세로() % 질조각수) * 16.").
    }
    아니면 {
        줄(L, "(* 13단계 — 정수 KV 계약의 프롬프트 어텐션 갈래 묶음 판: 블록 하나가 (머리, 질의 16, 묶음 하나)의 묶음 상태를 묶음칸에. 순서 약속은 커널생성.py 의 설명 *)").
        줄(L, 서식글("(* 실행한도 {이름} {32 * W} 1 *)")).
        줄(L, 서식글("[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 {kv} 짧은실수 참조 묶음칸에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 {이름}]는 \{")).
        줄(L, "    정수 tid = 블록안가로().").
        줄(L, "    정수 질조각수 = (묶음안행수 + 15) / 16.").
        줄(L, "    정수 질조각 = 블록가로() % 질조각수.").
        줄(L, "    정수 머리묶음 = 블록가로() / 질조각수.").
        줄(L, 서식글("    정수 머리 = 머리묶음 % {머리수}.")).
        줄(L, 서식글("    정수 묶g = 머리묶음 / {머리수}.")).
        줄(L, "    정수 문장 = 블록세로().").
        줄(L, "    정수 r0 = 질조각 * 16.").
    }
    문자열 머리식 = KV머리식("문장", "머리").
    줄(L, "    정수 끝r = r0 + 15.").
    줄(L, "    끝r >= 묶음안행수이면 \{ 끝r = 묶음안행수 - 1. \}").
    줄(L, "    정수 p0 = 위치시작 + r0.").
    줄(L, "    정수 끝조각 = (위치시작 + 끝r) / 64.").
    줄(L, "    정수 행바탕 = 문장 * 묶음안행수.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    정수 머리바탕 = {머리식}.")).
    줄(L, "    정수 키둘 = 최대길이 * 16.").
    줄(L, "    정수 키바탕 = 머리바탕 * 2 * 키둘.").
    줄(L, "    정수 값바탕 = 머리바탕 * (최대길이 / 32) * 1024.").
    줄(L, "    정수 지수낱말 = 머리바탕 * (최대길이 / 2).").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 g = lane / 4.").
    줄(L, "    정수 t = lane % 4.").
    줄(L, "    정수 w = tid / 32.").
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{판크기}().")).
    줄(L, "    중간정수 참조 키지i = 키지수 으로 중간정수 참조.").
    줄(L, "    중간정수 참조 값지i = 값지수 으로 중간정수 참조.").
    줄(L, "    중간정수 영i = 0.").
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    줄(L, 서식글("    tid < 16이면 \{ 판[{FM} + tid] = -3.0e38. \}")).
    묶음판이면 {
        줄(L, "    정수 조각시작 = 묶g * 16.").
        줄(L, "    정수 조각끝 = 조각시작 + 15.").
        줄(L, "    조각끝 > 끝조각이면 \{ 조각끝 = 끝조각. \}").
        줄(L, "    조각시작 <= 끝조각이면 \{").
    }
    문자열 시작 = "0".
    문자열 끝 = "끝조각".
    묶음판이면 { 시작 = "조각시작". 끝 = "조각끝". }
    정수 빼기 = 빼기둘 + 3 * 8388608.
    반복 (정수 h는 0부터 2 전까지) {
        줄(L, 서식글("    정수 qr{h} = r0 + g + {8 * h}.")).
        줄(L, 서식글("    qr{h} > 끝r이면 \{ qr{h} = 끝r. \}")).
        줄(L, 서식글("    정수 pq{h} = 위치시작 + qr{h}.")).
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 b는 0부터 2 전까지) {
                줄(L, 서식글("    정수 qo{j}_{b}_{h} = ({j} * 행수 + 행바탕 + qr{h}) * {너비 / 4} + (머리 * 2 + {b}) * 8 + t * 2.")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_0 = 자릿값q[qo{j}_{b}_{h}].")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_1 = 자릿값q[qo{j}_{b}_{h} + 1].")).
            }
        }
        반복 (정수 b2는 0부터 2 전까지) {
            줄(L, 서식글("    짧은실수 pqs{b2}_{h} = 비트실수(정보q[(머리 * 2 + {b2}) * 정보폭 + 행바탕 + qr{h}] - {빼기}).")).
        }
    }
    줄(L, "    정수 rr = tid / 16.").
    줄(L, "    정수 dq = tid % 16.").
    줄(L, "    정수 행r = r0 + rr.").
    줄(L, "    행r > 끝r이면 \{ 행r = 끝r. \}").
    줄(L, "    정수 행끝조각 = (위치시작 + 행r) / 64.").
    줄(L, "    짧은실수 Lr = 영.").
    반복 (정수 i는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 Or{i} = 영.")). }
    줄(L, 서식글("    반복 (정수 조각0 = {시작}: 조각0 <= {끝}: 조각0 += {W}) \{")).
    줄(L, "        정수 조각 = 조각0 + w.").
    줄(L, "        조각 <= 끝조각이면 \{").
    문자열 I = "            ".
    문자열 J = "                ".
    줄(L, 서식글("{I}정수 tb = 조각 * 64.")).
    반복 (정수 n는 0부터 8 전까지) {
        줄(L, 서식글("{I}정수 kw{n} = 키바탕 + (tb + {8 * n} + g) * 16 + t * 2.")).
        반복 (정수 b3는 0부터 2 전까지) {
            반복 (정수 j2는 0부터 2 전까지) {
                문자열 둘 = "".
                j2 != 0이면 { 둘 = " + 키둘". }
                줄(L, 서식글("{I}중간정수 kb{n}_{b3}_{j2}_0 = 키칸[kw{n}{둘} + {8 * b3}].")).
                줄(L, 서식글("{I}중간정수 kb{n}_{b3}_{j2}_1 = 키칸[kw{n}{둘} + {8 * b3 + 1}].")).
            }
        }
    }
    반복 (정수 n2는 0부터 8 전까지) { 줄(L, 서식글("{I}중간정수 kx{n2} = 키지i[지수낱말 + 조각 * 32 + {4 * n2} + t].")). }
    반복 (정수 n3는 0부터 8 전까지) {
        반복 (정수 e는 0부터 2 전까지) {
            반복 (정수 b4는 0부터 2 전까지) {
                줄(L, 서식글("{I}짧은실수 pk{n3}_{e}_{b4} = 비트실수(((kx{n3} >> {8 * (2 * e + b4)}) & 255) << 23).")).
            }
        }
    }
    반복 (정수 n4는 0부터 8 전까지) {
        반복 (정수 c는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 s{n4}_{c} = 영.")). }
        반복 (정수 b5는 0부터 2 전까지) {
            문자열 A1 = 서식글("qa1_{b5}_0_0, qa1_{b5}_1_0, qa1_{b5}_0_1, qa1_{b5}_1_1").
            문자열 A0 = 서식글("qa0_{b5}_0_0, qa0_{b5}_1_0, qa0_{b5}_0_1, qa0_{b5}_1_1").
            문자열 B1 = 서식글("kb{n4}_{b5}_1_0, kb{n4}_{b5}_1_1").
            문자열 B0 = 서식글("kb{n4}_{b5}_0_0, kb{n4}_{b5}_0_1").
            줄(L, 서식글("{I}\{")).
            반복 (정수 c2는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 hh{c2} = 정수텐서곱({c2}, {A1}, {B1}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c3는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 sm{c3} = 정수텐서곱({c3}, {A1}, {B0}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c4는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 smb{c4} = 정수텐서곱({c4}, {A0}, {B1}, sm0, sm1, sm2, sm3).")). }
            반복 (정수 c5는 0부터 4 전까지) { 줄(L, 서식글("{J}중간정수 ll{c5} = 정수텐서곱({c5}, {A0}, {B0}, 영i, 영i, 영i, 영i).")). }
            반복 (정수 c6는 0부터 4 전까지) {
                줄들(L, 정수곱읽기(서식글("짧은실수 u{c6}"), 서식글("hh{c6}"), 서식글("smb{c6}"), 서식글("ll{c6}"), J, 서식글("{c6}"), 참)).
            }
            반복 (정수 c7는 0부터 4 전까지) {
                정수 h2 = c7 >> 1.
                정수 e2 = c7 & 1.
                b5 == 0이면 { 줄(L, 서식글("{J}s{n4}_{c7} = (u{c7} * pqs0_{h2}) * pk{n4}_{e2}_0.")). }
                아니면 { 줄(L, 서식글("{J}s{n4}_{c7} = 곱해더하기(u{c7} * pqs1_{h2}, pk{n4}_{e2}_1, s{n4}_{c7}).")). }
            }
            줄(L, 서식글("{I}\}")).
        }
    }
    반복 (정수 dt는 0부터 8 전까지) {
        줄(L, 서식글("{I}정수 vw{dt} = 값바탕 + 조각 * 2048 + ({8 * dt} + g) * 8 + t * 2.")).
        반복 (정수 j3는 0부터 2 전까지) {
            반복 (정수 자는 0부터 2 전까지) {
                줄(L, 서식글("{I}중간정수 vb{dt}_{j3}_{자}_0 = 값칸[vw{dt} + {(j3 * 2 + 자) * 512}].")).
                줄(L, 서식글("{I}중간정수 vb{dt}_{j3}_{자}_1 = 값칸[vw{dt} + {(j3 * 2 + 자) * 512 + 1}].")).
            }
        }
    }
    반복 (정수 n5는 0부터 8 전까지) { 줄(L, 서식글("{I}중간정수 vx{n5} = 값지i[지수낱말 + 조각 * 32 + {4 * n5} + t].")). }
    줄(L, 서식글("{I}tb + 63 > p0이면 \{")).
    반복 (정수 n6는 0부터 8 전까지) {
        반복 (정수 c8는 0부터 4 전까지) {
            정수 h3 = c8 >> 1.
            정수 e3 = c8 & 1.
            줄(L, 서식글("{I}    tb + {8 * n6} + t * 2 + {e3} > pq{h3}이면 \{ s{n6}_{c8} = -3.0e38. \}")).
        }
    }
    줄(L, 서식글("{I}\}")).
    반복 (정수 h4는 0부터 2 전까지) {
        문자열목록 참조 xs = 줄목록().
        반복 (정수 n7는 0부터 8 전까지) {
            줄(xs, 서식글("s{n7}_{2 * h4}")).
            줄(xs, 서식글("s{n7}_{2 * h4 + 1}")).
        }
        문자열 expr = 최대사슬(xs).
        줄(L, 서식글("{I}짧은실수 mx{h4} = {expr}.")).
        줄(L, 서식글("{I}mx{h4} = 큰쪽(mx{h4}, 레인에서받기(mx{h4}, lane ^ 1)).")).
        줄(L, 서식글("{I}mx{h4} = 큰쪽(mx{h4}, 레인에서받기(mx{h4}, lane ^ 2)).")).
        줄(L, 서식글("{I}정수 ml{h4} = 0.")).
    }
    반복 (정수 n8는 0부터 8 전까지) {
        반복 (정수 c9는 0부터 4 전까지) {
            정수 h5 = c9 >> 1.
            줄들(L, 적힌지수식(서식글("짧은실수 e{n8}_{c9}"), 서식글("s{n8}_{c9} - mx{h5}"), I, 서식글("e{n8}_{c9}"))).
            줄(L, 서식글("{I}ml{h5} = ml{h5} + ((실수비트(곱해더하기(e{n8}_{c9}, 8388608.0, 8388608.0)) - 1258291200) 으로 정수).")).
        }
    }
    반복 (정수 h6는 0부터 2 전까지) {
        줄(L, 서식글("{I}ml{h6} = ml{h6} + 정수레인에서받기(ml{h6}, lane ^ 1).")).
        줄(L, 서식글("{I}ml{h6} = ml{h6} + 정수레인에서받기(ml{h6}, lane ^ 2).")).
        줄(L, 서식글("{I}짧은실수 l{h6} = (ml{h6} 으로 짧은실수) * 0.00000011920928955078125.")).
    }
    반복 (정수 n9는 0부터 8 전까지) {
        반복 (정수 e4는 0부터 2 전까지) {
            반복 (정수 b6는 0부터 2 전까지) {
                줄(L, 서식글("{I}짧은실수 pv{n9}_{e4}_{b6} = 비트실수(((vx{n9} >> {8 * (2 * e4 + b6)}) & 255) << 23).")).
            }
        }
    }
    반복 (정수 b7는 0부터 2 전까지) { 반복 (정수 j4는 0부터 2 전까지) { 반복 (정수 h7는 0부터 2 전까지) { 줄(L, 서식글("{I}짧은실수 Pe{b7}_{j4}_{h7} = 영.")). } } }
    반복 (정수 b8는 0부터 2 전까지) {
        반복 (정수 j5는 0부터 2 전까지) {
            반복 (정수 자2는 0부터 2 전까지) {
                반복 (정수 k는 0부터 4 전까지) { 줄(L, 서식글("{I}중간정수 ea{b8}_{j5}_{자2}_{k} = 0.")). }
            }
        }
    }
    줄들(L, e자리줄들(I)).
    반복 (정수 j6는 0부터 2 전까지) { 반복 (정수 c10는 0부터 4 전까지) { 줄(L, 서식글("{I}짧은실수 uo{j6}_{c10} = 영.")). } }
    반복 (정수 dt2는 0부터 8 전까지) {
        정수 b9 = dt2 / 4.
        반복 (정수 j7는 0부터 2 전까지) {
            줄(L, 서식글("{I}\{")).
