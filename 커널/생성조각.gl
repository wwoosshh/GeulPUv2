(* 정수조각계산워프 의 함수 안 함수들 — 적재(키, 접, ind2) · 점수(접, dst, ind2) *)
[문자열 키를 문자열 접을 문자열 ind2를 조각적재]는 -> 문자열목록 참조 {
    문자열목록 참조 out = 줄목록().
    줄(out, 서식글("{ind2}정수 kw{접} = 키바탕 + ({키}) * 16.")).
    반복 (정수 w는 0부터 16 전까지) { 줄(out, 서식글("{ind2}중간정수 k{접}_0_{w} = 키칸[kw{접} + {w}].")). }
    반복 (정수 w2는 0부터 16 전까지) { 줄(out, 서식글("{ind2}중간정수 k{접}_1_{w2} = 키칸[kw{접} + 최대길이 * 16 + {w2}].")). }
    반복 (정수 b는 0부터 2 전까지) { 줄(out, 서식글("{ind2}짧은실수 pk{접}_{b} = 비트실수((키지수[지수바탕 + ({키}) * 2 + {b}] 으로 중간정수) << 23).")). }
    반환 out.
}

[문자열 접을 문자열 dst를 문자열 ind2를 조각점수]는 -> 문자열목록 참조 {
    문자열목록 참조 out = 줄목록().
    반복 (정수 b는 0부터 2 전까지) {
        반복 (정수 종류는 0부터 3 전까지) {
            문자열 nm = "hh". 정수 ja = 1. 정수 jb = 1.
            종류 == 1이면 { nm = "sm". ja = 1. jb = 0. }
            종류 == 2이면 { nm = "ll". ja = 0. jb = 0. }
            줄(out, 서식글("{ind2}중간정수 {nm}{접}_{b} = 0.")).
            반복 (정수 w = 8 * b: w < 8 * b + 8: w += 1) {
                줄(out, 서식글("{ind2}{nm}{접}_{b} = 바이트넷곱더하기(qw{ja}_{w}, k{접}_{jb}_{w}, {nm}{접}_{b}).")).
            }
        }
        반복 (정수 w2 = 8 * b: w2 < 8 * b + 8: w2 += 1) {
            줄(out, 서식글("{ind2}sm{접}_{b} = 바이트넷곱더하기(qw0_{w2}, k{접}_1_{w2}, sm{접}_{b}).")).
        }
        줄들(out, 정수곱읽기(서식글("짧은실수 u{접}_{b}"), 서식글("hh{접}_{b}"), 서식글("sm{접}_{b}"), 서식글("ll{접}_{b}"), ind2, 서식글("{접}_{b}"), 거짓)).
    }
    줄(out, 서식글("{ind2}{dst} = ((u{접}_0 * pq0) * pk{접}_0).")).
    줄(out, 서식글("{ind2}{dst} = 곱해더하기(u{접}_1 * pq1, pk{접}_1, {dst}) * 0.125.")).
    반환 out.
}

(* 정수 KV 계약의 생성 어텐션 — 워프 하나가 키 조각(위치 64 개) 하나 *)
[문자열 ind를 정수 QB를 정수 WB를 문자열 위치를 문자열 조각을 문자열 o식을 문자열 ml식을 문자열 조각칸을 정수조각계산워프]는 -> 문자열목록 참조 {
    문자열 ind4 = 서식글("{ind}    ").
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}정수 t0 = {조각} * 64.")).
    줄(o, 서식글("{ind}정수 ta = t0 + 2 * rl.")).
    줄(o, 서식글("{ind}정수 wb = {WB} + rw * 72.")).
