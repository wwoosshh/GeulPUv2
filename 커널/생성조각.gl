    줄(o, 서식글("{ind}짧은실수 sb = -3.0e38.")).
    반복 (정수 j는 0부터 2 전까지) { 반복 (정수 w는 0부터 16 전까지) { 줄(o, 서식글("{ind}중간정수 qw{j}_{w} = 판i[{QB} + {j * 16 + w}].")). } }
    반복 (정수 b는 0부터 2 전까지) { 줄(o, 서식글("{ind}짧은실수 pq{b} = 판[{QB} + 32 + {b}].")). }
    줄들(o, 조각적재("ta", "a", ind)).
    줄들(o, 조각적재("ta + 1", "c", ind)).
    줄(o, 서식글("{ind}ta <= {위치}이면 \{")).
    줄들(o, 조각점수("a", "sa", ind4)).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}ta + 1 <= {위치}이면 \{")).
    줄들(o, 조각점수("c", "sb", ind4)).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}짧은실수 mx = 큰쪽(sa, sb).")).
    반복 (정수 sft = 16: sft >= 1: sft = sft / 2) { 줄(o, 서식글("{ind}mx = 큰쪽(mx, 아래에서받기(mx, {sft})).")). }
    줄(o, 서식글("{ind}짧은실수 m = 레인에서받기(mx, 0).")).
    줄들(o, 적힌지수식("짧은실수 ea", "sa - m", ind, "ea")).
    줄들(o, 적힌지수식("짧은실수 ec", "sb - m", ind, "ec")).
    줄(o, 서식글("{ind}정수 ml = ((실수비트(곱해더하기(ea, 8388608.0, 8388608.0)) - 1258291200) 으로 정수) + ((실수비트(곱해더하기(ec, 8388608.0, 8388608.0)) - 1258291200) 으로 정수).")).
    반복 (정수 sft2 = 16: sft2 >= 1: sft2 = sft2 / 2) { 줄(o, 서식글("{ind}ml = ml + 정수아래에서받기(ml, {sft2}).")). }
    줄(o, 서식글("{ind}짧은실수 l = (ml 으로 짧은실수) * 0.00000011920928955078125.")).
    줄(o, 서식글("{ind}정수 rq = rl % 16.")).
    줄(o, 서식글("{ind}정수 jj = rl / 16.")).
    줄(o, 서식글("{ind}정수 e낱말 = ((rq % 8) % 4) * 2 + rq / 8.")).
    줄(o, 서식글("{ind}정수 e반 = (rq % 8) / 4.")).
    반복 (정수 b2는 0부터 2 전까지) {
        줄(o, 서식글("{ind}\{")).
        줄(o, 서식글("{ind}    짧은실수 pva = 비트실수((값지수[지수바탕 + ta * 2 + {b2}] 으로 중간정수) << 23).")).
        줄(o, 서식글("{ind}    짧은실수 pvc = 비트실수((값지수[지수바탕 + (ta + 1) * 2 + {b2}] 으로 중간정수) << 23).")).
        줄(o, 서식글("{ind}    짧은실수 epa = ea * pva.")).
        줄(o, 서식글("{ind}    짧은실수 epc = ec * pvc.")).
        줄(o, 서식글("{ind}    짧은실수 m = 큰쪽(epa, epc).")).
        반복 (정수 sft3 = 1: sft3 <= 8: sft3 = sft3 * 2) { 줄(o, 서식글("{ind}    m = 큰쪽(m, 레인에서받기(m, rl ^ {sft3})).")). }
        줄들(o, 지수식(ind4)).
        줄(o, 서식글("{ind}    중간정수 ma = 실수비트(곱해더하기(epa, s, 8388736.0)) - 1258291200.")).
        줄(o, 서식글("{ind}    중간정수 mc = 실수비트(곱해더하기(epc, s, 8388736.0)) - 1258291200.")).
        줄(o, 서식글("{ind}    판s[(wb + {32 * b2} + jj * 16 + e낱말) * 2 + e반] = (바이트고르기(ma, mc, 64) ^ 32896) 으로 짧은정수.")).
        줄(o, 서식글("{ind}    판s[(wb + {32 * b2} + jj * 16 + 8 + e낱말) * 2 + e반] = 바이트고르기(ma, mc, 81) 으로 짧은정수.")).
        줄(o, 서식글("{ind}    rq == 0이면 \{ 판[wb + 64 + {2 * b2} + jj] = 비트실수(((E + 114) << 23) 으로 중간정수). \}")).
        줄(o, 서식글("{ind}\}")).
    }
    줄(o, 서식글("{ind}워프동기화().")).
    줄(o, 서식글("{ind}정수 bq = rl / 16.")).
    줄(o, 서식글("{ind}정수 eb = wb + bq * 32.")).
    줄(o, 서식글("{ind}정수 vb = 값바탕 + ({조각} * 2) * 1024 + rl * 16.")).
    반복 (정수 j2는 0부터 2 전까지) {
        반복 (정수 자는 0부터 2 전까지) {
            반복 (정수 w3는 0부터 8 전까지) { 줄(o, 서식글("{ind}중간정수 ew{j2}_{자}_{w3} = 판i[eb + {j2 * 16 + 자 * 8 + w3}].")). }
        }
    }
    반복 (정수 j3는 0부터 2 전까지) { 줄(o, 서식글("{ind}짧은실수 Pe{j3} = 판[wb + 64 + bq * 2 + {j3}].")). }
    반복 (정수 dd는 0부터 2 전까지) {
        반복 (정수 j4는 0부터 2 전까지) {
            반복 (정수 자2는 0부터 2 전까지) {
                반복 (정수 w4는 0부터 8 전까지) { 줄(o, 서식글("{ind}중간정수 v{dd}_{j4}_{자2}_{w4} = 값칸[vb + {(j4 * 2 + 자2) * 512 + dd * 8 + w4}].")). }
            }
        }
    }
    반복 (정수 dd2는 0부터 2 전까지) {
        줄(o, 서식글("{ind}\{")).
        반복 (정수 j5는 0부터 2 전까지) {
            반복 (정수 종류는 0부터 3 전까지) {
                문자열 nm = "hh". 정수 ja = 1. 정수 jb = 1.
                종류 == 1이면 { nm = "sm". ja = 1. jb = 0. }
                종류 == 2이면 { nm = "ll". ja = 0. jb = 0. }
                줄(o, 서식글("{ind}    중간정수 {nm}{j5} = 0.")).
                반복 (정수 w5는 0부터 8 전까지) { 줄(o, 서식글("{ind}    {nm}{j5} = 바이트넷곱더하기(ew{j5}_{ja}_{w5}, v{dd2}_{j5}_{jb}_{w5}, {nm}{j5}).")). }
            }
            반복 (정수 w6는 0부터 8 전까지) { 줄(o, 서식글("{ind}    sm{j5} = 바이트넷곱더하기(ew{j5}_0_{w6}, v{dd2}_{j5}_1_{w6}, sm{j5}).")). }
            줄들(o, 정수곱읽기(서식글("짧은실수 uo{j5}"), 서식글("hh{j5}"), 서식글("sm{j5}"), 서식글("ll{j5}"), ind4, 서식글("{j5}"), 거짓)).
        }
        줄(o, 서식글("{ind}    정수 o자리 = {o식}.")).
        줄(o, 서식글("{ind}    {조각칸}[o자리 + 2 * rl + {dd2}] = 곱해더하기(uo1, Pe1, uo0 * Pe0).")).
        줄(o, 서식글("{ind}\}")).
    }
    줄(o, 서식글("{ind}rl == 0이면 \{")).
    줄(o, 서식글("{ind}    정수 ml자리 = {ml식}.")).
    줄(o, 서식글("{ind}    {조각칸}[ml자리] = m.")).
    줄(o, 서식글("{ind}    {조각칸}[ml자리 + 1] = l.")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}워프동기화().")).
    반환 o.
}

(* 생성(문장마다 행 하나)의 어텐션 (가) — 블록 하나가 (행, 머리)의 키 조각 여덟 *)
[정수조각어텐션]는 -> 문자열목록 참조 {
    문자열 kv = 정수KV선언().
    문자열 머리식 = KV머리식("(행 / 묶음안행수)", "머리").
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 정수 KV 계약의 생성 어텐션 (가) — 블록 하나가 (행, 머리)의 키 조각 여덟(워프마다 하나). 순서 약속은 커널생성.py 의 설명 *)").
    줄(L, "(* 실행한도 정수조각어텐션 256 2 *)").
    줄(L, 서식글("[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 {kv} 짧은실수 참조 조각칸에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 정수조각어텐션]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 rl = tid % 32.").
    줄(L, "    정수 rw = tid / 32.").
    줄(L, 서식글("    정수 행 = 블록세로() / {머리수}.")).
    줄(L, 서식글("    정수 머리 = 블록세로() % {머리수}.")).
    줄(L, "    정수 조각 = 블록가로() * 8 + rw.").
    줄(L, "    정수 위치 = 위치시작 + 행 % 묶음안행수.").
    줄(L, 서식글("    정수 머리바탕 = {머리식}.")).
    줄(L, "    정수 키바탕 = 머리바탕 * 2 * 최대길이 * 16.").
    줄(L, "    정수 값바탕 = 머리바탕 * (최대길이 / 32) * 1024.").
    줄(L, "    정수 지수바탕 = 머리바탕 * 최대길이 * 2.").
    줄(L, "    정수 조각칸폭 = 최대길이 / 64.").
    줄(L, 서식글("    정수 쌍바탕 = (행 * {머리수} + 머리) * 조각칸폭 * 68.")).
    줄(L, "    정수 ml바탕 = 쌍바탕 + 조각칸폭 * 64.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, "    짧은실수 참조 판 = 공유판8().").
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    짧은정수 참조 판s = 판 으로 짧은정수 참조.").
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    줄(L, 서식글("    tid < 32이면 \{ 판i[tid] = 자릿값q[((tid / 16) * 행수 + 행) * {너비 / 4} + (머리 * 2 + (tid % 16) / 8) * 8 + tid % 8]. \}")).
    줄(L, 서식글("    tid < 2이면 \{ 판[32 + tid] = 비트실수(정보q[(머리 * 2 + tid) * 정보폭 + 행] - {빼기둘}). \}")).
    줄(L, "    동기화().").
    줄(L, "    조각 <= 위치 / 64이면 \{").
    줄들(L, 정수조각계산워프("        ", 0, 40, "위치", "조각", "쌍바탕 + 조각 * 64", "ml바탕 + 조각 * 2", "조각칸")).
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 13단계 계약 — 두 층 접기(정수접기). 기다림 없이(조각 접기 판), GSB 없음(FB + 1344) *)
[문자열 ind를 문자열 조각칸을 문자열 바탕을 문자열 조각끝을 문자열 목적을 정수 FB를 문자열 ml바탕을 정수 GSB를 정수접기]는 -> 문자열목록 참조 {
    정수 FM = FB. 정수 FLV = FB + 256. 정수 FP = FB + 512. 정수 FA = FB + 768. 정수 FN = FB + 1024.
    정수 GA = FB + 1280. 정수 GN = FB + 1296. 정수 GX = FB + 1312. 정수 CM = FB + 1328.
    정수 GS = FB + 1344.
    GSB >= 0이면 { GS = GSB. }
    문자열 I8 = 서식글("{ind}        ").
    문자열 I12 = 서식글("{ind}            ").
    문자열목록 참조 out = 줄목록().
    줄(out, 서식글("{ind}정수 조각수끝 = {조각끝} + 1.")).
    줄(out, 서식글("{ind}짧은실수 L = 0 으로 짧은실수.")).
    줄(out, 서식글("{ind}짧은실수 O = 0 으로 짧은실수.")).
    줄(out, 서식글("{ind}정수 레인 = tid % 32.")).
    줄(out, 서식글("{ind}반복 (정수 c0 = 0: c0 < 조각수끝: c0 += 256) \{")).
    줄(out, 서식글("{ind}    정수 c끝 = 조각수끝 - c0.")).
    줄(out, 서식글("{ind}    c끝 > 256이면 \{ c끝 = 256. \}")).
    줄(out, 서식글("{ind}    정수 접묶음수 = (c끝 + 15) / 16.")).
    줄(out, 서식글("{ind}    동기화().")).
    줄(out, 서식글("{ind}    tid < c끝이면 \{")).
    줄(out, 서식글("{ind}        판[{FM} + tid] = {조각칸}[{ml바탕} + (c0 + tid) * 2].")).
    줄(out, 서식글("{ind}        판[{FLV} + tid] = {조각칸}[{ml바탕} + (c0 + tid) * 2 + 1].")).
    줄(out, 서식글("{ind}    \}")).
    줄(out, 서식글("{ind}    동기화().")).
    줄(out, 서식글("{ind}    \{")).
    줄(out, 서식글("{ind}        짧은실수 pv = -3.0e38.")).
    줄(out, 서식글("{ind}        tid < c끝이면 \{ pv = 판[{FM} + tid]. \}")).
    반복 (정수 sft = 1: sft <= 8: sft = sft * 2) {
        줄(out, 서식글("{ind}        정수 kk{sft} = 레인 - {sft}.")).
        줄(out, 서식글("{ind}        (레인 % 16) < {sft}이면 \{ kk{sft} = 레인. \}")).
        줄(out, 서식글("{ind}        pv = 큰쪽(pv, 레인에서받기(pv, kk{sft})).")).
    }
    줄(out, 서식글("{ind}        tid < c끝이면 \{ 판[{FP} + tid] = pv. \}")).
    줄(out, 서식글("{ind}    \}")).
    줄(out, 서식글("{ind}    동기화().")).
    줄(out, 서식글("{ind}    (tid < c끝 그리고 tid % 16 > 0)이면 \{")).
    줄들(out, 적힌지수식(서식글("판[{FA} + tid]"), 서식글("판[{FP} + tid - 1] - 판[{FP} + tid]"), I8, "가")).
    줄들(out, 적힌지수식(서식글("판[{FN} + tid]"), 서식글("판[{FM} + tid] - 판[{FP} + tid]"), I8, "나")).
    줄(out, 서식글("{ind}    \}")).
    줄(out, 서식글("{ind}    동기화().")).
    줄(out, 서식글("{ind}    tid < 접묶음수이면 \{")).
    줄(out, 서식글("{ind}        정수 접a = tid * 16.")).
    줄(out, 서식글("{ind}        정수 접b = 접a + 16.")).
    줄(out, 서식글("{ind}        접b > c끝이면 \{ 접b = c끝. \}")).
    줄(out, 서식글("{ind}        짧은실수 접L = 판[{FLV} + 접a].")).
    줄(out, 서식글("{ind}        반복 (정수 접c = 접a + 1: 접c < 접b: 접c += 1) \{ 접L = 곱해더하기(판[{FLV} + 접c], 판[{FN} + 접c], 접L * 판[{FA} + 접c]). \}")).
    줄(out, 서식글("{ind}        판[{GS} + tid * 68] = 판[{FP} + 접b - 1].")).
    줄(out, 서식글("{ind}        판[{GS} + tid * 68 + 1] = 접L.")).
    줄(out, 서식글("{ind}    \}")).
    줄(out, 서식글("{ind}    \{")).
    줄(out, 서식글("{ind}        정수 접d = tid % 64.")).
    반복 (정수 k는 0부터 4 전까지) {
        줄(out, 서식글("{ind}        \{")).
        줄(out, 서식글("{ind}            정수 접g = tid / 64 + {4 * k}.")).
        줄(out, 서식글("{ind}            접g < 접묶음수이면 \{")).
        줄(out, 서식글("{ind}                정수 접a = 접g * 16.")).
        줄(out, 서식글("{ind}                정수 접n = c끝 - 접a.")).
        줄(out, 서식글("{ind}                접n > 16이면 \{ 접n = 16. \}")).
        반복 (정수 i는 0부터 16 전까지) { 줄(out, 서식글("{ind}                정수 접i{i} = 접a + {i}.")). }
        반복 (정수 i2는 1부터 16 전까지) { 줄(out, 서식글("{ind}                접i{i2} >= 접a + 접n이면 \{ 접i{i2} = 접a + 접n - 1. \}")). }
        반복 (정수 i3는 0부터 16 전까지) { 줄(out, 서식글("{ind}                짧은실수 접o{i3} = {조각칸}[{바탕} + (c0 + 접i{i3}) * 64 + 접d].")). }
        줄(out, 서식글("{ind}                짧은실수 접O = 접o0.")).
        반복 (정수 i4는 1부터 16 전까지) { 줄(out, 서식글("{ind}                접n > {i4}이면 \{ 접O = 곱해더하기(접o{i4}, 판[{FN} + 접a + {i4}], 접O * 판[{FA} + 접a + {i4}]). \}")). }
        줄(out, 서식글("{ind}                판[{GS} + 접g * 68 + 4 + 접d] = 접O.")).
        줄(out, 서식글("{ind}            \}")).
        줄(out, 서식글("{ind}        \}")).
    }
    줄(out, 서식글("{ind}    \}")).
    줄(out, 서식글("{ind}    동기화().")).
    줄(out, 서식글("{ind}    tid < 접묶음수이면 \{")).
    줄(out, 서식글("{ind}        짧은실수 접앞 = 판[{CM}].")).
    줄(out, 서식글("{ind}        반복 (정수 접h = 0: 접h < tid: 접h += 1) \{")).
    줄(out, 서식글("{ind}            (c0 > 0 또는 접h > 0)이면 \{ 접앞 = 큰쪽(접앞, 판[{GS} + 접h * 68]). \}")).
    줄(out, 서식글("{ind}            아니면 \{ 접앞 = 판[{GS} + 접h * 68]. \}")).
    줄(out, 서식글("{ind}        \}")).
    줄(out, 서식글("{ind}        짧은실수 접새 = 판[{GS} + tid * 68].")).
    줄(out, 서식글("{ind}        (c0 > 0 또는 tid > 0)이면 \{")).
    줄(out, 서식글("{ind}            접새 = 큰쪽(접앞, 판[{GS} + tid * 68]).")).
    줄들(out, 적힌지수식(서식글("판[{GA} + tid]"), "접앞 - 접새", I12, "ga")).
    줄들(out, 적힌지수식(서식글("판[{GN} + tid]"), 서식글("판[{GS} + tid * 68] - 접새"), I12, "gn")).
    줄(out, 서식글("{ind}        \}")).
    줄(out, 서식글("{ind}        판[{GX} + tid] = 접새.")).
    줄(out, 서식글("{ind}    \}")).
    줄(out, 서식글("{ind}    동기화().")).
    줄(out, 서식글("{ind}    tid < 64이면 \{")).
    줄(out, 서식글("{ind}        반복 (정수 접g = 0: 접g < 접묶음수: 접g += 1) \{")).
    줄(out, 서식글("{ind}            (c0 == 0 그리고 접g == 0)이면 \{ L = 판[{GS} + 1]. O = 판[{GS} + 4 + tid]. \}")).
    줄(out, 서식글("{ind}            아니면 \{")).
    줄(out, 서식글("{ind}                L = 곱해더하기(판[{GS} + 접g * 68 + 1], 판[{GN} + 접g], L * 판[{GA} + 접g]).")).
    줄(out, 서식글("{ind}                O = 곱해더하기(판[{GS} + 접g * 68 + 4 + tid], 판[{GN} + 접g], O * 판[{GA} + 접g]).")).
    줄(out, 서식글("{ind}            \}")).
    줄(out, 서식글("{ind}        \}")).
    줄(out, 서식글("{ind}    \}")).
    줄(out, 서식글("{ind}    동기화().")).
    줄(out, 서식글("{ind}    tid == 0이면 \{ 판[{CM}] = 판[{GX} + 접묶음수 - 1]. \}")).
    줄(out, 서식글("{ind}\}")).
    줄(out, 서식글("{ind}tid < 64이면 \{ {목적} = O / L. \}")).
    반환 out.
}

(* 생성의 어텐션 (나) — 블록 하나(256 스레드)가 (행, 머리) 하나, 조각들을 위치 순서대로 접는다 *)
[정수조각접기]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 정수 KV 계약의 생성 어텐션 (나) — 조각들을 위치 순서대로 접는다(적힌지수). 순서 약속은 커널생성.py 의 설명 *)").
    줄(L, "[짧은실수 참조 조각칸에서 짧은실수 참조 출력에 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 정수조각접기]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 쌍 = 블록가로().").
    줄(L, 서식글("    정수 행 = 쌍 / {머리수}.")).
    줄(L, 서식글("    정수 머리 = 쌍 % {머리수}.")).
    줄(L, "    정수 조각끝 = (위치시작 + 행 % 묶음안행수) / 64.").
    줄(L, "    정수 조각칸폭 = 최대길이 / 64.").
    줄(L, "    정수 바탕 = 쌍 * 조각칸폭 * 68.").
    줄(L, "    정수 ml바탕 = 바탕 + 조각칸폭 * 64.").
    줄(L, "    짧은실수 참조 판 = 공유판12().").
    줄들(L, 정수접기("    ", "조각칸", "바탕", "조각끝", 서식글("출력[행 * {너비} + 머리 * 64 + tid]"), 0, "ml바탕", -1)).
    줄(L, "\}").
    반환 L.
}

(* 15단계 — 정수조각계산워프와 같은 계산을, 워프 하나가 같은 KV 머리를 읽는 질의 머리 H 개에(고리 다섯) *)
[문자열 ind를 정수 QA를 정수 WB를 문자열 위치를 문자열 조각을 문자열 머리0을 문자열 H를 문자열 조각칸을 문자열 출력을 문자열 하나를 정수조각계산머리들]는 -> 문자열목록 참조 {
    정수 무리 = 머리수 / KV머리수.
    문자열 I2 = 서식글("{ind}    ").
    문자열 I6 = 서식글("{ind}        ").
    문자열 I10 = 서식글("{ind}            ").
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}정수 t0 = {조각} * 64.")).
    줄(o, 서식글("{ind}정수 ta = t0 + 2 * rl.")).
    줄(o, 서식글("{ind}정수 wb0 = {WB} + rw * {72 * 무리}.")).
    반복 (정수 단계는 0부터 2 전까지) {
        문자열 키 = "ta". 문자열 접 = "a". 정수 칸 = 0.
        단계 == 1이면 { 키 = "ta + 1". 접 = "c". 칸 = 1. }
        줄(o, 서식글("{ind}\{")).
        줄들(o, 조각적재(키, 접, I2)).
        줄(o, 서식글("{I2}반복 (정수 hi = 0: hi < {H}: hi += 1) \{")).
        줄(o, 서식글("{I2}    정수 qa = {QA} + ({머리0} + hi) * 34.")).
        줄(o, 서식글("{I2}    짧은실수 sx = -3.0e38.")).
        반복 (정수 j는 0부터 2 전까지) { 반복 (정수 w는 0부터 16 전까지) { 줄(o, 서식글("{I2}    중간정수 qw{j}_{w} = 판i[qa + {j * 16 + w}].")). } }
        반복 (정수 b는 0부터 2 전까지) { 줄(o, 서식글("{I2}    짧은실수 pq{b} = 판[qa + 32 + {b}].")). }
        줄(o, 서식글("{I2}    {키} <= {위치}이면 \{")).
        줄들(o, 조각점수(접, "sx", I10)).
        줄(o, 서식글("{I2}    \}")).
        줄(o, 서식글("{I2}    판[wb0 + hi * 72 + 2 * rl + {칸}] = sx.")).
        줄(o, 서식글("{I2}\}")).
        줄(o, 서식글("{ind}\}")).
    }
    줄(o, 서식글("{ind}워프동기화().")).
    줄(o, 서식글("{ind}정수 rq = rl % 16.")).
    줄(o, 서식글("{ind}정수 jj = rl / 16.")).
    줄(o, 서식글("{ind}정수 e낱말 = ((rq % 8) % 4) * 2 + rq / 8.")).
    줄(o, 서식글("{ind}정수 e반 = (rq % 8) / 4.")).
    줄(o, 서식글("{ind}반복 (정수 hi = 0: hi < {H}: hi += 1) \{")).
    줄(o, 서식글("{I2}정수 머리 = {머리0} + hi.")).
    줄(o, 서식글("{I2}정수 wb = wb0 + hi * 72.")).
    줄(o, 서식글("{I2}짧은실수 sa = 판[wb + 2 * rl].")).
    줄(o, 서식글("{I2}짧은실수 sb = 판[wb + 2 * rl + 1].")).
    줄(o, 서식글("{I2}워프동기화().")).
    줄(o, 서식글("{I2}짧은실수 mx = 큰쪽(sa, sb).")).
    반복 (정수 sft = 16: sft >= 1: sft = sft / 2) { 줄(o, 서식글("{I2}mx = 큰쪽(mx, 아래에서받기(mx, {sft})).")). }
    줄(o, 서식글("{I2}짧은실수 m = 레인에서받기(mx, 0).")).
    줄들(o, 적힌지수식("짧은실수 ea", "sa - m", I2, "ea")).
    줄들(o, 적힌지수식("짧은실수 ec", "sb - m", I2, "ec")).
    줄(o, 서식글("{I2}정수 ml = ((실수비트(곱해더하기(ea, 8388608.0, 8388608.0)) - 1258291200) 으로 정수) + ((실수비트(곱해더하기(ec, 8388608.0, 8388608.0)) - 1258291200) 으로 정수).")).
    반복 (정수 sft2 = 16: sft2 >= 1: sft2 = sft2 / 2) { 줄(o, 서식글("{I2}ml = ml + 정수아래에서받기(ml, {sft2}).")). }
    줄(o, 서식글("{I2}짧은실수 l = (ml 으로 짧은실수) * 0.00000011920928955078125.")).
    반복 (정수 b2는 0부터 2 전까지) {
        줄(o, 서식글("{I2}\{")).
        줄(o, 서식글("{I2}    짧은실수 pva = 비트실수((값지수[지수바탕 + ta * 2 + {b2}] 으로 중간정수) << 23).")).
        줄(o, 서식글("{I2}    짧은실수 pvc = 비트실수((값지수[지수바탕 + (ta + 1) * 2 + {b2}] 으로 중간정수) << 23).")).
        줄(o, 서식글("{I2}    짧은실수 epa = ea * pva.")).
        줄(o, 서식글("{I2}    짧은실수 epc = ec * pvc.")).
        줄(o, 서식글("{I2}    짧은실수 m = 큰쪽(epa, epc).")).
        반복 (정수 sft3 = 1: sft3 <= 8: sft3 = sft3 * 2) { 줄(o, 서식글("{I2}    m = 큰쪽(m, 레인에서받기(m, rl ^ {sft3})).")). }
        줄들(o, 지수식(서식글("{I2}    "))).
        줄(o, 서식글("{I2}    중간정수 ma = 실수비트(곱해더하기(epa, s, 8388736.0)) - 1258291200.")).
        줄(o, 서식글("{I2}    중간정수 mc = 실수비트(곱해더하기(epc, s, 8388736.0)) - 1258291200.")).
        줄(o, 서식글("{I2}    판s[(wb + {32 * b2} + jj * 16 + e낱말) * 2 + e반] = (바이트고르기(ma, mc, 64) ^ 32896) 으로 짧은정수.")).
        줄(o, 서식글("{I2}    판s[(wb + {32 * b2} + jj * 16 + 8 + e낱말) * 2 + e반] = 바이트고르기(ma, mc, 81) 으로 짧은정수.")).
        줄(o, 서식글("{I2}    rq == 0이면 \{ 판[wb + 64 + {2 * b2} + jj] = 비트실수(((E + 114) << 23) 으로 중간정수). \}")).
        줄(o, 서식글("{I2}\}")).
    }
    줄(o, 서식글("{I2}rl == 0이면 \{")).
    줄(o, 서식글("{I2}    판[wb + 68] = m.")).
    줄(o, 서식글("{I2}    판[wb + 69] = l.")).
    줄(o, 서식글("{I2}    ({하나}) == 0이면 \{")).
    줄(o, 서식글("{I2}        정수 ml자리 = 머리 * 조각칸폭 * 68 + 조각칸폭 * 64 + ({조각}) * 2.")).
    줄(o, 서식글("{I2}        {조각칸}[ml자리] = m.")).
    줄(o, 서식글("{I2}        {조각칸}[ml자리 + 1] = l.")).
    줄(o, 서식글("{I2}    \}")).
    줄(o, 서식글("{I2}\}")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}워프동기화().")).
    줄(o, 서식글("{ind}정수 bq = rl / 16.")).
    줄(o, 서식글("{ind}정수 vb = 값바탕 + ({조각} * 2) * 1024 + rl * 16.")).
    반복 (정수 dd는 0부터 2 전까지) {
        줄(o, 서식글("{ind}\{")).
        반복 (정수 j2는 0부터 2 전까지) {
            반복 (정수 자는 0부터 2 전까지) {
                반복 (정수 w2는 0부터 8 전까지) { 줄(o, 서식글("{I2}중간정수 v{dd}_{j2}_{자}_{w2} = 값칸[vb + {(j2 * 2 + 자) * 512 + dd * 8 + w2}].")). }
            }
        }
        줄(o, 서식글("{I2}반복 (정수 hi = 0: hi < {H}: hi += 1) \{")).
        줄(o, 서식글("{I2}    정수 머리 = {머리0} + hi.")).
        줄(o, 서식글("{I2}    정수 wb = wb0 + hi * 72.")).
        줄(o, 서식글("{I2}    정수 eb = wb + bq * 32.")).
        반복 (정수 j3는 0부터 2 전까지) {
            반복 (정수 자2는 0부터 2 전까지) {
                반복 (정수 w3는 0부터 8 전까지) { 줄(o, 서식글("{I2}    중간정수 ew{j3}_{자2}_{w3} = 판i[eb + {j3 * 16 + 자2 * 8 + w3}].")). }
            }
        }
        반복 (정수 j4는 0부터 2 전까지) { 줄(o, 서식글("{I2}    짧은실수 Pe{j4} = 판[wb + 64 + bq * 2 + {j4}].")). }
        반복 (정수 j5는 0부터 2 전까지) {
            반복 (정수 종류는 0부터 3 전까지) {
                문자열 nm = "hh". 정수 ja = 1. 정수 jb = 1.
                종류 == 1이면 { nm = "sm". ja = 1. jb = 0. }
                종류 == 2이면 { nm = "ll". ja = 0. jb = 0. }
                줄(o, 서식글("{I2}    중간정수 {nm}{j5} = 0.")).
                반복 (정수 w4는 0부터 8 전까지) { 줄(o, 서식글("{I2}    {nm}{j5} = 바이트넷곱더하기(ew{j5}_{ja}_{w4}, v{dd}_{j5}_{jb}_{w4}, {nm}{j5}).")). }
            }
            반복 (정수 w5는 0부터 8 전까지) { 줄(o, 서식글("{I2}    sm{j5} = 바이트넷곱더하기(ew{j5}_0_{w5}, v{dd}_{j5}_1_{w5}, sm{j5}).")). }
            줄들(o, 정수곱읽기(서식글("짧은실수 uo{j5}"), 서식글("hh{j5}"), 서식글("sm{j5}"), 서식글("ll{j5}"), I6, 서식글("{j5}"), 거짓)).
        }
        줄(o, 서식글("{I2}    짧은실수 ov = 곱해더하기(uo1, Pe1, uo0 * Pe0).")).
        줄(o, 서식글("{I2}    ({하나}) != 0이면 \{ {출력}[머리 * 64 + 2 * rl + {dd}] = ov / 판[wb + 69]. \}")).
        줄(o, 서식글("{I2}    아니면 \{ {조각칸}[머리 * 조각칸폭 * 68 + ({조각}) * 64 + 2 * rl + {dd}] = ov. \}")).
        줄(o, 서식글("{I2}\}")).
        줄(o, 서식글("{ind}\}")).
    }
    줄(o, 서식글("{ind}워프동기화().")).
    반환 o.
}

(* 15단계 — 정수접기와 같은 식 · 같은 차례를 블록 하나(워프 여덟)가 머리 하나에, 묶음을 워프들에 나눠 *)
[문자열 ind를 문자열 머리를 문자열 조각끝을 문자열 조각칸을 문자열 출력을 메가두층접기]는 -> 문자열목록 참조 {
    정수 GS = 0. 정수 GA = 1088. 정수 GN = 1344. 정수 GL = 1600. 정수 GP = 1856. 정수 G2 = 2112.
    문자열 I2 = 서식글("{ind}    ").
    문자열 I3 = 서식글("{ind}        ").
    문자열 I4 = 서식글("{ind}            ").
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}\{")).
    줄(o, 서식글("{I2}정수 접바탕 = ({머리}) * 조각칸폭 * 68.")).
    줄(o, 서식글("{I2}정수 ml바탕 = 접바탕 + 조각칸폭 * 64.")).
    줄(o, 서식글("{I2}정수 묶음수 = ({조각끝}) / 16 + 1.")).
    줄(o, 서식글("{I2}정수 i = rl % 16.")).
    줄(o, 서식글("{I2}정수 g = rw + 8 * (rl / 16).")).
    줄(o, 서식글("{I2}정수 c = g * 16 + i.")).
    줄(o, 서식글("{I2}짧은실수 mv = -3.0e38.")).
    줄(o, 서식글("{I2}짧은실수 lv = 0 으로 짧은실수.")).
    줄(o, 서식글("{I2}c <= {조각끝}이면 \{ mv = {조각칸}[ml바탕 + c * 2]. lv = {조각칸}[ml바탕 + c * 2 + 1]. \}")).
    줄(o, 서식글("{I2}짧은실수 pv = mv.")).
    반복 (정수 sft = 1: sft <= 8: sft = sft * 2) {
        줄(o, 서식글("{I2}정수 kk{sft} = rl - {sft}.")).
        줄(o, 서식글("{I2}i < {sft}이면 \{ kk{sft} = rl. \}")).
        줄(o, 서식글("{I2}pv = 큰쪽(pv, 레인에서받기(pv, kk{sft})).")).
    }
    줄(o, 서식글("{I2}짧은실수 앞p = 레인에서받기(pv, (rl + 31) % 32).")).
    줄(o, 서식글("{I2}(c <= {조각끝} 그리고 i > 0)이면 \{")).
    줄들(o, 적힌지수식(서식글("판[{GA} + c]"), "앞p - pv", I3, "가")).
    줄들(o, 적힌지수식(서식글("판[{GN} + c]"), "mv - pv", I3, "나")).
    줄(o, 서식글("{I2}\}")).
    줄(o, 서식글("{I2}g < 16이면 \{ 판[{GL} + c] = lv. 판[{GP} + c] = pv. \}")).
    줄(o, 서식글("{I2}워프동기화().")).
    줄(o, 서식글("{I2}반복 (정수 gg = rw: gg < 묶음수: gg += 8) \{")).
    줄(o, 서식글("{I3}정수 접a = gg * 16.")).
    줄(o, 서식글("{I3}정수 접n = {조각끝} + 1 - 접a.")).
    줄(o, 서식글("{I3}접n > 16이면 \{ 접n = 16. \}")).
    반복 (정수 k는 0부터 16 전까지) { 줄(o, 서식글("{I3}정수 접i{k} = 접a + {k}.")). }
    반복 (정수 k2는 1부터 16 전까지) { 줄(o, 서식글("{I3}접i{k2} >= 접a + 접n이면 \{ 접i{k2} = 접a + 접n - 1. \}")). }
    반복 (정수 dd는 0부터 2 전까지) {
        반복 (정수 k3는 0부터 16 전까지) { 줄(o, 서식글("{I3}짧은실수 접o{k3}_{dd} = {조각칸}[접바탕 + 접i{k3} * 64 + 2 * rl + {dd}].")). }
    }
    반복 (정수 dd2는 0부터 2 전까지) {
        줄(o, 서식글("{I3}짧은실수 접O{dd2} = 접o0_{dd2}.")).
        반복 (정수 k4는 1부터 16 전까지) { 줄(o, 서식글("{I3}접n > {k4}이면 \{ 접O{dd2} = 곱해더하기(접o{k4}_{dd2}, 판[{GN} + 접a + {k4}], 접O{dd2} * 판[{GA} + 접a + {k4}]). \}")). }
        줄(o, 서식글("{I3}판[{GS} + gg * 68 + 4 + 2 * rl + {dd2}] = 접O{dd2}.")).
    }
    줄(o, 서식글("{I3}rl == 0이면 \{")).
    줄(o, 서식글("{I3}    짧은실수 접L = 판[{GL} + 접a].")).
    줄(o, 서식글("{I3}    반복 (정수 접c = 1: 접c < 접n: 접c += 1) \{ 접L = 곱해더하기(판[{GL} + 접a + 접c], 판[{GN} + 접a + 접c], 접L * 판[{GA} + 접a + 접c]). \}")).
    줄(o, 서식글("{I3}    판[{GS} + gg * 68] = 판[{GP} + 접a + 접n - 1].")).
    줄(o, 서식글("{I3}    판[{GS} + gg * 68 + 1] = 접L.")).
    줄(o, 서식글("{I3}\}")).
    줄(o, 서식글("{I2}\}")).
    줄(o, 서식글("{I2}동기화().")).
    줄(o, 서식글("{I2}rw == 0이면 \{")).
    줄(o, 서식글("{I3}짧은실수 gm = -3.0e38.")).
    줄(o, 서식글("{I3}rl < 묶음수이면 \{ gm = 판[{GS} + rl * 68]. \}")).
    줄(o, 서식글("{I3}짧은실수 gp = gm.")).
    반복 (정수 sft2 = 1: sft2 <= 16: sft2 = sft2 * 2) {
        줄(o, 서식글("{I3}정수 gk{sft2} = rl - {sft2}.")).
        줄(o, 서식글("{I3}rl < {sft2}이면 \{ gk{sft2} = rl. \}")).
        줄(o, 서식글("{I3}gp = 큰쪽(gp, 레인에서받기(gp, gk{sft2})).")).
    }
    줄(o, 서식글("{I3}짧은실수 앞g = 레인에서받기(gp, (rl + 31) % 32).")).
    줄(o, 서식글("{I3}(rl < 묶음수 그리고 rl > 0)이면 \{")).
    줄들(o, 적힌지수식(서식글("판[{G2} + rl]"), "앞g - gp", I4, "ga")).
    줄들(o, 적힌지수식(서식글("판[{G2} + 16 + rl]"), "gm - gp", I4, "gn")).
    줄(o, 서식글("{I3}\}")).
    줄(o, 서식글("{I3}워프동기화().")).
    줄(o, 서식글("{I3}짧은실수 L = 판[{GS} + 1].")).
    줄(o, 서식글("{I3}짧은실수 O0 = 판[{GS} + 4 + 2 * rl].")).
    줄(o, 서식글("{I3}짧은실수 O1 = 판[{GS} + 4 + 2 * rl + 1].")).
    줄(o, 서식글("{I3}반복 (정수 접g = 1: 접g < 묶음수: 접g += 1) \{")).
    줄(o, 서식글("{I3}    L = 곱해더하기(판[{GS} + 접g * 68 + 1], 판[{G2} + 16 + 접g], L * 판[{G2} + 접g]).")).
    줄(o, 서식글("{I3}    O0 = 곱해더하기(판[{GS} + 접g * 68 + 4 + 2 * rl], 판[{G2} + 16 + 접g], O0 * 판[{G2} + 접g]).")).
    줄(o, 서식글("{I3}    O1 = 곱해더하기(판[{GS} + 접g * 68 + 4 + 2 * rl + 1], 판[{G2} + 16 + 접g], O1 * 판[{G2} + 접g]).")).
    줄(o, 서식글("{I3}\}")).
    줄(o, 서식글("{I3}{출력}[({머리}) * 64 + 2 * rl] = O0 / L.")).
    줄(o, 서식글("{I3}{출력}[({머리}) * 64 + 2 * rl + 1] = O1 / L.")).
    줄(o, 서식글("{I2}\}")).
    줄(o, 서식글("{ind}\}")).
    반환 o.
}
