(* GeulPU 19단계 — 커널 생성기의 Qwen2 길(글 언어): 행이 적을 때의 정수 행렬곱(줄 판 — dp4a)과 줄 길의 Qwen2 판들, 임베딩 ·
   가장 큰 번호 · 칸 판. 커널생성.py 의 같은 이름의 함수(줄의 글자 그대로). *)

(* 정수판바꾸기제자리 — 스레드가 맡을 블록들의 네 칸씩을 레지스터로 읽고(읽기틀 — @ = 칸의 식), 동기화 뒤 자리 낱말을 판i[DX …] 에 *)
[문자열 읽기틀을 문자열 K를 문자열 KB를 정수 DX를 정수 DM0을 정수 T를 문자열 ind를 정수 바퀴를 정수판바꾸기제자리]는 -> 문자열목록 참조 {
    정수 nb = T / 8.
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}\{")).
    줄(o, 서식글("{ind}    정수 lane = tid % 32.")).
    반복 (정수 r는 0부터 바퀴 전까지) {
        줄(o, 서식글("{ind}    정수 b0_{r} = {nb * r} + tid / 8.")).
        줄(o, 서식글("{ind}    정수 b_{r} = b0_{r}.")).
        줄(o, 서식글("{ind}    b_{r} >= {KB}이면 \{ b_{r} = {KB} - 1. \}")).
        반복 (정수 i는 0부터 4 전까지) {
            문자열 읽기 = 틀채우기(읽기틀, 서식글("b_{r} * 32 + (lane % 8) * 4 + {i}")).
            줄(o, 서식글("{ind}    짧은실수 xr{r}_{i} = {읽기}.")).
        }
    }
    줄(o, 서식글("{ind}    동기화().")).
    반복 (정수 r2는 0부터 바퀴 전까지) {
        줄(o, 서식글("{ind}    \{")).
        줄들(o, 블록바꾸기몸(서식글("xr{r2}_@"), "정수 자@ = 0. 자@", 서식글("b0_{r2} < {KB}이면 \{ 판i[{DM0} + b_{r2}] = @. \}"), 서식글("{ind}        "))).
        줄(o, 서식글("{ind}        b0_{r2} < {KB}이면 \{")).
        반복 (정수 j는 0부터 자리수 전까지) { 줄(o, 서식글("{ind}            판i[{DX} + {j} * (({K}) / 4) + b_{r2} * 8 + lane % 8] = 자{j}.")). }
        줄(o, 서식글("{ind}        \}")).
        줄(o, 서식글("{ind}    \}")).
    }
    줄(o, 서식글("{ind}    동기화().")).
    줄(o, 서식글("{ind}\}")).
    반환 o.
}

(* v_j — 블록 합 S_j 의 짧은실수 (마법수 M_0 + 8j · 2²³) *)
[문자열 M0을 문자열 S를 정수 j를 마법v]는 -> 문자열 {
    정수 a = (8 * j) << 23.
    반환 서식글("(비트실수(({M0} + {a}) + {S}) - 비트실수({M0} + {a}))").
}

(* 정수열곱 — 행 하나 × 열 묶음(w 열): (열, 블록) 쌍의 dp4a 정확한 블록 합 → u → 블록 차례의 곱해더하기 사슬 (Q8_0 · 자리 둘) *)
[문자열 면을 문자열 KB를 문자열 N을 문자열 Np를 문자열 w를 문자열 값을 문자열 척을 문자열 값바탕을 문자열 척바탕을 정수 DX를 정수 DM0을 정수 US를 문자열 척판을 정수 SD를 정수 T를 문자열 치우침식을 문자열목록 참조 끝식을 문자열 그룹을 문자열 ind를 정수열곱]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}반복 (정수 p = tid: p < ({w}) * ({KB}): p += {T}) \{")).
    줄(o, 서식글("{ind}    정수 nl = p % ({w}).")).
    줄(o, 서식글("{ind}    정수 b = p / ({w}).")).
    줄(o, 서식글("{ind}    정수 n = ({그룹}) * ({w}) + nl.")).
    줄(o, 서식글("{ind}    n >= {N}이면 \{ n = {N} - 1. \}")).
    줄(o, 서식글("{ind}    정수 wb = {값바탕}(b * ({N}) + n) * 8.")).
    반복 (정수 i는 0부터 8 전까지) { 줄(o, 서식글("{ind}    중간정수 wq{i} = {값}[wb + {i}].")). }
    반복 (정수 j는 0부터 자리수 전까지) {
        반복 (정수 q는 0부터 8 전까지) { 줄(o, 서식글("{ind}    중간정수 x{j}_{q} = 판i[{DX} + {j} * {면} + b * 8 + {q}].")). }
        줄(o, 서식글("{ind}    중간정수 S{j} = 0.")).
        반복 (정수 q2는 0부터 8 전까지) { 줄(o, 서식글("{ind}    S{j} = 바이트넷곱더하기(x{j}_{q2}, wq{q2}, S{j}).")). }
    }
    줄(o, 서식글("{ind}    중간정수 M0 = 판i[{DM0} + b].")).
    문자열 v1 = 마법v("M0", "S1", 1).
    문자열 v0 = 마법v("M0", "S0", 0).
    줄(o, 서식글("{ind}    {척판}[{SD} + b * ({w}) + nl] = {척}[{척바탕}b * ({Np}) + n].")).
    줄(o, 서식글("{ind}    판[{US} + b * ({w}) + nl] = {v1} + {v0}.")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}동기화().")).
    줄(o, 서식글("{ind}\{")).
    줄(o, 서식글("{ind}    정수 열 = ({그룹}) * ({w}) + tid.")).
    줄(o, 서식글("{ind}    (tid < {w} 그리고 열 < {N})이면 \{")).
    줄(o, 서식글("{ind}        짧은실수 y = 0 으로 짧은실수.")).
    줄(o, 서식글("{ind}        반복 (정수 b는 0부터 {KB} 전까지) \{ y = 곱해더하기(판[{US} + b * ({w}) + tid], {척판}[{SD} + b * ({w}) + tid], y). \}")).
    줄(o, 서식글("{ind}        짧은실수 v = y + {치우침식}.")).
    반복 (정수 k는 0부터 문자열목록_길이(끝식) 전까지) {
        문자열 x = 문자열목록_값(끝식, k).
        줄(o, 서식글("{ind}        {x}")).
    }
    줄(o, 서식글("{ind}    \}")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}동기화().")).
    반환 o.
}

(* 정수줄선형 — Qwen2(작은가() 아님)는 정수줄선형큰: 입력 행을 전역에서 바로 레지스터로(정수판바꾸기제자리) *)
[문자열 epi를 문자열 이름을 정수줄선형]는 -> 문자열목록 참조 {
    정수 T = 256.
    정수 X크기 = 너비.
    확장폭 > X크기이면 { X크기 = 확장폭. }
    정수 DX = 0.
    정수 DM0 = X크기.
    정수 US = DM0 + X크기 / 32.
    정수 SD = US + 800.
    정수 공유 = 공유판크기((SD + 800) * 4).
    정수 바퀴 = (X크기 / 32 + T / 8 - 1) / (T / 8).
    문자열 가중 = 가중선언("가중치", "척도").
    문자열 잔차 = "".
    문자열_같은가(epi, "_잔차")이면 { 잔차 = "짧은실수 참조 잔차와 ". }
    문자열 머리 = 서식글("짧은실수 참조 입력에서 {가중}짧은실수 참조 치우침과 {잔차}짧은실수 참조 출력에 정수 행수로 정수 깊이로 정수 열수로").
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 정수 블록 계약의 행렬곱 — 행이 적을 때(dp4a), 큰 깊이 판. 커널생성.py 의 설명 *)").
    줄(L, 서식글("[{머리} {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{공유}().")).
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    작은정수 참조 판b = 판 으로 작은정수 참조.").
    줄(L, "    정수 블록수 = 깊이 / 32.").
    줄(L, "    정수 깊이16 = 깊이 / 16 * 4.").
    줄(L, "    정수 척도폭 = (열수 + 63) / 64 * 64.").
    줄(L, "    정수 w = 800 / 블록수.").
    줄(L, "    정수 그룹 = 블록가로().").
    줄(L, "    정수 자리 = 0.").
    줄(L, "    정수 자리위 = 0.").
    줄(L, "    짧은실수 u = 0 으로 짧은실수.").
    줄(L, "    짧은실수 th = 0 으로 짧은실수.").
    줄(L, "    반복 (정수 행 = 0: 행 < 행수: 행 += 1) \{").
    줄들(L, 정수판바꾸기제자리("입력[행 * 깊이 + @]", "깊이", "블록수", DX, DM0, T, "        ", 바퀴)).
    문자열목록 참조 끝식 = 빈칸뗀목록(끝손질(epi, "v", "행", "열", "", "")).
    줄들(L, 정수열곱("깊이16", "블록수", "열수", "척도폭", "w", "가중치", "척도", "", "", DX, DM0, US, "판", SD, T, "치우침[열]", 끝식, "그룹", "        ")).
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 정수열곱묶음 — 정수열곱과 같은 계산을, 스레드가 (열, 블록) 쌍 U 개의 가중치 · 척도를 먼저 모두 읽은 뒤에 *)
[문자열 면을 문자열 KB를 문자열 N을 문자열 Np를 문자열 w를 문자열 값을 문자열 척을 문자열 값바탕을 문자열 척바탕을 정수 DX를 정수 DM0을 정수 US를 문자열 척판을 정수 SD를 정수 T를 문자열 치우침식을 문자열목록 참조 끝식을 문자열 그룹을 문자열 ind를 정수 U를 정수열곱묶음]는 -> 문자열목록 참조 {
    문자열 총 = 서식글("({w}) * ({KB})").
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}반복 (정수 p0 = tid: p0 < {총}: p0 += {T * U}) \{")).
    반복 (정수 i는 0부터 U 전까지) {
        줄(o, 서식글("{ind}    정수 p{i} = p0 + {T * i}.")).
        줄(o, 서식글("{ind}    정수 쓰{i} = 1.")).
        줄(o, 서식글("{ind}    p{i} >= {총}이면 \{ p{i} = {총} - 1. 쓰{i} = 0. \}")).
        줄(o, 서식글("{ind}    정수 nl{i} = p{i} % ({w}).")).
        줄(o, 서식글("{ind}    정수 b{i} = p{i} / ({w}).")).
        줄(o, 서식글("{ind}    정수 n{i} = ({그룹}) * ({w}) + nl{i}.")).
        줄(o, 서식글("{ind}    n{i} >= {N}이면 \{ n{i} = {N} - 1. \}")).
        줄(o, 서식글("{ind}    정수 wb{i} = {값바탕}(b{i} * ({N}) + n{i}) * 8.")).
        반복 (정수 q는 0부터 8 전까지) { 줄(o, 서식글("{ind}    중간정수 wq{i}_{q} = {값}[wb{i} + {q}].")). }
        줄(o, 서식글("{ind}    짧은실수 sc{i} = {척}[{척바탕}b{i} * ({Np}) + n{i}].")).
    }
    반복 (정수 i2는 0부터 U 전까지) {
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 q2는 0부터 8 전까지) { 줄(o, 서식글("{ind}    중간정수 x{i2}_{j}_{q2} = 판i[{DX} + {j} * {면} + b{i2} * 8 + {q2}].")). }
            줄(o, 서식글("{ind}    중간정수 S{i2}_{j} = 0.")).
            반복 (정수 q3는 0부터 8 전까지) { 줄(o, 서식글("{ind}    S{i2}_{j} = 바이트넷곱더하기(x{i2}_{j}_{q3}, wq{i2}_{q3}, S{i2}_{j}).")). }
        }
        줄(o, 서식글("{ind}    중간정수 M0{i2} = 판i[{DM0} + b{i2}].")).
        문자열 v1 = 마법v(서식글("M0{i2}"), 서식글("S{i2}_1"), 1).
        문자열 v0 = 마법v(서식글("M0{i2}"), 서식글("S{i2}_0"), 0).
        줄(o, 서식글("{ind}    쓰{i2} == 1이면 \{ {척판}[{SD} + b{i2} * ({w}) + nl{i2}] = sc{i2}. 판[{US} + b{i2} * ({w}) + nl{i2}] = {v1} + {v0}. \}")).
    }
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}동기화().")).
    줄(o, 서식글("{ind}\{")).
    줄(o, 서식글("{ind}    정수 열 = ({그룹}) * ({w}) + tid.")).
    줄(o, 서식글("{ind}    (tid < {w} 그리고 열 < {N})이면 \{")).
    줄(o, 서식글("{ind}        짧은실수 y = 0 으로 짧은실수.")).
    줄(o, 서식글("{ind}        반복 (정수 b는 0부터 {KB} 전까지) \{ y = 곱해더하기(판[{US} + b * ({w}) + tid], {척판}[{SD} + b * ({w}) + tid], y). \}")).
    줄(o, 서식글("{ind}        짧은실수 v = y + {치우침식}.")).
    반복 (정수 k는 0부터 문자열목록_길이(끝식) 전까지) {
        문자열 x = 문자열목록_값(끝식, k).
        줄(o, 서식글("{ind}        {x}")).
    }
    줄(o, 서식글("{ind}    \}")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}동기화().")).
    반환 o.
}

(* 줄 길의 QKV 끝손질 — 판[VS …] 의 열 64 개(머리 하나 — 그룹)를 RoPEKV정수로와 같은 식으로. 키더함 · 값더함 · 지수더함: 캐시 색인 앞의 식 *)
[정수 VS를 문자열 ind를 문자열 키더함을 문자열 값더함을 문자열 지수더함을 QKV줄끝]는 -> 문자열목록 참조 {
    정수 KBq = 너비 / 32.
    정수 KBk = (너비 + 64 * KV머리수) / 32.
    문자열 I2 = 서식글("{ind}    ").
    문자열 I3 = 서식글("{ind}        ").
    문자열 I4 = 서식글("{ind}            ").
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{ind}tid < 32이면 \{")).
    줄(L, 서식글("{I2}정수 lane = tid.")).
    줄(L, 서식글("{I2}정수 r = 행.")).
    줄(L, 서식글("{I2}정수 블록수 = {(너비 + 128 * KV머리수) / 32}.")).
    줄(L, 서식글("{I2}정수 정보폭 = (행수 + 63) / 64 * 64.")).
    줄(L, 서식글("{I2}정수 bb = (lane / 8) % 2.")).
    줄(L, 서식글("{I2}정수 b = 그룹 * 2 + bb.")).
    줄(L, 서식글("{I2}정수 xa = bb * 32 + (lane % 8) * 4.")).
    줄(L, 서식글("{I2}정수 문장 = r / 묶음안행수.")).
    줄(L, 서식글("{I2}정수 위치 = 위치시작 + r % 묶음안행수.")).
    줄(L, 서식글("{I2}정수 머리 = b / 2.")).
    줄(L, 서식글("{I2}b >= {KBq}이면 \{ 머리 = (b - {KBq}) / 2. \}")).
    줄(L, 서식글("{I2}b >= {KBk}이면 \{ 머리 = (b - {KBk}) / 2. \}")).
    줄(L, 서식글("{I2}정수 머리바탕 = 문장 * {KV머리수} + 머리.")).
    줄(L, 서식글("{I2}작은정수 참조 값바이트 = 값칸 으로 작은정수 참조.")).
    반복 (정수 i는 0부터 4 전까지) { 줄(L, 서식글("{I2}짧은실수 rx{i} = 판[{VS} + xa + {i}].")). }
    줄(L, 서식글("{I2}b < {KBk}이면 \{")).
    줄(L, 서식글("{I3}정수 짝 = xa + 32.")).
    줄(L, 서식글("{I3}bb == 1이면 \{ 짝 = xa - 32. \}")).
    줄(L, 서식글("{I3}정수 ti = 위치 * 32 + (lane % 8) * 4.")).
    반복 (정수 i2는 0부터 4 전까지) {
        줄(L, 서식글("{I3}짧은실수 p{i2} = 판[{VS} + 짝 + {i2}].")).
        줄(L, 서식글("{I3}짧은실수 cs{i2} = 코사인[ti + {i2}].")).
        줄(L, 서식글("{I3}짧은실수 sn{i2} = 사인[ti + {i2}].")).
        줄(L, 서식글("{I3}bb == 0이면 \{ rx{i2} = 곱해더하기(rx{i2}, cs{i2}, -(p{i2} * sn{i2})). \}")).
        줄(L, 서식글("{I3}아니면 \{ rx{i2} = 곱해더하기(rx{i2}, cs{i2}, p{i2} * sn{i2}). \}")).
    }
    줄(L, 서식글("{I2}\}")).
    줄(L, 서식글("{I2}중간정수 M0 = 0.")).
    줄들(L, 블록바꾸기몸("rx@", "정수 자@ = 0. 자@", "M0 = @.", I2)).
    문자열 pos식 = 낱말위치("lane % 8").
    줄(L, 서식글("{I2}정수 pos = {pos식}.")).
    줄(L, 서식글("{I2}lane < 16이면 \{")).
    줄(L, 서식글("{I3}b < {KBq}이면 \{")).
    반복 (정수 j는 0부터 2 전까지) { 줄(L, 서식글("{I4}자릿값q[({j} * 행수 + r) * {너비 / 4} + b * 8 + pos] = 자{j}.")). }
    줄(L, 서식글("{I4}lane % 8 == 0이면 \{ 정보q[b * 정보폭 + r] = M0. \}")).
    줄(L, 서식글("{I3}\}")).
    줄(L, 서식글("{I3}아니면 b < {KBk}이면 \{")).
    반복 (정수 j2는 0부터 2 전까지) { 줄(L, 서식글("{I4}키칸[{키더함}(머리바탕 * 2 + {j2}) * 최대길이 * 16 + 위치 * 16 + bb * 8 + pos] = 자{j2}.")). }
    줄(L, 서식글("{I4}lane % 8 == 0이면 \{ 키지수[{지수더함}(머리바탕 * 최대길이 + 위치) * 2 + bb] = (E + 114) 으로 부호없는 작은정수. \}")).
    줄(L, 서식글("{I3}\}")).
    줄(L, 서식글("{I3}아니면 \{")).
    줄(L, 서식글("{I4}정수 r32 = 위치 % 32.")).
    줄(L, 서식글("{I4}정수 r16 = r32 % 16.")).
    줄(L, 서식글("{I4}정수 낱말 = ((r16 % 8) / 2) * 2 + r32 / 16.")).
    줄(L, 서식글("{I4}정수 바이트 = (r16 / 8) * 2 + r16 % 2.")).
    줄(L, 서식글("{I4}정수 d0 = bb * 32 + (lane % 8) * 4.")).
    줄(L, 서식글("{I4}정수 값바탕 = {값더함}((머리바탕 * (최대길이 / 32) + 위치 / 32) * 2) * 2048.")).
    반복 (정수 j3는 0부터 2 전까지) {
        반복 (정수 i3는 0부터 4 전까지) {
            줄(L, 서식글("{I4}값바이트[값바탕 + {j3} * 2048 + (d0 + {i3}) * 32 + 낱말 * 4 + 바이트] = d{i3}{j3} 으로 작은정수.")).
        }
    }
    줄(L, 서식글("{I4}lane % 8 == 0이면 \{ 값지수[{지수더함}(머리바탕 * 최대길이 + 위치) * 2 + bb] = (E + 114) 으로 부호없는 작은정수. \}")).
    줄(L, 서식글("{I3}\}")).
    줄(L, 서식글("{I2}\}")).
    줄(L, 서식글("{ind}\}")).
    줄(L, 서식글("{ind}동기화().")).
    반환 L.
}

(* 줄 길의 SwiGLU 끝손질 — 판[VS …] 의 열 64 개(gate 32 · up 32)에서 h 32 개를 출력틀(@ = c)에 *)
[정수 VS를 문자열 출력틀을 문자열 ind를 SwiGLU줄끝]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("{ind}tid < 32이면 \{")).
    줄(L, 서식글("{ind}    짧은실수 g = 판[{VS} + tid].")).
    줄(L, 서식글("{ind}    짧은실수 uu = 판[{VS} + 32 + tid].")).
    줄들(L, SwiGLU식("x", "g", "uu", 서식글("{ind}    "), "s")).
    문자열 출력 = 틀채우기(출력틀, "tid").
    줄(L, 서식글("{ind}    {출력} = x.")).
    줄(L, 서식글("{ind}\}")).
    줄(L, 서식글("{ind}동기화().")).
    반환 L.
}

(* 정수줄선형Q — 줄 길(행 넷까지)의 정수 행렬곱(dp4a) Qwen2 판. 입력판 "그대로" · "RMS", 끝판 "" · "_잔차" · "_QKV" · "_SwiGLU" · "_큰번호" *)
[문자열 이름을 문자열 입력판을 문자열 끝판을 정수 K를 정수 w를 정수줄선형Q]는 -> 문자열목록 참조 {
    정수 T = 256.
    정수 KB = K / 32.
    정수 DX = 0.
    정수 DM0 = 자리수 * K / 4.
    정수 US = (DM0 + KB + 3) / 4 * 4.
    정수 SD = US + w * KB.
    정수 VS = SD + w * KB.
    정수 RS = VS + 64.
    정수 공유 = 공유판크기((RS + 256) * 4).
    정수 바퀴 = (KB + T / 8 - 1) / (T / 8).
    문자열 감마 = "".
    문자열_같은가(입력판, "RMS")이면 { 감마 = "짧은실수 참조 감마와 ". }
    문자열 가중 = 가중선언("가중치", "척도").
    문자열 출력부 = "짧은실수 참조 출력에".
    문자열_같은가(끝판, "_잔차")이면 { 출력부 = "짧은실수 참조 잔차와 짧은실수 참조 출력에". }
    문자열_같은가(끝판, "_큰번호")이면 { 출력부 = "짧은실수 참조 출력에 짧은실수 참조 부분값에 정수 참조 부분번호에". }
    문자열_같은가(끝판, "_QKV")이면 {
        문자열 kv = 정수KV선언().
        출력부 = 서식글("중간정수 참조 자릿값q에 중간정수 참조 정보q에 {kv} 짧은실수 참조 코사인과 짧은실수 참조 사인에").
    }
    문자열 꼬리 = "".
    문자열_같은가(끝판, "_QKV")이면 { 꼬리 = " 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로". }
    문자열 머리 = 서식글("짧은실수 참조 입력에서 {감마}{가중}짧은실수 참조 치우침과 {출력부} 정수 행수로 정수 열수로{꼬리}").
    문자열 끝이름 = 끝판.
    끝이름[0] == 0이면 { 끝이름 = "그대로". }
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("(* 14단계 — 정수 블록 계약의 행렬곱(dp4a) — 줄 길의 Qwen2 판(입력 {입력판}, 끝 {끝이름}). 커널생성.py 의 설명 *)")).
    줄(L, 서식글("(* 실행한도 {이름} {T} 2 *)")).
    줄(L, 서식글("[{머리} {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{공유}().")).
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    작은정수 참조 판b = 판 으로 작은정수 참조.").
    줄(L, "    정수 척도폭 = (열수 + 63) / 64 * 64.").
    줄(L, "    정수 그룹 = 블록가로().").
    줄(L, "    짧은실수 u = 0 으로 짧은실수.").
    줄(L, "    반복 (정수 행 = 0: 행 < 행수: 행 += 1) \{").
    문자열 읽기 = 서식글("입력[행 * {K} + @]").
    문자열_같은가(입력판, "RMS")이면 {
        줄(L, 서식글("        정수 바탕 = 행 * {K}.")).
        줄들(L, RMS정규화몸("        ", "입력", "바탕", 서식글("{RS}"))).
        읽기 = "(입력[바탕 + @] * 역rms) * 감마[@]".
    }
    줄들(L, 정수판바꾸기제자리(읽기, 서식글("{K}"), 서식글("{KB}"), DX, DM0, T, "        ", 바퀴)).
    문자열목록 참조 끝식 = 줄목록().
    (문자열_같은가(끝판, "") 또는 문자열_같은가(끝판, "_잔차"))이면 { 끝식 = 끝손질(끝판, "v", "행", "열", "", ""). }
    아니면 문자열_같은가(끝판, "_큰번호")이면 {
        줄(끝식, "출력[행 * 열수 + 열] = v.").
        줄(끝식, 서식글("판[{VS} + tid] = v.")).
    }
    아니면 { 줄(끝식, 서식글("판[{VS} + tid] = v.")). }
    줄들(L, 정수열곱묶음(서식글("{K / 4}"), 서식글("{KB}"), "열수", "척도폭", 서식글("{w}"), "가중치", "척도", "", "", DX, DM0, US, "판", SD, T, "치우침[열]", 끝식, "그룹", "        ", 4)).
    문자열_같은가(끝판, "_큰번호")이면 {
        줄(L, "        tid == 0이면 \{").
        줄(L, 서식글("            정수 열수끝 = 열수 - 그룹 * {w}.")).
        줄(L, 서식글("            열수끝 > {w}이면 \{ 열수끝 = {w}. \}")).
        줄(L, 서식글("            짧은실수 큰 = 판[{VS}].")).
        줄(L, "            정수 큰번호 = 0.").
        줄(L, "            반복 (정수 c = 1: c < 열수끝: c += 1) \{").
        줄(L, 서식글("                판[{VS} + c] > 큰이면 \{ 큰 = 판[{VS} + c]. 큰번호 = c. \}")).
        줄(L, "            \}").
        줄(L, 서식글("            정수 부자리 = 행 * ((열수 + {w - 1}) / {w}) + 그룹.")).
        줄(L, "            부분값[부자리] = 큰.").
        줄(L, 서식글("            부분번호[부자리] = 그룹 * {w} + 큰번호.")).
        줄(L, "        \}").
        줄(L, "        동기화().").
    }
    아니면 문자열_같은가(끝판, "_SwiGLU")이면 { 줄들(L, SwiGLU줄끝(VS, "출력[행 * (열수 / 2) + 그룹 * 32 + @]", "        ")). }
    아니면 문자열_같은가(끝판, "_QKV")이면 { 줄들(L, QKV줄끝(VS, "        ", "", "", "")). }
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 줄 길의 QKV 바꾸기 — RoPE(q · k) + 정수 KV 계약 *)
[RoPEKV정수로]는 -> 문자열목록 참조 {
    정수 QKV = 너비 + 128 * KV머리수.
    정수 KBq = 너비 / 32.
    정수 KBk = (너비 + 64 * KV머리수) / 32.
    문자열 kv = 정수KV선언().
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 14단계 — 줄 길의 QKV 바꾸기: RoPE(q · k) + 정수 KV 계약. 커널생성.py 의 설명 *)").
    줄(L, 서식글("[짧은실수 참조 입력에서 중간정수 참조 자릿값q에 중간정수 참조 정보q에 {kv} 짧은실수 참조 코사인과 짧은실수 참조 사인과 정수 행수로 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로 RoPEKV정수로]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 r = 블록세로().").
    줄(L, 서식글("    정수 블록수 = {QKV / 32}.")).
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, "    정수 b0 = 블록가로() * 32 + (tid / 32) * 4 + lane / 8.").
    줄(L, "    정수 b = b0.").
    줄(L, "    b >= 블록수이면 \{ b = 블록수 - 1. \}").
    줄(L, 서식글("    정수 xa = r * {QKV} + b * 32 + (lane % 8) * 4.")).
    줄(L, "    정수 문장 = r / 묶음안행수.").
    줄(L, "    정수 위치 = 위치시작 + r % 묶음안행수.").
    줄(L, "    정수 bb = b % 2.").
    줄(L, "    정수 머리 = b / 2.").
    줄(L, 서식글("    b >= {KBq}이면 \{ 머리 = (b - {KBq}) / 2. \}")).
    줄(L, 서식글("    b >= {KBk}이면 \{ 머리 = (b - {KBk}) / 2. \}")).
    줄(L, 서식글("    정수 머리바탕 = 문장 * {KV머리수} + 머리.")).
    줄(L, "    작은정수 참조 값바이트 = 값칸 으로 작은정수 참조.").
    반복 (정수 i는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 rx{i} = 입력[xa + {i}].")). }
    줄(L, 서식글("    b < {KBk}이면 \{")).
    줄(L, "        정수 짝 = xa + 32.").
    줄(L, "        bb == 1이면 \{ 짝 = xa - 32. \}").
    줄(L, "        정수 ti = 위치 * 32 + (lane % 8) * 4.").
    반복 (정수 i2는 0부터 4 전까지) {
        줄(L, 서식글("        짧은실수 p{i2} = 입력[짝 + {i2}].")).
        줄(L, 서식글("        짧은실수 cs{i2} = 코사인[ti + {i2}].")).
        줄(L, 서식글("        짧은실수 sn{i2} = 사인[ti + {i2}].")).
        줄(L, 서식글("        bb == 0이면 \{ rx{i2} = 곱해더하기(rx{i2}, cs{i2}, -(p{i2} * sn{i2})). \}")).
        줄(L, 서식글("        아니면 \{ rx{i2} = 곱해더하기(rx{i2}, cs{i2}, p{i2} * sn{i2}). \}")).
    }
    줄(L, "    \}").
    줄(L, "    중간정수 M0 = 0.").
    줄들(L, 블록바꾸기몸("rx@", "정수 자@ = 0. 자@", "M0 = @.", "    ")).
    문자열 pos식 = 낱말위치("lane % 8").
    줄(L, 서식글("    정수 pos = {pos식}.")).
    줄(L, "    b0 < 블록수이면 \{").
    줄(L, 서식글("        b < {KBq}이면 \{")).
    반복 (정수 j는 0부터 2 전까지) { 줄(L, 서식글("            자릿값q[({j} * 행수 + r) * {너비 / 4} + b * 8 + pos] = 자{j}.")). }
    줄(L, "            lane % 8 == 0이면 \{ 정보q[b * 정보폭 + r] = M0. \}").
    줄(L, "        \}").
    줄(L, 서식글("        아니면 b < {KBk}이면 \{")).
    반복 (정수 j2는 0부터 2 전까지) { 줄(L, 서식글("            키칸[(머리바탕 * 2 + {j2}) * 최대길이 * 16 + 위치 * 16 + bb * 8 + pos] = 자{j2}.")). }
    줄(L, "            lane % 8 == 0이면 \{ 키지수[(머리바탕 * 최대길이 + 위치) * 2 + bb] = (E + 114) 으로 부호없는 작은정수. \}").
    줄(L, "        \}").
    줄(L, "        아니면 \{").
    줄(L, "            정수 r32 = 위치 % 32.").
    줄(L, "            정수 r16 = r32 % 16.").
    줄(L, "            정수 낱말 = ((r16 % 8) / 2) * 2 + r32 / 16.").
    줄(L, "            정수 바이트 = (r16 / 8) * 2 + r16 % 2.").
    줄(L, "            정수 d0 = bb * 32 + (lane % 8) * 4.").
    줄(L, "            정수 값바탕 = ((머리바탕 * (최대길이 / 32) + 위치 / 32) * 2) * 2048.").
    반복 (정수 j3는 0부터 2 전까지) {
        반복 (정수 i3는 0부터 4 전까지) {
            줄(L, 서식글("            값바이트[값바탕 + {j3} * 2048 + (d0 + {i3}) * 32 + 낱말 * 4 + 바이트] = d{i3}{j3} 으로 작은정수.")).
        }
    }
    줄(L, "            lane % 8 == 0이면 \{ 값지수[(머리바탕 * 최대길이 + 위치) * 2 + bb] = (E + 114) 으로 부호없는 작은정수. \}").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 줄 길의 SwiGLU — gate · up 출력을 h [행][확장폭] 으로 *)
[SwiGLU줄]는 -> 문자열목록 참조 {
    정수 F = 확장폭.
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 14단계 — 줄 길의 SwiGLU: h = silu(gate) · up — _SwiGLU정수 와 같은 식 *)").
    줄(L, "[짧은실수 참조 입력에서 짧은실수 참조 출력에 정수 행수로 SwiGLU줄]는 \{").
    줄(L, "    정수 i = 실행번호().").
    줄(L, 서식글("    i < 행수 * {F}이면 \{")).
    줄(L, 서식글("        정수 r = i / {F}.")).
    줄(L, 서식글("        정수 j = i % {F}.")).
    줄(L, 서식글("        정수 a = r * {2 * F} + (j / 32) * 64 + j % 32.")).
    줄(L, "        짧은실수 g = 입력[a].").
    줄(L, "        짧은실수 u = 입력[a + 32].").
    줄들(L, SwiGLU식("x", "g", "u", "        ", "s")).
    줄(L, "        출력[i] = x.").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 임베딩(위치 임베딩 없음) — 칸 = 참: 생성 그래프의 판(토큰을 토큰[걸음칸[1] + r] 에서) *)
[참거짓 칸을 임베딩qwen]는 -> 문자열목록 참조 {
    문자열 이름 = "임베딩".
    문자열 걸음 = "".
    칸이면 { 이름 = "임베딩칸". 걸음 = "정수 참조 걸음칸으로 ". }
    문자열 가중 = 가중선언("낱말표", "낱말척도").
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 14단계 — 임베딩(위치 임베딩 없음): 낱말표(정수 배치)에서 값 하나씩 정확히 풀어 *)").
    줄(L, 서식글("[정수 참조 토큰에서 {가중}짧은실수 참조 출력에 정수 행수로 {걸음}{이름}]는 \{")).
    줄(L, "    정수 i = 실행번호().").
    줄(L, 서식글("    i < 행수 * {너비}이면 \{")).
    줄(L, 서식글("        정수 r = i / {너비}.")).
    줄(L, 서식글("        정수 c = i % {너비}.")).
    칸이면 { 줄(L, "        정수 t = 토큰[걸음칸[1] + r]."). }
    아니면 { 줄(L, "        정수 t = 토큰[r]."). }
    줄들(L, 낱말풀기("t", "c", "낱값", "        ")).
    줄(L, "        출력[i] = 낱값.").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* 가장 큰 번호의 고르기 끝(토큰 쓰기) — 칸 판은 걸음칸을 올린다 *)
[문자열목록 참조 L을 참거짓 칸을 큰번호끝]는 {
    칸이면 {
        줄(L, "        토큰출력[걸음칸[1] + 1] = 큰번호.").
        줄(L, "        걸음칸[0] = 걸음칸[0] + 1.").
        줄(L, "        걸음칸[1] = 걸음칸[1] + 1.").
    }
    아니면 { 줄(L, "        토큰출력[문장] = 큰번호."). }
    줄(L, "    \}").
    줄(L, "\}").
}

(* 문장마다 마지막 행의 로짓에서 가장 큰 칸의 번호(값이 같으면 작은 번호) *)
[참거짓 칸을 가장큰번호qwen]는 -> 문자열목록 참조 {
    문자열 이름 = "가장큰번호".
    문자열 걸음 = "".
    칸이면 { 이름 = "가장큰번호칸". 걸음 = "정수 참조 걸음칸으로 ". }
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 로짓에서 가장 큰 칸의 번호 — 값이 같으면 작은 번호. 블록 하나가 문장 하나, 256 스레드, 열수 ≥ 256 *)").
    줄(L, 서식글("[짧은실수 참조 로짓에서 정수 참조 토큰출력에 정수 묶음안행수로 정수 열수로 {걸음}{이름}]는 \{")).
    줄(L, "    정수 문장 = 블록가로().").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    짧은실수 참조 값들 = 공유판4().").
    줄(L, "    정수 참조 번호들 = 공유메모리2().").
    줄(L, "    정수 바탕 = (문장 * 묶음안행수 + 묶음안행수 - 1) * 열수.").
    줄(L, "    짧은실수 최고 = 로짓[바탕 + tid].").
    줄(L, "    정수 최고번호 = tid.").
    줄(L, "    반복 (정수 j = tid + 256: j < 열수: j += 256) \{").
    줄(L, "        짧은실수 v = 로짓[바탕 + j].").
    줄(L, "        v > 최고이면 \{").
    줄(L, "            최고 = v.").
    줄(L, "            최고번호 = j.").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "    값들[tid] = 최고.").
    줄(L, "    번호들[tid] = 최고번호.").
    줄(L, "    동기화().").
    줄(L, "    tid == 0이면 \{").
    줄(L, "        짧은실수 큰 = 값들[0].").
    줄(L, "        정수 큰번호 = 번호들[0].").
    줄(L, "        반복 (정수 k는 1부터 256 전까지) \{").
    줄(L, "            (값들[k] > 큰 또는 (값들[k] == 큰 그리고 번호들[k] < 큰번호))이면 \{").
    줄(L, "                큰 = 값들[k].").
    줄(L, "                큰번호 = 번호들[k].").
    줄(L, "            \}").
    줄(L, "        \}").
    큰번호끝(L, 칸).
    반환 L.
}

(* 정수줄선형Q(…, "_큰번호") 의 부분에서 가장 큰 값의 번호 *)
[참거짓 칸을 가장큰번호부분]는 -> 문자열목록 참조 {
    문자열 이름 = "가장큰번호부분".
    문자열 걸음 = "".
    칸이면 { 이름 = "가장큰번호부분칸". 걸음 = "정수 참조 걸음칸으로 ". }
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 14단계 — 부분(블록마다의 가장 큰 값 · 번호)에서 가장 큰 칸의 번호 — 값이 같으면 작은 번호 *)").
    줄(L, 서식글("[짧은실수 참조 부분값에서 정수 참조 부분번호와 정수 참조 토큰출력에 정수 묶음안행수로 정수 부분수로 {걸음}{이름}]는 \{")).
    줄(L, "    정수 문장 = 블록가로().").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    짧은실수 참조 값들 = 공유판4().").
    줄(L, "    정수 참조 번호들 = 공유메모리2().").
    줄(L, "    정수 바탕 = (문장 * 묶음안행수 + 묶음안행수 - 1) * 부분수.").
    줄(L, "    짧은실수 최고 = 부분값[바탕 + tid].").
    줄(L, "    정수 최고번호 = 부분번호[바탕 + tid].").
    줄(L, "    반복 (정수 j = tid + 256: j < 부분수: j += 256) \{").
    줄(L, "        짧은실수 v = 부분값[바탕 + j].").
    줄(L, "        v > 최고이면 \{").
    줄(L, "            최고 = v.").
    줄(L, "            최고번호 = 부분번호[바탕 + j].").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "    값들[tid] = 최고.").
    줄(L, "    번호들[tid] = 최고번호.").
    줄(L, "    동기화().").
    줄(L, "    tid == 0이면 \{").
    줄(L, "        짧은실수 큰 = 값들[0].").
    줄(L, "        정수 큰번호 = 번호들[0].").
    줄(L, "        반복 (정수 k는 1부터 256 전까지) \{").
    줄(L, "            (값들[k] > 큰 또는 (값들[k] == 큰 그리고 번호들[k] < 큰번호))이면 \{").
    줄(L, "                큰 = 값들[k].").
    줄(L, "                큰번호 = 번호들[k].").
    줄(L, "            \}").
    줄(L, "        \}").
    큰번호끝(L, 칸).
    반환 L.
}

(* 생성 그래프의 판 — `정수 위치시작으로` 를 `정수 참조 걸음칸으로` 로, 몸의 처음에 위치시작 = 걸음칸[0], 이름 끝에 '칸' *)
[문자열목록 참조 L을 문자열 이름을 칸판]는 -> 문자열목록 참조 {
    문자열목록 참조 out = 줄목록().
    참거짓 찾음 = 거짓.
    문자열 끝꼴 = 서식글(" {이름}]는 \{").
    문자열 한도꼴 = 서식글("(* 실행한도 {이름} ").
    반복 (정수 k는 0부터 문자열목록_길이(L) 전까지) {
        문자열 x = 문자열목록_값(L, k).
        (글앞같음(x, "[") 그리고 글뒤같음(x, 끝꼴))이면 {
            찾음이면 { 파일에_쓰기(표준오류(), "칸판: 머리가 둘 — %s\n", 이름). 1로 종료하다. }
            문자열 y = 글바꾸기(x, " 정수 위치시작으로", " 정수 참조 걸음칸으로").
            y = 글바꾸기(y, 끝꼴, 서식글(" {이름}칸]는 \{")).
            줄(out, y).
            줄(out, "    정수 위치시작 = 걸음칸[0].").
            찾음 = 참.
        }
        아니면 글앞같음(x, 한도꼴)이면 { 줄(out, 글바꾸기(x, 한도꼴, 서식글("(* 실행한도 {이름}칸 "))). }
        아니면 { 줄(out, x). }
    }
    아닌 찾음이면 { 파일에_쓰기(표준오류(), "칸판: 머리를 찾지 못했다 — %s\n", 이름). 1로 종료하다. }
    반환 out.
}
