(* GeulPU 22단계 — 커널 생성기: 7B(머리 128)의 생성 길(행 넷까지) 판. 문서/22단계.md 의 모듈 목록 "줄 판(행 넷까지)" · "생성 어텐션(조각 +
   조각 접기 — 머리 128)".
     정수조각어텐션128 — 블록 하나가 (KV 머리, 키 조각 하나): 그 KV 머리를 읽는 질의 머리 일곱 × 행을 가상 행으로(워프마다 16) 함께 —
       키 · 값 조각을 한 번만 올린다. 셈은 묶음 판의 조각 하나와 같은 줄(큰조각셈). 조각의 몫 (m, l, o) 을 조각칸 [행][머리][조각][132] 에.
     정수조각접기128 — (머리, 행)마다 조각 몫을 계약의 두 층 접기(13단계 — 묶음(조각 16 개) 안을 차례로, 그다음 묶음끼리 차례로)로.
     정수줄자리 — 행 넷까지의 정수 행렬곱(dp4a): 활성값의 자리 둘 · 정보를 전역에서(앞 판이 쓴 것), 블록 하나가 열 W 개.
   23단계 — 생성 그래프의 판(행 하나 — 같은 식 · 같은 차례, 계약 그대로): 정수조각어텐션넷(조각 셈을 워프 넷으로), 정수조각접기넓(묶음 안
     접기를 묶음끼리 나란히), RMS정규화정수줄펼침(읽기를 앞으로), 정수줄하나(가중치 · 척도 · 자리를 비동기 복사의 판으로 미리 — Q8_0 · Q4_0).
   셋 모두 계약은 그대로다(같은 연산을 같은 차례로) — 프롬프트 길(타일 판 · 묶음 판)과 비트까지 같아야 한다(22a · 22b). *)

(* ---- 생성 어텐션 (가) ---- *)
[참거짓 넷을 정수조각어텐션128]는 -> 문자열목록 참조 {
    정수 T = 128.
    정수 SH = 큰머리 + 4.
    정수 무리 = 머리수 / KV머리수.
    문자열 c128 = "0.088388346135616302490234375".   (* 짧은실수(1/√128) — 묶음 판과 같은 글자 *)
    문자열 이름 = "정수조각어텐션".
    넷이면 { 이름 = "정수조각어텐션넷". }          (* 23단계 — 셈을 워프 넷으로(행 둘까지 — 가상 행 16 개 안) *)
    큰협력 = 협력판 그리고 (아닌 공유32 또는 공유32새).   (* 34단계 — --협력 이면 큰조각셈 · 큰조각셈넷이 협력 판으로(34m 의 공유32 는 아니다) *)
    큰판32 = 협력판 그리고 공유32 그리고 공유32새.     (* 35단계 — 공유32 의 협력 판(키 · 값을 번갈아 — 32 KB) *)
    문자열 위치매개 = "정수 위치시작으로".
    문자열 문행 = "행수".                         (* 문장 하나의 행 — 표 판은 묶음안행수(행수는 모든 문장의 행) *)
    문자열 머리식 = "KV머리".                      (* KV 캐시의 머리 자리 — 표 판은 슬롯 · KV머리수 + KV머리 *)
    표판이면 {
        이름 = 서식글("{이름}표").
        위치매개 = "정수 참조 위치표로 정수 참조 슬롯표로".
        문행 = "묶음안행수".
        머리식 = 서식글("(슬롯 * {KV머리수} + KV머리)").
    }
    문자열 먼매개 = "".
    (표판 그리고 먼판)이면 { 먼매개 = " 정수 참조 먼표로". }      (* GeulPUv2 ③c — 앞쪽 그룹은 정수조각어텐션묶음표 가(먼표 — 엔진표.gl 의 표걸음) *)
    (* GeulPUv2 ③c — F1 모듈의 표 스텝 커널은 타일을 반복문으로 돈다: 블록 x 가 타일 x, x + 격자, …(격자 = 실행개수 / 128 — 엔진이 깊이와
       상관없이 작게 띄운다). 예전에는 격자가 최대 길이만큼이라 문맥 설정이 길면 짧은 깊이에서도 빈 블록이 층마다 수만 개였다. 타일마다의
       계산 · 쓰는 자리는 그대로다 *)
    참거짓 넷돌기 = 표판 그리고 먼판 그리고 넷.
    문자열 kv = 정수KV선언().
    문자열목록 참조 L = 줄목록().
    표판이면 { 줄(L, "(* 28단계 — 표 판: 정수조각어텐션넷 과 같은 셈, 블록이 (키 조각, KV 머리 + KV머리수 · 문장) — 문장의 위치 · KV 슬롯을 위치표 · 슬롯표에서 *)"). }
    아니면 { 줄(L, "(* 22단계 — 정수 KV 계약의 생성 어텐션 (가), 머리 128: 블록 하나가 (KV 머리, 키 조각 하나) — 질의 머리 일곱 × 행을 가상 행으로 함께. 조각 몫을 조각칸에 *)"). }
    줄(L, 서식글("(* 실행한도 {이름} {T} 2 *)")).
    줄(L, 서식글("[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 {kv} 짧은실수 참조 조각칸에 정수 행수로 정수 묶음안행수로 {위치매개} 정수 최대길이로{먼매개} {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    아닌 넷돌기이면 { 줄(L, "    정수 조각 = 블록가로()."). }
    표판이면 {
        줄(L, 서식글("    정수 문장 = 블록세로() / {KV머리수}.")).
        줄(L, 서식글("    정수 KV머리 = 블록세로() % {KV머리수}.")).
        줄(L, "    정수 위치시작 = 위치표[문장].").
        줄(L, "    정수 슬롯 = 슬롯표[문장].").
    }
    아니면 { 줄(L, "    정수 KV머리 = 블록세로()."). }
    아닌 넷돌기이면 { 줄(L, "    정수 tb = 조각 * 64."). }
    줄(L, "    정수 p0 = 위치시작.").
    줄(L, 서식글("    정수 VR = {무리} * {문행}.")).
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    KV8이면 {                          (* GeulPUv2 ③b-2 — 8비트 KV 의 배치(RoPEKV정수로128) *)
        줄(L, 서식글("    정수 키바탕 = {머리식} * 최대길이 * 32.")).
        줄(L, 서식글("    정수 값바탕 = {머리식} * (최대길이 / 32) * 1024.")).
        줄(L, 서식글("    정수 스케일바탕 = {머리식} * 최대길이 * 4.")).
    }
    아니면 {
        줄(L, 서식글("    정수 키바탕 = {머리식} * 2 * 최대길이 * 32.")).
        줄(L, 서식글("    정수 값바탕 = {머리식} * (최대길이 / 32) * 2048.")).
        줄(L, 서식글("    정수 지수바이트 = {머리식} * 최대길이 * 4.")).
    }
    공유32이면 { 줄들(L, 큰지수전역머리("    ")). }          (* 34단계 — 공유32: 지수를 전역에서(생성머리128.gl) *)
    줄(L, "    정수 조각칸폭 = 최대길이 / 64.").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 g = lane / 4.").
    줄(L, "    정수 t = lane % 4.").
    줄(L, "    정수 w = tid / 32.").
    큰판32이면 {                                       (* 35단계 — 키 · 값 자리 [0, 4096) 뒤에 질의 판 · D 판(생성머리128.gl) *)
        줄(L, "    짧은실수 참조 판 = 공유판32().").
        줄(L, 서식글("    정수 QW = {큰QW32} + w * {2 * 큰QJ}.")).
        줄(L, 서식글("    정수 QW1 = QW + {큰QJ}.")).
        줄(L, 서식글("    정수 DW = {큰DW32} + w * {16 * 협DS}.")).
        줄(L, 서식글("    정수 dr = DW + g * {협DS} + t * 2.")).
    }
    아니면 큰협력이면 {
        줄(L, "    짧은실수 참조 판 = 공유판48().").
        줄(L, 서식글("    정수 QW = {큰QW바탕} + w * {2 * 큰QJ}.")).
        줄(L, 서식글("    정수 QW1 = QW + {큰QJ}.")).                (* 둘째 자리 — 한 변수로(뒷단이 같은 값의 읽기를 다시 쓴다) *)
        줄(L, 서식글("    정수 DW = {큰DW바탕} + w * {16 * 협DS}.")).
        줄(L, 서식글("    정수 dr = DW + g * {협DS} + t * 2.")).
    }
    아니면 공유32이면 { 줄(L, "    짧은실수 참조 판 = 공유판32()."). }       (* 34단계 — 키 · 값 자리만 *)
    아니면 { 줄(L, "    짧은실수 참조 판 = 공유판36()."). }
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    짧은실수 참조 키넓 = 키칸 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 값넓 = 값칸 으로 짧은실수 참조.").
    큰시작마법 = 시작마법생성 그리고 선형자리수 == 1 그리고 아닌 큰협력.   (* GeulPUv2 4단계 — 생성 · 표 걸음의 조각 판(넘침 없음)에 누산 시작값 마법수 *)
    줄(L, "    중간정수 영i = 0.").
    큰시작마법이면 { 줄(L, "    중간정수 마i = 1262485504.            (* 4단계 — 텐서곱의 누산 시작값(비트(1.5 · 2²³)) *)"). }
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    넷돌기이면 {                              (* GeulPUv2 ③c — 앞쪽 그룹의 타일은 정수조각어텐션묶음표 가 맡았다. 이 행의 타일 먼묶음 · 16 … 조각끝r 을 돈다 *)
        줄(L, 서식글("    정수 조각끝r = (위치시작 + {문행} - 1) / 64.")).
        줄(L, "    정수 먼묶음 = 먼표[문장].").
        줄(L, 서식글("    정수 넷격자 = 실행개수() / {T}.")).
        줄(L, "    정수 조각0 = 먼묶음 * 16 + 블록가로().").
        줄(L, "    조각0 <= 조각끝r이면 \{").
    }
    아니면 { 줄(L, 서식글("    tb <= 위치시작 + {문행} - 1이면 \{")). }
    반복 (정수 h는 0부터 2 전까지) {
        넷이면 { 줄(L, 서식글("    정수 v원{h} = g + {8 * h}.")). }
        아니면 { 줄(L, 서식글("    정수 v원{h} = w * 16 + g + {8 * h}.")). }
        줄(L, 서식글("    정수 v{h} = v원{h}.")).
        줄(L, 서식글("    v{h} >= VR이면 \{ v{h} = VR - 1. \}")).
        줄(L, 서식글("    정수 qh{h} = KV머리 * {무리} + v{h} / {문행}.")).
        표판이면 {
            줄(L, 서식글("    정수 qr{h} = 문장 * 묶음안행수 + v{h} % 묶음안행수.")).
            줄(L, 서식글("    정수 pq{h} = 위치시작 + v{h} % 묶음안행수.")).
        }
        아니면 {
            줄(L, 서식글("    정수 qr{h} = v{h} % 행수.")).
            줄(L, 서식글("    정수 pq{h} = 위치시작 + qr{h}.")).
        }
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 b는 0부터 4 전까지) {
                줄(L, 서식글("    정수 qo{j}_{b}_{h} = ({j} * 행수 + qr{h}) * {질의폭 / 4} + (qh{h} * 4 + {b}) * 8 + t * 2.")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_0 = 자릿값q[qo{j}_{b}_{h}].")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_1 = 자릿값q[qo{j}_{b}_{h} + 1].")).
            }
        }
        반복 (정수 b2는 0부터 4 전까지) {
            줄(L, 서식글("    짧은실수 pqs{b2}_{h} = 비트실수(정보q[(qh{h} * 4 + {b2}) * 정보폭 + qr{h}] - {빼기둘}).")).
        }
        F2이면 { 줄(L, 서식글("    짧은실수 qc{h} = pqs0_{h} * 0.1275174319744110107421875.")). }   (* F2 — 큰조각셈 · 큰조각셈넷 의 점수 끝 곱 *)
    }
    반복 (정수 u는 0부터 1024 / T 전까지) {
        KV8이면 { 줄들(L, 큰KV8올리기주소(u, T)). 계속. }                 (* ③b-2 *)
        문자열 c = 서식글("(tid + {T * u})").
        줄(L, 서식글("    정수 kj{u} = {c} / 512.")).
        줄(L, 서식글("    정수 kk{u} = ({c} % 512) / 8.")).
        줄(L, 서식글("    정수 kq{u} = {c} % 8.")).
        큰협력이면 { 줄(L, 서식글("    정수 k저장{u} = {큰KS} + kj{u} * 2048 + (kq{u} / 2) * 512 + kk{u} * 8 + (kq{u} % 2) * 4.")). }   (* 블록마다 열 먼저 *)
        아니면 { 줄(L, 서식글("    정수 k저장{u} = {큰KS} + kj{u} * 2048 + kk{u} * 32 + (kq{u} ^ ((kk{u} & 3) * 2)) * 4.")). }
        줄(L, 서식글("    정수 k원본{u} = 키바탕 + kj{u} * 최대길이 * 32 + kk{u} * 32 + kq{u} * 4.")).
        정수 VB = 큰값바탕().
        줄(L, 서식글("    정수 v저장{u} = {VB} + ({c} / 512) * 2048 + (({c} % 512) / 256) * 1024 + (({c} % 256) / 2) * 8 + ({c} % 2) * 4.")).
        줄(L, 서식글("    정수 v원본{u} = 값바탕 + ({c} / 512) * 2048 + (({c} % 512) / 256) * 1024 + (({c} % 256) / 2) * 8 + ({c} % 2) * 4.")).
    }
    넷돌기이면 {
        줄(L, "    반복 (정수 조각 = 조각0: 조각 <= 조각끝r: 조각 += 넷격자) \{").
        줄(L, "    정수 tb = 조각 * 64.").
        줄(L, "    동기화().").                         (* 앞 타일의 계산이 공유 메모리를 다 읽은 뒤에 덮는다 *)
    }
    줄(L, "    \{").
    줄들(L, 큰어텐션올리기("조각", "        ")).
    줄(L, "    \}").
    줄(L, "    비동기묶기().").
    줄(L, "    \{").
    줄들(L, 큰어텐션지수풀기("조각", "        ")).
    줄(L, "    \}").
    줄(L, "    비동기기다리기(0).").
    줄(L, "    동기화().").
    문자열 I = "        ".
    문자열 J = "            ".
    넷이면 {
        줄들(L, 큰조각셈넷(I, J, c128)).
        반복 (정수 h3는 0부터 2 전까지) {
            줄(L, 서식글("{I}(v원{h3} < VR 그리고 pq{h3} >= tb)이면 \{")).
            줄(L, 서식글("{I}    정수 상바탕 = ((qr{h3} * {머리수} + qh{h3}) * 조각칸폭 + 조각) * {SH}.")).
            줄(L, 서식글("{I}    (w == 0 그리고 t == 0)이면 \{ 조각칸[상바탕] = mx{h3}. 조각칸[상바탕 + 1] = l{h3}. \}")).
            F2이면 { 줄(L, 서식글("{I}    (w == 0 그리고 t == 0)이면 \{ 조각칸[상바탕 + 2] = Pf{h3}. \}")). }      (* F2 — 타일 결과는 uo, 배율 Pf 는 칸 2 *)
            반복 (정수 i6는 0부터 4 전까지) {
                반복 (정수 e6는 0부터 2 전까지) {
                    줄(L, 서식글("{I}    조각칸[상바탕 + 4 + (w * 4 + {i6}) * 8 + {e6} + t * 2] = o{i6}_{2 * h3 + e6}.")).
                }
            }
            줄(L, 서식글("{I}\}")).
        }
        넷돌기이면 { 줄(L, "    \}"). }            (* ③c — 타일 반복문 *)
        줄(L, "    \}").
        줄(L, "\}").
        큰협력 = 거짓.
        큰판32 = 거짓.
        큰시작마법 = 거짓.
        반환 L.
    }
    큰판32이면 { 줄(L, "        \{"). }            (* 35단계 — 블록 장벽이 셈 안에 있어 모든 워프가 셈한다(쉬는 워프의 행은 VR − 1 로 묶였고 쓰기만 막힌다) *)
    아니면 { 줄(L, "        (w * 16 < VR)이면 \{"). }
    줄들(L, 큰조각셈(I, J, c128)).
    반복 (정수 h2는 0부터 2 전까지) {
        줄(L, 서식글("{I}(v원{h2} < VR 그리고 pq{h2} >= tb)이면 \{")).
        줄(L, 서식글("{I}    정수 상바탕 = ((qr{h2} * {머리수} + qh{h2}) * 조각칸폭 + 조각) * {SH}.")).
        줄(L, 서식글("{I}    t == 0이면 \{ 조각칸[상바탕] = mx{h2}. 조각칸[상바탕 + 1] = l{h2}. \}")).
        F2이면 { 줄(L, 서식글("{I}    t == 0이면 \{ 조각칸[상바탕 + 2] = Pf{h2}. \}")). }      (* F2 — 타일 결과는 uo, 배율 Pf 는 칸 2 *)
        반복 (정수 dt는 0부터 16 전까지) {
            반복 (정수 e는 0부터 2 전까지) {
                줄(L, 서식글("{I}    조각칸[상바탕 + {4 + 8 * dt + e} + t * 2] = o{dt}_{2 * h2 + e}.")).
            }
        }
        줄(L, 서식글("{I}\}")).
    }
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    큰협력 = 거짓.
    큰판32 = 거짓.
    큰시작마법 = 거짓.
    반환 L.
}

(* ---- GeulPUv2 ③c — 표 스텝의 앞쪽 그룹 ----
   표 스텝(서버의 생성 · 추측 검증)에서 같은 슬롯 · 이어진 위치의 행들(연속 행 — 추측 검증의 [다음 토큰, 초안 1 … k])은 같은 KV 를 읽는다.
   예전에는 행마다 · 타일(키 64)마다 블록이 KV 타일을 따로 올리고 타일 결과(M, L, O 128)를 조각칸에 써서 병합 커널이 다시 읽었다 — 깊이 64k
   에서 행 8 의 검증 스텝이 행 1 의 3.8 배(8비트 KV)였다. 앞쪽 그룹(첫 행의 위치 p 앞의 다 찬 그룹 p / 1024 개 — 가림이 없다)은 이제
   정수조각어텐션묶음표 가 연속 행 · KV 헤드 하나 · 그룹 하나를 블록 하나로 맡아 KV 타일을 한 번만 올리고, 그룹의 타일 16 개를
   레지스터 안에서 차례로 병합해(프롬프트 어텐션 정수어텐션묶음128 과 같은 식) 그룹 상태를 묶음칸에 쓴다. 가까운 타일(그 뒤)은 예전처럼
   정수조각어텐션넷표 가, 병합은 정수조각접기넓표 가 묶음칸의 그룹 상태와 조각칸의 타일 결과를 계약의 차례(그룹 안은 타일 차례, 그다음 그룹끼리
   차례)로 잇는다 — 그룹 상태는 병합 커널의 첫 층 결과와 같은 연산 · 같은 차례라 비트까지 같다. 연속 행과 앞쪽 그룹 수는 엔진이 스텝마다
   계산해 표칸에 올린다(먼표 — [앞쪽 그룹 수 8][연속 행 수 8], 엔진표.gl 의 표걸음 — 첫 위치가 한도 이상일 때만). F1 모듈(--빠른)과
   1.0.0 1-7 의 정밀 CUDA 모듈(--먼)에 — --먼 없는 정밀 모듈 · Vulkan 모듈은 바이트까지 그대로다 *)
참거짓 먼판 = 거짓.               (* 표 스텝의 커널 셋이 앞쪽 그룹을 쓰는가 — 커널생성이 F1 모듈에서 켠다(1.0.0 1-7 — 정밀 모듈은 --먼 으로) *)
참거짓 먼켬 = 거짓.               (* GeulPUv2 1.0.0 1-7 — 커널생성 --먼: 정밀(자리 둘) 모듈에도 앞쪽 그룹 — 앱은 CUDA 모듈에만 준다(Vulkan 모듈은 그대로) *)

(* 앞쪽 그룹의 어텐션: 블록 하나(스레드 128)가 (그룹 묶g, KV 헤드, 연속 행의 첫 행) — 질의 헤드 무리 × 행 먼수 를 가상 행으로(워프마다 16 —
   정수조각어텐션128 과 같은 배치), 그룹의 타일 16 개를 차례로 올려 큰조각셈 으로 계산하고 레지스터 안에서 병합한다(큰묶음갱신 — 정수어텐션묶음128
   과 같은 줄). 첫 행이 아니거나 앞쪽 그룹이 아닌 블록은 곧 끝난다. 격자 (최대길이 / 1024, KV머리수 × 행수).
   넷 = 참: 가상 행이 16 개 이하(행 하나 — Qwen 은 행 둘 · Llama 는 행 넷까지)면 워프 넷이 타일 하나를 나눠(점수는 키 16 개씩, 가중합은 값의
   블록 하나씩 — 큰조각셈넷, 정수조각어텐션넷 과 같은 줄) 계산하고, 워프마다 제 d 32 개의 누적 O 를 같은 식으로 병합한다. 넷 = 거짓 커널은
   가상 행이 16 개를 넘을 때만 맡는다 *)
[참거짓 넷을 정수조각어텐션묶음128표]는 -> 문자열목록 참조 {
    정수 T = 128.
    정수 SH = 큰머리 + 4.
    정수 무리 = 머리수 / KV머리수.
    문자열 c128 = "0.088388346135616302490234375".   (* 짧은실수(1/√128) — 프롬프트 어텐션 커널과 같은 글자 *)
    문자열 이름 = "정수조각어텐션묶음표".
    넷이면 { 이름 = "정수조각어텐션넷묶음표". }
    문자열 kv = 정수KV선언().
    큰협력 = 거짓.
    큰판32 = 거짓.
    큰묶음갱신 = 참.               (* 타일을 올리는 주소(바탕 넷 + 상수)와 큰조각셈 안의 병합 — 큰조각셈넷 은 이 값을 보지 않아 넷 = 참 커널은 뒤에 병합한다(아래) *)
    큰시작마법 = 거짓.
    문자열목록 참조 L = 줄목록().
    줄(L, "(* GeulPUv2 ③c — 표 스텝의 앞쪽 그룹 어텐션: 블록 하나가 (그룹, KV 헤드, 연속 행) — 타일 16 개를 레지스터 안에서 병합해 그룹 상태를 묶음칸에 *)").
    줄(L, 서식글("(* 실행한도 {이름} {T} 2 *)")).
    줄(L, 서식글("[중간정수 참조 자릿값q에서 중간정수 참조 정보q와 {kv} 짧은실수 참조 묶음칸에 정수 행수로 정수 묶음안행수로 정수 참조 위치표로 정수 참조 슬롯표로 정수 최대길이로 정수 참조 먼표로 {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 묶g = 블록가로().").
    줄(L, 서식글("    정수 행0 = 블록세로() / {KV머리수}.")).
    줄(L, 서식글("    정수 KV머리 = 블록세로() % {KV머리수}.")).
    줄(L, "    정수 먼수 = 먼표[8 + 행0].").                   (* 연속 행의 첫 행이면 행 수, 아니면(또는 앞쪽 그룹이 없으면) 0 *)
    문자열 맡음 = 서식글("{무리} * 먼수 > 16").
    넷이면 { 맡음 = 서식글("{무리} * 먼수 <= 16"). }
    줄(L, 서식글("    (먼수 > 0 그리고 {맡음} 그리고 묶g < 먼표[행0])이면 \{")).
    줄(L, "    정수 위치시작 = 위치표[행0].").
    줄(L, "    정수 p0 = 위치시작.").
    줄(L, 서식글("    정수 VR = {무리} * 먼수.")).
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    정수 머리바탕 = 슬롯표[행0] * {KV머리수} + KV머리.")).
    KV8이면 {
        줄(L, "    정수 키바탕 = 머리바탕 * 최대길이 * 32.").
        줄(L, "    정수 값바탕 = 머리바탕 * (최대길이 / 32) * 1024.").
        줄(L, "    정수 스케일바탕 = 머리바탕 * 최대길이 * 4.").
    }
    아니면 {
        줄(L, "    정수 키바탕 = 머리바탕 * 2 * 최대길이 * 32.").
        줄(L, "    정수 값바탕 = 머리바탕 * (최대길이 / 32) * 2048.").
        줄(L, "    정수 지수바이트 = 머리바탕 * 최대길이 * 4.").
    }
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 g = lane / 4.").
    줄(L, "    정수 t = lane % 4.").
    줄(L, "    정수 w = tid / 32.").
    줄(L, "    짧은실수 참조 판 = 공유판36().").
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    짧은실수 참조 키넓 = 키칸 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 값넓 = 값칸 으로 짧은실수 참조.").
    줄(L, "    중간정수 영i = 0.").
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    줄(L, "    정수 조각시작 = 묶g * 16.").
    반복 (정수 h는 0부터 2 전까지) {
        넷이면 { 줄(L, 서식글("    정수 v원{h} = g + {8 * h}.")). }
        아니면 { 줄(L, 서식글("    정수 v원{h} = w * 16 + g + {8 * h}.")). }
        줄(L, 서식글("    정수 v{h} = v원{h}.")).
        줄(L, 서식글("    v{h} >= VR이면 \{ v{h} = VR - 1. \}")).
        줄(L, 서식글("    정수 qh{h} = KV머리 * {무리} + v{h} / 먼수.")).
        줄(L, 서식글("    정수 qr{h} = 행0 + v{h} % 먼수.")).
        줄(L, 서식글("    정수 pq{h} = 위치시작 + v{h} % 먼수.")).
        반복 (정수 j는 0부터 2 전까지) {
            반복 (정수 b는 0부터 4 전까지) {
                줄(L, 서식글("    정수 qo{j}_{b}_{h} = ({j} * 행수 + qr{h}) * {질의폭 / 4} + (qh{h} * 4 + {b}) * 8 + t * 2.")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_0 = 자릿값q[qo{j}_{b}_{h}].")).
                줄(L, 서식글("    중간정수 qa{j}_{b}_{h}_1 = 자릿값q[qo{j}_{b}_{h} + 1].")).
            }
        }
        반복 (정수 b2는 0부터 4 전까지) {
            줄(L, 서식글("    짧은실수 pqs{b2}_{h} = 비트실수(정보q[(qh{h} * 4 + {b2}) * 정보폭 + qr{h}] - {빼기둘}).")).
        }
        F2이면 { 줄(L, 서식글("    짧은실수 qc{h} = pqs0_{h} * 0.1275174319744110107421875.")). }   (* F2 *)
    }
    (* 타일을 올리는 주소 — 정수어텐션묶음128 의 바탕 넷 + 상수와 같다 *)
    정수 VB0 = 큰값바탕().
    줄(L, 서식글("    정수 kb바탕 = {큰KS} + (tid / 8) * 32 + ((tid % 8) ^ (((tid / 8) & 3) * 2)) * 4.")).
    줄(L, "    정수 kg바탕 = 키바탕 + (tid / 8) * 32 + (tid % 8) * 4.").
    아닌 KV8이면 { 줄(L, "    정수 키줄 = 최대길이 * 32."). }
    줄(L, 서식글("    정수 vb바탕 = {VB0} + (tid / 2) * 8 + (tid % 2) * 4.")).
    줄(L, "    정수 vg바탕 = 값바탕 + (tid / 2) * 8 + (tid % 2) * 4.").
    반복 (정수 h2는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 M{h2} = 영.")). }
    반복 (정수 h3는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 L{h3} = 영.")). }
    정수 OD = 16.                   (* 스레드의 누적 O 는 d 8 개 단위로 OD 개(× 4 칸) — 넷 = 참 커널은 제 워프의 d 32 개 *)
    넷이면 { OD = 4. }
    반복 (정수 dt는 0부터 OD 전까지) { 반복 (정수 c2는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 O{dt}_{c2} = 영.")). } }
    줄(L, "    반복 (정수 조각 = 조각시작: 조각 <= 조각시작 + 15: 조각 += 1) \{").
    줄(L, "        동기화().").
    줄(L, "        \{").
    줄들(L, 큰어텐션올리기("조각", "            ")).
    줄(L, "        \}").
    줄(L, "        비동기묶기().").
    줄(L, "        \{").
    줄들(L, 큰어텐션지수풀기("조각", "            ")).
    줄(L, "        \}").
    줄(L, "        비동기기다리기(0).").
    줄(L, "        동기화().").
    줄(L, "        정수 tb = 조각 * 64.").
    넷이면 { 줄(L, "        \{"). }                (* 큰조각셈넷 안의 블록 장벽 — 모든 워프가 계산한다 *)
    아니면 { 줄(L, "        (w * 16 < VR)이면 \{"). }
    문자열 I = "        ".
    문자열 J = "            ".
    넷이면 {
        줄들(L, 큰조각셈넷(I, J, c128)).
        (* 큰조각셈 의 큰묶음갱신 과 같은 식 — 원소마다 O = fma(o, 접B, O · 접A) (이어 병합 (옛, 새) · 첫 타일 (0, 1) · 가린 타일 (1, 0)) *)
        반복 (정수 hu는 0부터 2 전까지) {
            줄(L, 서식글("{I}참거짓 갱{hu} = pq{hu} >= tb.")).
            줄(L, 서식글("{I}참거짓 접{hu} = 갱{hu} 그리고 조각 != 조각시작.")).
            줄(L, 서식글("{I}짧은실수 새큰{hu} = 큰쪽(M{hu}, mx{hu}).")).
            줄들(L, 큰지수식(서식글("짧은실수 옛{hu}"), 서식글("M{hu} - 새큰{hu}"), I, 서식글("f{hu}a"))).
            줄들(L, 큰지수식(서식글("짧은실수 새{hu}"), 서식글("mx{hu} - 새큰{hu}"), I, 서식글("f{hu}b"))).
            줄(L, 서식글("{I}짧은실수 접A{hu} = 1.0.")).
            줄(L, 서식글("{I}짧은실수 접B{hu} = 0.0.")).
            줄(L, 서식글("{I}갱{hu}이면 \{ 접A{hu} = 0.0. 접B{hu} = 1.0. \}")).
            줄(L, 서식글("{I}접{hu}이면 \{ 접A{hu} = 옛{hu}. 접B{hu} = 새{hu}. \}")).
            F2이면 { 줄(L, 서식글("{I}짧은실수 PB{hu} = Pf{hu} * 접B{hu}.")). }      (* F2 — o 는 uo, 배율은 Pf · 접B 하나 *)
        }
        반복 (정수 i8는 0부터 4 전까지) {
            반복 (정수 c8는 0부터 4 전까지) {
                정수 h8 = c8 >> 1.
                F2이면 { 줄(L, 서식글("{I}O{i8}_{c8} = 곱해더하기(o{i8}_{c8}, PB{h8}, O{i8}_{c8} * 접A{h8}).")). }
                아니면 { 줄(L, 서식글("{I}O{i8}_{c8} = 곱해더하기(o{i8}_{c8}, 접B{h8}, O{i8}_{c8} * 접A{h8}).")). }
            }
        }
    }
    아니면 { 줄들(L, 큰조각셈(I, J, c128)). }
    반복 (정수 h12는 0부터 2 전까지) {         (* O 는 원소마다 병합했다 — 여기는 M · L (정수어텐션묶음128 과 같은 식) *)
        줄(L, 서식글("{I}갱{h12}이면 \{")).
        줄(L, 서식글("{I}    접{h12}이면 \{")).
        줄(L, 서식글("{I}        L{h12} = 곱해더하기(l{h12}, 새{h12}, L{h12} * 옛{h12}).")).
        줄(L, 서식글("{I}        M{h12} = 새큰{h12}.")).
        줄(L, 서식글("{I}    \}")).
        줄(L, 서식글("{I}    아니면 \{")).
        줄(L, 서식글("{I}        M{h12} = mx{h12}.")).
        줄(L, 서식글("{I}        L{h12} = l{h12}.")).
        줄(L, 서식글("{I}    \}")).
        줄(L, 서식글("{I}\}")).
    }
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "    정수 묶음수 = (최대길이 + 1023) / 1024.").
    반복 (정수 h13는 0부터 2 전까지) {
        줄(L, 서식글("    v원{h13} < VR이면 \{")).
        줄(L, 서식글("        정수 상바탕 = ((qr{h13} * {머리수} + qh{h13}) * 묶음수 + 묶g) * {SH}.")).
        넷이면 {                                  (* 워프 w 는 d [32w, 32w + 32) — 정수조각어텐션넷 이 조각칸에 쓰는 자리와 같다 *)
            줄(L, 서식글("        (w == 0 그리고 t == 0)이면 \{ 묶음칸[상바탕] = M{h13}. 묶음칸[상바탕 + 1] = L{h13}. \}")).
            반복 (정수 i9는 0부터 4 전까지) {
                반복 (정수 e9는 0부터 2 전까지) {
                    줄(L, 서식글("        묶음칸[상바탕 + 4 + (w * 4 + {i9}) * 8 + {e9} + t * 2] = O{i9}_{2 * h13 + e9}.")).
                }
            }
        }
        아니면 {
            줄(L, 서식글("        t == 0이면 \{ 묶음칸[상바탕] = M{h13}. 묶음칸[상바탕 + 1] = L{h13}. \}")).
            반복 (정수 dt7는 0부터 16 전까지) {
                반복 (정수 e5는 0부터 2 전까지) {
                    줄(L, 서식글("        묶음칸[상바탕 + {4 + 8 * dt7 + e5} + t * 2] = O{dt7}_{2 * h13 + e5}.")).
                }
            }
        }
        줄(L, "    \}").
    }
    줄(L, "    \}").
    줄(L, "\}").
    큰묶음갱신 = 거짓.
    반환 L.
}

(* ---- 생성 어텐션 (나) — 두 층 접기 ---- *)
(* 블록 하나(스레드 128 — d 하나씩)가 (머리, 행) 하나: 묶음(조각 16 개)마다 조각 몫을 차례로 접고(첫 조각이 처음 값 — 묶음 판의 고리와 같은
   식), 묶음끼리 차례로 접는다(첫 묶음이 처음 값 — 묶음 접기와 같은 식). 실수출력 = 거짓: c_proj 의 자리 둘 · 정보, 참: 짧은실수 [행][질의폭] *)
[참거짓 실수출력을 참거짓 넓을 정수조각접기128]는 -> 문자열목록 참조 {
    정수 SH = 큰머리 + 4.
    문자열 이름 = "정수조각접기".
    실수출력이면 { 이름 = "정수조각접기짧은". }
    정수 T = 128.                    (* 23단계 — 넓: 스레드 1024 = 묶음 자리 8 × d 128 (묶음 안 접기를 묶음끼리 나란히) *)
    넓이면 {
        이름 = 서식글("{이름}넓").
        T = 1024.
    }
    문자열 위치매개 = "정수 위치시작으로".
    표판이면 {
        이름 = 서식글("{이름}표").
        위치매개 = "정수 참조 위치표로".
    }
    참거짓 먼 = 먼판 그리고 표판 그리고 넓.          (* GeulPUv2 ③c — 앞쪽 그룹은 묶음칸의 그룹 상태로(정수조각어텐션묶음128표 의 설명) *)
    문자열 먼매개 = "".
    먼이면 { 먼매개 = " 짧은실수 참조 묶음칸과 정수 참조 먼표로". }
    문자열 출력 = "중간정수 참조 정보와 중간정수 참조 자릿값에".
    실수출력이면 { 출력 = "짧은실수 참조 출력에". }
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 22단계 — 정수 KV 계약의 생성 어텐션 (나), 머리 128: 블록 하나가 (머리, 행) — 조각 몫을 두 층으로 차례로 접는다 *)").
    줄(L, 서식글("(* 실행한도 {이름} {T} {1024 / T} *)")).
    넓이면 { 줄(L, "(* 23단계 — 묶음 안 접기(조각 16 개 차례로)는 묶음마다 스레드 128 이 나란히, 묶음끼리의 접기는 스레드 128 이 차례로 — 식은 같다 *)"). }
    줄(L, 서식글("[짧은실수 참조 조각칸에서 {출력} 정수 행수로 정수 묶음안행수로 {위치매개} 정수 최대길이로{먼매개} {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 머리 = 블록가로().").
    줄(L, "    정수 행 = 블록세로().").
    표판이면 { 줄(L, "    정수 조각끝 = (위치표[행 / 묶음안행수] + 행 % 묶음안행수) / 64."). }
    아니면 { 줄(L, "    정수 조각끝 = (위치시작 + 행 % 묶음안행수) / 64."). }
    줄(L, "    정수 조각칸폭 = 최대길이 / 64.").
    줄(L, 서식글("    정수 바탕 = (행 * {머리수} + 머리) * 조각칸폭 * {SH}.")).
    먼이면 {
        줄(L, "    정수 먼묶음 = 먼표[행].").                  (* 이 행의 연속 행이 정수조각어텐션묶음표 로 맡긴 앞쪽 그룹 수 *)
        줄(L, "    정수 먼묶음수 = (최대길이 + 1023) / 1024.").
        줄(L, 서식글("    정수 먼바탕 = (행 * {머리수} + 머리) * 먼묶음수 * {SH}.")).      (* 이 행 · 헤드의 그룹 상태 [그룹][M, L, 빈 둘, O 128] *)
    }
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 w = tid / 32.").
    (* 판(공유 4 KB — 넓 판 12 KB): 무리(조각 128 개 = 묶음 여덟)마다 조각의 M · L [조각], 묶음 안 배율 옛 · 새 [조각], 묶음의 M · 배율
       가 · 나 · 여기까지의 최댓값 [묶음](넓 판은 묶음의 L · O 도). 배율은 스레드들이 나눠(조각마다 — 묶음 안의 앞 조각들의 최댓값은 정확해서
       차례 접기의 큰쪽과 같다), 사슬(곱해더하기)은 스레드 d 마다 차례로.
       GeulPUv2 4b단계 — 예전에는 모든 조각을 판의 고정 칸(조각 160 · 묶음 16)에 두어 위치 10,240 부터 칸이 겹쳤고(값이 틀림) 넓 판은 18 번
       묶음(위치 18,432)부터 공유 12 KB 를 넘었다. 이제 무리를 차례로 돌며 앞 무리들의 묶음 최댓값(이음M — 앞에서부터 차례로 큰쪽, 레지스터)과
       누적 (L, O)만 들고 간다(머리 64 판 — 생성조각.gl 의 정수접기 — 과 같은 꼴). 무리는 늘 묶음 경계에서 나뉘고 모든 곱해더하기 · 적힌지수 ·
       큰쪽의 피연산자와 차례가 예전 판과 같아(조각 128 개 — 위치 8,191 — 까지는 무리 하나로 셈이 한 글자도 다르지 않다) 같은 비트이고,
       길이의 한도는 최대길이뿐이다. 판은 무리 안 번호(c · 첫 · g0 · 묶음 j), 조각칸은 전체 번호(무리바탕 = 바탕 + 무리시작 · SH) — 문서/4b단계.md *)
    정수 무리 = 128.
    (무리 % 16 != 0 또는 무리 > 160 또는 무리 / 16 > 8)이면 {
        파일에_쓰기(표준오류(), "정수조각접기128: 무리는 묶음(조각 16)의 배수 · 판의 칸(조각 160 · 묶음 8) 안이어야 한다\n").
        1로 종료하다.
    }
    넓이면 { 줄(L, "    짧은실수 참조 판 = 공유판12()."). }
    아니면 { 줄(L, "    짧은실수 참조 판 = 공유판4()."). }
    정수 PBB = 704.                   (* F2 — 타일 배율 PB [무리 안 타일] 의 판 자리(넓 판은 묶음 O [720, 1744) 뒤) *)
    넓이면 { PBB = 1760. }
    줄(L, "    짧은실수 L = 0 으로 짧은실수.").
    줄(L, "    짧은실수 O = L.").
    줄(L, "    짧은실수 이음M = L.").                                   (* 앞 무리들의 묶음 최댓값(첫 무리에서는 쓰지 않는다) *)
    문자열 dd = "tid".
    넓이면 {
        dd = "d".
        줄(L, "    정수 d = tid % 128.").
    }
    줄(L, 서식글("    반복 (정수 무리시작 = 0: 무리시작 <= 조각끝: 무리시작 += {무리}) \{")).
    줄(L, "        무리시작 > 0이면 \{ 동기화(). \}").                 (* 앞 무리의 묶음 셈이 판을 다 읽은 뒤에 덮는다 *)
    줄(L, "        정수 무리끝 = 조각끝 - 무리시작.").                 (* 이 무리의 끝 조각(무리 안 번호) *)
    줄(L, 서식글("        무리끝 > {무리 - 1}이면 \{ 무리끝 = {무리 - 1}. \}")).
    줄(L, 서식글("        정수 무리바탕 = 바탕 + 무리시작 * {SH}.")).
    줄(L, 서식글("        반복 (정수 c = tid: c <= 무리끝: c += {T}) \{")).
    먼이면 { 줄(L, "            (무리시작 + c >= 먼묶음 * 16)이면 \{"). }          (* ③c — 앞쪽 그룹의 타일은 읽지 않는다 *)
    줄(L, 서식글("            판[c] = 조각칸[무리바탕 + c * {SH}].")).
    줄(L, 서식글("            판[160 + c] = 조각칸[무리바탕 + c * {SH} + 1].")).
    먼이면 { 줄(L, "            \}"). }
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, 서식글("        반복 (정수 c2 = tid: c2 <= 무리끝: c2 += {T}) \{")).
    먼이면 { 줄(L, "            (무리시작 + c2 >= 먼묶음 * 16)이면 \{"). }
    줄(L, "            정수 첫 = (c2 / 16) * 16.").
    줄(L, "            짧은실수 앞큰 = 판[첫].").
    줄(L, "            반복 (정수 k = 첫 + 1: k < c2: k += 1) \{ 앞큰 = 큰쪽(앞큰, 판[k]). \}").
    줄(L, "            c2 > 첫이면 \{").
    줄(L, "                짧은실수 새큰 = 큰쪽(앞큰, 판[c2]).").
    줄들(L, 큰지수식("판[320 + c2]", "앞큰 - 새큰", "                ", "fa")).
    줄들(L, 큰지수식("판[480 + c2]", "판[c2] - 새큰", "                ", "fb")).
    줄(L, "                앞큰 = 새큰.").
    줄(L, "            \}").
    F2이면 {                          (* F2 — 타일의 배율 PB = fp32(Pf · 나)(그룹의 첫 타일은 Pf) — 칸 2 의 Pf *)
        줄(L, 서식글("            짧은실수 pf = 조각칸[무리바탕 + c2 * {SH} + 2].")).
        줄(L, 서식글("            c2 > 첫이면 \{ 판[{PBB} + c2] = pf * 판[480 + c2]. \}")).
        줄(L, 서식글("            아니면 \{ 판[{PBB} + c2] = pf. \}")).
    }
    줄(L, "            (c2 == 무리끝 또는 c2 % 16 == 15)이면 \{ 판[640 + c2 / 16] = 앞큰. \}").
    먼이면 { 줄(L, "            \}"). }
    줄(L, "        \}").
    먼이면 {                          (* ③c — 앞쪽 그룹의 최댓값은 그룹 상태의 M(타일 최댓값들의 큰쪽 — 위의 앞큰과 같은 값) *)
        줄(L, "        tid <= 무리끝 / 16이면 \{").
        줄(L, "            정수 먼G = 무리시작 / 16 + tid.").
        줄(L, 서식글("            먼G < 먼묶음이면 \{ 판[640 + tid] = 묶음칸[먼바탕 + 먼G * {SH}]. \}")).
        줄(L, "        \}").
    }
    줄(L, "        동기화().").
    (* 묶음끼리의 배율 — 무리 안 묶음 j(전체 묶음 G = 무리시작 / 16 + j). 처음 값은 G = 0 에서만(배율 없음). 앞M 의 사슬은 첫 무리면 판[640]
       에서(h 는 1 부터), 그 뒤 무리는 이음M 에서(h 는 0 부터) — 어느 쪽이든 M₀ … M_{G−1} 을 차례로 큰쪽(예전 판과 같은 차례). 판[688 + j] 는
       묶음 j 까지의 최댓값(무리의 끝 묶음 것이 다음 무리의 이음M) *)
    줄(L, "        정수 무리묶음수 = 무리끝 / 16 + 1.").
    줄(L, "        tid < 무리묶음수이면 \{").
    줄(L, "            (무리시작 == 0 그리고 tid == 0)이면 \{ 판[688] = 판[640]. \}").
    줄(L, "            아니면 \{").
    줄(L, "                짧은실수 앞M = 이음M.").
    줄(L, "                정수 h0 = 0.").
    줄(L, "                무리시작 == 0이면 \{").
    줄(L, "                    앞M = 판[640].").
    줄(L, "                    h0 = 1.").
    줄(L, "                \}").
    줄(L, "                반복 (정수 h = h0: h < tid: h += 1) \{ 앞M = 큰쪽(앞M, 판[640 + h]). \}").
    줄(L, "                짧은실수 새큰2 = 큰쪽(앞M, 판[640 + tid]).").
    줄들(L, 큰지수식("판[656 + tid]", "앞M - 새큰2", "                ", "ga")).
    줄들(L, 큰지수식("판[672 + tid]", "판[640 + tid] - 새큰2", "                ", "gb")).
    줄(L, "                판[688 + tid] = 새큰2.").
    줄(L, "            \}").
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, "        이음M = 판[687 + 무리묶음수].").                     (* 레지스터로 — 다음 무리가 판[688 …] 을 다시 쓴다 *)
    넓이면 {
        줄(L, "        정수 g0 = (tid / 128) * 16.").            (* 묶음마다 스레드 128 이 나란히 — 무리 안 묶음 tid / 128 *)
        줄(L, "        g0 <= 무리끝이면 \{").
    }
    아니면 { 줄(L, "        반복 (정수 g0 = 0: g0 <= 무리끝: g0 += 16) \{"). }
    줄(L, "            정수 g끝 = g0 + 15.").
    줄(L, "            g끝 > 무리끝이면 \{ g끝 = 무리끝. \}").
    먼이면 {                          (* ③c — 앞쪽 그룹은 그룹 상태 그대로(첫 층의 결과와 같은 비트), 그 뒤의 그룹은 예전처럼 타일을 차례로 *)
        줄(L, "            짧은실수 Lg = 0 으로 짧은실수.").
        줄(L, "            짧은실수 Og = Lg.").
        줄(L, "            정수 먼G0 = 무리시작 / 16 + g0 / 16.").
        줄(L, "            먼G0 < 먼묶음이면 \{").
        줄(L, 서식글("                Lg = 묶음칸[먼바탕 + 먼G0 * {SH} + 1].")).
        줄(L, 서식글("                Og = 묶음칸[먼바탕 + 먼G0 * {SH} + 4 + {dd}].")).
        줄(L, "            \}").
        줄(L, "            아니면 \{").
        줄(L, "            Lg = 판[160 + g0].").
        F2이면 { 줄(L, 서식글("            Og = 조각칸[무리바탕 + g0 * {SH} + 4 + {dd}] * 판[{PBB} + g0].")). }   (* F2 — 첫 타일 O = U · Pf *)
        아니면 { 줄(L, 서식글("            Og = 조각칸[무리바탕 + g0 * {SH} + 4 + {dd}].")). }
    }
    아니면 {
        줄(L, "            짧은실수 Lg = 판[160 + g0].").
        F2이면 { 줄(L, 서식글("            짧은실수 Og = 조각칸[무리바탕 + g0 * {SH} + 4 + {dd}] * 판[{PBB} + g0].")). }
        아니면 { 줄(L, 서식글("            짧은실수 Og = 조각칸[무리바탕 + g0 * {SH} + 4 + {dd}].")). }
    }
    줄(L, "            반복 (정수 c0 = g0 + 1: c0 <= g끝: c0 += 8) \{").
    반복 (정수 u는 0부터 8 전까지) {
        줄(L, 서식글("                정수 cc{u} = c0 + {u}.")).
        u > 0이면 { 줄(L, 서식글("                cc{u} > g끝이면 \{ cc{u} = g끝. \}")). }
    }
    반복 (정수 u2는 0부터 8 전까지) { 줄(L, 서식글("                짧은실수 oc{u2} = 조각칸[무리바탕 + cc{u2} * {SH} + 4 + {dd}].")). }
    줄(L, "                Lg = 곱해더하기(판[160 + cc0], 판[480 + cc0], Lg * 판[320 + cc0]).").
    문자열 나칸 = "480".
    F2이면 { 나칸 = 서식글("{PBB}"). }                 (* F2 — O 의 배율은 PB(L 은 나 그대로) *)
    줄(L, 서식글("                Og = 곱해더하기(oc0, 판[{나칸} + cc0], Og * 판[320 + cc0]).")).
    반복 (정수 u3는 1부터 8 전까지) {
        줄(L, 서식글("                c0 + {u3} <= g끝이면 \{")).
        줄(L, 서식글("                    Lg = 곱해더하기(판[160 + cc{u3}], 판[480 + cc{u3}], Lg * 판[320 + cc{u3}]).")).
        줄(L, 서식글("                    Og = 곱해더하기(oc{u3}, 판[{나칸} + cc{u3}], Og * 판[320 + cc{u3}]).")).
        줄(L, "                \}").
    }
    줄(L, "            \}").
    먼이면 { 줄(L, "            \}"). }
    넓이면 {                              (* 묶음 몫을 판에 — L 은 [704 + 묶음 j], O 는 [720 + j · 128 + d](= 720 + tid) — 그 뒤 스레드 128 이 차례로 *)
        줄(L, "            d == 0이면 \{ 판[704 + tid / 128] = Lg. \}").
        줄(L, "            판[720 + tid] = Og.").
        줄(L, "        \}").
        줄(L, "        동기화().").
        줄(L, "        tid < 128이면 \{").
        줄(L, "            반복 (정수 gg = 0: gg < 무리묶음수: gg += 1) \{").
        줄(L, "                (무리시작 == 0 그리고 gg == 0)이면 \{").
        줄(L, "                    L = 판[704].").
        줄(L, "                    O = 판[720 + tid].").
        줄(L, "                \}").
        줄(L, "                아니면 \{").
        줄(L, "                    L = 곱해더하기(판[704 + gg], 판[672 + gg], L * 판[656 + gg]).").
        줄(L, "                    O = 곱해더하기(판[720 + gg * 128 + tid], 판[672 + gg], O * 판[656 + gg]).").
        줄(L, "                \}").
        줄(L, "            \}").
        줄(L, "        \}").
    }
    아니면 {
        줄(L, "            (무리시작 == 0 그리고 g0 == 0)이면 \{").
        줄(L, "                L = Lg.").
        줄(L, "                O = Og.").
        줄(L, "            \}").
        줄(L, "            아니면 \{").
        줄(L, "                정수 gg = g0 / 16.").
        줄(L, "                L = 곱해더하기(Lg, 판[672 + gg], L * 판[656 + gg]).").
        줄(L, "                O = 곱해더하기(Og, 판[672 + gg], O * 판[656 + gg]).").
        줄(L, "            \}").
        줄(L, "        \}").
    }
    줄(L, "    \}").
    넓이면 { 줄(L, "    tid >= 128이면 \{ 반환. \}"). }
    줄(L, "    짧은실수 x = O / L.").
    실수출력이면 {
        줄(L, 서식글("    출력[행 * {질의폭} + 머리 * 128 + tid] = x.")).
        줄(L, "\}").
        반환 L.
    }
    줄(L, "    짧은실수 m = 큰쪽(x, 0.0 - x).").
    반복 (정수 k2 = 1: k2 <= 16: k2 = k2 * 2) { 줄(L, 서식글("    m = 큰쪽(m, 레인에서받기(m, lane ^ {k2})).")). }
    줄들(L, 지수식("    ")).
    줄들(L, 넷자리식("x", "    ", "q")).
    문자열 위치식 = 낱말위치("lane / 4").
    반복 (정수 j는 0부터 자리수 전까지) {
        줄(L, 서식글("    정수 반{j} = (dq{j} & 255) 으로 정수.")).
        줄(L, 서식글("    정수 옆{j}_1 = 정수레인에서받기(반{j}, lane + 1).")).
        줄(L, 서식글("    정수 옆{j}_2 = 정수레인에서받기(반{j}, lane + 2).")).
        줄(L, 서식글("    정수 옆{j}_3 = 정수레인에서받기(반{j}, lane + 3).")).
        줄(L, 서식글("    lane % 4 == 0이면 \{ 자릿값[({j} * 행수 + 행) * {질의폭 / 4} + (머리 * 4 + w) * 8 + {위치식}] = (반{j} | (옆{j}_1 << 8) | (옆{j}_2 << 16) | (옆{j}_3 << 24)) 으로 중간정수. \}")).
    }
    문자열 마법 = 마법수0().
    줄(L, 서식글("    lane == 0이면 \{ 정보[(머리 * 4 + w) * 정보폭 + 행] = {마법}. \}")).
    줄(L, "\}").
    반환 L.
}

(* ---- 줄 판(행 넷까지) — 활성값의 자리를 전역에서 ---- *)
(* 블록 하나(스레드 256)가 열 W 개. 블록 BC 개씩: (가) (열, 블록) 쌍마다(스레드가 쌍 U 개의 가중치 · 척도를 먼저 읽고) 행마다 블록 합 S₀ · S₁
   (dp4a) → u = v₁ + v₀ (마법수 — 정확, 더하기 하나) 를 판에, (나) (행, 열)의 스레드가 y ← 곱해더하기(u, d, y) 를 블록 차례로. 끝손질:
   "" — 출력 = y + 치우침, "_잔차" — 출력 = 잔차 + (y + 치우침), "_SwiGLU정수" (W 64: 열 64 개 = [gate 32 | up 32]) — h = silu(g) · u 의 블록
   하나를 down 의 자리 둘 · 정보로(타일 판의 _SwiGLU정수 와 같은 식) *)
[문자열 epi를 문자열 형식을 정수줄자리]는 -> 문자열목록 참조 {
    참거짓 Q4 = 문자열_같은가(형식, "Q4_0").
    정수 T = 256.
    정수 R = 4.
    정수 U = 4.
    참거짓 스위 = 문자열_같은가(epi, "_SwiGLU정수").
    정수 W = 32.
    정수 BC = 64.
    스위이면 { W = 64. BC = 32. }
    공유32이면 { BC = BC / 2. }           (* 34단계 — 공유 32 KB 장치: 한 번에 올리는 블록을 반으로(사슬의 블록 차례는 그대로) *)
    정수 US = 0.
    정수 SD = R * BC * W.
    정수 VS = SD + BC * W.
    정수 공유 = 공유판크기((VS + R * W) * 4).
    문자열 이름 = 서식글("정수줄자리{epi}").
    문자열 가중 = 가중선언("가중치", "척도").
    문자열 잔차 = "".
    문자열_같은가(epi, "_잔차")이면 { 잔차 = "짧은실수 참조 잔차와 ". }
    문자열 출력부 = "짧은실수 참조 출력에".
    스위이면 { 출력부 = "중간정수 참조 다음정보와 중간정수 참조 다음자리에". }
    문자열 머리 = 서식글("중간정수 참조 자릿값에서 중간정수 참조 정보와 {가중}짧은실수 참조 치우침과 {잔차}{출력부} 정수 행수로 정수 깊이로 정수 열수로").
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("(* 22단계 — 정수 블록 계약의 행렬곱(dp4a) — 줄 판(행 넷까지, 활성값의 자리를 전역에서), 열 {W} 개 · 블록 {BC} 개씩. 끝손질 {epi} *)")).
    줄(L, 서식글("(* 실행한도 {이름} {T} 2 *)")).
    줄(L, 서식글("[{머리} {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 그룹 = 블록가로().").
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{공유}().")).
    줄(L, "    정수 블록수 = 깊이 / 32.").
    줄(L, "    정수 깊이4 = 깊이 / 4.").
    줄(L, "    정수 척도폭 = (열수 + 63) / 64 * 64.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    정수 사행 = tid / {W}.")).
    줄(L, 서식글("    정수 사열 = tid % {W}.")).
    줄(L, 서식글("    정수 열 = 그룹 * {W} + 사열.")).
    줄(L, "    짧은실수 y = 0 으로 짧은실수.").
    줄(L, 서식글("    반복 (정수 첫블록 = 0: 첫블록 < 블록수: 첫블록 += {BC}) \{")).
    줄(L, "        정수 bn = 블록수 - 첫블록.").
    줄(L, 서식글("        bn > {BC}이면 \{ bn = {BC}. \}")).
    줄(L, 서식글("        반복 (정수 쌍0 = tid: 쌍0 < bn * {W}: 쌍0 += {T * U}) \{")).
    문자열 I = "            ".
    반복 (정수 i는 0부터 U 전까지) {
        줄(L, 서식글("{I}정수 p{i} = 쌍0 + {T * i}.")).
        줄(L, 서식글("{I}정수 쓰{i} = 1.")).
        줄(L, 서식글("{I}p{i} >= bn * {W}이면 \{ p{i} = bn * {W} - 1. 쓰{i} = 0. \}")).
        줄(L, 서식글("{I}정수 nl{i} = p{i} % {W}.")).
        줄(L, 서식글("{I}정수 bl{i} = p{i} / {W}.")).
        줄(L, 서식글("{I}정수 b{i} = 첫블록 + bl{i}.")).
        줄(L, 서식글("{I}정수 n{i} = 그룹 * {W} + nl{i}.")).
        줄(L, 서식글("{I}n{i} >= 열수이면 \{ n{i} = 열수 - 1. \}")).
        Q4이면 {                       (* Q4_0 — 열마다 낱말 넷(니블), 바이트마다 부호 있는 q 로 *)
            줄(L, 서식글("{I}정수 wb{i} = (b{i} * 열수 + n{i}) * 4.")).
            반복 (정수 k4는 0부터 4 전까지) {
                줄(L, 서식글("{I}중간정수 ww{i}_{k4} = 가중치[wb{i} + {k4}].")).
                문자열 lo = 서식글("ww{i}_{k4} & 252645135").
                문자열 hi = 서식글("(ww{i}_{k4} >> 4) & 252645135").
                줄(L, 서식글("{I}중간정수 wq{i}_{2 * k4} = {니블부호(lo)}.")).
                줄(L, 서식글("{I}중간정수 wq{i}_{2 * k4 + 1} = {니블부호(hi)}.")).
            }
        }
        아니면 {
            줄(L, 서식글("{I}정수 wb{i} = (b{i} * 열수 + n{i}) * 8.")).
            반복 (정수 q는 0부터 8 전까지) { 줄(L, 서식글("{I}중간정수 wq{i}_{q} = 가중치[wb{i} + {q}].")). }
        }
        줄(L, 서식글("{I}짧은실수 sc{i} = 척도[b{i} * 척도폭 + n{i}].")).
    }
    반복 (정수 i2는 0부터 U 전까지) {
        줄(L, 서식글("{I}쓰{i2} == 1이면 \{ 판[{SD} + bl{i2} * {W} + nl{i2}] = sc{i2}. \}")).
        반복 (정수 r는 0부터 R 전까지) {
            줄(L, 서식글("{I}{r} < 행수이면 \{")).
            반복 (정수 j는 0부터 자리수 전까지) {
                반복 (정수 q2는 0부터 8 전까지) {
                    문자열 pos = 서식글("{(q2 % 4) * 2 + q2 / 4}").
                    줄(L, 서식글("{I}    중간정수 x{j}_{q2} = 자릿값[({j} * 행수 + {r}) * 깊이4 + b{i2} * 8 + {pos}].")).
                }
                줄(L, 서식글("{I}    중간정수 S{j} = 0.")).
                반복 (정수 q3는 0부터 8 전까지) { 줄(L, 서식글("{I}    S{j} = 바이트넷곱더하기(x{j}_{q3}, wq{i2}_{q3}, S{j}).")). }
            }
            줄(L, 서식글("{I}    중간정수 M0 = 정보[b{i2} * 정보폭 + {r}].")).
            문자열 v1 = 마법v("M0", "S1", 1).
            문자열 v0 = 마법v("M0", "S0", 0).
            문자열 합v = 서식글("{v1} + {v0}").
            자리수 == 1이면 { 합v = v0. }                         (* 33단계 — 자리 하나면 v₀ 만 *)
            줄(L, 서식글("{I}    쓰{i2} == 1이면 \{ 판[{US} + ({r} * {BC} + bl{i2}) * {W} + nl{i2}] = {합v}. \}")).
            줄(L, 서식글("{I}\}")).
        }
    }
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, 서식글("        (tid < 행수 * {W} 그리고 열 < 열수)이면 \{")).
    (* 사슬 — 여덟씩 미리 읽고 차례로 곱해더하기(블록 차례 그대로) *)
    줄(L, "            반복 (정수 c0 = 0: c0 < bn: c0 += 8) \{").
    반복 (정수 a는 0부터 8 전까지) {
        줄(L, 서식글("                정수 cc{a} = c0 + {a}.")).
        a > 0이면 { 줄(L, 서식글("                cc{a} >= bn이면 \{ cc{a} = bn - 1. \}")). }
    }
    반복 (정수 a2는 0부터 8 전까지) {
        줄(L, 서식글("                짧은실수 uu{a2} = 판[{US} + (사행 * {BC} + cc{a2}) * {W} + 사열].")).
        줄(L, 서식글("                짧은실수 dd{a2} = 판[{SD} + cc{a2} * {W} + 사열].")).
    }
    줄(L, "                y = 곱해더하기(uu0, dd0, y).").
    반복 (정수 a3는 1부터 8 전까지) { 줄(L, 서식글("                c0 + {a3} < bn이면 \{ y = 곱해더하기(uu{a3}, dd{a3}, y). \}")). }
    줄(L, "            \}").
    줄(L, "        \}").
    줄(L, "        동기화().").
    줄(L, "    \}").
    아닌 스위이면 {
        줄(L, 서식글("    (tid < 행수 * {W} 그리고 열 < 열수)이면 \{")).
        줄(L, "        짧은실수 v = y + 치우침[열].").
        문자열_같은가(epi, "_잔차")이면 { 줄(L, "        출력[사행 * 열수 + 열] = 잔차[사행 * 열수 + 열] + v."). }
        아니면 { 줄(L, "        출력[사행 * 열수 + 열] = v."). }
        줄(L, "    \}").
        줄(L, "\}").
        반환 L.
    }
    (* _SwiGLU정수: 열 64 개 = [gate 32 | up 32] → h 32 개(블록 그룹) — 행마다 워프 하나(tid = 행 · 64 + i, i < 32) *)
    줄(L, "    짧은실수 v = 0 으로 짧은실수.").
    줄(L, 서식글("    (tid < 행수 * {W} 그리고 열 < 열수)이면 \{ v = y + 치우침[열]. \}")).
    줄(L, 서식글("    판[{VS} + tid] = v.")).
    줄(L, "    동기화().").
    줄(L, "    (사열 < 32 그리고 사행 < 행수)이면 \{").
    줄(L, 서식글("        짧은실수 gg = 판[{VS} + 사행 * 64 + 사열].")).
    줄(L, 서식글("        짧은실수 uu = 판[{VS} + 사행 * 64 + 32 + 사열].")).
    줄들(L, SwiGLU식("x", "gg", "uu", "        ", "s")).
    줄(L, "        짧은실수 m = 큰쪽(x, 0.0 - x).").
    반복 (정수 k2 = 1: k2 <= 16: k2 = k2 * 2) { 줄(L, 서식글("        m = 큰쪽(m, 레인에서받기(m, lane ^ {k2})).")). }
    줄들(L, 지수식("        ")).
    줄들(L, 넷자리식("x", "        ", "q")).
    문자열 위치식 = 낱말위치("lane / 4").
    반복 (정수 j2는 0부터 자리수 전까지) {
        줄(L, 서식글("        정수 반{j2} = (dq{j2} & 255) 으로 정수.")).
        줄(L, 서식글("        정수 옆{j2}_1 = 정수레인에서받기(반{j2}, lane + 1).")).
        줄(L, 서식글("        정수 옆{j2}_2 = 정수레인에서받기(반{j2}, lane + 2).")).
        줄(L, 서식글("        정수 옆{j2}_3 = 정수레인에서받기(반{j2}, lane + 3).")).
        줄(L, 서식글("        lane % 4 == 0이면 \{ 다음자리[({j2} * 행수 + 사행) * (열수 / 8) + 그룹 * 8 + {위치식}] = (반{j2} | (옆{j2}_1 << 8) | (옆{j2}_2 << 16) | (옆{j2}_3 << 24)) 으로 중간정수. \}")).
    }
    문자열 마법 = 마법수0().
    줄(L, 서식글("        lane == 0이면 \{ 다음정보[그룹 * 정보폭 + 사행] = {마법}. \}")).
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* ---- 23단계 — 생성의 RMS(행 하나 — 블록 하나, 스레드 256): RMS정규화정수줄(14단계)과 같은 식 · 같은 차례. 다른 것은 읽기의 자리뿐 —
   입력 · 감마를 먼저 다 읽고(스레드마다 D/256 개) 차례대로 더한다(부분합 · 접기의 차례 그대로). 너비가 256 의 배수일 때(7B 모듈) *)
[RMS정규화정수줄펼침]는 -> 문자열목록 참조 {
    정수 D = 너비.
    정수 KB = 너비 / 32.
    정수 n = D / 256.
    정수 공유 = 공유판크기((D + 256) * 4).
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 23단계 — RMSNorm + 정수 블록 계약의 활성값 바꾸기(생성 — 읽기를 앞으로): 블록 하나가 한 행(256 스레드). RMS정규화정수줄과 같은 식 *)").
    줄(L, "[짧은실수 참조 입력에서 짧은실수 참조 감마와 중간정수 참조 자릿값에 중간정수 참조 정보에 정수 행수로 RMS정규화정수줄펼침]는 \{").
    줄(L, "    정수 행 = 블록가로().").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{공유}().")).
    줄(L, 서식글("    정수 바탕 = 행 * {D}.")).
    반복 (정수 k는 0부터 n 전까지) { 줄(L, 서식글("    짧은실수 xc{k} = 입력[바탕 + tid + {256 * k}].")). }
    반복 (정수 k2는 0부터 n 전까지) { 줄(L, 서식글("    짧은실수 gm{k2} = 감마[tid + {256 * k2}].")). }
    줄(L, "    짧은실수 부분 = 0 으로 짧은실수.").
    반복 (정수 k3는 0부터 n 전까지) { 줄(L, 서식글("    부분 += xc{k3} * xc{k3}.")). }
    줄(L, 서식글("    판[{D} + tid] = 부분.")).
    줄(L, "    동기화().").
    줄(L, "    반복 (정수 접기 = 128: 접기 > 0: 접기 /= 2) \{").
    줄(L, 서식글("        tid < 접기이면 \{ 판[{D} + tid] = 판[{D} + tid] + 판[{D} + tid + 접기]. \}")).
    줄(L, "        동기화().").
    줄(L, "    \}").
    줄(L, 서식글("    짧은실수 역rms = 1.0 / 제곱근(판[{D}] / {D}.0 + {RMS_eps}).")).
    반복 (정수 k4는 0부터 n 전까지) { 줄(L, 서식글("    판[tid + {256 * k4}] = (xc{k4} * 역rms) * gm{k4}.")). }
    줄(L, "    동기화().").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    반복 (정수 bb = 0: bb < {KB}: bb += 32) \{")).
    줄(L, "        정수 b0 = bb + tid / 8.").
    줄(L, "        정수 b = b0.").
    줄(L, 서식글("        b >= {KB}이면 \{ b = {KB - 1}. \}")).
    줄들(L, 블록바꾸기몸("판[b * 32 + (lane % 8) * 4 + @]", "정수 자@ = 0. 자@", 서식글("b0 < {KB}이면 \{ 정보[b * 정보폭 + 행] = @. \}"), "        ")).
    줄(L, 서식글("        b0 < {KB}이면 \{")).
    반복 (정수 j는 0부터 자리수 전까지) {
        줄(L, 서식글("            자릿값[({j} * 행수 + 행) * {D / 4} + b * 8 + (lane % 4) * 2 + (lane % 8) / 4] = 자{j}.")).
    }
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}

(* ---- 23단계 — 한 행 줄 판(생성 그래프): 가중치 · 척도 · 활성값의 자리를 비동기 복사의 판 S 개로 미리 올린다 ----
   블록 하나(스레드 128)가 열 W 개(SwiGLU 64 — [gate 32 | up 32]). 판 하나 = 블록 BK 개 × 열 W 개. 판 s 를 기다린 뒤 판 s + S − 1 의
   복사를 먼저 띄우고(메모리가 쉬지 않게), (가) 스레드마다 블록 하나의 열 P 개(c, c + TPK, …)의 정확한 블록 합 S₀ · S₁ (dp4a — Q4_0 은
   니블(q + 8)을 그대로 곱하고 8 · ΣD 를 뺀다: 정수라 값이 같다) → u = v₁ + v₀ 와 척도 d 를 짝판(둘)에, (나) 열의 스레드(tid < W)가
   판 s − 1 의 짝으로 y ← 곱해더하기(u, d, y) — 블록 차례 그대로. 끝손질은 정수줄자리(행 하나)와 같다 — 계약이 같아 비트까지 같다. *)
정수 줄하나BUF = 0.
정수 줄하나OM = 0.

(* 판 st(식)의 복사를 판 자리 bb(식)에 — 가중치 NV 개 · 척도(tid < NCS) · 활성값의 자리(NCS ≤ tid < NCS + NCX) *)
[문자열 st를 문자열 bb를 문자열 ind를 정수 NV를 정수 T를 정수 BK를 정수 NCS를 정수 NCX를 줄하나올리기]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}정수 올바탕 = ({bb}) * {줄하나BUF}.")).
    줄(o, 서식글("{ind}정수 kb바탕 = ({st}) * {BK}.")).
    반복 (정수 v는 0부터 NV 전까지) {
        줄(o, 서식글("{ind}(kb바탕 + wk{v} < 블록수 그리고 wc{v} < 열수)이면 \{ 비동기복사16(판 에, 올바탕 + tid * 4 + {T * 4 * v} 를, 가중넓 에서, ({st}) * 판걸음 + wg{v} 로). \}")).
    }
    줄(o, 서식글("{ind}tid < {NCS}이면 \{")).
    줄(o, 서식글("{ind}    kb바탕 + sk < 블록수이면 \{ 비동기복사16(판 에, 올바탕 + so 를, 척도넓 에서, kb바탕 * (척도폭 / 2) + sg 로). \}")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}아니면 tid < {NCS + NCX}이면 \{")).
    줄(o, 서식글("{ind}    kb바탕 + xk < 블록수이면 \{ 비동기복사16(판 에, 올바탕 + xo 를, 자리넓 에서, kb바탕 * 8 + xg 로). \}")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}아니면 tid < {NCS + NCX + BK}이면 \{")).
    줄(o, 서식글("{ind}    kb바탕 + mk < 블록수이면 \{ 비동기복사(판 에, 올바탕 + {줄하나OM} + mk 를, 정보넓 에서, (kb바탕 + mk) * 정보폭 로). \}")).
    줄(o, 서식글("{ind}\}")).
    반환 o.
}

(* 34단계 — Vulkan(협력 모듈)에는 비동기 복사가 없어 복사의 지연이 그대로 드러난다. 판 st 를 단의 처음에 레지스터로 읽고(넓게읽기 — 16 바이트를
   한 번에), 셈 뒤에 판 자리 bb 에 쓴다(넓게쓰기) — 읽기의 지연이 이 단의 셈 뒤에 숨는다. 같은 바이트 · 같은 자리 *)
[문자열 st를 문자열 ind를 정수 NV를 정수 BK를 정수 NCS를 정수 NCX를 줄하나읽기]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}rkb = ({st}) * {BK}.")).
    반복 (정수 v는 0부터 NV 전까지) {
        줄(o, 서식글("{ind}(rkb + wk{v} < 블록수 그리고 wc{v} < 열수)이면 \{")).
        줄(o, 서식글("{ind}    정수 ri{v} = ({st}) * 판걸음 + wg{v}.")).
        줄(o, 서식글("{ind}    ra{v} = 넓게읽기(0, 가중넓 에서, ri{v} 로).")).
        줄(o, 서식글("{ind}    rb{v} = 넓게읽기(1, 가중넓 에서, ri{v} 로).")).
        줄(o, 서식글("{ind}\}")).
    }
    줄(o, 서식글("{ind}(tid < {NCS} 그리고 rkb + sk < 블록수)이면 \{")).
    줄(o, 서식글("{ind}    정수 ris = rkb * (척도폭 / 2) + sg.")).
    줄(o, 서식글("{ind}    rs = 넓게읽기(0, 척도넓 에서, ris 로).")).
    줄(o, 서식글("{ind}    rt = 넓게읽기(1, 척도넓 에서, ris 로).")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}(tid >= {NCS} 그리고 tid < {NCS + NCX} 그리고 rkb + xk < 블록수)이면 \{")).
    줄(o, 서식글("{ind}    정수 rix = rkb * 8 + xg.")).
    줄(o, 서식글("{ind}    rx = 넓게읽기(0, 자리넓 에서, rix 로).")).
    줄(o, 서식글("{ind}    ry = 넓게읽기(1, 자리넓 에서, rix 로).")).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}(tid >= {NCS + NCX} 그리고 tid < {NCS + NCX + BK} 그리고 rkb + mk < 블록수)이면 \{ rm = 정보넓[(rkb + mk) * 정보폭]. \}")).
    반환 o.
}

[문자열 bb를 문자열 ind를 정수 NV를 정수 T를 정수 BK를 정수 NCS를 정수 NCX를 줄하나쓰기]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}정수 올바탕w = ({bb}) * {줄하나BUF}.")).
    반복 (정수 v는 0부터 NV 전까지) {
        줄(o, 서식글("{ind}(rkb + wk{v} < 블록수 그리고 wc{v} < 열수)이면 \{ 넓게쓰기(판, 올바탕w + tid * 4 + {T * 4 * v}, ra{v}, rb{v}). \}")).
    }
    줄(o, 서식글("{ind}(tid < {NCS} 그리고 rkb + sk < 블록수)이면 \{ 넓게쓰기(판, 올바탕w + so, rs, rt). \}")).
    줄(o, 서식글("{ind}(tid >= {NCS} 그리고 tid < {NCS + NCX} 그리고 rkb + xk < 블록수)이면 \{ 넓게쓰기(판, 올바탕w + xo, rx, ry). \}")).
    줄(o, 서식글("{ind}(tid >= {NCS + NCX} 그리고 tid < {NCS + NCX + BK} 그리고 rkb + mk < 블록수)이면 \{ 판[올바탕w + {줄하나OM} + mk] = rm. \}")).
    반환 o.
}

(* 사슬 — 짝판 e(식)의 블록 BK 개를 차례로(블록 kb0(식) + k < 블록수 만) *)
[문자열 e를 문자열 kb0을 문자열 접을 문자열 ind를 정수 BK를 정수 W를 줄하나사슬]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    반복 (정수 k는 0부터 BK 전까지) {
        줄(o, 서식글("{ind}짧은실수 {접}u{k} = 판[{e} + {k * W * 2}].")).
        줄(o, 서식글("{ind}짧은실수 {접}d{k} = 판[{e} + {k * W * 2 + 1}].")).
    }
    줄(o, 서식글("{ind}y = 곱해더하기({접}u0, {접}d0, y).")).
    반복 (정수 k2는 1부터 BK 전까지) { 줄(o, 서식글("{ind}{kb0} + {k2} < 블록수이면 \{ y = 곱해더하기({접}u{k2}, {접}d{k2}, y). \}")). }
    반환 o.
}

[문자열 epi를 문자열 형식을 정수줄하나]는 -> 문자열목록 참조 {
    참거짓 Q4 = 문자열_같은가(형식, "Q4_0").
    참거짓 스위 = 문자열_같은가(epi, "_SwiGLU정수").
    정수 T = 128.
    정수 W = 32.
    스위이면 { W = 64. }
    정수 BW = 8.                          (* 열 하나 · 블록 하나의 가중치 낱말 *)
    Q4이면 { BW = 4. }
    정수 BK = 8.
    (아닌 Q4 그리고 스위)이면 { BK = 4. }
    정수 P = BK * W / T.                  (* 스레드마다 같은 블록의 열 *)
    정수 TPK = W / P.                     (* 블록 하나를 맡는 스레드 *)
    정수 S = 4.
    (아닌 Q4 그리고 아닌 스위)이면 { S = 3. }
    (공유32 그리고 스위)이면 {            (* 34단계 — 공유 32 KB 장치: 미리 올리는 판을 줄인다(사슬의 블록 차례는 그대로) *)
        S = 3.
        Q4이면 { S = 2. }
    }
    정수 OS = BK * W * BW.                (* 판 안: 가중치 [블록][열][BW] · 척도 [블록][열](반실수) · 자리 [블록][자리 둘][낱말 8] *)
    정수 OX = OS + BK * W / 2.
    정수 OM = OX + BK * 8 * 자리수.       (* 블록마다 마법수 M0 (정보 — 4 바이트 비동기 복사) *)
    정수 BUF = OM + (BK + 3) / 4 * 4.
    정수 OU = S * BUF.                    (* 짝판 [둘][블록][열][u, d] *)
    정수 UDS = BK * W * 2.
    정수 VS = OU + 2 * UDS.               (* SwiGLU — 열 W 개의 v *)
    정수 끝 = VS.
    스위이면 { 끝 = VS + W. }
    정수 공유 = 공유판크기(끝 * 4).
    정수 한도 = 99 / 공유.
    한도 > 4이면 { 한도 = 4. }
    정수 WR = W * BW / 4.                 (* 블록 하나의 가중치 복사(16 바이트) *)
    정수 NV = BK * WR / T.
    정수 SR = W / 8.                      (* 블록 하나의 척도 복사 *)
    정수 NCS = BK * SR.
    정수 NCX = BK * 2 * 자리수.           (* 블록마다 자리 둘 × 32 바이트 (33단계 — 자리 하나면 32 바이트) *)
    줄하나BUF = BUF.
    줄하나OM = OM.
    문자열 이름 = 서식글("정수줄하나{epi}").
    문자열 가중 = 가중선언("가중치", "척도").
    문자열 잔차 = "".
    문자열_같은가(epi, "_잔차")이면 { 잔차 = "짧은실수 참조 잔차와 ". }
    문자열 출력부 = "짧은실수 참조 출력에".
    스위이면 { 출력부 = "중간정수 참조 다음정보와 중간정수 참조 다음자리에". }
    문자열 머리 = 서식글("중간정수 참조 자릿값에서 중간정수 참조 정보와 {가중}짧은실수 참조 치우침과 {잔차}{출력부} 정수 행수로 정수 깊이로 정수 열수로").
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("(* 23단계 — 정수 블록 계약의 행렬곱(dp4a) — 한 행 줄 판, 열 {W} 개 · 판 {S} 개(블록 {BK} 개씩, 비동기 복사). 끝손질 {epi} *)")).
    줄(L, 서식글("(* 실행한도 {이름} {T} {한도} *)")).
    줄(L, 서식글("[{머리} {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 그룹 = 블록가로().").
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{공유}().")).
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    반실수 참조 판h = 판 으로 반실수 참조.").
    줄(L, "    짧은실수 참조 자리넓 = 자릿값 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 가중넓 = 가중치 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 척도넓 = 척도 으로 짧은실수 참조.").
    줄(L, "    정수 블록수 = 깊이 / 32.").
    줄(L, "    정수 깊이4 = 깊이 / 4.").
    줄(L, "    정수 척도폭 = (열수 + 63) / 64 * 64.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    줄(L, 서식글("    정수 단수 = (블록수 + {BK - 1}) / {BK}.")).
    줄(L, 서식글("    정수 열0 = 그룹 * {W}.")).
    줄(L, 서식글("    정수 판걸음 = 열수 * {BK * BW}.")).
    반복 (정수 v는 0부터 NV 전까지) {
        줄(L, 서식글("    정수 wk{v} = (tid + {T * v}) / {WR}.")).
        줄(L, 서식글("    정수 wr{v} = (tid + {T * v}) % {WR}.")).
        줄(L, 서식글("    정수 wc{v} = 열0 + wr{v} * 4 / {BW}.")).
        줄(L, 서식글("    정수 wg{v} = (wk{v} * 열수 + 열0) * {BW} + wr{v} * 4.")).
    }
    줄(L, 서식글("    정수 sk = tid / {SR}.")).
    줄(L, 서식글("    정수 so = {OS} + sk * {W / 2} + (tid % {SR}) * 4.")).
    줄(L, 서식글("    정수 sg = sk * (척도폭 / 2) + 열0 / 2 + (tid % {SR}) * 4.")).
    줄(L, 서식글("    정수 xa = tid - {NCS}.")).
    줄(L, "    xa < 0이면 \{ xa = 0. \}").
    자리수 == 1이면 {                     (* 33단계 — 자리 하나: 블록마다 16 바이트 조각 둘 *)
        줄(L, "    정수 xk = xa / 2.").
        줄(L, 서식글("    정수 xo = {OX} + xk * 8 + (xa % 2) * 4.")).
        줄(L, "    정수 xg = xk * 8 + (xa % 2) * 4.").
    }
    아니면 {
        줄(L, "    정수 xk = xa / 4.").
        줄(L, 서식글("    정수 xo = {OX} + xk * 16 + ((xa / 2) % 2) * 8 + (xa % 2) * 4.")).
        줄(L, "    정수 xg = ((xa / 2) % 2) * 깊이4 + xk * 8 + (xa % 2) * 4.").
    }
    줄(L, 서식글("    정수 mk = tid - {NCS + NCX}.")).
    줄(L, "    mk < 0이면 \{ mk = 0. \}").
    줄(L, "    짧은실수 참조 정보넓 = 정보 으로 짧은실수 참조.").
    줄(L, 서식글("    정수 ck = tid / {TPK}.")).
    줄(L, 서식글("    정수 cc = tid % {TPK}.")).
    줄(L, "    짧은실수 y = 0 으로 짧은실수.").
    반복 (정수 s0는 0부터 S - 1 전까지) {
        줄(L, 서식글("    {s0} < 단수이면 \{")).
        줄들(L, 줄하나올리기(서식글("{s0}"), 서식글("{s0}"), "        ", NV, T, BK, NCS, NCX)).
        줄(L, "    \}").
        줄(L, "    비동기묶기().").
    }
    줄(L, "    반복 (정수 s = 0: s < 단수: s += 1) \{").
    줄(L, 서식글("        비동기기다리기({S - 2}).")).
    줄(L, "        동기화().").
    협력판이면 {                                    (* 34단계 — Vulkan: 다음 판을 레지스터로 읽고, 쓰기는 셈 뒤(줄하나읽기 · 줄하나쓰기) *)
        줄(L, "        정수 rkb = 0.").
        반복 (정수 v0는 0부터 NV 전까지) { 줄(L, 서식글("        정수 ra{v0} = 0. 정수 rb{v0} = 0.")). }
        줄(L, "        정수 rs = 0. 정수 rt = 0. 정수 rx = 0. 정수 ry = 0.").
        줄(L, "        짧은실수 rm = 0 으로 짧은실수.").
        줄(L, 서식글("        s + {S - 1} < 단수이면 \{")).
        줄들(L, 줄하나읽기(서식글("s + {S - 1}"), "            ", NV, BK, NCS, NCX)).
        줄(L, "        \}").
    }
    아니면 {
        줄(L, 서식글("        s + {S - 1} < 단수이면 \{")).
        줄들(L, 줄하나올리기(서식글("s + {S - 1}"), 서식글("(s + {S - 1}) % {S}"), "            ", NV, T, BK, NCS, NCX)).
        줄(L, "        \}").
        줄(L, "        비동기묶기().").
    }
    (* (가) 판 s 의 쌍 — 활성값의 자리는 판 안의 자리 차례(낱말위치)대로 읽어 넷씩 묶인다 *)
    문자열 I = "        ".
    줄(L, 서식글("{I}정수 BB = (s % {S}) * {BUF}.")).
    줄(L, 서식글("{I}정수 e = {OU} + (s % 2) * {UDS}.")).
    줄(L, 서식글("{I}정수 kb = s * {BK} + ck.")).
    줄(L, 서식글("{I}정수 BX = BB + {OX} + ck * {8 * 자리수}.")).
    반복 (정수 j는 0부터 자리수 전까지) {
        반복 (정수 pz는 0부터 8 전까지) {
            정수 qi = pz / 2.
            pz % 2 == 1이면 { qi = 4 + pz / 2. }
            줄(L, 서식글("{I}중간정수 x{j}_{qi} = 판i[BX + {j * 8 + pz}].")).
        }
    }
    줄(L, 서식글("{I}중간정수 M0 = 판i[BB + {OM} + ck].")).
    Q4이면 {
        반복 (정수 j2는 0부터 자리수 전까지) {
            줄(L, 서식글("{I}중간정수 합{j2} = 0.")).
            반복 (정수 i2는 0부터 8 전까지) { 줄(L, 서식글("{I}합{j2} = 바이트넷곱더하기(x{j2}_{i2}, 16843009, 합{j2}).")). }
            줄(L, 서식글("{I}중간정수 빼{j2} = 0 - 합{j2} * 8.")).
        }
    }
    반복 (정수 p는 0부터 P 전까지) {
        줄(L, 서식글("{I}정수 cl{p} = ck * {W} + cc + {TPK * p}.")).
        줄(L, 서식글("{I}정수 cw{p} = BB + cl{p} * {BW}.")).
        Q4이면 {
            반복 (정수 k4는 0부터 4 전까지) { 줄(L, 서식글("{I}중간정수 ww{p}_{k4} = 판i[cw{p} + {k4}].")). }
        }
        아니면 {
            반복 (정수 q는 0부터 8 전까지) { 줄(L, 서식글("{I}중간정수 wq{p}_{q} = 판i[cw{p} + {q}].")). }
        }
        반복 (정수 j3는 0부터 자리수 전까지) {
            Q4이면 { 줄(L, 서식글("{I}중간정수 S{p}_{j3} = 빼{j3}.")). }
            아니면 { 줄(L, 서식글("{I}중간정수 S{p}_{j3} = 0.")). }
            반복 (정수 i3는 0부터 8 전까지) {
                문자열 wv = 서식글("wq{p}_{i3}").
                Q4이면 {
                    i3 % 2 == 0이면 { wv = 서식글("(ww{p}_{i3 / 2} & 252645135)"). }
                    아니면 { wv = 서식글("((ww{p}_{i3 / 2} >> 4) & 252645135)"). }
                }
                줄(L, 서식글("{I}S{p}_{j3} = 바이트넷곱더하기(x{j3}_{i3}, {wv}, S{p}_{j3}).")).
            }
        }
        줄(L, 서식글("{I}짧은실수 sc{p} = 판h[(BB + {OS}) * 2 + cl{p}].")).
        문자열 v0 = 마법v("M0", 서식글("S{p}_0"), 0).
        자리수 == 1이면 { 줄(L, 서식글("{I}판[e + cl{p} * 2] = {v0}.")). }          (* 33단계 — 자리 하나 *)
        아니면 {
            문자열 v1 = 마법v("M0", 서식글("S{p}_1"), 1).
            줄(L, 서식글("{I}판[e + cl{p} * 2] = {v1} + {v0}.")).
        }
        줄(L, 서식글("{I}판[e + cl{p} * 2 + 1] = sc{p}.")).
    }
    (* (나) 판 s − 1 의 사슬 *)
    줄(L, 서식글("{I}(tid < {W} 그리고 s > 0)이면 \{")).
    줄(L, 서식글("{I}    정수 e2 = {OU} + ((s - 1) % 2) * {UDS} + tid * 2.")).
    줄(L, 서식글("{I}    정수 kb2 = (s - 1) * {BK}.")).
    줄들(L, 줄하나사슬("e2", "kb2", "c", 서식글("{I}    "), BK, W)).
    줄(L, 서식글("{I}\}")).
    협력판이면 {
        줄(L, 서식글("{I}s + {S - 1} < 단수이면 \{")).
        줄들(L, 줄하나쓰기(서식글("(s + {S - 1}) % {S}"), 서식글("{I}    "), NV, T, BK, NCS, NCX)).
        줄(L, 서식글("{I}\}")).
    }
    줄(L, "    \}").
    줄(L, "    동기화().").
    줄(L, 서식글("    tid < {W}이면 \{")).
    줄(L, 서식글("        정수 e3 = {OU} + ((단수 - 1) % 2) * {UDS} + tid * 2.")).
    줄(L, 서식글("        정수 kb3 = (단수 - 1) * {BK}.")).
    줄들(L, 줄하나사슬("e3", "kb3", "f", "        ", BK, W)).
    줄(L, "    \}").
    줄(L, "    정수 열 = 열0 + tid.").
    아닌 스위이면 {
        줄(L, 서식글("    (tid < {W} 그리고 열 < 열수)이면 \{")).
        줄(L, "        짧은실수 v = y + 치우침[열].").
        문자열_같은가(epi, "_잔차")이면 { 줄(L, "        출력[열] = 잔차[열] + v."). }
        아니면 { 줄(L, "        출력[열] = v."). }
        줄(L, "    \}").
        줄(L, "\}").
        반환 L.
    }
    (* _SwiGLU정수: 열 64 개 = [gate 32 | up 32] → h 32 개(블록 그룹) — 워프 하나 (정수줄자리의 행 하나와 같은 식) *)
    줄(L, "    짧은실수 v = 0 으로 짧은실수.").
    줄(L, 서식글("    (tid < {W} 그리고 열 < 열수)이면 \{ v = y + 치우침[열]. \}")).
    줄(L, 서식글("    tid < {W}이면 \{ 판[{VS} + tid] = v. \}")).
    줄(L, "    동기화().").
    줄(L, "    tid < 32이면 \{").
    줄(L, 서식글("        짧은실수 gg = 판[{VS} + tid].")).
    줄(L, 서식글("        짧은실수 uu = 판[{VS} + 32 + tid].")).
    줄들(L, SwiGLU식("x", "gg", "uu", "        ", "s")).
    줄(L, "        짧은실수 m = 큰쪽(x, 0.0 - x).").
    반복 (정수 k2 = 1: k2 <= 16: k2 = k2 * 2) { 줄(L, 서식글("        m = 큰쪽(m, 레인에서받기(m, lane ^ {k2})).")). }
    줄들(L, 지수식("        ")).
    줄들(L, 넷자리식("x", "        ", "q")).
    문자열 위치식 = 낱말위치("lane / 4").
    반복 (정수 j4는 0부터 자리수 전까지) {
        줄(L, 서식글("        정수 반{j4} = (dq{j4} & 255) 으로 정수.")).
        줄(L, 서식글("        정수 옆{j4}_1 = 정수레인에서받기(반{j4}, lane + 1).")).
        줄(L, 서식글("        정수 옆{j4}_2 = 정수레인에서받기(반{j4}, lane + 2).")).
        줄(L, 서식글("        정수 옆{j4}_3 = 정수레인에서받기(반{j4}, lane + 3).")).
        줄(L, 서식글("        lane % 4 == 0이면 \{ 다음자리[({j4} * 행수) * (열수 / 8) + 그룹 * 8 + {위치식}] = (반{j4} | (옆{j4}_1 << 8) | (옆{j4}_2 << 16) | (옆{j4}_3 << 24)) 으로 중간정수. \}")).
    }
    문자열 마법 = 마법수0().
    줄(L, 서식글("        lane == 0이면 \{ 다음정보[그룹 * 정보폭] = {마법}. \}")).
    줄(L, "    \}").
    줄(L, "\}").
    반환 L.
}
