(* GeulPU 34단계 — 커널 생성기: 협력 행렬(Vulkan · SPV_KHR_cooperative_matrix)의 정수 타일 판. 커널생성 … --협력 이 켠다.
   정수타일선형(생성타일.gl)과 같은 판 표 · 같은 이름 · 같은 매개변수 · 같은 스레드의 칸 · 같은 끝손질(정수타일끝)이다. 다른 것은
   블록마다의 정수 곱이다.
   - 판(공유 메모리)에 A(활성값의 자리 — 행 먼저, 줄 사이 48 바이트)와 B(가중치 — 열 먼저, 깊이 차례, 열 사이 48 바이트)를 둔다.
     가중치는 텐서곱 조각의 차례로 섞어 저장되어 있어(낱말 i 가 깊이 낱말 (i % 4) · 2 + i / 4) 판에 올릴 때 푼다 — Q8_0 은 낱말씩
     복사하며 제자리에, Q4_0 은 블록앞에서 니블을 부호 있는 바이트로 풀며 제자리에.
   - 워프마다 16 × 16 칸씩 정수행렬판곱둘(D = (A1 · B) · 256 + A0 · B)로 곱해 워프의 D 판에 두고, 스레드마다 정수타일선형의 조각 칸
     (행 g · g + 8, 열 2t · 2t + 1)을 D 에서 읽어 같은 끝셈으로 더한다. 정수 곱의 합은 정확하고 끝셈의 차례는 그대로라 비트까지 같다.
   - 이 판의 모듈은 SPIR-V 뒷단(--협력 MxNxK)으로만 옮긴다. PTX 뒷단은 정수행렬판곱을 모른다. *)

상수 정수 협AS = 12.               (* A 의 줄 사이(낱말) — 32 바이트 + 메움 16 바이트 *)
상수 정수 협BS = 12.               (* B 의 열 사이(낱말) *)
상수 정수 협DS = 20.               (* D 의 줄 사이(낱말) — 16 + 4 *)
정수 협U = 0.                      (* Q4_0 — 풀어 둔 B 의 자리(낱말) *)
정수 협D = 0.                      (* 워프마다의 D 판이 시작하는 자리(낱말) *)
정수 협nu = 0.                     (* Q4_0 — 스레드마다 푸는 열의 수 *)
참거짓 협력레인 = 거짓.              (* --레인 16x8 | 16x16 — 레인의 성분이 정수텐서곱의 조각 칸들인 장치(NVIDIA): D 를 판에 두지 않는다 *)
참거짓 협력묶음 = 참.                (* 묶음 판 — 단 S 개를 한꺼번에 올리고(장벽) S 블록을 차례로 곱한다(장벽). Vulkan 에는 비동기 복사가
                                       없어 블록마다 올리면 복사의 지연이 블록마다 드러난다. Q4_0 은 니블을 올릴 때 레지스터에서 푼다.
                                       판마다 BN ≥ T(스레드마다 B 의 열이 하나 이상)일 때만 — 2026-10-14 판마다 잰 값(34단계 34g).
                                       --협력묶음없이 면 모든 판이 예전 길(블록마다 올리기) *)
참거짓 타묶음 = 거짓.                (* 지금 내는 판이 묶음 판인가 — 정수협력타일선형 이 정한다 *)
참거짓 협력레인16 = 거짓.            (* 16x16(성분 j = 행 g + 8 · (j >> 2), 열 8 · ((j >> 1) & 1) + 2t + (j & 1)), 아니면 16x8(정수텐서곱 차례) *)

(* --레인: 성분 j 가 놓인 칸 — 16 × 16 의 열 조각(0 · 1)과 정수텐서곱 조각의 칸(0 … 3: 행 g · g + 8 × 열 2t · 2t + 1) *)
[정수 j를 레인열조각]는 -> 정수 {
    협력레인16이면 { 반환 (j >> 1) & 1. }
    반환 j >> 2.
}

[정수 j를 레인칸]는 -> 정수 {
    협력레인16이면 { 반환 ((j >> 2) << 1) | (j & 1). }
    반환 j & 3.
}

(* 블록 kb 를 판 bb 에 — A(자리마다 행 BM × 32 바이트, 16 바이트 조각) · 정보(BM 낱말) · B(Q8_0 은 낱말씩, Q4_0 은 16 바이트 조각) · 척도 *)
[문자열 bb를 문자열 kb를 문자열 ind를 참거짓 달리기를 협력올리기]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    정수 T = 타T.
    줄(o, 서식글("{ind}정수 올바탕 = ({bb}) * {타BUF}.")).
    아닌 달리기이면 { 줄(o, 서식글("{ind}정수 k8 = ({kb}) * 8.")). }
    반복 (정수 u는 0부터 타NA 전까지) {
        문자열 ca = 서식글("{ind}비동기복사16(판 에, 올바탕 + {타OA} + a저장{u} 를, 자리넓 에서, pa{u} 로).").
        아닌 달리기이면 { ca = 서식글("{ind}비동기복사16(판 에, 올바탕 + {타OA} + a저장{u} 를, 자리넓 에서, ga{u} + k8 로)."). }
        정수 a_th = 타NAc - T * u.
        a_th >= T이면 { 줄(o, ca). }
        아니면 {
            문자열 csa = 앞뒤빈칸떼기(ca).
            줄(o, 서식글("{ind}tid < {a_th}이면 \{ {csa} \}")).
        }
    }
    달리기이면 { 줄(o, 서식글("{ind}tid < {타BM / 4}이면 \{ 비동기복사16(판 에, 올바탕 + {타OI} + tid * 4 를, 정보넓 에서, pi 로). \}")). }
    아니면 { 줄(o, 서식글("{ind}tid < {타BM / 4}이면 \{ 비동기복사16(판 에, 올바탕 + {타OI} + tid * 4 를, 정보넓 에서, gi + ({kb}) * 정보폭 로). \}")). }
    문자열 복사 = "비동기복사".
    타Q4이면 { 복사 = "비동기복사16". }
    반복 (정수 u2는 0부터 타nb 전까지) {
        정수 n_th = 타NBc - T * u2.
        (타Q4 그리고 타묶음)이면 {
            (* 묶음 판의 Q4_0 — 열의 니블 16 바이트를 레지스터로 읽어 깊이 차례의 부호 있는 바이트 32 로 풀어 단에 쓴다. 낱말 w0 … w3 →
               아래(w0) 아래(w2) 위(w0) 위(w2) | 아래(w1) 아래(w3) 위(w1) 위(w3) — 블록앞의 풀기와 같은 바이트 *)
            문자열 src = 서식글("pb{u2}").
            아닌 달리기이면 { src = 서식글("gb{u2} + ({kb}) * 열걸음"). }
            문자열 ind2 = ind.
            n_th < T이면 {
                줄(o, 서식글("{ind}tid < {n_th}이면 \{")).
                ind2 = 서식글("{ind}    ").
            }
            줄(o, 서식글("{ind2}정수 qi{u2} = {src}.")).
            줄(o, 서식글("{ind2}정수 qa{u2} = 넓게읽기(0, 가중넓 에서, qi{u2} 로).")).
            줄(o, 서식글("{ind2}정수 qb{u2} = 넓게읽기(1, 가중넓 에서, qi{u2} 로).")).
            줄(o, 서식글("{ind2}정수 LA{u2} = ((qa{u2} & 1085102592571150095) + 8680820740569200760) ^ 넷풀기표.")).
            줄(o, 서식글("{ind2}정수 LB{u2} = ((qb{u2} & 1085102592571150095) + 8680820740569200760) ^ 넷풀기표.")).
            줄(o, 서식글("{ind2}정수 HA{u2} = (((qa{u2} >> 4) & 1085102592571150095) + 8680820740569200760) ^ 넷풀기표.")).
            줄(o, 서식글("{ind2}정수 HB{u2} = (((qb{u2} >> 4) & 1085102592571150095) + 8680820740569200760) ^ 넷풀기표.")).
            줄(o, 서식글("{ind2}넓게쓰기(판, 올바탕 + {타OB} + b저장{u2}, (LA{u2} & 4294967295) | (LB{u2} << 32), (HA{u2} & 4294967295) | (HB{u2} << 32)).")).
            줄(o, 서식글("{ind2}넓게쓰기(판, 올바탕 + {타OB} + b저장{u2} + 4, ((LA{u2} >> 32) & 4294967295) | (LB{u2} & 넷위표), ((HA{u2} >> 32) & 4294967295) | (HB{u2} & 넷위표)).")).
            n_th < T이면 { 줄(o, 서식글("{ind}\}")). }
            계속.
        }
        문자열 c = 서식글("{ind}{복사}(판 에, 올바탕 + {타OB} + b저장{u2} 를, 가중넓 에서, pb{u2} 로).").
        아닌 달리기이면 { c = 서식글("{ind}{복사}(판 에, 올바탕 + {타OB} + b저장{u2} 를, 가중넓 에서, gb{u2} + ({kb}) * 열걸음 로)."). }
        n_th >= T이면 { 줄(o, c). }
        아니면 {
            문자열 cs = 앞뒤빈칸떼기(c).
            줄(o, 서식글("{ind}tid < {n_th}이면 \{ {cs} \}")).
        }
    }
    달리기이면 { 줄(o, 서식글("{ind}tid < {타BN / 8}이면 \{ 비동기복사16(판 에, 올바탕 + {타OS} + tid * 4 를, 척도넓 에서, ps 로). \}")). }
    아니면 { 줄(o, 서식글("{ind}tid < {타BN / 8}이면 \{ 비동기복사16(판 에, 올바탕 + {타OS} + tid * 4 를, 척도넓 에서, gs8 + ({kb}) * 척도걸음 로). \}")). }
    반환 o.
}

(* 블록 kb + S − 1 을 올릴 버퍼(타올림글)에, 달리는 색인을 걸음만큼 *)
[문자열 kb를 문자열 ind를 협력올리기묶음]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}{kb} + {타S - 1} < 블록수이면 \{")).
    줄들(o, 협력올리기(타올림글, 서식글("{kb} + {타S - 1}"), 서식글("{ind}    "), 참)).
    줄(o, 서식글("{ind}\}")).
    줄(o, 서식글("{ind}비동기묶기().")).
    반복 (정수 u는 0부터 타NA 전까지) { 줄(o, 서식글("{ind}pa{u} = pa{u} + 8.")). }
    줄(o, 서식글("{ind}pi = pi + 정보폭.")).
    반복 (정수 u2는 0부터 타nb 전까지) { 줄(o, 서식글("{ind}pb{u2} = pb{u2} + 열걸음.")). }
    줄(o, 서식글("{ind}ps = ps + 척도걸음.")).
    반환 o.
}

(* 니블 낱말 w 의 아래 · 위 니블 넷을 부호 있는 바이트 넷으로 — 정수타일선형의 b0 · b1 과 같은 식 *)
[문자열 w를 참거짓 위를 니블풀기식]는 -> 문자열 {
    위이면 { 반환 서식글("(((({w} >> 4) & 252645135) + 2021161080) ^ 2155905152) 으로 중간정수"). }
    반환 서식글("((({w} & 252645135) + 2021161080) ^ 2155905152) 으로 중간정수").
}

(* 블록앞(kb, ind) — 기다리기 · 동기화 · 다음 올리기 · 판의 자리 · (Q4_0) 니블 풀기 · 행의 정보 *)
[문자열 kb를 문자열 ind를 협력블록앞]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    줄(o, 서식글("{ind}비동기기다리기({타S - 2}).")).
    줄(o, 서식글("{ind}동기화().")).
    줄들(o, 협력올리기묶음(kb, ind)).
    줄(o, 서식글("{ind}정수 BB = {타버퍼글} * {타BUF}.")).
    줄(o, 서식글("{ind}정수 BI = BB + oi.")).
    줄(o, 서식글("{ind}정수 BSh = BB * 2 + osh.")).
    타Q4이면 {
        (* 열마다 니블 낱말 넷 w0 … w3 → 깊이 차례의 낱말 여덟: 아래(w0) 아래(w2) 위(w0) 위(w2) 아래(w1) 아래(w3) 위(w1) 위(w3) *)
        문자열[8] 원.
        원[0] = "w0". 원[1] = "w2". 원[2] = "w0". 원[3] = "w2". 원[4] = "w1". 원[5] = "w3". 원[6] = "w1". 원[7] = "w3".
        반복 (정수 i는 0부터 협nu 전까지) {
            줄(o, 서식글("{ind}uc{i} < {타BN}이면 \{")).
            반복 (정수 w는 0부터 4 전까지) { 줄(o, 서식글("{ind}    중간정수 w{w} = 판i[BB + {타OB} + uc{i} * 4 + {w}].")). }
            줄(o, 서식글("{ind}    정수 ud = {협U} + uc{i} * {협BS}.")).
            반복 (정수 j는 0부터 8 전까지) {
                문자열 식 = 니블풀기식(원[j], (j / 2) % 2 == 1).
                줄(o, 서식글("{ind}    판i[ud + {j}] = {식}.")).
            }
            줄(o, 서식글("{ind}\}")).
        }
        줄(o, 서식글("{ind}동기화().")).
    }
    반복 (정수 m2는 0부터 타MT 전까지) {
        반복 (정수 h는 0부터 2 전까지) {
            줄(o, 서식글("{ind}mp{m2}_{h} = 판i[BI + {16 * m2 + 8 * h}].")).
            줄(o, 서식글("{ind}mf{m2}_{h} = 비트실수(mp{m2}_{h}).")).
            아닌 타Q4이면 { 줄(o, 서식글("{ind}P{m2}_{h} = 비트실수(mp{m2}_{h} + 4194304).")). }       (* 31단계 — P · 2²⁴ = 2^(E + 11) *)
        }
    }
    반환 o.
}

(* 블록의 척도 — 스레드의 열(열 조각 n 의 2t · 2t + 1)마다 하나 *)
[문자열 ind를 협력척도]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    반복 (정수 n는 0부터 타NT 전까지) {
        반복 (정수 e는 0부터 2 전까지) { 줄(o, 서식글("{ind}짧은실수 dn{n}_{e} = 판h[BSh + {8 * n + e}] 으로 짧은실수.")). }
    }
    반환 o.
}

(* 곱과 끝셈(m, p, ind) — 행 조각 m · 열 짝 p(열 조각 2p · 2p + 1)의 16 × 16 칸을 협력 행렬로 곱해 D 판에, 스레드의 칸을 읽어 더한다 *)
[정수 m을 정수 p를 문자열 ind를 협력곱]는 -> 문자열목록 참조 {
    문자열목록 참조 o = 줄목록().
    정수 a0 = 타OA + 16 * m * 협AS.
    정수 a1 = a0 + 협AS * 타BM.
    문자열 bb = 서식글("BB + {타OB + 16 * p * 협BS} + bw").
    (타Q4 그리고 아닌 타묶음)이면 { bb = 서식글("{협U + 16 * p * 협BS} + bw"). }       (* 묶음 판의 Q4_0 은 단에 풀어 둔 바이트 *)
    협력레인이면 {
        (* --레인: 레인의 성분 j 가 정수텐서곱의 조각 칸(열 조각 2p + (j >> 2) 의 칸 j & 3)인 장치(NVIDIA 의 16x8x32) — D 를 판에 두지 않는다 *)
        (* 주소는 변수로 — 성분 j 를 이어 부를 때 인자가 같은 변수여야 하고, 뒷단은 같은 값의 A(행 조각마다) · B(열 짝마다)를 다시 쓴다 *)
        p == 0이면 {
            줄(o, 서식글("{ind}정수 pa1_{m} = BB + {a1} + aw.")).
            줄(o, 서식글("{ind}정수 pa0_{m} = BB + {a0} + aw.")).
        }
        m == 0이면 { 줄(o, 서식글("{ind}정수 pb_{p} = {bb}.")). }
        반복 (정수 j는 0부터 8 전까지) {
            정수 nj = 2 * p + 레인열조각(j).
            정수 cj = 레인칸(j).
            줄(o, 서식글("{ind}중간정수 T{nj}_{m}_{cj} = 정수행렬판곱둘성분({j}, 판, pa1_{m}, pa0_{m}, {협AS}, pb_{p}, {협BS}).")).
        }
    }
    아니면 자리수 == 1이면 { 줄(o, 서식글("{ind}정수행렬판곱(판, BB + {a0} + aw, {협AS}, {bb}, {협BS}, DW, {협DS}).")). }
    아니면 { 줄(o, 서식글("{ind}정수행렬판곱둘(판, BB + {a1} + aw, BB + {a0} + aw, {협AS}, {bb}, {협BS}, DW, {협DS}).")). }
    아닌 협력레인이면 { 줄(o, 서식글("{ind}워프동기화().")). }
    반복 (정수 nn는 0부터 2 전까지) {
        정수 n = 2 * p + nn.
        반복 (정수 c는 0부터 4 전까지) {
            정수 h = c >> 1.
            정수 e2 = c & 1.
            아닌 협력레인이면 { 줄(o, 서식글("{ind}중간정수 T{n}_{m}_{c} = 판i[dr + {8 * h * 협DS + 8 * nn + e2}].")). }
            타Q4이면 {                        (* 27단계 — 마법수 + T 의 비트를 실수로 읽어 M 을 빼면 T · 2^(E − 13) (정확) *)
                줄(o, 서식글("{ind}중간정수 Tq{n}_{m}_{c} = mp{m}_{h} + T{n}_{m}_{c}.")).
                줄(o, 서식글("{ind}y{m}_{n}_{c} = 곱해더하기(비트실수(Tq{n}_{m}_{c}) - mf{m}_{h}, dn{n}_{e2}, y{m}_{n}_{c}).")).
            }
            아니면 {
                줄(o, 서식글("{ind}짧은실수 Pdn{n}_{m}_{c} = P{m}_{h} * dn{n}_{e2}.")).
                줄(o, 서식글("{ind}y{m}_{n}_{c} = 곱해더하기((T{n}_{m}_{c} 으로 짧은실수) * 0.000000059604644775390625, Pdn{n}_{m}_{c}, y{m}_{n}_{c}).")).
            }
        }
    }
    아닌 협력레인이면 { 줄(o, 서식글("{ind}워프동기화().")). }
    반환 o.
}

(* 묶음 판의 몸(정수협력타일선형 의 머리 뒤) — 달리는 포인터는 블록 0 에서. 반복마다: 장벽(앞 묶음의 곱이 모두 끝남) → 블록
   kb0 … kb0 + S − 1 을 단 0 … S − 1 에 → 장벽 → 단마다 차례로 곱. 장벽은 S 블록에 둘, 복사의 지연은 S 블록에 한 번 드러난다.
   블록마다의 곱 · 끝셈의 차례는 그대로라 값이 같다 *)
[문자열 epi를 정수 MT를 정수 NT를 정수 WR를 정수 WC를 협력묶음몸]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    정수 S = 타S.
    반복 (정수 u5는 0부터 타NA 전까지) { 줄(L, 서식글("    정수 pa{u5} = ga{u5}.")). }
    줄(L, "    정수 pi = gi.").
    반복 (정수 u6는 0부터 타nb 전까지) { 줄(L, 서식글("    정수 pb{u6} = gb{u6}.")). }
    줄(L, "    정수 ps = gs8.").
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    반복 (정수 m는 0부터 MT 전까지) {
        반복 (정수 n는 0부터 NT 전까지) {
            반복 (정수 i2는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 y{m}_{n}_{i2} = 영.")). }
        }
    }
    반복 (정수 m3는 0부터 MT 전까지) { 반복 (정수 h는 0부터 2 전까지) { 줄(L, 서식글("    중간정수 mp{m3}_{h} = 0.")). } }
    반복 (정수 m4는 0부터 MT 전까지) { 반복 (정수 h2는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 mf{m4}_{h2} = 영.")). } }
    반복 (정수 m5는 0부터 MT 전까지) { 반복 (정수 h3는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 P{m5}_{h3} = 영.")). } }
    줄(L, 서식글("    반복 (정수 kb0 = 0: kb0 < 블록수: kb0 += {S}) \{")).
    줄(L, "        동기화().").
    반복 (정수 pj는 0부터 S 전까지) {
        pj == 0이면 { 줄(L, "        \{"). }
        아니면 { 줄(L, 서식글("        kb0 + {pj} < 블록수이면 \{")). }
        줄들(L, 협력올리기(서식글("{pj}"), "", "            ", 참)).
        줄(L, "        \}").
        반복 (정수 u는 0부터 타NA 전까지) { 줄(L, 서식글("        pa{u} = pa{u} + 8.")). }
        줄(L, "        pi = pi + 정보폭.").
        반복 (정수 u2는 0부터 타nb 전까지) { 줄(L, 서식글("        pb{u2} = pb{u2} + 열걸음.")). }
        줄(L, "        ps = ps + 척도걸음.").
    }
    줄(L, "        동기화().").
    반복 (정수 pj2는 0부터 S 전까지) {
        문자열 I = "                ".
        줄(L, "        \{").
        줄(L, 서식글("            정수 kb = kb0 + {pj2}.")).
        줄(L, "            kb < 블록수이면 \{").
        줄(L, 서식글("{I}정수 BB = {pj2 * 타BUF}.")).
        줄(L, 서식글("{I}정수 BI = BB + oi.")).
        줄(L, 서식글("{I}정수 BSh = BB * 2 + osh.")).
        반복 (정수 m2는 0부터 MT 전까지) {
            반복 (정수 h4는 0부터 2 전까지) {
                줄(L, 서식글("{I}mp{m2}_{h4} = 판i[BI + {16 * m2 + 8 * h4}].")).
                줄(L, 서식글("{I}mf{m2}_{h4} = 비트실수(mp{m2}_{h4}).")).
                아닌 타Q4이면 { 줄(L, 서식글("{I}P{m2}_{h4} = 비트실수(mp{m2}_{h4} + 4194304).")). }
            }
        }
        줄들(L, 협력척도(I)).
        반복 (정수 m6는 0부터 MT 전까지) {
            반복 (정수 pp는 0부터 NT / 2 전까지) { 줄들(L, 협력곱(m6, pp, I)). }
        }
        줄(L, "            \}").
        줄(L, "        \}").
    }
    줄(L, "    \}").
    줄들(L, 정수타일끝(epi, MT, NT, WR, WC)).
    줄(L, "\}").
    반환 L.
}

(* 정수 블록 계약의 행렬곱 — BM × BN 칸을 블록 하나가, 블록마다의 곱은 협력 행렬로 *)
[문자열 epi를 문자열 이름을 문자열 형식을 문자열 판을 참거짓 열먼저를 정수협력타일선형]는 -> 문자열목록 참조 {
    정수 p = 판번호(판).
    정수 WM = 판WM[p]. 정수 WN = 판WN[p]. 정수 MT = 판MT[p]. 정수 NT = 판NT[p]. 정수 한도 = 판한도[p]. 정수 S = 판S[p].
    정수 T = 32 * WM * WN.
    정수 WR = 16 * MT.
    정수 WC = 8 * NT.
    정수 BM = WR * WM.
    정수 BN = WC * WN.
    참거짓 Q4 = 문자열_같은가(형식, "Q4_0").
    정수 BW = 8.
    Q4이면 { BW = 4. }
    정수 OA = 0.
    정수 OB = 협AS * 자리수 * BM.
    정수 B크기 = BN * 협BS.
    Q4이면 { B크기 = BN * 4. }
    정수 OI = OB + B크기.
    정수 OS = OI + BM.
    정수 BUF = OS + BN / 2.
    정수 U크기 = 0.
    Q4이면 { U크기 = BN * 협BS. }
    정수 D크기 = WM * WN * 16 * 협DS.
    협력레인이면 { D크기 = 0. }                (* --레인: D 를 레지스터에서 바로 *)
    (S > 2 그리고 (S * BUF + U크기 + D크기) * 4 > 48 * 1024)동안 { S = S - 1. }
    참거짓 묶을판 = 협력묶음 그리고 BN >= T.     (* 스레드마다 B 의 열이 하나 이상인 판만 — 작은 판(BN < T)은 예전 길이 빨랐다 *)
    타묶음 = 묶을판.
    묶을판이면 {
        (* 묶음 판: Q4_0 도 B 를 풀어 단에 둔다(U 없음). 단의 수는 예전 판의 공유 메모리 안에서(점유를 그대로), 적어도 둘 *)
        정수 예산 = S * BUF + U크기.
        B크기 = BN * 협BS.
        OI = OB + B크기.
        OS = OI + BM.
        BUF = OS + BN / 2.
        U크기 = 0.
        S = 예산 / BUF.
        S < 2이면 { S = 2. }
        (S > 2 그리고 (S * BUF + D크기) * 4 > 48 * 1024)동안 { S = S - 1. }
    }
    협U = S * BUF.
    협D = 협U + U크기.
    정수 공유 = 공유판크기((협D + D크기) * 4).
    협nu = (BN + T - 1) / T.
    문자열 가중 = 가중선언("가중치", "척도").
    문자열 잔차 = "".
    문자열_같은가(epi, "_잔차")이면 { 잔차 = "짧은실수 참조 잔차와 ". }
    문자열 출력부 = "짧은실수 참조 출력에".
    문자열_같은가(epi, "_SwiGLU정수")이면 { 출력부 = "중간정수 참조 다음정보와 중간정수 참조 다음자리에". }
    아니면 문자열_같은가(epi, "_QKV정수")이면 {
        출력부 = "중간정수 참조 자릿값q와 중간정수 참조 정보q와 중간정수 참조 키칸과 중간정수 참조 값칸과 부호없는 작은정수 참조 키지수와 부호없는 작은정수 참조 값지수와 짧은실수 참조 코사인과 짧은실수 참조 사인에".
    }
    문자열 KV부 = "".
    문자열_같은가(epi, "_QKV정수")이면 { KV부 = " 정수 묶음안행수로 정수 위치시작으로 정수 최대길이로". }
    문자열 머리 = 서식글("중간정수 참조 자릿값에서 중간정수 참조 정보와 {가중}짧은실수 참조 치우침과 {잔차}{출력부} 정수 행수로 정수 깊이로 정수 열수로 정수 척도폭으로{KV부} 정수 행시작으로 정수 열시작으로").
    문자열목록 참조 L = 줄목록().
    줄(L, 서식글("(* 정수 블록 계약의 행렬곱({형식}) — {BM} × {BN} 칸, 워프 {WM} × {WN}, 블록마다의 곱은 협력 행렬(34단계) *)")).
    줄(L, 서식글("(* 실행한도 {이름} {T} {한도} *)")).
    줄(L, 서식글("[{머리} {이름}]는 \{")).
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 lane = tid % 32.").
    줄(L, "    정수 g = lane / 4.").
    줄(L, "    정수 t = lane % 4.").
    줄(L, 서식글("    정수 wm = (tid / 32) / {WN}.")).
    줄(L, 서식글("    정수 wn = (tid / 32) % {WN}.")).
    열먼저이면 { 줄(L, 서식글("    정수 행0 = 행시작 + 블록세로() * {BM}.")). }
    아니면 { 줄(L, 서식글("    정수 행0 = 행시작 + 블록가로() * {BM}.")). }
    열먼저이면 { 줄(L, 서식글("    정수 열0 = 열시작 + 블록가로() * {BN}.")). }
    아니면 { 줄(L, 서식글("    정수 열0 = 열시작 + 블록세로() * {BN}.")). }
    줄(L, 서식글("    짧은실수 참조 판 = 공유판{공유}().")).
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    반실수 참조 판h = 판 으로 반실수 참조.").
    줄(L, "    짧은실수 참조 자리넓 = 자릿값 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 정보넓 = 정보 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 가중넓 = 가중치 으로 짧은실수 참조.").
    줄(L, "    짧은실수 참조 척도넓 = 척도 으로 짧은실수 참조.").
    줄(L, "    정수 블록수 = 깊이 / 32.").
    줄(L, "    정수 깊이4 = 깊이 / 4.").
    줄(L, "    정수 정보폭 = (행수 + 63) / 64 * 64.").
    정수 NA = (2 * 자리수 * BM + T - 1) / T.
    반복 (정수 u는 0부터 NA 전까지) {
        줄(L, 서식글("    정수 ac{u} = tid + {T * u}.")).
        줄(L, 서식글("    정수 ar{u} = (ac{u} / 2) % {BM}.")).
        줄(L, 서식글("    정수 rg{u} = 행0 + ar{u}.")).
        줄(L, 서식글("    rg{u} >= 행수이면 \{ rg{u} = 행수 - 1. \}")).
        줄(L, 서식글("    정수 a저장{u} = (ac{u} / {2 * BM}) * {협AS * BM} + ar{u} * {협AS} + (ac{u} % 2) * 4.")).
        줄(L, 서식글("    정수 ga{u} = ((ac{u} / {2 * BM}) * 행수 + rg{u}) * 깊이4 + (ac{u} % 2) * 4.")).
    }
    줄(L, "    정수 gi = 행0 + tid * 4.").
    줄(L, "    정수 척도걸음 = 척도폭 / 2.").
    정수 NBc = BN * 8.                   (* Q8_0 — 열마다 낱말 여덟을 하나씩 *)
    Q4이면 { NBc = BN. }                 (* Q4_0 — 열마다 16 바이트 조각 하나 *)
    정수 nb = (NBc + T - 1) / T.
    반복 (정수 u2는 0부터 nb 전까지) {
        Q4이면 {
            줄(L, 서식글("    정수 bc{u2} = tid + {T * u2}.")).
            줄(L, 서식글("    정수 cg{u2} = 열0 + bc{u2}.")).
            줄(L, 서식글("    cg{u2} >= 열수이면 \{ cg{u2} = 열수 - 1. \}")).
            묶을판이면 { 줄(L, 서식글("    정수 b저장{u2} = bc{u2} * {협BS}.")). }        (* 풀어 둔 열 *)
            아니면 { 줄(L, 서식글("    정수 b저장{u2} = bc{u2} * 4.")). }
            줄(L, 서식글("    정수 gb{u2} = cg{u2} * 4.")).
            계속.
        }
        (* 저장의 낱말 i 는 깊이 낱말 (i % 4) · 2 + i / 4 — 판에는 깊이 차례로 *)
        줄(L, 서식글("    정수 bx{u2} = tid + {T * u2}.")).
        줄(L, 서식글("    정수 bc{u2} = bx{u2} / 8.")).
        줄(L, 서식글("    정수 bs{u2} = bx{u2} % 8.")).
        줄(L, 서식글("    정수 cg{u2} = 열0 + bc{u2}.")).
        줄(L, 서식글("    cg{u2} >= 열수이면 \{ cg{u2} = 열수 - 1. \}")).
        줄(L, 서식글("    정수 b저장{u2} = bc{u2} * {협BS} + (bs{u2} % 4) * 2 + bs{u2} / 4.")).
        줄(L, 서식글("    정수 gb{u2} = cg{u2} * 8 + bs{u2}.")).
    }
    줄(L, 서식글("    정수 열걸음 = 열수 * {BW}.")).
    줄(L, 서식글("    정수 oi = {OI} + wm * {WR} + g.")).
    줄(L, 서식글("    정수 osh = {2 * OS} + wn * {WC} + t * 2.")).
    줄(L, "    정수 c8 = 열0 + tid * 8.").
    줄(L, "    c8 > 척도폭 - 8이면 \{ c8 = 척도폭 - 8. \}").
    줄(L, "    정수 gs8 = c8 / 2.").
    줄(L, 서식글("    정수 aw = wm * {WR * 협AS}.")).
    줄(L, 서식글("    정수 bw = wn * {WC * 협BS}.")).
    줄(L, 서식글("    정수 DW = {협D} + (tid / 32) * {16 * 협DS}.")).
    줄(L, 서식글("    정수 dr = DW + g * {협DS} + t * 2.")).
    (Q4 그리고 아닌 묶을판)이면 { 반복 (정수 i는 0부터 협nu 전까지) { 줄(L, 서식글("    정수 uc{i} = tid + {T * i}.")). } }
    (Q4 그리고 묶을판)이면 {                  (* 올릴 때 니블을 푸는 표 — 0x8080808080808080 · 0xFFFFFFFF00000000 *)
        줄(L, "    정수 넷풀기표 = 0 - 9187201950435737472.").
        줄(L, "    정수 넷위표 = 0 - 4294967296.").
    }
    타T = T. 타BM = BM. 타BN = BN. 타S = S. 타BUF = BUF. 타OA = OA. 타OB = OB. 타OI = OI. 타OS = OS.
    타NA = NA. 타nb = nb. 타NBc = NBc. 타MT = MT. 타NT = NT. 타NAc = 2 * 자리수 * BM.
    타Q4 = Q4.
    묶을판이면 {
        줄들(L, 협력묶음몸(epi, MT, NT, WR, WC)).
        반환 L.
    }
    반복 (정수 p2는 0부터 S - 1 전까지) {
        p2 == 0이면 { 줄(L, "    \{"). }
        아니면 { 줄(L, 서식글("    {p2} < 블록수이면 \{")). }
        줄들(L, 협력올리기(서식글("{p2}"), 서식글("{p2}"), "        ", 거짓)).
        줄(L, "    \}").
        줄(L, "    비동기묶기().").
    }
    반복 (정수 u5는 0부터 NA 전까지) { 줄(L, 서식글("    정수 pa{u5} = ga{u5} + {(S - 1) * 8}.")). }
    줄(L, 서식글("    정수 pi = gi + {S - 1} * 정보폭.")).
    반복 (정수 u6는 0부터 nb 전까지) { 줄(L, 서식글("    정수 pb{u6} = gb{u6} + {S - 1} * 열걸음.")). }
    줄(L, 서식글("    정수 ps = gs8 + {S - 1} * 척도걸음.")).
    줄(L, "    짧은실수 영 = 0 으로 짧은실수.").
    반복 (정수 m는 0부터 MT 전까지) {
        반복 (정수 n는 0부터 NT 전까지) {
            반복 (정수 i2는 0부터 4 전까지) { 줄(L, 서식글("    짧은실수 y{m}_{n}_{i2} = 영.")). }
        }
    }
    반복 (정수 m3는 0부터 MT 전까지) { 반복 (정수 h는 0부터 2 전까지) { 줄(L, 서식글("    중간정수 mp{m3}_{h} = 0.")). } }
    반복 (정수 m4는 0부터 MT 전까지) { 반복 (정수 h2는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 mf{m4}_{h2} = 영.")). } }
    반복 (정수 m5는 0부터 MT 전까지) { 반복 (정수 h3는 0부터 2 전까지) { 줄(L, 서식글("    짧은실수 P{m5}_{h3} = 영.")). } }
    (* 주 반복을 S 번 펼친다: 몸 pj 의 버퍼는 pj, 올릴 버퍼는 (pj + S − 1) % S *)
    줄(L, 서식글("    반복 (정수 kb0 = 0: kb0 < 블록수: kb0 += {S}) \{")).
    반복 (정수 pj는 0부터 S 전까지) {
        문자열 I = "                ".
        타버퍼글 = 서식글("{pj}").
        타올림글 = 서식글("{(pj + S - 1) % S}").
        줄(L, "        \{").
        줄(L, 서식글("            정수 kb = kb0 + {pj}.")).
        줄(L, "            kb < 블록수이면 \{").
        줄들(L, 협력블록앞("kb", I)).
        줄들(L, 협력척도(I)).
        반복 (정수 m6는 0부터 MT 전까지) {
            반복 (정수 pp는 0부터 NT / 2 전까지) { 줄들(L, 협력곱(m6, pp, I)). }
        }
        줄(L, "            \}").
        줄(L, "        \}").
    }
    줄(L, "    \}").
    줄들(L, 정수타일끝(epi, MT, NT, WR, WC)).
    줄(L, "\}").
    반환 L.
}

(* --레인 모듈의 차례 확인 판 — 엔진이 모듈을 올릴 때 돌린다. A1 = 0, A0 = [단위 16 | 0], B[k][c] = 16k + c − 128(k < 16)이면
   D[r][c] = 16r + c − 128 이라, 레인의 성분 j 가 이 모듈의 차례(레인열조각 · 레인칸)의 칸과 같은지 센다. 답칸[레인] = 틀린 성분 수 *)
[협력차례확인판]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "(* 34단계 — --레인 모듈: 장치의 협력 행렬 성분 차례가 이 모듈의 차례와 같은지(엔진이 올릴 때 돌린다) *)").
    줄(L, "[중간정수 참조 답칸에 협력차례확인]는 \{").
    줄(L, "    정수 tid = 블록안가로().").
    줄(L, "    정수 g = tid / 4.").
    줄(L, "    정수 t = tid % 4.").
    줄(L, "    짧은실수 참조 판 = 공유판4().").
    줄(L, "    중간정수 참조 판i = 판 으로 중간정수 참조.").
    줄(L, "    tid < 16이면 \{").
    줄(L, "        반복 (정수 w는 0부터 12 전까지) \{ 판i[tid * 12 + w] = 0. 판i[192 + tid * 12 + w] = 0. \}").
    줄(L, "        판i[192 + tid * 12 + tid / 4] = (1 << (8 * (tid % 4))) 으로 중간정수.").
    줄(L, "        반복 (정수 w2는 0부터 12 전까지) \{").
    줄(L, "            정수 v = 0.").
    줄(L, "            w2 < 4이면 \{ 반복 (정수 b는 0부터 4 전까지) \{ v = v | (((16 * (w2 * 4 + b) + tid - 128) & 255) << (8 * b)). \} \}").
    줄(L, "            판i[384 + tid * 12 + w2] = v 으로 중간정수.").
    줄(L, "        \}").
    줄(L, "    \}").
    줄(L, "    워프동기화().").
    줄(L, "    정수 틀림 = 0.").
    반복 (정수 j는 0부터 8 전까지) {
        정수 nn = 레인열조각(j).
        정수 cc = 레인칸(j).
        줄(L, 서식글("    중간정수 s{j} = 정수행렬판곱둘성분({j}, 판, 0, 192, 12, 384, 12).")).
        줄(L, 서식글("    (s{j} 으로 정수) != 16 * (g + {8 * (cc >> 1)}) + {8 * nn + (cc & 1)} + 2 * t - 128이면 \{ 틀림 += 1. \}")).
    }
    줄(L, "    답칸[tid] = 틀림 으로 중간정수.").
    줄(L, "\}").
    반환 L.
}

(* 모듈 머리의 내장 선언 — 협력 행렬의 판 곱(SPIR-V 뒷단) *)
[협력머리줄]는 -> 문자열목록 참조 {
    문자열목록 참조 L = 줄목록().
    줄(L, "외부 [짧은실수 참조 판에 정수 a자리를 정수 a너비를 정수 b자리를 정수 b너비를 정수 d자리를 정수 d너비를 정수행렬판곱]는.").
    줄(L, "외부 [짧은실수 참조 판에 정수 a1자리를 정수 a0자리를 정수 a너비를 정수 b자리를 정수 b너비를 정수 d자리를 정수 d너비를 정수행렬판곱둘]는.").
    줄(L, "외부 [짧은실수 참조 판에 정수 a자리를 정수 a2자리를 정수 a너비를 정수 b자리를 정수 b2자리를 정수 b너비를 정수 d자리를 정수 d너비를 정수행렬판곱짝]는.").
    줄(L, "외부 [정수 j를 짧은실수 참조 원본에서 정수 색인으로 넓게읽기]는 -> 정수.").
    줄(L, "외부 [짧은실수 참조 판에 정수 자리를 정수 앞을 정수 뒤를 넓게쓰기]는.").
    협력레인이면 {
        줄(L, "외부 [정수 j를 짧은실수 참조 판에 정수 a1자리를 정수 a0자리를 정수 a너비를 정수 b자리를 정수 b너비를 정수행렬판곱둘성분]는 -> 중간정수.").
        줄(L, "외부 [정수 j를 짧은실수 참조 판에 정수 a자리를 정수 a너비를 정수 b자리를 정수 b너비를 정수행렬판곱성분]는 -> 중간정수.").
        줄(L, "외부 [정수 j를 짧은실수 참조 판에 정수 a자리를 정수 a2자리를 정수 a너비를 정수 b자리를 정수 b2자리를 정수 b너비를 정수행렬판곱짝성분]는 -> 중간정수.").
    }
    줄(L, "").
    반환 L.
}
